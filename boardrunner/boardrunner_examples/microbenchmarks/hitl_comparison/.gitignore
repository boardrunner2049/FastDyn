# Local benchmark cruft. Committed artifacts (pre_built/, results/) are
# explicit; everything below is a byproduct of running the benches.

# Fresh `make` output (pre_built/ is what's committed).
firmware/firmware_src/build/

# FastDyn plugin's per-run log dumps (dev.c opens these on plugin_install).
debug.log
io.log

# Avatar2 spawns its openocd/qemu in an "output_directory" that ends up
# next to the bench script.
avatar2/.avatar_out/
**/.avatar_out/

# Python bytecode.
__pycache__/
*.pyc

# Local Python venv (evaluator creates their own; see README step 7).
.venv/
*.bin
libaio_shim/
