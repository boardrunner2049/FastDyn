+/*
+ * Only the ordinary dispatcher, after resolving this particular goto_tb,
+ * may bind a carrier-specific successor. Other callers, even for the same
+ * general TB, use the unchanged public entry. The ordinary G jump list owns
+ * this link so QEMU reset/invalidation restores R's original reset path.
+ */
+bool tcg_supercache_link_direct(CPUState *cpu, TranslationBlock *src, int n,
+                                TranslationBlock *dst, vaddr pc)
+{
+    Sc6Link *link;
+    const Sc6Slot *slot;
+    const Sc6Variant *v;
+
+    if ((unsigned)n >= 2) {
+        return false;
+    }
+    link = sc6.direct_single[n];
+    if (!link && sc6.direct_links[n]) {
+        link = g_hash_table_lookup(sc6.direct_links[n], src);
+    }
+    if (!link) {
+        return false;
+    }
+    slot = &sc6.slots[link->slot];
+    v = &sc6.variants[link->variant];
+    if (slot->e.exit_class != SC6_EXIT_DIRECT || slot->e.slot_n != n ||
+        slot->e.target_vaddr != pc || sc6.live[slot->src] != src ||
+        sc6.live[v->general] != dst) {
+        return false;
+    }
+    sc6_try_arm(cpu, link - sc6.links);
+    return link->armed;
+}
