+/*
+ * Build only after slot/link validation. Cache TB addresses do not move across
+ * flush epochs; sc6.live and the link state still decide whether they are live.
+ * Separate tables keep both ordinary slots of one source independently keyed.
+ */
+static void sc6_index_direct_links(void)
+{
+    if (!tcg_sc6_has_direct) {
+        return;
+    }
+    for (uint32_t i = 0; i < sc6.n_links; i++) {
+        Sc6Link *link = &sc6.links[i];
+        const Sc6Slot *slot = &sc6.slots[link->slot];
+        GHashTable **table;
+        void *src;
+
+        if (slot->e.exit_class != SC6_EXIT_DIRECT) {
+            continue;
+        }
+        table = &sc6.direct_links[slot->e.slot_n];
+        if (!*table && !sc6.direct_single[slot->e.slot_n]) {
+            sc6.direct_single[slot->e.slot_n] = link;
+            continue;
+        }
+        if (!*table) {
+            Sc6Link *first = sc6.direct_single[slot->e.slot_n];
+            const Sc6Slot *first_slot = &sc6.slots[first->slot];
+
+            *table = g_hash_table_new(g_direct_hash, g_direct_equal);
+            src = (uint8_t *)supercache.buffer + first_slot->e.src_tb_offset;
+            g_hash_table_insert(*table, src, first);
+            sc6.direct_single[slot->e.slot_n] = NULL;
+        }
+        src = (uint8_t *)supercache.buffer + slot->e.src_tb_offset;
+        g_hash_table_insert(*table, src, link);
+    }
+}
