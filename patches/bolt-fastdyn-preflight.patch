+# RUN:   %t/fixture.o -o %t/reference.elf
+# RUN: llvm-readelf -rW %t/reference.elf | FileCheck %s --check-prefix=INPUT
+# RUN: rm -f %t/no-got-policy.elf %t/no-target2-policy.elf
+# RUN: not llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-target2=got-rel --relocs --use-old-text \
+# RUN:   --reorder-functions=user --align-functions=1 \
+# RUN:   --function-order=%t/order.txt -o %t/no-got-policy.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=UNQUALIFIED
+# RUN: not test -e %t/no-got-policy.elf
+# RUN: not llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-got=fixed-static --relocs --use-old-text \
