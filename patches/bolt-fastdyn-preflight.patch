+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); l=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='loop_worker'); lf=next(x for x in l['functions'] if x['name']=='loop_worker'); print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),d['summary']['unmapped_instruction_count'],len(lf['instruction_origins']),lf['original_size'],lf['output_size']); print([(hex(x['original_address']) if x.get('original_address') is not None else '-',hex(x['output_address']),x['origin_kind']) for x in lf['instruction_origins']])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# NO-CONTRACT: 0
+# LOG: 1 Functions were reordered by LoopInversionPass
+# DISASM: <loop_worker>:
+# DISASM: movs r1, #0x0
+# DISASM-NEXT: b
+# DISASM-NEXT: adds r1, #0x1
+# DISASM-NEXT: cmp r1, #0x4
+# DISASM-NEXT: blt
+# DISASM-NEXT: mov r0, r1
+# DISASM-NEXT: bx lr
+# REPORT: True loop_inversion 0 7 16 14
+# REPORT-NEXT: [('0x8000006', '0x8000006', 'original_instruction'), ('-', '0x8000008', 'synthesized_control_edge'), ('0x800000a', '0x800000c', 'original_instruction'), ('0x800000c', '0x800000e', 'original_instruction'), ('0x800000e', '0x800000a', 'original_instruction'), ('0x8000012', '0x8000010', 'original_instruction'), ('0x8000014', '0x8000012', 'original_instruction')]
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl loop_worker
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl loop_worker
+  .type loop_worker,%function
+  .thumb_func
+loop_worker:
+  movs r1, #0
+  b .Lloop_check
+.Lloop_check:
+  cmp r1, #4
+  bge .Lloop_exit
+.Lloop_body:
+  adds r1, #1
+  b .Lloop_check
+.Lloop_exit:
+  mov r0, r1
+  bx lr
+  .size loop_worker, .-loop_worker
+
+# FDATA: 1 loop_worker 0 100
+# FDATA: 1 loop_worker 4 500
+# FDATA: 1 loop_worker 8 400
+# FDATA: 1 loop_worker c 100
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
