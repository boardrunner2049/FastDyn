+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=CODE
+# RUN: %python -c "import json; d=json.load(open('%t/report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='target2_got_worker'); p=f['owned_literal_pools'][0]; print(hex(f['original_address']),hex(f['output_address']),hex(p['original_address']),hex(p['output_address']),p['preserve_original_address'],p['relocation_count'])" \
+# RUN:   | FileCheck %s --check-prefix=LAYOUT
+
+# INPUT: 08000120 {{.*}} R_ARM_TARGET2 08000124 value
+# UNQUALIFIED: --firmbolt-arm-target2=got-rel together with --firmbolt-arm-got=fixed-static
+# SYMBOLS: 08000100 T target2_got_worker
+# SYMBOLS: 08000110 T Reset_Handler
+# OUTPUT: 0800010c {{.*}} R_ARM_TARGET2 08000124 value
+# OUTPUT-NOT: R_ARM_GOT_PREL
+# MAPPING-DAG: 0800010c {{.*}} $d
+# MAPPING-DAG: 08000110 {{.*}} $t
+# DATA: Contents of section .rodata:
+# DATA-NEXT: 8000124 2a000000
+# DATA: Contents of section .got:
+# DATA-NEXT: 8000128 24010008
+# CODE: 08000100 <target2_got_worker>:
+# CODE-NEXT: 8000100: 4802          ldr r0, [pc, #0x8]
+# CODE: 800010c: 1c 00 00 00
+# LAYOUT: 0x8000114 0x8000100 0x8000120 0x800010c False 1
+
+//--- fixture.s
+  .syntax unified
+  .cpu cortex-m3
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+
+  .section .isr_vector,"a",%progbits
+  .p2align 2
+  .globl g_pfnVectors
+  .type g_pfnVectors,%object
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+  .size g_pfnVectors, .-g_pfnVectors
+
+  .section .text,"ax",%progbits
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl target2_got_worker
+  movw r1, #0
+  movt r1, #0x2000
+  str r0, [r1]
+.globl fixture_halt
+fixture_halt:
+  b fixture_halt
+  .size Reset_Handler, .-Reset_Handler
+
+  .p2align 2
+  .globl target2_got_worker
+  .type target2_got_worker,%function
+  .thumb_func
+target2_got_worker:
+  ldr r0, .Ltarget2_delta
+  add r0, pc
+  adds r0, #6
+  ldr r0, [r0]
+  ldr r0, [r0]
+  bx lr
+  .p2align 2
+.Ltarget2_delta:
+  .long value(TARGET2)
+  .size target2_got_worker, .-target2_got_worker
+
+  .section .rodata,"a",%progbits
+  .p2align 2
+  .globl value
+  .type value,%object
+value:
+  .long 42
+  .size value, .-value
+
+//--- link.ld
+ENTRY(Reset_Handler)
+MEMORY {
+  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 64K
+  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 16K
+}
+SECTIONS {
+  .isr_vector ORIGIN(FLASH) : { KEEP(*(.isr_vector)) } > FLASH
+  .text ORIGIN(FLASH) + 0x100 : { *(.text*) } > FLASH
+  .rodata : { *(.rodata*) } > FLASH
+  .got : { *(.got*) } > FLASH
+  .data : { *(.data*) } > RAM AT > FLASH
+  .bss (NOLOAD) : { *(.bss*) *(COMMON) } > RAM
+}
+
+//--- order.txt
+target2_got_worker
+Reset_Handler
