+++ b/bolt/test/ARM/thumb-function-splitting-relocs.s
@@ -0,0 +1,154 @@
+## Qualify native BOLT hot/cold function splitting for a relocation-complete
+## Cortex-M image.  The profile observes only split_worker's hot return.  The
+## emitted image still retains and precisely attributes the held-out cold
+## return, while the vector-reachable Reset_Handler remains one fragment.
+
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/fixture.s -o %t/fixture.o
+# RUN: ld.lld --emit-relocs -T %t/link.ld %t/fixture.o -o %t/reference.elf
+
+## Splitting changes placement and the encoding/range of cross-fragment
+## branches, so firmware callers must name that observation contract.
+# RUN: not llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --data=%t/profile.fdata --relocs --use-old-text \
+# RUN:   --merge-text-sections --align-functions=4 --align-text=4 \
+# RUN:   --split-functions --split-all-cold -o %t/unadmitted.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=UNADMITTED
+
+# RUN: llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --data=%t/profile.fdata --relocs --use-old-text \
+# RUN:   --merge-text-sections --align-functions=4 --align-text=4 \
+# RUN:   --split-functions --split-all-cold \
+# RUN:   --firmbolt-allow-function-splitting \
+# RUN:   --fastdyn-firmware-report=%t/report.json \
+# RUN:   -o %t/candidate.elf 2>&1 | FileCheck %s --check-prefix=BOLT
+
+# RUN: llvm-readelf -hSWl %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=ELF
+# RUN: llvm-readelf -rW %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=RELOCS
+# RUN: llvm-nm --numeric-sort %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=SYMBOLS
+# RUN: llvm-objdump -d %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=CODE
+# RUN: %python -c "import json; r=json.load(open('%t/report.json')); l=json.load(open('%t/report.json.layout.json')); f=next(x for x in l['functions'] if x['name']=='split_worker'); v=next(x for x in l['functions'] if x['name']=='Reset_Handler'); print(r['summary']['firmware_modification_reason_counts']['function_splitting'],l['split_function_count'],f['firmware_modification_reasons'],f['fragments'],[(hex(o['original_address']),hex(o['output_address']),o['output_size'],o['origin_kind']) for o in f['instruction_origins']],v['fragments'])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# UNADMITTED: BOLT-ERROR: Cortex-M function splitting changes fragment placement and cross-fragment branch events
+
+# BOLT: BOLT-INFO: 1 out of 2 functions in the binary (50.0%) have non-empty execution profile
+# BOLT: BOLT-INFO: Firm-BOLT publication policy checked 1 attempted function(s), rejected 0
+# BOLT: BOLT-INFO: using original .text for new code with 0x4 alignment
+# BOLT: BOLT-INFO: merged 2 code sections into .text [0x8000100, 0x800012c)
+# BOLT: BOLT-INFO: FastDyn wrote linker-resolved firmware layout
+# BOLT: BOLT-INFO: not adding new segments
+
+# ELF: Entry point address: 0x8000111
+# ELF: .bolt.org.text {{.*}} 08000100 {{.*}} 000000 {{.*}} AX
+# ELF: .text {{.*}} 08000100 {{.*}} 00002c {{.*}} AX
+# ELF: LOAD {{.*}} 0x08000000 {{.*}} 0x00008 0x00008 R
+# ELF-NEXT: LOAD {{.*}} 0x08000100 {{.*}} 0x0002c 0x0002c R E
+
+# RELOCS: R_ARM_THM_CALL 08000101 split_worker
+# RELOCS-NEXT: R_ARM_THM_CALL 08000101 split_worker
+# RELOCS-NEXT: R_ARM_THM_JUMP24 08000128 fixture_halt
+# RELOCS: R_ARM_ABS32 08000111 Reset_Handler
+
+# SYMBOLS: 08000100 T split_worker
+# SYMBOLS: 0800010c t split_worker.cold.0
+# SYMBOLS-NOT: Reset_Handler.cold
+# SYMBOLS: 08000110 T Reset_Handler
+# SYMBOLS: 08000128 T fixture_halt
+
+# CODE: 08000100 <split_worker>:
+# CODE: bne.w 0x800010c <split_worker.cold.0>
+# CODE: movs r0, #0x11
+# CODE: bx lr
+# CODE: 0800010c <split_worker.cold.0>:
+# CODE: movs r0, #0x2a
+# CODE: bx lr
+# CODE: 08000110 <Reset_Handler>:
+# CODE: bl 0x8000100 <split_worker>
+# CODE: bl 0x8000100 <split_worker>
+
+# REPORT: 1 1 ['function_splitting']
+# REPORT-SAME: {'block_count': 2, 'block_original_addresses': [134218012, 134218016], 'block_output_addresses': [134217984, 134217990], 'fragment_number': 0, 'kind': 'main', 'output_address': 134217984, 'output_size': 10}
+# REPORT-SAME: {'block_count': 1, 'block_original_addresses': [134218020], 'block_output_addresses': [134217996], 'fragment_number': 1, 'kind': 'cold', 'output_address': 134217996, 'output_size': 4}
+# REPORT-SAME: [('0x800011c', '0x8000100', 2, 'original_instruction'), ('0x800011e', '0x8000102', 4, 'original_instruction'), ('0x8000120', '0x8000106', 2, 'original_instruction'), ('0x8000122', '0x8000108', 2, 'original_instruction'), ('0x8000124', '0x800010c', 2, 'original_instruction'), ('0x8000126', '0x800010e', 2, 'original_instruction')]
+# REPORT-SAME: [{'block_count': 2,
+# REPORT-SAME: 'kind': 'main'
+
+//--- fixture.s
+.syntax unified
+.cpu cortex-m3
+.thumb
+.eabi_attribute Tag_CPU_arch, 10
+.eabi_attribute Tag_CPU_arch_profile, 'M'
+
+.section .isr_vector, "a", %progbits
+.align 2
+.global g_pfnVectors
+.type g_pfnVectors, %object
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+.size g_pfnVectors, . - g_pfnVectors
+
+.section .text, "ax", %progbits
+.align 2
+.global Reset_Handler
+.type Reset_Handler, %function
+.thumb_func
+Reset_Handler:
+  movw r4, #0
+  movt r4, #0x2000
+  movs r0, #0
+  bl split_worker
+  str r0, [r4]
+  movs r0, #1
+  bl split_worker
+  str r0, [r4, #4]
+.global fixture_halt
+fixture_halt:
+  b fixture_halt
+.size Reset_Handler, . - Reset_Handler
+
+.align 2
+.global split_worker
+.type split_worker, %function
+.thumb_func
+split_worker:
+  cmp r0, #0
+  bne 1f
+  movs r0, #17
+  bx lr
+1:
+  movs r0, #42
+  bx lr
+.size split_worker, . - split_worker
+
+//--- link.ld
+ENTRY(Reset_Handler)
+MEMORY {
+  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 64K
+  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 16K
+}
+SECTIONS {
+  .isr_vector ORIGIN(FLASH) : { KEEP(*(.isr_vector)) } > FLASH
+  .text ORIGIN(FLASH) + 0x100 : {
+    *(.text*)
+    . = . + 4;
+  } > FLASH
+  .data : { *(.data*) } > RAM AT > FLASH
+  .bss (NOLOAD) : { *(.bss*) *(COMMON) } > RAM
+}
