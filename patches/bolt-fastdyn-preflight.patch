diff --git a/bolt/test/ARM/thumb-firmware-branch-pair-preservation.s b/bolt/test/ARM/thumb-firmware-branch-pair-preservation.s
new file mode 100644
index 0000000000000000000000000000000000000000..4b94fe4f200a309f28e78498934b6db2376ac77c
--- /dev/null
+++ b/bolt/test/ARM/thumb-firmware-branch-pair-preservation.s
@@ -0,0 +1,58 @@
+## With guest instruction-count preservation enabled, do not invert a
+## conditional branch whose taken target is the next block when an explicit
+## unconditional false edge follows it. Inversion swaps the one-branch and
+## two-branch path costs; retaining the old unconditional target and appending
+## a third branch is both semantically wrong and larger.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --fastdyn-firmware-report=%t.report.json -o %t.bolt
+# RUN: llvm-objdump -d --start-address=0x08000008 --stop-address=0x08000016 %t.bolt | FileCheck %s --check-prefix=CODE
+# RUN: %python -c "import json; d=json.load(open('%t.report.json')); f=next(x for x in d['functions'] if x['name']=='branch_pair'); s=[i for i in f['instructions'] if i['provenance_kind']=='synthesized_control_edge']; print(f['firmware_modified'],len(s),f['post_optimization_instruction_count'],f['original_size'],f['estimated_post_optimization_size'])" | FileCheck %s --check-prefix=REPORT
+
+# CODE: <branch_pair>:
+# CODE-NEXT: cmp r0, #0x0
+# CODE-NEXT: beq 0x800000e
+# CODE-NEXT: b 0x8000012
+# CODE-NEXT: movs r0, #0x1
+# CODE-NEXT: bx lr
+# CODE-NEXT: movs r0, #0x2
+# CODE-NEXT: bx lr
+# REPORT: False 0 7 14 14
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl branch_pair
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl branch_pair
+  .type branch_pair,%function
+  .thumb_func
+branch_pair:
+  cmp r0, #0
+  beq .Ltrue
+  b .Lfalse
+.Ltrue:
+  movs r0, #1
+  bx lr
+.Lfalse:
+  movs r0, #2
+  bx lr
+  .size branch_pair, .-branch_pair
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
