+# RUN:   --frame-opt=none -o %t.bolt 2>&1 | FileCheck %s
+
+# CHECK: BOLT-ERROR: Cortex-M veneer slot has an original direct code reference from Reset_Handler
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl __firmbolt_thumb_veneer_slot0
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .section .firmbolt.veneer,"ax",%progbits
+  .p2align 2
+  .globl __firmbolt_thumb_veneer_slot0
+  .type __firmbolt_thumb_veneer_slot0,%function
+  .thumb_func
+__firmbolt_thumb_veneer_slot0:
+  bx lr
+  nop
+  nop
+  nop
+  .size __firmbolt_thumb_veneer_slot0, .-__firmbolt_thumb_veneer_slot0
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
