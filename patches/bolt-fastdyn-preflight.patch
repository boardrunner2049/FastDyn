+TEST(ARMRelocationHandlerTest, ThumbBranchRoundTripsAndRanges) {
+  std::unique_ptr<RelocationHandler> Handler = createARMRelocationHandler();
+  constexpr uint64_t PC = 0x08001000;
+  constexpr uint32_t BWide = 0x9000f000;
+  constexpr uint32_t BCondWide = 0x8000f000;
+
+  for (const auto &[Type, Original, Back, Forward] : {
+           std::tuple<uint32_t, uint32_t, uint64_t, uint64_t>{
+               ELF::R_ARM_THM_JUMP24, BWide, PC - 0x100000, PC + 0x0ffffe},
+           {ELF::R_ARM_THM_CALL, 0xf800f000, PC - 0x100000,
+            PC + 0x0ffffe},
+           {ELF::R_ARM_THM_JUMP19, BCondWide, PC - 0x10000,
+            PC + 0x0fffe},
+       }) {
+    for (uint64_t Target : {Back, Forward}) {
+      ASSERT_TRUE(Handler->canEncodeValue(Type, Target, PC));
+      const uint64_t Encoded =
+          Handler->encodeValue(Type, Target, PC, Original);
+      EXPECT_EQ(Handler->extractValue(Type, Encoded, PC), Target);
+    }
+  }
+
+  EXPECT_FALSE(Handler->canEncodeValue(ELF::R_ARM_THM_JUMP8,
+                                       PC + 0x104, PC));
+  EXPECT_TRUE(Handler->canEncodeValue(ELF::R_ARM_THM_JUMP8,
+                                      PC + 0x102, PC));
+  EXPECT_FALSE(Handler->canEncodeValue(ELF::R_ARM_THM_JUMP8,
+                                       PC - 0xfe, PC));
+  EXPECT_TRUE(Handler->canEncodeValue(ELF::R_ARM_THM_JUMP8,
+                                      PC - 0xfc, PC));
+  EXPECT_FALSE(Handler->canEncodeValue(ELF::R_ARM_THM_JUMP11,
+                                       PC + 0x804, PC));
+  EXPECT_TRUE(Handler->canEncodeValue(ELF::R_ARM_THM_JUMP11,
+                                      PC + 0x802, PC));
+  EXPECT_FALSE(Handler->canEncodeValue(ELF::R_ARM_THM_JUMP11,
+                                       PC - 0x7fe, PC));
+  EXPECT_TRUE(Handler->canEncodeValue(ELF::R_ARM_THM_JUMP11,
+                                      PC - 0x7fc, PC));
+
+  // CBZ/CBNZ use an unsigned, forward-only displacement from Thumb PC+4.
+  // Preserve the CBNZ opcode and r7 while exercising both immediate fields.
+  constexpr uint32_t CbnzR7 = 0xb907;
+  EXPECT_FALSE(
+      Handler->canEncodeValue(ELF::R_ARM_THM_JUMP6, PC + 2, PC));
+  EXPECT_TRUE(
+      Handler->canEncodeValue(ELF::R_ARM_THM_JUMP6, PC + 4, PC));
+  EXPECT_TRUE(
+      Handler->canEncodeValue(ELF::R_ARM_THM_JUMP6, PC + 130, PC));
+  EXPECT_FALSE(
+      Handler->canEncodeValue(ELF::R_ARM_THM_JUMP6, PC + 132, PC));
+  EXPECT_FALSE(
+      Handler->canEncodeValue(ELF::R_ARM_THM_JUMP6, PC + 5, PC));
+  const uint64_t CbnzMax = Handler->encodeValue(
+      ELF::R_ARM_THM_JUMP6, PC + 130, PC, CbnzR7);
+  EXPECT_EQ(CbnzMax, 0xbbffU);
+  EXPECT_EQ(Handler->extractValue(ELF::R_ARM_THM_JUMP6, CbnzMax, PC),
+            PC + 130);
+}
