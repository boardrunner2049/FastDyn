index 0000000000000000000000000000000000000000..1f870b1f22652f3fddf19b6307bc8decf6eed97d
--- /dev/null
+++ b/bolt/test/ARM/thumb1-native-simplify-rodata-loads.s
@@ -0,0 +1,62 @@
+## Cortex-M0+/Thumb-1 has no flag-preserving MOVW/MOVT equivalent.  The
+## existing read-only-load pass must therefore retain even a linked immutable
+## scalar load instead of selecting an instruction unavailable on the CPU.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 \
+# RUN:   --section-start=.rodata=0x08000100 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --firmbolt-arm-full-pipeline --simplify-rodata-loads \
+# RUN:   --firmbolt-allow-read-only-load-elision --eliminate-unreachable=false \
+# RUN:   --fastdyn-firmware-report=%t.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m0plus \
+# RUN:   --disassemble-symbols=load_immutable %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='load_immutable'); print(f['firmware_modification_attempted'],f['firmware_modified'],f['firmware_modification_reasons'])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# LOG: simplified 0 out of 1 loads from statically computed addresses
+# DISASM: <load_immutable>:
+# DISASM: ldr r0, [pc, #0x{{[0-9a-f]+}}]
+# DISASM-NEXT: bx lr
+# REPORT: False False []
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl load_immutable
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl load_immutable
+  .type load_immutable,%function
+  .thumb_func
+load_immutable:
+  ldr r0, immutable_scalar
+  bx lr
+  .size load_immutable, .-load_immutable
+
+  .section .rodata,"a",%progbits
+  .p2align 2
+  .globl immutable_scalar
+  .type immutable_scalar,%object
+immutable_scalar:
+  .word 0x1234
+  .size immutable_scalar, .-immutable_scalar
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-nonfallthrough-branch-literal-pool.s b/bolt/test/ARM/thumb1-nonfallthrough-branch-literal-pool.s
