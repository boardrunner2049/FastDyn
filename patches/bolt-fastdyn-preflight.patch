+/// Resolve the firmware-declared B(S) value for an ARM static-base-relative
+/// reference. AAELF32 permits a platform-selected addressing origin, so a
+/// PT_LOAD start is evidence only when the caller explicitly selects that
+/// policy. Executable targets remain unsupported because function movement
+/// would change S while the compact BREL instruction is intentionally emitted
+/// with its already-linked immediate.
+static std::optional<uint64_t>
+getARMStaticBase(const BinaryContext &BC, uint64_t SymbolAddress) {
+  if (opts::FirmBOLTARMStaticBase !=
+      opts::ARMStaticBasePolicy::SegmentStart)
+    return std::nullopt;
+  auto SegmentIt = BC.SegmentMapInfo.upper_bound(SymbolAddress);
+  if (SegmentIt == BC.SegmentMapInfo.begin())
+    return std::nullopt;
+  --SegmentIt;
+  const SegmentInfo &Segment = SegmentIt->second;
+  if (SymbolAddress < Segment.Address ||
+      SymbolAddress >= Segment.Address + Segment.Size ||
+      Segment.IsExecutable)
+    return std::nullopt;
+  return Segment.Address;
+}
