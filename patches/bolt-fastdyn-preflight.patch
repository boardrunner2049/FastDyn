+  str r0, [sp]
+  ldr r1, [sp]
+  adds r0, r1, #1
+  add sp, #4
+  pop {r4, pc}
+  .size pop_handler, .-pop_handler
+
+  .globl register_handler
+  .type register_handler,%function
+  .thumb_func
