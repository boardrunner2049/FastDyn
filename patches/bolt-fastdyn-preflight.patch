+/// Bind AArch32 GOT requests back to the exact graph in a fixed firmware image.
+/// BOLT disables JITLink's ordinary target passes because they allocate new
+/// sections and stubs outside BOLT's layout model. Running the generic
+/// AArch32 GOTBuilder here would therefore synthesize a fresh $__GOT section,
+/// which is invalid for a fixed Cortex-M memory map. Every admitted edge must
+/// instead have an exact origin, slot and/or target recorded while the input
+/// relocation graph was analyzed.
+Error bindFixedARMGOTEdges(jitlink::LinkGraph &G, const BinaryContext &BC) {
+  const std::optional<uint64_t> BaseAddress = BC.getARMFixedGOTBase();
+  uint64_t EdgeIndex = 0;
+  for (jitlink::Block *Block : G.blocks()) {
+    for (jitlink::Edge &Edge : Block->edges()) {
+      const jitlink::Edge::Kind Kind = Edge.getKind();
+      const bool IsGOTPrel =
+          Kind == jitlink::aarch32::Data_RequestGOTAndTransformToDelta32;
+      const bool IsGOTBrel =
+          Kind == jitlink::aarch32::
+                      Data_RequestGOTAndTransformToDelta32FromGOT;
+      const bool IsGOTOFF =
+          Kind == jitlink::aarch32::
+                      Data_RequestGOTOFFAndTransformToDelta32FromGOT;
+      const bool IsBasePrel =
+          Kind == jitlink::aarch32::Data_RequestGOTBaseAndTransformToDelta32;
+      if (!IsGOTPrel && !IsGOTBrel && !IsGOTOFF && !IsBasePrel)
+        continue;
+      if (!BaseAddress)
+        return make_error<jitlink::JITLinkError>(
+            "fixed AArch32 GOT edge has no retained GOT origin");
+      jitlink::Symbol &Target = Edge.getTarget();
+      if (!Target.hasName())
+        return make_error<jitlink::JITLinkError>(
+            "fixed AArch32 GOT edge has no retained target identity");
+      const StringRef TargetName = *Target.getName();
+
+      uint64_t BoundValue = 0;
+      jitlink::Edge::Kind BoundKind = jitlink::aarch32::Data_Pointer32;
+      if (IsGOTPrel || IsGOTBrel) {
+        const std::optional<ARMFixedGOTEntry> Entry =
+            BC.getARMFixedGOTEntry(TargetName);
+        if (!Entry || Entry->BaseAddress != *BaseAddress)
+          return make_error<jitlink::JITLinkError>(
+              "no exact retained firmware GOT slot for " + TargetName.str());
+        BoundValue = IsGOTPrel
+                         ? Entry->SlotAddress
+                         : uint32_t(Entry->SlotAddress - *BaseAddress);
+        BoundKind = IsGOTPrel ? jitlink::aarch32::Data_Delta32
+                              : jitlink::aarch32::Data_Pointer32;
+      } else if (IsGOTOFF) {
+        const std::optional<uint64_t> TargetAddress =
+            BC.getARMFixedGOTTarget(TargetName);
+        if (!TargetAddress)
+          return make_error<jitlink::JITLinkError>(
+              "no exact fixed firmware target for " + TargetName.str());
+        BoundValue = uint32_t(*TargetAddress - *BaseAddress);
+      } else {
+        if (TargetName != "_GLOBAL_OFFSET_TABLE_")
+          return make_error<jitlink::JITLinkError>(
+              "R_ARM_BASE_PREL does not name _GLOBAL_OFFSET_TABLE_");
+        BoundValue = *BaseAddress;
+        BoundKind = jitlink::aarch32::Data_Delta32;
+      }
+
+      const std::string SlotName =
+          formatv("$__firmbolt_fixed_got.{0}.{1:x}.{2}", TargetName,
+                  BoundValue, EdgeIndex++)
+              .str();
