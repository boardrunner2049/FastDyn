+++ b/bolt/test/ARM/thumb2-rwpi-static-base-relocations.s
@@ -0,0 +1,233 @@
+## AAELF32 leaves the static-base addressing origin B(S) to the platform.
+## FirmBOLT must retain an RWPI function by default, then admit its exact
+## non-executable PT_LOAD-relative MOVW/MOVT pair only when the firmware
+## declares that B(S) is the target segment start.  The qualified run also
+## proves that ordinary FOP can change the function without losing the typed
+## reference or its original SHT_REL records.
+
+# REQUIRES: system-linux
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple=thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   -arm-add-build-attributes %t/fixture.s -o %t.o
+# RUN: ld.lld --emit-relocs -T %t/link.ld %t.o -o %t.exe
+# RUN: llvm-mc -filetype=obj -triple=thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   -arm-add-build-attributes %t/overflow.s -o %t.overflow.o
+# RUN: not ld.lld -T %t/link.ld %t.overflow.o -o %t.overflow 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=OVERFLOW
+# RUN: llvm-readelf -lW %t.exe | FileCheck %s --check-prefix=SEGMENTS
+# RUN: llvm-readelf -rW %t.exe | FileCheck %s --check-prefix=INPUT-RELOCS
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=all --fastdyn-firmware-report=%t.default.json \
+# RUN:   -o %t.default 2>&1 | FileCheck %s --check-prefix=DEFAULT
+# RUN: %python -c "import json; d=json.load(open('%t.default.json')); fs={x['name']:x for x in d['functions']}; print(fs['rwpi_worker']['simple'],fs['rwpi_worker']['firmware_modified']); print(fs['sbrel32_worker']['simple'],fs['sbrel32_worker']['firmware_modified'])" \
+# RUN:   | FileCheck %s --check-prefix=DEFAULT-REPORT
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-static-base=segment-start --frame-opt=all \
+# RUN:   --fastdyn-firmware-report=%t.qualified.json -o %t.qualified 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=QUALIFIED
+# RUN: %python -c "import json; d=json.load(open('%t.qualified.json')); fs={x['name']:x for x in d['functions']}; print(fs['rwpi_worker']['simple'],fs['rwpi_worker']['firmware_modified']); print(fs['sbrel32_worker']['simple'],fs['sbrel32_worker']['firmware_modified']); print(fs['unsupported_exec_brel']['simple'],fs['unsupported_exec_brel']['firmware_modified'])" \
+# RUN:   | FileCheck %s --check-prefix=QUALIFIED-REPORT
+# RUN: llvm-readelf -rW %t.qualified \
+# RUN:   | FileCheck %s --check-prefix=OUTPUT-RELOCS
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --no-show-raw-insn %t.qualified \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+
+# SEGMENTS-DAG: LOAD {{.*}}0x08000000{{.*}} R E
+# SEGMENTS-DAG: LOAD {{.*}}0x20000000{{.*}} RW
+
+# INPUT-RELOCS-DAG: 0800011c {{.*}} R_ARM_THM_MOVW_BREL_NC {{.*}} rw_data
+# INPUT-RELOCS-DAG: 08000120 {{.*}} R_ARM_THM_MOVT_BREL {{.*}} rw_data
+# INPUT-RELOCS-DAG: {{[0-9a-f]+}} {{.*}} R_ARM_THM_MOVW_BREL {{.*}} rw_data_checked
+# INPUT-RELOCS-DAG: 20000028 {{.*}} R_ARM_SBREL32 {{.*}} rw_data_checked
+
+# OVERFLOW: relocation R_ARM_THM_MOVW_BREL out of range: 65536 is not in [0, 65535]
+
+# DEFAULT: ARM B(S) is platform-defined
+# DEFAULT: BOLT: 1 out of 5 functions were overwritten.
+# DEFAULT-REPORT: False False
+# DEFAULT-REPORT: True True
+
+# QUALIFIED: BOLT-INFO: FOP optimized 3 redundant load(s)
+# QUALIFIED: BOLT: 3 out of 5 functions were overwritten.
+# QUALIFIED-REPORT: True True
+# QUALIFIED-REPORT: True True
+# QUALIFIED-REPORT: False False
+
+# OUTPUT-RELOCS-DAG: 0800011a {{.*}} R_ARM_THM_MOVW_BREL_NC {{.*}} rw_data
+# OUTPUT-RELOCS-DAG: 0800011e {{.*}} R_ARM_THM_MOVT_BREL {{.*}} rw_data
+# OUTPUT-RELOCS-DAG: {{[0-9a-f]+}} {{.*}} R_ARM_THM_MOVW_BREL {{.*}} rw_data_checked
+# OUTPUT-RELOCS-DAG: 20000028 {{.*}} R_ARM_SBREL32 {{.*}} rw_data_checked
+
