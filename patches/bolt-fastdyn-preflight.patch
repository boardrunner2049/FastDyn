+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --frame-opt=none -o %t.bolt 2>&1 | FileCheck %s
+
+# CHECK: BOLT-ERROR: Cortex-M veneer reservation __firmbolt_thumb_veneer_slot0 must use both section .firmbolt.veneer and prefix __firmbolt_thumb_veneer_slot
+
+  .syntax unified
