index 0000000000000000000000000000000000000000..669e22f84404336d2405b7f3a38b2014b86a9426
--- /dev/null
+++ b/bolt/test/ARM/thumb-profiled-block-layout.s
@@ -0,0 +1,68 @@
+## Generic BOLT profile import and block layout must operate through the
+## Cortex-M target and compact publication path.  The input places the cold
+## return on the conditional fallthrough.  The frozen profile makes the taken
+## target hot, so ext-tsp inverts the condition and makes that block the final
+## fallthrough without changing the guest instruction count.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e reset_entry %t.o -o %t.exe
+# RUN: link_fdata --no-lbr %s %t.exe %t.fdata
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --data=%t.fdata --reorder-blocks=ext-tsp \
+# RUN:   --eliminate-unreachable=false --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=profiled_worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); f=next(x for x in d['functions'] if x['name']=='profiled_worker'); print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),f['post_optimization_instruction_count'])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# LOG: 1 out of 2 functions were overwritten.
+# DISASM: <profiled_worker>:
+# DISASM: cmp r0, #0x0
+# DISASM-NEXT: bne
+# DISASM-NEXT: movs r0, #0x2
+# DISASM-NEXT: bx lr
+# DISASM-NEXT: movs r0, #0x1
+# DISASM-NEXT: bx lr
+# REPORT: True block_reordering 6
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl reset_entry
+  .type reset_entry,%function
+  .thumb_func
+reset_entry:
+  movs r0, #0
+  bl profiled_worker
+1:
+  b 1b
+  .size reset_entry, .-reset_entry
+
+  .globl profiled_worker
+  .type profiled_worker,%function
+  .thumb_func
+profiled_worker:
+# FDATA: 1 profiled_worker 0 10
+  cmp r0, #0
+  beq 2f
+1:
+# FDATA: 1 profiled_worker 4 1
+  movs r0, #1
+  bx lr
+2:
+# FDATA: 1 profiled_worker 8 10
+  movs r0, #2
+  bx lr
+  .size profiled_worker, .-profiled_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word reset_entry
diff --git a/bolt/test/ARM/thumb-reserved-veneer-slot-live-reject.s b/bolt/test/ARM/thumb-reserved-veneer-slot-live-reject.s
