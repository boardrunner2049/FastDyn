+# RUN:   | FileCheck %s --check-prefix=AMBIGUOUS
+
+# RELOCS-DAG: R_ARM_THM_ALU_ABS_G0_NC{{.*}}target_data
+# RELOCS-DAG: R_ARM_THM_ALU_ABS_G1_NC{{.*}}target_data
+# RELOCS-DAG: R_ARM_THM_ALU_ABS_G2_NC{{.*}}target_data
+# RELOCS-DAG: R_ARM_THM_ALU_ABS_G3{{.*}}target_data
+
+# BOLT: BOLT-WARNING: Failed to analyze 1 relocations
+# BOLT: BOLT-INFO: FOP optimized 1 redundant load(s)
+# BOLT: BOLT: 1 out of 3 functions were overwritten.
+
+# AMBIGUOUS: False False
+
+# DISASM-LABEL: <byte_worker>:
+# DISASM: movs r0, #0x34
+# DISASM: strb r0, [r1]
+# DISASM: movs r0, #0x12
+# DISASM: strb r0, [r1, #0x1]
+# DISASM: movs r0, #0x0
+# DISASM: strb r0, [r1, #0x2]
+# DISASM: movs r0, #0x8
+# DISASM: strb r0, [r1, #0x3]
+# DISASM-LABEL: <ambiguous_addend_worker>:
+# DISASM: movs r0, #0x35
+
+#--- fixture.s
+  .syntax unified
+  .thumb
+
+  .section .isr_vector,"a",%progbits
+  .p2align 2
