+
+#include "bolt/Core/ARMUnwindInfo.h"
+#include "bolt/Core/BinaryContext.h"
+#include "bolt/Core/BinarySection.h"
+#include "llvm/Support/Endian.h"
+#include "llvm/Support/MathExtras.h"
+#include <cassert>
+#include <cinttypes>
+#include <limits>
+
+using namespace llvm;
+
+namespace llvm {
+namespace bolt {
+
+Expected<ARMUnwindRecord>
+decodeARMUnwindRecord(BinaryContext &BC, uint32_t Word,
+                      uint64_t WordAddress) {
+  if (Word == 1)
+    return ARMUnwindRecord{ARMUnwindModel::CantUnwind, std::nullopt};
+
+  const auto AppendWordOpcodes = [](SmallVectorImpl<uint8_t> &Opcodes,
+                                    uint32_t Value, unsigned Count) {
+    for (int Shift = static_cast<int>(Count - 1) * 8; Shift >= 0; Shift -= 8)
+      Opcodes.push_back(static_cast<uint8_t>(Value >> Shift));
+  };
+
+  if (Word & 0x80000000U) {
+    if ((Word & 0xff000000U) != 0x80000000U)
+      return createStringError(
+          errc::not_supported,
+          "inline ARM EHABI word at 0x%" PRIx64
+          " is not compact personality model 0",
+          WordAddress);
+    ARMCompactUnwindProgram Program;
+    Program.StorageAddress = WordAddress;
+    Program.StorageSize = sizeof(uint32_t);
+    AppendWordOpcodes(Program.Opcodes, Word, 3);
+    return ARMUnwindRecord{ARMUnwindModel::InlineCompact,
+                           std::move(Program)};
+  }
+
+  const int64_t Delta = SignExtend64<31>(Word & 0x7fffffffU);
+  if (WordAddress >
+      static_cast<uint64_t>(std::numeric_limits<int64_t>::max()))
+    return createStringError(errc::result_out_of_range,
+                             "ARM PREL31 place is not representable");
+  const int64_t SignedTarget = static_cast<int64_t>(WordAddress) + Delta;
+  if (SignedTarget < 0)
+    return createStringError(errc::result_out_of_range,
+                             "ARM PREL31 target underflows address zero");
+  const uint64_t Target = static_cast<uint64_t>(SignedTarget);
+
+  ErrorOr<BinarySection &> TargetSection = BC.getSectionForAddress(Target);
+  if (!TargetSection || !TargetSection->isAllocatable() ||
+      TargetSection->isText() ||
+      !TargetSection->getName().starts_with(".ARM.extab") ||
+      !TargetSection->containsRange(Target, sizeof(uint32_t)))
+    return createStringError(
+        errc::executable_format_error,
+        "ARM EHABI record at 0x%" PRIx64
+        " does not reference a complete allocatable .ARM.extab word",
+        WordAddress);
+
+  const uint64_t Offset = Target - TargetSection->getAddress();
+  const StringRef Contents = TargetSection->getContents();
+  if (Offset > Contents.size() ||
+      Contents.size() - Offset < sizeof(uint32_t))
+    return createStringError(errc::executable_format_error,
+                             "ARM EHABI entry at 0x%" PRIx64
+                             " has no file-backed header word",
+                             Target);
+  const uint32_t Header = BC.AsmInfo->isLittleEndian()
+                              ? support::endian::read32le(Contents.data() +
+                                                          Offset)
+                              : support::endian::read32be(Contents.data() +
+                                                          Offset);
+  if (!(Header & 0x80000000U))
+    return ARMUnwindRecord{ARMUnwindModel::Generic, std::nullopt};
+  if (Header & 0x70000000U)
+    return createStringError(errc::executable_format_error,
+                             "ARM EHABI compact entry at 0x%" PRIx64
+                             " has reserved header bits set",
+                             Target);
+
+  const unsigned PersonalityIndex = (Header >> 24) & 0x0f;
+  if (PersonalityIndex > 2)
+    return createStringError(errc::not_supported,
+                             "ARM EHABI compact personality index %u at "
+                             "0x%" PRIx64 " is not supported",
+                             PersonalityIndex, Target);
+  const uint64_t AdditionalWords =
+      PersonalityIndex == 0 ? 0 : (Header >> 16) & 0xff;
+  const uint64_t RequiredBytes =
+      sizeof(uint32_t) * (1 + AdditionalWords);
+  if (!TargetSection->containsRange(Target, RequiredBytes) ||
+      RequiredBytes > Contents.size() - Offset)
+    return createStringError(errc::executable_format_error,
+                             "ARM EHABI compact entry at 0x%" PRIx64
+                             " extends beyond section %s",
+                             Target,
+                             TargetSection->getName().str().c_str());
+
+  ARMCompactUnwindProgram Program;
+  Program.PersonalityIndex = PersonalityIndex;
+  Program.StorageSection = &*TargetSection;
+  Program.StorageAddress = Target;
+  Program.StorageSize = RequiredBytes;
+  AppendWordOpcodes(Program.Opcodes, Header,
+                    PersonalityIndex == 0 ? 3 : 2);
+  for (uint64_t I = 0; I < AdditionalWords; ++I) {
+    const char *WordData =
+        Contents.data() + Offset + sizeof(uint32_t) * (I + 1);
+    const uint32_t OpcodeWord =
+        BC.AsmInfo->isLittleEndian()
+            ? support::endian::read32le(WordData)
+            : support::endian::read32be(WordData);
+    AppendWordOpcodes(Program.Opcodes, OpcodeWord, 4);
+  }
+  return ARMUnwindRecord{ARMUnwindModel::ExternalCompact,
+                         std::move(Program)};
+}
+
+Expected<SmallVector<uint8_t, 16>>
+encodeARMCompactUnwindProgram(const ARMCompactUnwindProgram &Program,
+                              ArrayRef<uint8_t> Opcodes,
+                              bool IsLittleEndian) {
+  const uint64_t AdditionalWords =
+      Program.PersonalityIndex == 0 ? 0 : (Program.StorageSize / 4) - 1;
+  const uint64_t ExpectedOpcodes =
+      Program.PersonalityIndex == 0 ? 3 : 2 + AdditionalWords * 4;
+  if ((Program.PersonalityIndex > 2) ||
+      Program.StorageSize != 4 * (1 + AdditionalWords) ||
+      Opcodes.size() != ExpectedOpcodes)
+    return createStringError(errc::invalid_argument,
+                             "ARM compact unwind program shape changed");
+
+  SmallVector<uint8_t, 16> Output(Program.StorageSize);
+  const auto WriteWord = [IsLittleEndian](uint8_t *Data, uint32_t Value) {
+    if (IsLittleEndian)
+      support::endian::write32le(Data, Value);
+    else
+      support::endian::write32be(Data, Value);
+  };
+  uint32_t Header = 0x80000000U |
+                    (static_cast<uint32_t>(Program.PersonalityIndex) << 24);
+  size_t OpcodeOffset = 0;
+  if (Program.PersonalityIndex == 0) {
+    Header |= static_cast<uint32_t>(Opcodes[0]) << 16;
+    Header |= static_cast<uint32_t>(Opcodes[1]) << 8;
+    Header |= Opcodes[2];
+    OpcodeOffset = 3;
+  } else {
+    Header |= static_cast<uint32_t>(AdditionalWords) << 16;
+    Header |= static_cast<uint32_t>(Opcodes[0]) << 8;
+    Header |= Opcodes[1];
+    OpcodeOffset = 2;
+  }
+  WriteWord(Output.data(), Header);
+  for (uint64_t I = 0; I < AdditionalWords; ++I) {
+    uint32_t Word = 0;
+    for (unsigned Byte = 0; Byte < 4; ++Byte)
+      Word = (Word << 8) | Opcodes[OpcodeOffset++];
+    WriteWord(Output.data() + 4 * (I + 1), Word);
+  }
+  assert(OpcodeOffset == Opcodes.size() && "opcode shape was prevalidated");
+  return Output;
+}
+
+} // namespace bolt
+} // namespace llvm
