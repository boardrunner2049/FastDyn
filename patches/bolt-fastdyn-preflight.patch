+++ b/bolt/test/ARM/thumb-aggressive-register-reassignment.s
@@ -0,0 +1,244 @@
+## Qualify the liveness-backed Cortex-M half of BOLT RegReAssign.  R2/R3 and
+## R12 are ordinary caller-saved AAPCS names, but exchanging them is legal only
+## when both are dead at every function entry and no ABI output names either
+## register.  Across an ordinary direct call, the exact transitive callee-use
+## summary must observe neither name and both values must be dead after the
+## call.  Live-in, callee-observed, and unknown-call controls remain unchanged.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs --no-merge-exidx-entries -Ttext=0x08000000 -e Reset_Handler \
+# RUN:   %t.o -o %t.exe
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --reg-reassign \
+# RUN:   --firmbolt-allow-register-reassignment --use-aggr-reg-reassign \
+# RUN:   --assume-abi -o %t.denied 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=DENIED
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --reg-reassign \
+# RUN:   --firmbolt-allow-register-reassignment \
+# RUN:   --firmbolt-allow-aggressive-register-reassignment \
+# RUN:   --use-aggr-reg-reassign -o %t.noabi 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=NOABI
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --reg-reassign \
+# RUN:   --firmbolt-allow-register-reassignment \
+# RUN:   --firmbolt-allow-aggressive-register-reassignment \
+# RUN:   --use-aggr-reg-reassign --assume-abi -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=WORKER
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=live_in_worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=LIVE
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=call_worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=CALL
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=arg_call_worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=ARGCALL
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=indirect_call_worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=INDIRECT
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=live_after_call_worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=CALLLIVE
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=tail_call_worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=TAILCALL
+
+# DENIED: aggressive Cortex-M register reassignment requires --firmbolt-allow-aggressive-register-reassignment
+# NOABI: aggressive Cortex-M register reassignment requires --assume-abi
+# LOG: BOLT-INFO: Reg Reassignment Pass Stats:
+# LOG-NEXT: 2 functions affected.
+# LOG-NEXT: 8 static bytes saved.
+# WORKER-LABEL: <worker>:
+# WORKER-NEXT: mov.w r2, r1
+# WORKER-NEXT: ldr r0, [r2]
+# WORKER-NEXT: str r0, [r2, #0x4]
+# WORKER-NEXT: bx lr
+# LIVE-LABEL: <live_in_worker>:
+# LIVE-NEXT: add.w r0, r2, r3
+# LIVE-NEXT: mov.w r12, r1
+# LIVE-NEXT: ldr.w r1, [r12]
+# LIVE-NEXT: add r0, r1
+# LIVE-NEXT: bx lr
+# CALL-LABEL: <call_worker>:
+# CALL-NEXT: push {lr}
+# CALL-NEXT: mov.w r2, r1
+# CALL-NEXT: ldr r0, [r2]
+# CALL-NEXT: bl {{.*}} <no_args_callee>
+# CALL-NEXT: mov.w r2, r1
+# CALL-NEXT: str r0, [r2, #0x4]
+# CALL-NEXT: pop {pc}
+# ARGCALL-LABEL: <arg_call_worker>:
+# ARGCALL-NEXT: push {lr}
+# ARGCALL-NEXT: mov.w r12, r1
+# ARGCALL-NEXT: ldr.w r0, [r12]
+# ARGCALL-NEXT: bl {{.*}} <uses_r2_r3_callee>
+# ARGCALL-NEXT: mov.w r12, r1
+# ARGCALL-NEXT: str.w r0, [r12, #0x4]
+# ARGCALL-NEXT: pop {pc}
+# INDIRECT-LABEL: <indirect_call_worker>:
+# INDIRECT-NEXT: push {lr}
+# INDIRECT-NEXT: mov.w r12, r1
+# INDIRECT-NEXT: ldr.w r0, [r12]
+# INDIRECT-NEXT: blx r3
+# INDIRECT-NEXT: mov.w r12, r1
+# INDIRECT-NEXT: str.w r0, [r12, #0x4]
+# INDIRECT-NEXT: pop {pc}
+# CALLLIVE-LABEL: <live_after_call_worker>:
+# CALLLIVE-NEXT: push {lr}
+# CALLLIVE-NEXT: mov.w r12, r1
+# CALLLIVE-NEXT: ldr.w r0, [r12]
+# CALLLIVE-NEXT: bl {{.*}} <no_args_callee>
+# CALLLIVE-NEXT: str.w r0, [r12, #0x4]
+# CALLLIVE-NEXT: pop {pc}
+# TAILCALL-LABEL: <tail_call_worker>:
+# TAILCALL-NEXT: mov.w r12, r1
+# TAILCALL-NEXT: ldr.w r0, [r12]
+# TAILCALL-NEXT: b.w {{.*}} <no_args_callee>
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  .fnstart
+  movs r0, #0
+  bl worker
+1:
+  b 1b
+  .cantunwind
+  .fnend
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl worker
+  .type worker,%function
+  .thumb_func
+worker:
+  .fnstart
+  mov.w r12, r1
+  ldr.w r0, [r12, #0]
+  str.w r0, [r12, #4]
+  bx lr
+  .cantunwind
+  .fnend
+  .size worker, .-worker
+
+  .globl live_in_worker
+  .type live_in_worker,%function
+  .thumb_func
+live_in_worker:
+  .fnstart
+  add.w r0, r2, r3
+  mov.w r12, r1
+  ldr.w r1, [r12, #0]
+  add r0, r1
+  bx lr
+  .cantunwind
+  .fnend
+  .size live_in_worker, .-live_in_worker
+
+  .globl call_worker
+  .type call_worker,%function
+  .thumb_func
+call_worker:
+  .fnstart
+  push {lr}
+  mov.w r12, r1
+  ldr.w r0, [r12, #0]
+  bl no_args_callee
+  mov.w r12, r1
+  str.w r0, [r12, #4]
+  pop {pc}
+  .cantunwind
+  .fnend
+  .size call_worker, .-call_worker
+
+  .globl no_args_callee
+  .type no_args_callee,%function
+  .thumb_func
+no_args_callee:
+  .fnstart
+  adds r0, #1
+  bx lr
+  .cantunwind
+  .fnend
+  .size no_args_callee, .-no_args_callee
+
+  .globl arg_call_worker
+  .type arg_call_worker,%function
+  .thumb_func
+arg_call_worker:
+  .fnstart
+  push {lr}
+  mov.w r12, r1
+  ldr.w r0, [r12, #0]
+  bl uses_r2_r3_callee
+  mov.w r12, r1
+  str.w r0, [r12, #4]
+  pop {pc}
+  .cantunwind
+  .fnend
+  .size arg_call_worker, .-arg_call_worker
+
+  .globl uses_r2_r3_callee
+  .type uses_r2_r3_callee,%function
+  .thumb_func
+uses_r2_r3_callee:
+  .fnstart
+  add.w r0, r2, r3
+  bx lr
+  .cantunwind
+  .fnend
+  .size uses_r2_r3_callee, .-uses_r2_r3_callee
+
+  .globl indirect_call_worker
+  .type indirect_call_worker,%function
+  .thumb_func
+indirect_call_worker:
+  .fnstart
+  push {lr}
+  mov.w r12, r1
+  ldr.w r0, [r12, #0]
+  blx r3
+  mov.w r12, r1
+  str.w r0, [r12, #4]
+  pop {pc}
+  .cantunwind
+  .fnend
+  .size indirect_call_worker, .-indirect_call_worker
+
+  .globl live_after_call_worker
+  .type live_after_call_worker,%function
+  .thumb_func
+live_after_call_worker:
+  .fnstart
+  push {lr}
+  mov.w r12, r1
+  ldr.w r0, [r12, #0]
+  bl no_args_callee
+  str.w r0, [r12, #4]
+  pop {pc}
+  .cantunwind
+  .fnend
+  .size live_after_call_worker, .-live_after_call_worker
+
+  .globl tail_call_worker
+  .type tail_call_worker,%function
+  .thumb_func
+tail_call_worker:
+  .fnstart
+  mov.w r12, r1
+  ldr.w r0, [r12, #0]
+  b.w no_args_callee
+  .cantunwind
+  .fnend
+  .size tail_call_worker, .-tail_call_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
