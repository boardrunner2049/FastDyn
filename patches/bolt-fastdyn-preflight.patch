diff --git a/bolt/test/ARM/thumb-profile-guided-alignment.s b/bolt/test/ARM/thumb-profile-guided-alignment.s
new file mode 100644
index 0000000000000000000000000000000000000000..3e820634562b75174a88c36ad0dc8deb95cae27b
--- /dev/null
+++ b/bolt/test/ARM/thumb-profile-guided-alignment.s
@@ -0,0 +1,143 @@
+## Qualify BOLT's ordinary profile-guided basic-block alignment for a
+## relocation-complete Cortex-M image.  Firmware admission is explicit because
+## fall-through alignment NOPs are executed guest work, and the final writer
+## must prove that their bytes fit linker-owned flash capacity.
+
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/fixture.s -o %t/fixture.o
+# RUN: ld.lld --emit-relocs -T %t/capacity.ld %t/fixture.o -o %t/reference.elf
+# RUN: ld.lld --emit-relocs -T %t/tight.ld %t/fixture.o -o %t/tight.elf
+
+# RUN: not llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --data=%t/profile.fdata --relocs --use-old-text \
+# RUN:   --align-functions=1 --align-blocks --block-alignment=16 \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   -o %t/no-contract.elf 2>&1 | FileCheck %s --check-prefix=NO-CONTRACT
+
+# RUN: not llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --data=%t/profile.fdata --relocs --use-old-text \
+# RUN:   --align-functions=1 --align-blocks --block-alignment=16 \
+# RUN:   --firmbolt-allow-block-alignment \
+# RUN:   -o %t/count-contract.elf 2>&1 | FileCheck %s --check-prefix=COUNT
+
+# RUN: llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --data=%t/profile.fdata --relocs --use-old-text \
+# RUN:   --align-functions=1 --align-blocks --block-alignment=16 \
+# RUN:   --firmbolt-allow-block-alignment \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --fastdyn-firmware-report=%t/aligned.json -v=1 \
+# RUN:   -o %t/aligned.elf 2>&1 | FileCheck %s --check-prefix=ALIGN
+# RUN: llvm-nm --numeric-sort %t/aligned.elf \
+# RUN:   | FileCheck %s --check-prefix=NM
+# RUN: llvm-objdump -d --no-show-raw-insn %t/aligned.elf \
+# RUN:   | FileCheck %s --check-prefix=DIS
+# RUN: %python -c "import json; d=json.load(open('%t/aligned.json')); f=next(x for x in d['functions'] if x['name']=='hot_worker'); print(f['firmware_modification_reasons']); print([(hex(i['original_address']),hex(i['estimated_output_offset'])) for i in f['instructions']])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# RUN: not llvm-bolt %t/tight.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --data=%t/profile.fdata --relocs --use-old-text \
+# RUN:   --align-functions=1 --align-blocks --block-alignment=16 \
+# RUN:   --firmbolt-allow-block-alignment \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   -o %t/over-budget.elf 2>&1 | FileCheck %s --check-prefix=BUDGET
+
+# NO-CONTRACT: Cortex-M basic-block alignment inserts executed padding
+# COUNT: Cortex-M basic-block alignment is incompatible with the default guest instruction-count contract
+# ALIGN: BOLT-INFO: Cortex-M alignment qualified 2 function(s) at 1-byte function alignment and aligned 1 profiled basic block(s) at 16 bytes
+# ALIGN: BOLT-INFO: not adding new segments
+# NM: 08000100 T hot_worker
+# NM: 08000110 T hot_loop
+# DIS: 08000100 <hot_worker>:
+# DIS: 8000100: movs r1, #0
+# DIS: 800010a: nop
+# DIS: 800010e: nop
+# DIS: 08000110 <hot_loop>:
+# DIS: 8000110: adds r1, #0x1
+# REPORT: block_alignment
+# BUDGET: Cortex-M firmware emission requires every allocatable section to fit an existing qualified range
+
+//--- fixture.s
+.syntax unified
+.cpu cortex-m3
+.thumb
+.eabi_attribute Tag_CPU_arch, 10
+.eabi_attribute Tag_CPU_arch_profile, 'M'
+
+.section .isr_vector, "a", %progbits
+.align 2
+.global g_pfnVectors
+.type g_pfnVectors, %object
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+.size g_pfnVectors, . - g_pfnVectors
+
+.section .text, "ax", %progbits
+.align 1
+.global hot_worker
+.type hot_worker, %function
+.thumb_func
+hot_worker:
+  movs r1, #0
+  movs r2, #0
+  adds r2, #1
+  adds r2, #1
+  adds r2, #1
+.global hot_loop
+hot_loop:
+  adds r1, #1
+  cmp r1, r0
+  bne hot_loop
+  mov r0, r1
+  bx lr
+.size hot_worker, . - hot_worker
+
+.global Reset_Handler
+.type Reset_Handler, %function
+.thumb_func
+Reset_Handler:
+  movw r4, #0
+  movt r4, #0x2000
+  movs r0, #10
+  bl hot_worker
+  str r0, [r4]
+.global fixture_halt
+fixture_halt:
+  b fixture_halt
+.size Reset_Handler, . - Reset_Handler
+
+//--- capacity.ld
+ENTRY(Reset_Handler)
+MEMORY {
+  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 64K
+  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 16K
+}
+SECTIONS {
+  .isr_vector ORIGIN(FLASH) : { KEEP(*(.isr_vector)) } > FLASH
+  .text ORIGIN(FLASH) + 0x100 : {
+    *(.text*)
+    /* Explicit linker-owned capacity for alignment and branch repair. */
+    . = . + 32;
+  } > FLASH
+  .data : { *(.data*) } > RAM AT > FLASH
+  .bss (NOLOAD) : { *(.bss*) *(COMMON) } > RAM
+}
+
+//--- tight.ld
+ENTRY(Reset_Handler)
+MEMORY {
+  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 64K
+  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 16K
+}
+SECTIONS {
+  .isr_vector ORIGIN(FLASH) : { KEEP(*(.isr_vector)) } > FLASH
+  .text ORIGIN(FLASH) + 0x100 : { *(.text*) } > FLASH
+  .data : { *(.data*) } > RAM AT > FLASH
+  .bss (NOLOAD) : { *(.bss*) *(COMMON) } > RAM
+}
+
+//--- profile.fdata
+1 Reset_Handler a 1 hot_worker 0 0 100
