--- a/bolt/test/link_fdata.py
+++ b/bolt/test/link_fdata.py
@@ -45,6 +45,11 @@ fdata_pat = re.compile(r"([01].*) (?P<mispred>\d+) (?P<exec>\d+)")
 # <loc>: [<id>:]<offset>
 preagg_pat = re.compile(r"(?P<type>[TRSBFfr]) (?P<offsets_count>.*)")
 
+# Memory-access profile:
+# 4 <function> <instruction offset> 4 <object> <object offset> <count>
+# This is intentionally distinct from an eight-field LBR edge record.
+mem_pat = re.compile(r"(?P<locations>4 .*) (?P<count>\d+)$")
+
 # Basic sample profile (without brstack):
 # <is symbol?> <closest elf symbol or DSO name> <relative address> <count>
 nolbr_pat = re.compile(r"([01].*) (?P<count>\d+)")
@@ -64,8 +69,27 @@ with open(args.input, "r") as f:
         profile_line = prefix_match.group(2)
         fdata_match = fdata_pat.match(profile_line)
         preagg_match = preagg_pat.match(profile_line)
+        mem_match = mem_pat.match(profile_line)
         nolbr_match = nolbr_pat.match(profile_line)
-        if fdata_match:
+        # A numeric no-LBR offset is otherwise ambiguous with the tail of an
+        # LBR record (for example "1 fn 4 10").  The caller has already
+        # declared the file mode, so prefer the corresponding grammar.
+        if args.no_lbr and nolbr_match:
+            loc, count = nolbr_match.groups()
+            # Split by whitespaces not preceded by a backslash (negative lookbehind)
+            chunks = re.split(r"(?<!\\) +", loc)
+            assert (
+                len(chunks) == 3
+            ), f"ERROR: wrong format/whitespaces must be escaped:\n{line}"
+            exprs.append(("NOLBR", (*chunks, count)))
+        elif mem_match:
+            locations, count = mem_match.groups()
+            chunks = re.split(r"(?<!\\) +", locations)
+            assert (
+                len(chunks) == 6
+            ), f"ERROR: wrong memory profile format/whitespaces must be escaped:\n{line}"
+            exprs.append(("MEM", (*chunks, count)))
+        elif fdata_match:
             src_dst, mispred, execnt = fdata_match.groups()
             # Split by whitespaces not preceded by a backslash (negative lookbehind)
             chunks = re.split(r"(?<!\\) +", src_dst)
@@ -157,6 +181,14 @@ with open(args.output, "w", newline="\n") as f:
         elif etype == "NOLBR":
             issym, anchor, offsym, count = expr
             print(evaluate_symbol(issym, anchor, offsym), count, file=f)
+        elif etype == "MEM":
+            issym1, anchor1, offsym1, issym2, anchor2, offsym2, count = expr
+            print(
+                evaluate_symbol(issym1, anchor1, offsym1),
+                evaluate_symbol(issym2, anchor2, offsym2),
+                count,
+                file=f,
+            )
         elif etype == "PREAGG":
             # Replace all symbols enclosed in ##
             print(expr[0], re.sub(replace_pat, replace_symbol, expr[1]), file=f)
