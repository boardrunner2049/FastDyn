+# RUN: yaml2obj %s -o %t.exe
+# RUN: llvm-readelf -r %t.exe | FileCheck %s --check-prefix=RELOCS
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=none --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-readelf -r %t.bolt | FileCheck %s --check-prefix=RELOCS
+# RUN: llvm-objdump -s -j .text %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=BYTES
+
+# RELOCS: R_ARM_ABS8{{.*}}answer8
+# RELOCS: R_ARM_ABS16{{.*}}answer16
+# BOLT: unresolved=0
+# BOLT: BOLT-INFO: not adding new segments
+# BYTES: 8000000 7047fee7 151500
+
+--- !ELF
+FileHeader:
+  Class:           ELFCLASS32
+  Data:            ELFDATA2LSB
+  Type:            ET_EXEC
