diff --git a/bolt/test/ARM/cortex-m-cpu-profiles.s b/bolt/test/ARM/cortex-m-cpu-profiles.s
new file mode 100644
index 0000000000000000000000000000000000000000..5f7a91ef591e21f1509131027473ae960f17d157
--- /dev/null
+++ b/bolt/test/ARM/cortex-m-cpu-profiles.s
@@ -0,0 +1,47 @@
+## Qualify the remaining architecture-equivalent Cortex-M CPUs without
+## pretending that untested Armv8-M/security/MVE profiles are covered.  M0 and
+## M0+ share Armv6-M; M4 and M7 share Armv7E-M.  The explicit CPU still drives
+## LLVM feature selection, while ELF attributes must match its architecture.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0 %s -o %t.m0.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.m0.o -o %t.m0.exe
+# RUN: llvm-bolt %t.m0.exe --firmbolt-cortex-m-cpu=cortex-m0 \
+# RUN:   --frame-opt=none -o %t.m0.bolt
+# RUN: llvm-objdump -d --mcpu=cortex-m0 %t.m0.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: not llvm-bolt %t.m0.exe --firmbolt-cortex-m-cpu=cortex-m7 \
+# RUN:   --frame-opt=none -o %t.bad 2>&1 | FileCheck %s --check-prefix=MISMATCH
+# RUN: llvm-mc -filetype=obj -triple thumbv7em-none-eabi -mcpu=cortex-m7 \
+# RUN:   -defsym=M7=1 %s -o %t.m7.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.m7.o -o %t.m7.exe
+# RUN: llvm-bolt %t.m7.exe --firmbolt-cortex-m-cpu=cortex-m7 \
+# RUN:   --frame-opt=none -o %t.m7.bolt
+# RUN: llvm-objdump -d --mcpu=cortex-m7 %t.m7.bolt | FileCheck %s --check-prefix=DISASM
+
+# DISASM: <Reset_Handler>:
+# DISASM: movs r0, #0x1
+# DISASM: bx lr
+# MISMATCH: Cortex-M CPU/input attribute mismatch
+
+  .syntax unified
+  .thumb
+  .ifdef M7
+  .eabi_attribute Tag_CPU_arch, 13
+  .else
+  .eabi_attribute Tag_CPU_arch, 12
+  .endif
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #1
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/cortex-m-handler-fop.s b/bolt/test/ARM/cortex-m-handler-fop.s
new file mode 100644
index 0000000000000000000000000000000000000000..0c4369134fca069369185578a5471586ca4ccde2
--- /dev/null
+++ b/bolt/test/ARM/cortex-m-handler-fop.s
@@ -0,0 +1,85 @@
+## Exact vector entries may use the narrow exception-entry contract: ordinary
+## FOP replaces a stack reload with a same-width move while retaining the
+## stack store, instruction count/order, entry address and BX LR exception
+## return.  A handler touched by any additional pass retains its input body.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=all --eliminate-unreachable=false \
+# RUN:   --fastdyn-firmware-report=%t.json -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.json')); fs={x['name']:x for x in d['functions']}; a=fs['irq_handler']; b=fs['unsupported_handler']; print(a['cortex_m_vector_entry'],a['firmware_modified'],','.join(a['firmware_modification_reasons']),','.join(a['firmware_publication_rejections'])); print(b['cortex_m_vector_entry'],b['firmware_modified'],','.join(b['firmware_modification_reasons']),','.join(b['firmware_publication_rejections']))" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+
+# BOLT: primary-entry-handlers=3
+# BOLT: FOP optimized 2 redundant load(s)
+# BOLT: retained original handler unsupported_handler: transformation exceeds the exception-entry contract
+# BOLT: BOLT: 1 out of 3 functions were overwritten.
+
+# REPORT: True True frame_load_forwarding
+# REPORT-NEXT: True False cfg_normalization,frame_load_forwarding exception_contract_unsupported
+
+# DISASM: <irq_handler>:
+# DISASM: str r0, [sp]
+# DISASM-NEXT: mov r1, r0
+# DISASM: bx lr
+# DISASM: <unsupported_handler>:
+# DISASM: str r0, [sp]
+# DISASM-NEXT: ldr r1, [sp]
+# DISASM-NEXT: cmp r0, #0x0
+# DISASM-NEXT: beq
+# DISASM-NEXT: b
+# DISASM: bx lr
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl irq_handler
+  .type irq_handler,%function
+  .thumb_func
+irq_handler:
+  sub sp, #4
+  str r0, [sp]
+  ldr r1, [sp]
+  adds r0, r1, #1
+  add sp, #4
+  bx lr
+  .size irq_handler, .-irq_handler
+
+  .globl unsupported_handler
+  .type unsupported_handler,%function
+  .thumb_func
+unsupported_handler:
+  sub sp, #4
+  str r0, [sp]
+  ldr r1, [sp]
+  cmp r0, #0
+  beq .Lsame
+  b .Lsame
+.Lsame:
+  adds r0, r1, #1
+  add sp, #4
+  bx lr
+  .size unsupported_handler, .-unsupported_handler
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+  .word irq_handler
+  .word unsupported_handler
diff --git a/bolt/test/ARM/cortex-m-v8-profiles.s b/bolt/test/ARM/cortex-m-v8-profiles.s
new file mode 100644
index 0000000000000000000000000000000000000000..9fbed017a73e08f6fbc0fe42e3b9ef64b14678a5
--- /dev/null
+++ b/bolt/test/ARM/cortex-m-v8-profiles.s
@@ -0,0 +1,149 @@
+## Qualify one CPU from each M-profile Armv8 generation.  Ordinary code may
+## use the audited native pipeline; TrustZone transition/gateway code is decoded
+## but retained as an opaque semantic unit; MVE integer and floating-point
+## instructions are decoded and exactly re-emitted on Cortex-M55.  PACBTI-M
+## instructions are decoded and retained as an opaque function on Cortex-M85.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv8m.base-none-eabi \
+# RUN:   -mcpu=cortex-m23 -defsym=M23=1 %s -o %t.m23.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.m23.o -o %t.m23.exe
+# RUN: llvm-bolt %t.m23.exe --firmbolt-cortex-m-cpu=cortex-m23 \
+# RUN:   --frame-opt=all --fastdyn-firmware-report=%t.m23.json \
+# RUN:   -o %t.m23.bolt 2>&1 | FileCheck %s --check-prefix=M23-BOLT
+# RUN: llvm-objdump -d --mcpu=cortex-m23 %t.m23.bolt \
+# RUN:   | FileCheck %s --check-prefix=M23-DISASM
+
+# RUN: llvm-mc -filetype=obj -triple thumbv8m.main-none-eabi \
+# RUN:   -mcpu=cortex-m33 -mattr=+8msecext -defsym=M33=1 %s -o %t.m33.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.m33.o -o %t.m33.exe
+# RUN: llvm-bolt %t.m33.exe --firmbolt-cortex-m-cpu=cortex-m33 \
+# RUN:   --frame-opt=all --fastdyn-firmware-report=%t.m33.json \
+# RUN:   -o %t.m33.bolt 2>&1 | FileCheck %s --check-prefix=M33-BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.m33.json')); f=next(x for x in d['functions'] if x['name']=='secure_gateway'); print(f['simple'],f['firmware_modified'])" | FileCheck %s --check-prefix=M33-REPORT
+# RUN: llvm-objdump -d --mcpu=cortex-m33 --mattr=+8msecext %t.m33.bolt \
+# RUN:   | FileCheck %s --check-prefix=M33-DISASM
+
+# RUN: llvm-mc -filetype=obj -triple thumbv8.1m.main-none-eabi \
+# RUN:   -mcpu=cortex-m55 -mattr=+mve,+mve.fp -defsym=M55=1 %s -o %t.m55.o
