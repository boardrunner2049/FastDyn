+TEST_P(MCPlusBuilderTester, ARM_TailDuplicationPropagationReplacements) {
+  if (GetParam() != Triple::thumb)
+    GTEST_SKIP();
+
+  auto NarrowBinary = [](unsigned Opcode) {
+    return MCInst(MCInstBuilder(Opcode)
+                      .addReg(ARM::R0)
+                      .addReg(ARM::CPSR)
+                      .addReg(ARM::R0)
+                      .addReg(ARM::R2)
+                      .addImm(ARMCC::AL)
+                      .addReg(0));
+  };
+  MCInst NarrowAdd = NarrowBinary(ARM::tADDrr);
+  BC->MIB->addAnnotation<int64_t>(NarrowAdd, "propagation-test", 7);
+  ASSERT_TRUE(BC->MIB->replaceRegWithImm(NarrowAdd, ARM::R2, 5));
+  EXPECT_EQ(NarrowAdd.getOpcode(), ARM::tADDi8);
+  EXPECT_EQ(NarrowAdd.getOperand(3).getImm(), 5);
+  EXPECT_EQ(BC->MIB->getAnnotationAs<int64_t>(NarrowAdd, "propagation-test"),
+            7);
+
+  MCInst NarrowSub = NarrowBinary(ARM::tSUBrr);
+  ASSERT_TRUE(BC->MIB->replaceRegWithImm(NarrowSub, ARM::R2, 5));
+  EXPECT_EQ(NarrowSub.getOpcode(), ARM::tSUBi8);
+  EXPECT_EQ(NarrowSub.getOperand(3).getImm(), 5);
+
+  MCInst NarrowThreeAddress = MCInstBuilder(ARM::tADDrr)
+                                  .addReg(ARM::R0)
+                                  .addReg(ARM::CPSR)
+                                  .addReg(ARM::R1)
+                                  .addReg(ARM::R2)
+                                  .addImm(ARMCC::AL)
+                                  .addReg(0);
+  ASSERT_TRUE(
+      BC->MIB->replaceRegWithImm(NarrowThreeAddress, ARM::R2, 7));
+  EXPECT_EQ(NarrowThreeAddress.getOpcode(), ARM::tADDi3);
+  MCInst NarrowUnencodable = MCInstBuilder(ARM::tADDrr)
+                                .addReg(ARM::R0)
+                                .addReg(ARM::CPSR)
+                                .addReg(ARM::R1)
+                                .addReg(ARM::R2)
+                                .addImm(ARMCC::AL)
+                                .addReg(0);
+  EXPECT_FALSE(BC->MIB->replaceRegWithImm(NarrowUnencodable, ARM::R2, 8));
+  EXPECT_EQ(NarrowUnencodable.getOpcode(), ARM::tADDrr);
+
+  MCInst NarrowCompare = MCInstBuilder(ARM::tCMPr)
+                             .addReg(ARM::R0)
+                             .addReg(ARM::R2)
+                             .addImm(ARMCC::AL)
+                             .addReg(0);
+  ASSERT_TRUE(BC->MIB->replaceRegWithImm(NarrowCompare, ARM::R2, 255));
+  EXPECT_EQ(NarrowCompare.getOpcode(), ARM::tCMPi8);
+
+  auto WideBinary = [](unsigned Opcode) {
+    return MCInst(MCInstBuilder(Opcode)
+                      .addReg(ARM::R0)
+                      .addReg(ARM::R1)
+                      .addReg(ARM::R2)
+                      .addImm(ARMCC::AL)
+                      .addReg(0)
+                      .addReg(0));
+  };
+  for (const auto &[RegisterOpcode, ImmediateOpcode] :
+       {std::pair{ARM::t2ADDrr, ARM::t2ADDri},
+        std::pair{ARM::t2SUBrr, ARM::t2SUBri},
+        std::pair{ARM::t2ANDrr, ARM::t2ANDri},
+        std::pair{ARM::t2ORRrr, ARM::t2ORRri},
+        std::pair{ARM::t2EORrr, ARM::t2EORri}}) {
+    MCInst Inst = WideBinary(RegisterOpcode);
+    ASSERT_TRUE(BC->MIB->replaceRegWithImm(Inst, ARM::R2, 5));
+    EXPECT_EQ(Inst.getOpcode(), ImmediateOpcode);
+    EXPECT_EQ(Inst.getOperand(2).getImm(), 5);
+  }
+
+  MCInst WideCompare = MCInstBuilder(ARM::t2CMPrr)
+                           .addReg(ARM::R8)
+                           .addReg(ARM::R2)
+                           .addImm(ARMCC::AL)
+                           .addReg(0);
+  ASSERT_TRUE(BC->MIB->replaceRegWithImm(WideCompare, ARM::R2, 5));
+  EXPECT_EQ(WideCompare.getOpcode(), ARM::t2CMPri);
+
+  MCInst WideMove = MCInstBuilder(ARM::t2MOVr)
+                        .addReg(ARM::R8)
+                        .addReg(ARM::R2)
+                        .addImm(ARMCC::AL)
+                        .addReg(0)
+                        .addReg(0);
+  ASSERT_TRUE(BC->MIB->replaceRegWithImm(WideMove, ARM::R2, 5));
+  EXPECT_EQ(WideMove.getOpcode(), ARM::t2MOVi);
+
+  MCInst Unencodable = WideBinary(ARM::t2ADDrr);
+  EXPECT_FALSE(
+      BC->MIB->replaceRegWithImm(Unencodable, ARM::R2, 0x12345678));
+  EXPECT_EQ(Unencodable.getOpcode(), ARM::t2ADDrr);
+
+  MCInst NarrowMove = MCInstBuilder(ARM::tMOVr)
+                          .addReg(ARM::R0)
+                          .addReg(ARM::R2)
+                          .addImm(ARMCC::AL)
+                          .addReg(0);
+  EXPECT_FALSE(BC->MIB->replaceRegWithImm(NarrowMove, ARM::R2, 5));
+
+  MCInst Copy = NarrowBinary(ARM::tADDrr);
+  ASSERT_TRUE(BC->MIB->replaceRegWithReg(Copy, ARM::R2, ARM::R3));
+  EXPECT_EQ(Copy.getOperand(3).getReg(), ARM::R3);
+  MCInst WrongClass = NarrowBinary(ARM::tADDrr);
+  EXPECT_FALSE(BC->MIB->replaceRegWithReg(
+      WrongClass, ARM::R2, ARM::R8));
+  MCInst DestinationAlias = NarrowBinary(ARM::tADDrr);
+  EXPECT_FALSE(BC->MIB->replaceRegWithReg(
+      DestinationAlias, ARM::R0, ARM::R3));
+}
