+TEST(ARMRelocationHandlerTest, ThumbLiteralAndMovRoundTrips) {
+  std::unique_ptr<RelocationHandler> Handler = createARMRelocationHandler();
+  constexpr uint64_t PC = 0x08001002;
+  constexpr uint64_t Literal = 0x080013fc;
+  ASSERT_TRUE(Handler->canEncodeValue(ELF::R_ARM_THM_PC8, Literal, PC));
+  const uint64_t Ldr = Handler->encodeValue(ELF::R_ARM_THM_PC8, Literal, PC,
