index 0000000000000000000000000000000000000000..c2ffbfd0b77a15e6ee4e2189153d1e97c9b8747e
--- /dev/null
+++ b/bolt/test/ARM/thumb-native-register-reassignment.s
@@ -0,0 +1,197 @@
+## BOLT's original RegReAssign profitability model is x86-specific. Firm-BOLT
+## provides a target hook that swaps only qualified AAPCS callee-saved register
+## pairs and accounts for the exact Thumb encodings unlocked by that swap.
+## The contract is explicit because transient register state changes between
+## the function entry and exit even though both callee-saved values are restored.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-objcopy --rename-section=.ARM.exidx=.ARM %t.exe %t.named.exe
+# RUN: not llvm-bolt %t.named.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --reg-reassign -o %t.denied 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=DENIED
+# RUN: llvm-bolt %t.named.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --reg-reassign \
+# RUN:   --firmbolt-allow-register-reassignment \
+# RUN:   --fastdyn-firmware-report=%t.json -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=compact_worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=COMPACT-DISASM
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=external_worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=EXTERNAL-DISASM
+# RUN: llvm-readobj --unwind %t.bolt | FileCheck %s --check-prefix=EHABI
+# RUN: llvm-readobj --unwind %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=EXTERNAL-EHABI
+# RUN: %python -c "import json; d=json.load(open('%t.json')); f={x['name']:x for x in d['functions']}['worker']; print(f['firmware_modified'],f['firmware_modification_reasons'],d['summary']['unmapped_instruction_count'])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-bolt %t.named.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --reg-reassign \
+# RUN:   --firmbolt-allow-register-reassignment --relocs --use-old-text \
+# RUN:   -o %t.reloc.bolt 2>&1 | FileCheck %s --check-prefix=RELOC-LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=compact_worker \
+# RUN:   %t.reloc.bolt | FileCheck %s --check-prefix=COMPACT-DISASM
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=external_worker \
+# RUN:   %t.reloc.bolt | FileCheck %s --check-prefix=EXTERNAL-DISASM
+# RUN: llvm-readobj --unwind %t.reloc.bolt \
+# RUN:   | FileCheck %s --check-prefix=RELOC-EHABI
+# RUN: llvm-readobj --unwind %t.reloc.bolt \
+# RUN:   | FileCheck %s --check-prefix=EXTERNAL-EHABI
+
+# DENIED: Cortex-M register reassignment changes transient register state
+# LOG: BOLT-INFO: Reg Reassignment Pass: ARM EHABI admitted 2 CANTUNWIND-covered function(s) and retained 0 function(s) with unsupported compact, shared or generic unwind programs; 3 single-function compact program(s) remain candidate-qualified.
+# LOG: BOLT-INFO: Reg Reassignment Pass Stats:
+# LOG-NEXT: 4 functions affected.
+# LOG-NEXT: 32 static bytes saved.
+# LOG: BOLT-INFO: rewrote 1 ARM EHABI inline compact register program(s) in .ARM
+# LOG: BOLT-INFO: rewrote 2 ARM EHABI external compact register program(s) referenced by .ARM
+# RELOC-LOG: BOLT-INFO: rebuilt ARM EHABI index .ARM
+# RELOC-LOG-SAME: after function layout
+# RELOC-LOG: BOLT-INFO: rewrote 2 ARM EHABI external compact register program(s) after function layout
+# DISASM-LABEL: <worker>:
+# DISASM-NEXT: sub sp, #0x8
+# DISASM-NEXT: str r4, [sp, #0x4]
+# DISASM-NEXT: mov.w r4, r1
+# DISASM-NEXT: ldr r0, [r4]
+# DISASM-NEXT: str r0, [r4, #0x4]
+# DISASM-NEXT: ldr r4, [sp, #0x4]
+# DISASM-NEXT: add sp, #0x8
+# DISASM-NEXT: bx lr
+# COMPACT-DISASM-LABEL: <compact_worker>:
+# COMPACT-DISASM-NEXT: sub sp, #0x8
+# COMPACT-DISASM-NEXT: str r4, [sp, #0x4]
+# COMPACT-DISASM-NEXT: mov.w r4, r1
+# COMPACT-DISASM-NEXT: ldr r0, [r4]
+# COMPACT-DISASM-NEXT: str r0, [r4, #0x4]
+# COMPACT-DISASM-NEXT: ldr r4, [sp, #0x4]
+# COMPACT-DISASM-NEXT: add sp, #0x8
+# COMPACT-DISASM-NEXT: bx lr
+# EXTERNAL-DISASM-LABEL: <external_worker>:
+# EXTERNAL-DISASM-NEXT: sub sp, #0x8
+# EXTERNAL-DISASM-NEXT: str r4, [sp, #0x4]
+# EXTERNAL-DISASM-NEXT: mov.w r4, r1
+# EXTERNAL-DISASM-NEXT: ldr r0, [r4]
+# EXTERNAL-DISASM-NEXT: str r0, [r4, #0x4]
+# EXTERNAL-DISASM-NEXT: ldr r4, [sp, #0x4]
+# EXTERNAL-DISASM-NEXT: add sp, #0x8
+# EXTERNAL-DISASM-NEXT: bx lr
+# EHABI: FunctionAddress: 0x8000022
+# EHABI: Model: Compact (Inline)
+# EHABI: 0x80 0x01 ; pop {r4}
+# EHABI: 0xB0 ; finish
+# EXTERNAL-EHABI-COUNT-2: ExceptionHandlingTable: .ARM.extab
+# EXTERNAL-EHABI-NOT: 0x80 0x10 ; pop {r8}
+# EXTERNAL-EHABI: 0x80 0x01 ; pop {r4}
+# RELOC-EHABI: FunctionAddress: 0x800001A
+# RELOC-EHABI: Model: Compact (Inline)
+# RELOC-EHABI: 0x80 0x01 ; pop {r4}
+# RELOC-EHABI: 0xB0 ; finish
+# REPORT: True ['register_reassignment'] 0
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  .fnstart
+  movs r0, #0
+  bl worker
+1:
+  b 1b
+  .cantunwind
+  .fnend
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl worker
+  .type worker,%function
+  .thumb_func
+worker:
+  .fnstart
+  sub sp, #8
+  str.w r8, [sp, #4]
+  mov.w r8, r1
+  ldr.w r0, [r8, #0]
+  str.w r0, [r8, #4]
+  ldr.w r8, [sp, #4]
+  add sp, #8
+  bx lr
+  .cantunwind
+  .fnend
+  .size worker, .-worker
+
+  // This body has the same profitable encoding opportunity and its private
+  // inline compact unwind program names r8. The target must rewrite both the
+  // body and that exact register-pop operand atomically.
+  .globl compact_worker
+  .type compact_worker,%function
+  .thumb_func
+compact_worker:
+  .fnstart
+  .save {r8}
+  sub sp, #8
+  str.w r8, [sp, #4]
+  mov.w r8, r1
+  ldr.w r0, [r8, #0]
+  str.w r0, [r8, #4]
+  ldr.w r8, [sp, #4]
+  add sp, #8
+  bx lr
+  .fnend
+  .size compact_worker, .-compact_worker
+
+  // Personality model 1 forces the same register-bearing bytecode into a
+  // separately allocated .ARM.extab payload. The function and its private
+  // record must be renamed together in compact and relocation publication.
+  .weak __aeabi_unwind_cpp_pr1
+  .globl external_worker
+  .type external_worker,%function
+  .thumb_func
+external_worker:
+  .fnstart
+  .personalityindex 1
+  .save {r8}
+  sub sp, #8
+  str.w r8, [sp, #4]
+  mov.w r8, r1
+  ldr.w r0, [r8, #0]
+  str.w r0, [r8, #4]
+  ldr.w r8, [sp, #4]
+  add sp, #8
+  bx lr
+  .fnend
+  .size external_worker, .-external_worker
+
+  // A second private record in the same output section ensures publication
+  // composes edits instead of recreating the section from immutable input for
+  // each function and accidentally restoring the first program.
+  .globl external_worker_two
+  .type external_worker_two,%function
+  .thumb_func
+external_worker_two:
+  .fnstart
+  .personalityindex 1
+  .save {r8}
+  sub sp, #8
+  str.w r8, [sp, #4]
+  mov.w r8, r1
+  ldr.w r0, [r8, #0]
+  str.w r0, [r8, #4]
+  ldr.w r8, [sp, #4]
+  add sp, #8
+  bx lr
+  .fnend
+  .size external_worker_two, .-external_worker_two
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
