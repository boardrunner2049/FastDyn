+  EXPECT_TRUE(Handler->canEncodeValue(ELF::R_ARM_ABS8,
+                                      uint64_t(int64_t(-128)), PC));
+  EXPECT_FALSE(Handler->canEncodeValue(ELF::R_ARM_ABS8, 256, PC));
+  EXPECT_EQ(int64_t(Handler->extractValue(ELF::R_ARM_ABS8, 0xf0, PC)),
+            -16);
+
+  EXPECT_EQ(Handler->getSizeForType(ELF::R_ARM_ABS16), 2U);
+  EXPECT_TRUE(Handler->canEncodeValue(ELF::R_ARM_ABS16, 65535, PC));
+  EXPECT_TRUE(Handler->canEncodeValue(ELF::R_ARM_ABS16,
+                                      uint64_t(int64_t(-32768)), PC));
+  EXPECT_FALSE(Handler->canEncodeValue(ELF::R_ARM_ABS16, 65536, PC));
+  EXPECT_EQ(int64_t(Handler->extractValue(ELF::R_ARM_ABS16, 0x8000, PC)),
+            -32768);
+}
