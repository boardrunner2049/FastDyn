+# BOLT: BOLT-INFO: FOP optimized 1 redundant load(s)
+# BOLT: BOLT-INFO: FRAME ANALYSIS: 0 function(s) (0.0% dyn cov) could not have its frame indices restored.
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+
+# DISASM: <worker>:
+# DISASM-NEXT: push {r7, lr}
+# DISASM-NEXT: sub sp, #0x4
+# DISASM-NEXT: add r7, sp, #0x0
+# DISASM-NEXT: str r0, [r7]
+# DISASM-NEXT: mov r1, r0
+# DISASM-NEXT: mov sp, r7
+# DISASM-NEXT: add sp, #0x4
+# DISASM-NEXT: pop {r7, pc}
