@@ -0,0 +1,11 @@
+ENTRY(Reset_Handler)
+
+SECTIONS {
+  . = 0x00000000;
+  rom_start : { KEEP(*(rom_start)) }
+
+  . = 0x00001000;
+  .text : { *(.text*) }
+
+  .ARM.attributes 0 : { *(.ARM.attributes) }
+}
diff --git a/bolt/test/ARM/cortex-m-cpu-profiles.s b/bolt/test/ARM/cortex-m-cpu-profiles.s
new file mode 100644
index 0000000000000000000000000000000000000000..be2eea26d8284cbb8a99732e09fbf604fc0bb602
--- /dev/null
+++ b/bolt/test/ARM/cortex-m-cpu-profiles.s
@@ -0,0 +1,78 @@
+## Qualify architecture-equivalent Cortex-M CPUs without conflating their
+## identities. M0/M0+/M1 share Armv6-M; M4/M7 share Armv7E-M. The explicit CPU
+## still drives LLVM feature selection, while ELF attributes provide exact or
+## architecture-level evidence. The M1 arm also proves that Thumb triples take
+## the same AArch32 attribute-import path as ARM triples.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0 %s -o %t.m0.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.m0.o -o %t.m0.exe
+# RUN: llvm-bolt %t.m0.exe --firmbolt-cortex-m-cpu=cortex-m0 \
+# RUN:   --frame-opt=none -o %t.m0.bolt
+# RUN: llvm-objdump -d --mcpu=cortex-m0 %t.m0.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m1 \
+# RUN:   -defsym=M1=1 %s -o %t.m1.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.m1.o -o %t.m1.exe
+# RUN: llvm-bolt %t.m1.exe --firmbolt-cortex-m-cpu=cortex-m1 \
+# RUN:   --firmbolt-reject-target-incompatible-input --frame-opt=none \
+# RUN:   -o %t.m1.bolt 2>&1 | FileCheck %s --check-prefix=M1
+# RUN: llvm-objdump -d --mcpu=cortex-m1 %t.m1.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: not llvm-bolt %t.m0.exe --firmbolt-cortex-m-cpu=cortex-m7 \
+# RUN:   --frame-opt=none -o %t.bad 2>&1 | FileCheck %s --check-prefix=MISMATCH
+# RUN: llvm-mc -filetype=obj -triple thumbv7em-none-eabi -mcpu=cortex-m7 \
+# RUN:   -defsym=M7=1 %s -o %t.m7.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.m7.o -o %t.m7.exe
+# RUN: llvm-bolt %t.m7.exe --firmbolt-cortex-m-cpu=cortex-m7 \
+# RUN:   --frame-opt=none -o %t.m7.bolt
+# RUN: llvm-objdump -d --mcpu=cortex-m7 %t.m7.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: not llvm-bolt %t.m7.exe --firmbolt-cortex-m-cpu=cortex-m4 \
+# RUN:   --frame-opt=none -o %t.bad-exact 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=EXACT-MISMATCH
+# RUN: llvm-mc -filetype=obj -triple thumbv7em-none-eabi -mcpu=cortex-m7 \
+# RUN:   -defsym=M7=1 -defsym=GENERIC=1 %s -o %t.generic.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.generic.o -o %t.generic.exe
+# RUN: llvm-bolt %t.generic.exe --firmbolt-cortex-m-cpu=cortex-m4 \
+# RUN:   --frame-opt=none -o %t.generic.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=GENERIC
+
+# DISASM: <Reset_Handler>:
+# DISASM: movs r0, #0x1
+# DISASM: bx lr
+# MISMATCH: Cortex-M CPU/input attribute mismatch
+# EXACT-MISMATCH: Cortex-M exact CPU/input attribute mismatch
+# EXACT-MISMATCH: --firmbolt-cortex-m-cpu=cortex-m4 does not match Tag_CPU_name=cortex-m7
+# GENERIC: BOLT-INFO: Cortex-M target CPU cortex-m4, input CPU attribute 7E-M
+# M1: BOLT-INFO: Cortex-M target CPU cortex-m1, input CPU attribute cortex-m1
+
+  .syntax unified
+  .thumb
+  .ifdef M7
+  .eabi_attribute Tag_CPU_arch, 13
+  .ifdef GENERIC
+  .eabi_attribute Tag_CPU_name, "7E-M"
+  .else
+  .eabi_attribute Tag_CPU_name, "cortex-m7"
+  .endif
+  .else
+  .eabi_attribute Tag_CPU_arch, 12
+  .ifdef M1
+  .eabi_attribute Tag_CPU_name, "cortex-m1"
+  .else
+  .eabi_attribute Tag_CPU_name, "cortex-m0"
+  .endif
+  .endif
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #1
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/cortex-m-handler-fallthrough-branch-elision.s b/bolt/test/ARM/cortex-m-handler-fallthrough-branch-elision.s
new file mode 100644
index 0000000000000000000000000000000000000000..188f08b64471035f51f1b51fd5ebc4d4c7c4928a
--- /dev/null
+++ b/bolt/test/ARM/cortex-m-handler-fallthrough-branch-elision.s
@@ -0,0 +1,76 @@
+## Cortex-M handlers retain CFG edits by default.  The explicit handler
+## fallthrough-branch contract admits only a conditional direct branch whose
+## target is the immediately following instruction, while preserving every
+## other original identity, architectural-state instruction and exception
+## return.  A two-branch normalization remains rejected under the opt-in.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=none --eliminate-unreachable=false \
+# RUN:   --fastdyn-firmware-report=%t.default.json -o %t.default
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=none --eliminate-unreachable=false \
+# RUN:   --firmbolt-allow-handler-fallthrough-branch-elision \
+# RUN:   --fastdyn-firmware-report=%t.allowed.json -o %t.allowed
