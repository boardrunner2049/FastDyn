+# RUN: llvm-objdump -d --mcpu=cortex-m0plus %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); c=next(x for x in d['functions'] if x['name']=='caller'); s=next(x for x in d['functions'] if x['name']=='__firmbolt_thumb_veneer_slot0'); src=next(x['original_address'] for x in c['instructions'] if x['is_call']); v=[x for x in s['instructions'] if x['provenance_kind']=='synthesized_call_veneer']; print('POST',s['firmware_veneer_slot'],s['firmware_modification_reasons'],len(v),all(x['source_original_address']==src for x in v))" | FileCheck %s --check-prefix=POST
+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); s=next(x for x in d['functions'] if x['name']=='__firmbolt_thumb_veneer_slot0'); q=s['synthesized_inline_data']; print('FINAL',s['firmware_veneer_slot'],s['output_address']==0x08000100,s['output_size'],len(q),q[0]['output_address']==0x08000104,q[0]['target_output_address']&1)" | FileCheck %s --check-prefix=FINAL
+
+# BOLT: veneer-slots=1
+# BOLT: 1 reserved firmware veneer slots allocated
+# BOLT: 2 out of 5 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+
+# DISASM: <caller>:
+# DISASM: bl 0x8000100 <__firmbolt_thumb_veneer_slot0>
+# DISASM: <__firmbolt_thumb_veneer_slot0>:
+# DISASM-NEXT: 8000100: {{.*}} ldr r3, [pc, #0x0]
+# DISASM-NEXT: 8000102: {{.*}} bx r3
+
+# POST: POST True ['unreachable_code_elimination', 'veneer_slot_allocation'] 2 True
+# FINAL: FINAL True True 8 1 True 1
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl caller
+  .type caller,%function
+  .thumb_func
+caller:
+  push {lr}
+  bl target
+  pop {pc}
+  .size caller, .-caller
+
+  .globl filler
