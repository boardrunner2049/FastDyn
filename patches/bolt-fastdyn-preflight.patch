index 0000000000000000000000000000000000000000..ed66e98f18db94ba4123cfce463e0bbb2852b216
--- /dev/null
+++ b/bolt/test/ARM/thumb-native-tail-duplication-copy-propagation.s
@@ -0,0 +1,102 @@
+## Copy propagation uses the same independent Cortex-M contract as constant
+## propagation.  The source and replacement must satisfy the exact operand
+## register class, and a move whose destination remains observable is retained.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: link_fdata --no-lbr %s %t.exe %t.fdata
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata \
+# RUN:   --tail-duplication=aggressive --tail-duplication-minimum-offset=0 \
+# RUN:   --firmbolt-allow-tail-duplication \
+# RUN:   --firmbolt-allow-tail-duplication-propagation \
+# RUN:   --tail-duplication-const-copy-propagation \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --eliminate-unreachable=false -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=taildup_copy %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=taildup_copy_observable %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=OBSERVABLE
+
+# LOG: tail duplication modified 2
+# LOG: tail duplication applied 1 static
+# DISASM: <taildup_copy>:
+# DISASM-NOT: mov r2, r3
+# DISASM: add.w r0, r0, r3
+# DISASM-NEXT: bx lr
+# OBSERVABLE: <taildup_copy_observable>:
+# OBSERVABLE: mov r1, r3
+# OBSERVABLE: add.w r0, r0, r1
+# OBSERVABLE-NEXT: bx lr
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  movs r3, #5
+  bl taildup_copy
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl taildup_copy
+  .type taildup_copy,%function
+  .thumb_func
+taildup_copy:
+  cmp r0, #0
+  bne .Lcold
+.Lhot:
+  mov r2, r3
+  b.w .Lshared
+.Lcold:
+  movs r0, #10
+  bx lr
+.Lshared:
+  add.w r0, r0, r2
+  bx lr
+  .size taildup_copy, .-taildup_copy
+
+# FDATA: 1 taildup_copy 0 100
+# FDATA: 1 taildup_copy 4 100
+# FDATA: 1 taildup_copy a 1
