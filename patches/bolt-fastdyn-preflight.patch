+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl load_immutable
+  bl load_unresolved_pool
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl load_immutable
+  .type load_immutable,%function
+  .thumb_func
+load_immutable:
+  ldr.w r0, immutable_scalar
+  bx lr
+  .size load_immutable, .-load_immutable
+
+  .globl load_unresolved_pool
