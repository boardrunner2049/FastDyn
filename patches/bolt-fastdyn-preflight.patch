+  adds r0, #9
+  bx lr
+  .size promoted_target, .-promoted_target
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb-native-inlining.s b/bolt/test/ARM/thumb-native-inlining.s
