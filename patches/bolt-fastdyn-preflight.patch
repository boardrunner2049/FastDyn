+# RUN:   --relocs --use-old-text --update-debug-sections --keep-aranges \
+# RUN:   --always-convert-to-ranges --align-functions=1 \
+# RUN:   -o %t/candidate-v2.elf
+# RUN: llvm-dwarfdump --verify %t/candidate-v2.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=VERIFY
+# RUN: %clang --target=thumbv7m-none-eabi -mcpu=cortex-m3 -mthumb \
+# RUN:   -O2 -g -gdwarf-3 -ffreestanding -fno-unwind-tables \
+# RUN:   -fno-asynchronous-unwind-tables -c %t/fixture.c -o %t/fixture-v3.o
+# RUN: ld.lld --emit-relocs -T %t/link.ld %t/fixture-v3.o %t/aranges.o \
+# RUN:   -o %t/reference-v3.elf
+# RUN: llvm-bolt %t/reference-v3.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --update-debug-sections --keep-aranges \
+# RUN:   --always-convert-to-ranges --align-functions=1 \
+# RUN:   -o %t/candidate-v3.elf
+# RUN: llvm-dwarfdump --verify %t/candidate-v3.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=VERIFY
