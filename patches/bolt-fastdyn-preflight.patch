--- /dev/null
+++ b/bolt/test/ARM/thumb-native-inlining.s
@@ -0,0 +1,70 @@
+## Native BOLT inlining is useful on firmware, but it changes a call boundary
+## and copies callee instructions into a different original-address domain.
+## Firm-BOLT therefore keeps it fail-closed by default and records exact clone
+## provenance when the workload contract explicitly admits the change.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --force-inline=tiny_callee --eliminate-unreachable=false \
+# RUN:   -o %t.denied 2>&1 | FileCheck %s --check-prefix=DENIED
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --force-inline=tiny_callee --firmbolt-allow-inlining \
+# RUN:   --eliminate-unreachable=false --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=caller %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); l=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='caller'); lf=next(x for x in l['functions'] if x['name']=='caller'); clones=[x for x in f['instructions'] if x['provenance_kind']=='cloned_original_instruction']; lc=[x for x in lf['instruction_origins'] if x['origin_kind']=='cloned_original_instruction']; print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),f['post_optimization_instruction_count'],len(clones),d['summary']['cloned_original_instruction_count']); print([(hex(x['original_address']),hex(x['output_address'])) for x in lc])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# DENIED: Cortex-M inlining changes call boundaries
+# LOG: 1 out of 3 functions were overwritten.
+# DISASM: <caller>:
+# DISASM-NOT: bl
+# DISASM: push {lr}
+# DISASM: movs r0, #0x2a
+# DISASM-NEXT: adds r0, #0x1
+# DISASM-NEXT: pop {pc}
+# REPORT: True inlining 4 1 1
+# REPORT-NEXT: [('0x8000010', '0x8000008')]
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl caller
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl caller
+  .type caller,%function
+  .thumb_func
+caller:
+  push {lr}
+  bl tiny_callee
+  adds r0, #1
+  pop {pc}
+  .size caller, .-caller
+
+  .globl tiny_callee
+  .type tiny_callee,%function
+  .thumb_func
+tiny_callee:
+  movs r0, #42
+  bx lr
+  .size tiny_callee, .-tiny_callee
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
