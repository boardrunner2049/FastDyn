diff --git a/bolt/test/ARM/thumb2-pcrel-reference-relocations.s b/bolt/test/ARM/thumb2-pcrel-reference-relocations.s
new file mode 100644
index 0000000000000000000000000000000000000000..d98cb794d1a20e85a709b4fea9bb2817bffc4503
--- /dev/null
+++ b/bolt/test/ARM/thumb2-pcrel-reference-relocations.s
@@ -0,0 +1,69 @@
+## Exercise the complete BOLT path for Thumb-2 PC-relative instruction
+## references.  The relocation handler and AArch32 JITLink implementation are
+## insufficient if MCPlusBuilder silently drops these references while reading
+## the input executable.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 \
+# RUN:   --section-start=.rodata=0x08000100 \
+# RUN:   --section-start=.isr_vector=0x08002000 \
+# RUN:   -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-readelf -r %t.exe | FileCheck %s --check-prefix=INPUT-RELOCS
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=none --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+
+# INPUT-RELOCS-DAG: R_ARM_THM_ALU_PREL_11_0{{.*}}external_data
+# INPUT-RELOCS-DAG: R_ARM_THM_MOVW_PREL_NC{{.*}}external_data
+# INPUT-RELOCS-DAG: R_ARM_THM_MOVT_PREL{{.*}}external_data
+# BOLT: unresolved=0
+# BOLT: BOLT-INFO: not adding new segments
+# DISASM: <pcrel_worker>:
+# DISASM-NEXT: adr.w r0, #244
+# DISASM-NEXT: movw r1, #0xf4
+# DISASM-NEXT: movt r1, #0x0
+# DISASM-NEXT: bx lr
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+
+  .section .text.entry,"ax",%progbits
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl pcrel_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .section .text.worker,"ax",%progbits
+  .p2align 2
+  .globl pcrel_worker
+  .type pcrel_worker,%function
+  .thumb_func
+pcrel_worker:
+  adr.w r0, external_data
+  movw r1, :lower16:(external_data - .)
+  movt r1, :upper16:(external_data - .)
+  bx lr
+  .size pcrel_worker, .-pcrel_worker
+
+  .section .rodata,"a",%progbits
+  .p2align 2
+  .globl external_data
+external_data:
+  .word 0x12345678
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+  .word 0
+  .word 0
diff --git a/bolt/test/ARM/thumb2-terminal-literal-pool.s b/bolt/test/ARM/thumb2-terminal-literal-pool.s
