+## Firm-BOLT qualifies BOLT's native indirect-call promotion for ordinary
+## Thumb-2 register calls under an explicit call/branch-event contract. The
+## direct and fallback calls retain exact call-site provenance; compare and
+## branch scaffolding is typed as a synthesized call-promotion expansion.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: link_fdata %s %t.exe %t.fdata
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
+# RUN:   --icp-calls-topn=1 --assume-abi -o %t.no-contract 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=NO-CONTRACT
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=all \
+# RUN:   --firmbolt-allow-indirect-call-promotion --assume-abi \
+# RUN:   -o %t.all 2>&1 | FileCheck %s --check-prefix=ALL-MODE
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
+# RUN:   --icp-calls-topn=1 --icp-top-callsites=0 --assume-abi \
+# RUN:   --firmbolt-allow-indirect-call-promotion \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --fastdyn-firmware-report=%t.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=indirect_caller \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); l=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='indirect_caller'); lf=next(x for x in l['functions'] if x['name']=='indirect_caller'); kinds=[x['origin_kind'] for x in lf['instruction_origins']]; print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),d['summary']['unmapped_instruction_count'],l['synthesized_call_promotion_instruction_count'],lf['original_size'],lf['output_size']); print(kinds.count('original_instruction'),kinds.count('cloned_original_instruction'),kinds.count('synthesized_call_promotion'))" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# NO-CONTRACT: Cortex-M indirect-call promotion changes call and branch events
+# ALL-MODE: Cortex-M jump-table promotion changes compare and branch events
+# LOG: ICP succeeded in indirect_caller
+# DISASM: <indirect_caller>:
+# DISASM: push {lr}
+# DISASM: movw {{r[0-9]+}}, #{{[0-9]+}}
+# DISASM-NEXT: movt {{r[0-9]+}}, #{{[0-9]+}}
+# DISASM-NEXT: cmp{{(\.w)?}} r3, {{r[0-9]+}}
+# DISASM-NEXT: bne
+# DISASM: bl 0x{{[0-9a-f]+}} <promoted_target>
+# DISASM: blx r3
+# DISASM: pop {pc}
+# REPORT: True {{.*}}indirect_call_promotion{{.*}} 0 6 40 28
+# REPORT-NEXT: 3 1 6
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #10
+  movw r3, :lower16:promoted_target + 1
+  movt r3, :upper16:promoted_target + 1
+  bl indirect_caller
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl indirect_caller
+  .type indirect_caller,%function
+  .thumb_func
+indirect_caller:
+  push {lr}
+  blx r3
+# FDATA: 1 indirect_caller 2 1 promoted_target 0 0 100
+  b 1f
+  /* Explicitly unreachable bytes inside the symbol-bounded function range
+     provide compact-emission capacity. They are not an alternate entry and
+     must be proven unreachable before the candidate may consume the range. */
+  .rept 16
+  nop
+  .endr
+1:
+  pop {pc}
+  .size indirect_caller, .-indirect_caller
+
