+# RUN:   --tail-duplication=aggressive --tail-duplication-minimum-offset=0 \
+# RUN:   --firmbolt-allow-tail-duplication \
+# RUN:   --firmbolt-allow-tail-duplication-propagation \
+# RUN:   --tail-duplication-const-copy-propagation \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --eliminate-unreachable=false --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=taildup_propagate %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); l=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='taildup_propagate'); lf=next(x for x in l['functions'] if x['name']=='taildup_propagate'); clones=[x for x in lf['instruction_origins'] if x['origin_kind']=='cloned_original_instruction']; print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),lf['original_size'],lf['output_size'],len(clones)); print([(hex(x['original_address']),hex(x['output_address'])) for x in clones])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# DENIED: Cortex-M tail-duplication propagation removes register-defining instructions
+# LOG: tail duplication modified 1
+# LOG: tail duplication applied 1 static
+# DISASM: <taildup_propagate>:
+# DISASM-NOT: mov.w r2
+# DISASM: add.w r0, r0, #0x5
+# DISASM-NEXT: bx lr
+# REPORT: True {{.*}}tail_duplication{{.*}} 22 20 2
+# REPORT-NEXT: [('0x
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  bl taildup_propagate
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl taildup_propagate
+  .type taildup_propagate,%function
+  .thumb_func
+taildup_propagate:
+  cmp r0, #0
+  bne .Lcold
+.Lhot:
+  mov.w r2, #5
+  b.w .Lshared
+.Lcold:
+  movs r0, #10
+  bx lr
+.Lshared:
+  add.w r0, r0, r2
+  bx lr
+  .size taildup_propagate, .-taildup_propagate
+
+# FDATA: 1 taildup_propagate 0 100
+# FDATA: 1 taildup_propagate 4 100
+# FDATA: 1 taildup_propagate c 1
+# FDATA: 1 taildup_propagate 10 100
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
