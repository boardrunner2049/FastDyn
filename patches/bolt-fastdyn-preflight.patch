+## than depending on a hand-written order.  worker_a is hottest, followed by
+## Reset_Handler and worker_b.
+# RUN: llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --data=%t/profile.fdata --relocs --use-old-text \
+# RUN:   --reorder-functions=exec-count \
