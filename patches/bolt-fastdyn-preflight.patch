+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl virtual_caller
+  .type virtual_caller,%function
+  .thumb_func
+virtual_caller:
+  push {lr}
+  ldr r3, [r0]
+  ldr r2, [r3]
+  blx r2
+# FDATA: 1 virtual_caller 6 1 promoted_target 0 0 100
+# FDATA: 4 virtual_caller 4 4 writable_vtable 0 100
+  b 1f
+  .rept 16
+  nop
+  .endr
+1:
+  pop {pc}
+  .size virtual_caller, .-virtual_caller
+
+  .globl promoted_target
+  .type promoted_target,%function
+  .thumb_func
+promoted_target:
+  adds r0, #7
+  bx lr
+  .size promoted_target, .-promoted_target
+
+  .section .data.vtable,"aw",%progbits
+  .p2align 2
+  .globl writable_vtable
+  .type writable_vtable,%object
+writable_vtable:
