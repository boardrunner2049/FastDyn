+  .eabi_attribute Tag_BTI_extension, 1
+  .endif
+  .endif
+  .endif
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl ordinary_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl ordinary_worker
+  .type ordinary_worker,%function
+  .thumb_func
+ordinary_worker:
+  sub sp, #4
+  str r0, [sp]
+  ldr r1, [sp]
+  adds r0, r1, #1
+  add sp, #4
+  bx lr
+  .size ordinary_worker, .-ordinary_worker
+
+  .ifdef M33
+  .globl secure_gateway
+  .type secure_gateway,%function
+  .thumb_func
+secure_gateway:
+  sg
+  bxns lr
+  .size secure_gateway, .-secure_gateway
+  .endif
+
+  .ifdef M55
+  .globl mve_worker
+  .type mve_worker,%function
+  .thumb_func
+mve_worker:
+  vadd.i32 q0, q1, q2
+  vadd.f32 q0, q1, q2
+  bx lr
+  .size mve_worker, .-mve_worker
+  .endif
+
+  .ifdef M85
+  .globl pacbti_worker
+  .type pacbti_worker,%function
+  .thumb_func
+pacbti_worker:
+  pacbti r12, lr, sp
+  bti
+  aut r12, lr, sp
+  bx lr
+  .size pacbti_worker, .-pacbti_worker
+  .endif
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/cortex-m4-features.s b/bolt/test/ARM/cortex-m4-features.s
