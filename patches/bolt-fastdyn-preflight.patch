diff --git a/bolt/test/ARM/thumb1-literal-pool-external-reference.s b/bolt/test/ARM/thumb1-literal-pool-external-reference.s
new file mode 100644
index 0000000000000000000000000000000000000000..afcd84110ca5f10dac63318c407836ba25f22550
--- /dev/null
+++ b/bolt/test/ARM/thumb1-literal-pool-external-reference.s
@@ -0,0 +1,60 @@
+## A stripped, fully linked firmware can retain a raw pointer to an interleaved
+## literal pool without a relocation. Firm-BOLT must not move the pool merely
+## because the owning LDR was symbolized successfully.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=2 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json')); f=next(x for x in d['functions'] if x['name']=='large_worker'); print(f['address_stable_layout'],f['firmware_modified'],','.join(f['firmware_modification_reasons']))" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-readelf -x .rodata %t.exe > %t.in.rodata
+# RUN: llvm-readelf -x .rodata %t.bolt > %t.out.rodata
+# RUN: diff %t.in.rodata %t.out.rodata
+
+# BOLT: BOLT-INFO: retained literal pools in large_worker: pool has a raw allocated-section reference
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 0 function(s), attached 0 owner block(s), rebound 0 PC-relative reference(s), and retained 1 function(s)
+# BOLT: BOLT: 0 out of 2 functions were overwritten.
+# REPORT: True False
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl large_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl large_worker
+  .type large_worker,%function
+  .thumb_func
+large_worker:
+  ldr r1, .Lliteral
+  adds r0, r0, r1
+  b .Lresume
+  .p2align 2
+.Lliteral:
+  .word 7
+.Lresume:
+  .rept 520
+  nop
+  .endr
+  bx lr
+  .size large_worker, .-large_worker
+
+  .section .rodata,"a",%progbits
+  .p2align 2
+literal_pool_observer:
+  .word .Lliteral
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-literal-pool-relocation.s b/bolt/test/ARM/thumb1-literal-pool-relocation.s
new file mode 100644
index 0000000000000000000000000000000000000000..1c4645e018b56886a98162728c88ba7938921761
--- /dev/null
+++ b/bolt/test/ARM/thumb1-literal-pool-relocation.s
@@ -0,0 +1,72 @@
+## ARM firmware uses SHT_REL rather than SHT_RELA. Verify that compact
+## non-relocation-layout mode still consumes the input metadata, recovers the
+## implicit addend, carries the pool relocation and qualifies the guarded
+## Thumb-1 pool instead of silently dropping the dependency.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=2 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json')); f=next(x for x in d['functions'] if x['name']=='large_worker'); p=[p for i in f['instructions'] for p in i.get('owned_literal_pool_ranges',[])]; print(f['address_stable_layout'],f['firmware_modified'],len(p),sum(x['relocation_count'] for x in p),d['summary']['function_count'])" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objdump -d --start-address=0x08000008 --stop-address=0x08000018 %t.bolt | FileCheck %s --check-prefix=CODE
+# RUN: llvm-readelf -r %t.bolt | FileCheck %s --check-prefix=RELOCS
+
+# BOLT: BOLT-INFO: reading ARM SHT_REL metadata for compact firmware emission
+# BOLT: BOLT-INFO: literal-pool model for large_worker has 1 retained relocation(s)
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 1 owner block(s), rebound 1 PC-relative reference(s), and retained 0 function(s)
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# REPORT: False True 1 1 2
+# CODE: adr r1,
+# CODE: 8000010: 28 04 00 08 .word 0x08000428
+# RELOCS: 08000010 {{.*}} R_ARM_ABS32 {{.*}} external_object
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl large_worker
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl large_worker
+  .type large_worker,%function
+  .thumb_func
+large_worker:
+  adr r1, .Lliteral
+  ldr r0, [r1]
+  b .Lresume
+  .p2align 2
+.Lliteral:
+  .word external_object
+.Lresume:
+  .rept 520
+  nop
+  .endr
+  bx lr
+  .size large_worker, .-large_worker
+
+  // Keep a typed object in the executable section. Firmware linker scripts
+  // commonly merge read-only constants into flash text; it must not become a
+  // synthetic Thumb function or acquire bit zero when the pool relocation is
+  // resolved.
+  .text
+  .p2align 2
+  .globl external_object
+  .type external_object,%object
+external_object:
+  .word 0x12345678
+  .size external_object, .-external_object
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-local-branch-relaxation.s b/bolt/test/ARM/thumb1-local-branch-relaxation.s
new file mode 100644
index 0000000000000000000000000000000000000000..6583e469d8ca0e090cee3c457c383df663e9bde2
--- /dev/null
+++ b/bolt/test/ARM/thumb1-local-branch-relaxation.s
@@ -0,0 +1,62 @@
+## Thumb-1 has no wide conditional branch.  Force a qualified CFG layout to
+## move a formerly adjacent successor beyond the T1 range and require BOLT to
+## insert an in-function trampoline instead of emitting a truncated branch.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --reorder-blocks=reverse --frame-opt=none -v=1 \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --fastdyn-firmware-report=%t.json -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-objdump -d %t.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; p=json.load(open('%t.json')); f=json.load(open('%t.json.layout.json')); e=[x for q in p['functions'] for x in q['instructions'] if x['provenance_kind']=='synthesized_control_edge']; o=[x for q in f['functions'] for x in q['instruction_origins'] if x['origin_kind']=='synthesized_control_edge']; print(len(e),p['summary']['verified_synthesized_control_edge_instruction_count'],p['summary']['unmapped_instruction_count'],len(o),f['synthesized_control_edge_instruction_count'],all(x['output_address']>=0x08000000 for x in o),all(x['source_original_block_address']>=0x08000000 for x in o))" | FileCheck %s --check-prefix=ORIGIN
+
+# BOLT: BOLT-INFO: relaxed {{[1-9][0-9]*}} Thumb-1 local branch(es) with in-function trampolines
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+
+# DISASM: <branch_worker>:
+# DISASM: cmp r0, #0x0
+# DISASM-NEXT: bne
+# DISASM-NEXT: {{[[:space:]]b[[:space:]]}}
+
+# ORIGIN: 1 1 0 1 1 True True
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl branch_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl branch_worker
+  .type branch_worker,%function
+  .thumb_func
+branch_worker:
+  cmp r0, #0
+  beq .Lnear
+  b .Lpadding
+.Lnear:
+  movs r0, #1
+  bx lr
+.Lpadding:
+  .rept 200
+  nop
+  .endr
+  movs r0, #2
+  bx lr
+  .size branch_worker, .-branch_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-moved-literal-pool-relocation.s b/bolt/test/ARM/thumb1-moved-literal-pool-relocation.s
