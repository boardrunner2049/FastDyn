+  movs r1, #2
+  movs r2, #3
+  ldr r3, .Ltarget_pointer
+  bl tail_dispatch
+1:
+  b 1b
+  .p2align 2
+.Ltarget_pointer:
+  .word promoted_target + 1
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl tail_dispatch
+  .type tail_dispatch,%function
+  .thumb_func
+tail_dispatch:
+  push {r4}
+  pop {r4}
+  bx r3
+# FDATA: 1 tail_dispatch 4 1 promoted_target 0 0 100
+  .rept 16
+  nop
+  .endr
+  .size tail_dispatch, .-tail_dispatch
+
+  .globl promoted_target
+  .type promoted_target,%function
+  .thumb_func
+promoted_target:
+  adds r0, r1
+  adds r0, r2
+  adds r0, #7
+  bx lr
+  .size promoted_target, .-promoted_target
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
