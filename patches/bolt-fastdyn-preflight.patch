index 0000000000000000000000000000000000000000..32cacd19052fce8ce031094e83ee78c1f9260c2a
--- /dev/null
+++ b/bolt/test/ARM/thumb-target1-absolute-relocation.s
@@ -0,0 +1,107 @@
+## R_ARM_TARGET1 is platform-defined: GNU and LLD can interpret it as either
+## ABS32 or REL32.  FirmBOLT must reject it by default and only consume the
+## qualified bare-metal absolute form after an explicit policy declaration.
+## Exercise the complete relocation path by moving the pointed-to Thumb
+## function and checking the retained data slot, Thumb state bit and relocation
+## metadata rather than merely accepting the input record.
+
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/fixture.s -o %t/fixture.o
+# RUN: ld.lld --emit-relocs --target1-abs -T %t/link.ld %t/fixture.o \
+# RUN:   -o %t/reference.elf
+# RUN: llvm-readelf -rW %t/reference.elf \
+# RUN:   | FileCheck %s --check-prefix=INPUT
+# RUN: rm -f %t/unqualified.elf %t/relative-candidate.elf
+# RUN: not llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --reorder-functions=user \
+# RUN:   --function-order=%t/order.txt -o %t/unqualified.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=UNQUALIFIED
+# RUN: not test -e %t/unqualified.elf
+# RUN: ld.lld --emit-relocs --target1-rel -T %t/link.ld %t/fixture.o \
+# RUN:   -o %t/relative.elf
+# RUN: not llvm-bolt %t/relative.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-target1=abs --relocs --use-old-text \
+# RUN:   --reorder-functions=user --function-order=%t/order.txt \
+# RUN:   -o %t/relative-candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=RELATIVE
+# RUN: not test -e %t/relative-candidate.elf
+# RUN: llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-target1=abs --relocs --use-old-text \
+# RUN:   --reorder-functions=user --function-order=%t/order.txt \
+# RUN:   -o %t/candidate.elf
+# RUN: llvm-nm --numeric-sort %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=SYMBOLS
+# RUN: llvm-objdump -s -j .dispatch %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=DATA
+# RUN: llvm-readelf -rW %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=OUTPUT
+
+# INPUT: R_ARM_TARGET1 {{.*}} target_worker
+# UNQUALIFIED: qualify its absolute meaning with --firmbolt-arm-target1=abs
+# RELATIVE: has PC-relative contents but --firmbolt-arm-target1=abs declares absolute semantics
+# SYMBOLS: 08000100 T target_worker
+# SYMBOLS: 08000104 T Reset_Handler
+# DATA: 8000200 01010008
+# OUTPUT: 08000200 {{.*}} R_ARM_TARGET1 08000101 target_worker
+
+//--- fixture.s
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+
+  .section .isr_vector,"a",%progbits
+  .p2align 2
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+
+  .section .text,"ax",%progbits
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movw r3, :lower16:dispatch_slot
+  movt r3, :upper16:dispatch_slot
+  ldr r3, [r3]
+  movs r0, #40
+  blx r3
+  movw r1, #0
+  movt r1, #0x2000
+  str r0, [r1]
+.globl fixture_halt
+fixture_halt:
+  b fixture_halt
+  .size Reset_Handler, .-Reset_Handler
+
+  .p2align 2
+  .globl target_worker
+  .type target_worker,%function
+  .thumb_func
+target_worker:
+  adds r0, #2
+  bx lr
+  .size target_worker, .-target_worker
+
+  .section .dispatch,"a",%progbits
+  .p2align 2
+  .globl dispatch_slot
+  .type dispatch_slot,%object
+dispatch_slot:
+  .word target_worker(TARGET1)
