+TEST_F(AArch32Errors, applyFixupThumbAdrUsesArchitecturalPC) {
+  // A Thumb instruction at address 2 mod 4 observes Align(PC + 4, 4), not
+  // Align(PC, 4).  The difference is visible for ADR.W and literal loads and
+  // previously made a detached Cortex-M TBB table point two bytes early.
+  uint8_t AdrMem[4];
+  constexpr HalfWords AdrR2Opcode{0xf20f, 0x0200};
+  write<endianness::little>(AdrMem, AdrR2Opcode);
+  Block &Site = createMutableBlock(AdrMem, 0x1002, ThumbAlignment);
+  Block &Target = createBlock(Zeros, 0x1042);
+  Symbol &TargetSymbol =
+      G->addAnonymousSymbol(Target, 0, SymbolSize, false, false);
+  // ELF/ARM REL encodes the architectural +4 PC bias as an implicit -4
+  // addend.  JITLink combines that addend with Align(P, 4), yielding the
+  // architectural Align(P + 4, 4) base for both halfword phases.
+  Edge E(Thumb_AluPrel11_0, 0, TargetSymbol, -4);
+
+  EXPECT_THAT_ERROR(applyFixup(*G, Site, E, Cfg), Succeeded());
+  Expected<int64_t> Addend =
+      readAddendThumb(*G, Site, 0, Thumb_AluPrel11_0, Cfg);
+  ASSERT_THAT_EXPECTED(Addend, Succeeded());
+  EXPECT_EQ(*Addend, 0x3e);
+}
+
+TEST_F(AArch32Errors, applyFixupThumbLiteralUsesArchitecturalPC) {
+  // R_ARM_THM_PC8 is shared by ADR T1 and LDR (literal) T1.  At the second
+  // halfword of a word, both must use Align(PC + 4, 4) and preserve the REL
+  // format's implicit -4 addend.
+  uint8_t LdrMem[2];
+  support::endian::write16le(LdrMem, 0x4800); // ldr r0, [pc, #0]
+  Block &Site = createMutableBlock(LdrMem, 0x1002, ThumbAlignment);
+  Block &Target = createBlock(Zeros, 0x1044);
+  Symbol &TargetSymbol =
+      G->addAnonymousSymbol(Target, 0, SymbolSize, false, false);
+  Edge E(Thumb_Pc8, 0, TargetSymbol, -4);
+
+  EXPECT_THAT_ERROR(applyFixup(*G, Site, E, Cfg), Succeeded());
+  EXPECT_EQ(support::endian::read16le(LdrMem), 0x4810);
+  Expected<int64_t> Addend = readAddendThumb(*G, Site, 0, Thumb_Pc8, Cfg);
+  ASSERT_THAT_EXPECTED(Addend, Succeeded());
+  EXPECT_EQ(*Addend, 0x40);
+}
