@@ -0,0 +1,52 @@
+## A Thumb-1 literal pool may follow a proven non-fallthrough terminator
+## without a separate skip branch. Firm-BOLT attaches the pool to the return,
+## keeps the exact access address under the default contract and emits the
+## typed bytes once.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='terminal_worker'); p=f['owned_literal_pools']; print(f['firmware_modified'],len(p),p[0]['owner_instruction_output_address'],p[0]['original_address'],p[0]['output_address'],len(p[0]['labels']),d['synthesized_inline_data_bytes'])" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objdump -d --start-address=0x08000008 --stop-address=0x08000010 %t.bolt | FileCheck %s --check-prefix=CODE
+
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 1 owner block(s), rebound 1 PC-relative reference(s), and retained 0 function(s)
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+# REPORT: True 1 134217738 134217740 134217740 1 4
+# CODE: <terminal_worker>:
+# CODE: ldr r0, [pc, #0x0]
+# CODE-NEXT: bx lr
+# CODE-NEXT: 800000c: {{.*}}.word 0x00000007
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl terminal_worker
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl terminal_worker
+  .type terminal_worker,%function
+  .thumb_func
+terminal_worker:
+  ldr r0, .Lliteral
+  bx lr
+.Lliteral:
+  .word 7
+  .size terminal_worker, .-terminal_worker
+
+  .section .isr_vector,"a",%progbits
