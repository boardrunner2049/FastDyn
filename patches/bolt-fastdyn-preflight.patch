index 0000000000000000000000000000000000000000..5b7bfe96f97ae94edc4615671318df3d67eeffe8
--- /dev/null
+++ b/bolt/test/ARM/thumb2-branch-shortening.s
@@ -0,0 +1,59 @@
+## The generic shortening pass used to return immediately on every non-x86
+## target even though the Cortex-M pass schedule advertised it.  Wide Thumb-2
+## direct branches can be narrowed without changing architectural effects;
+## final MC relaxation remains responsible for widening an out-of-range edge.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --eliminate-unreachable=false --frame-opt=none \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-objdump -d --start-address=0x08000008 --stop-address=0x08000018 %t.bolt | FileCheck %s --check-prefix=CODE
+# RUN: %python -c "import json; d=json.load(open('%t.report.json')); f=next(x for x in d['functions'] if x['name']=='shorten_worker'); print(f['firmware_modified'],f['firmware_modification_reasons'],f['firmware_publication_rejections'])" | FileCheck %s --check-prefix=REPORT
+
+# BOLT: BOLT-INFO: 2 instructions were shortened
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+# CODE: <shorten_worker>:
+# CODE: cmp r0, #0x0
+# CODE-NEXT: b{{eq|ne}}
+# CODE-NEXT: b
+# CODE-NOT: b{{eq|ne}}.w
+# REPORT: True ['instruction_shortening'] []
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl shorten_worker
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl shorten_worker
+  .type shorten_worker,%function
+  .thumb_func
+shorten_worker:
+  cmp r0, #0
+  bne.w .Lnonzero
+  b.w .Lzero
+.Lnonzero:
+  movs r0, #2
+  bx lr
+.Lzero:
