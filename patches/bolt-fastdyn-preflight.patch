+  MCInst MoveToPC = MCInstBuilder(ARM::tMOVr)
+                        .addReg(ARM::PC)
+                        .addReg(ARM::R4)
+                        .addImm(ARMCC::AL)
+                        .addReg(0);
+  EXPECT_TRUE(BC->MIB->isPossibleExceptionReturn(MoveToPC));
+
+  MCInst LoadToPC = MCInstBuilder(ARM::t2LDRi12)
+                        .addReg(ARM::PC)
+                        .addReg(ARM::SP)
+                        .addImm(0)
+                        .addImm(ARMCC::AL)
+                        .addReg(0);
+  EXPECT_TRUE(BC->MIB->isPossibleExceptionReturn(LoadToPC));
+  LoadToPC.getOperand(0).setReg(ARM::R0);
+  EXPECT_FALSE(BC->MIB->isPossibleExceptionReturn(LoadToPC));
+
+  MCInst OrdinaryMove = MCInstBuilder(ARM::tMOVr)
+                            .addReg(ARM::R0)
+                            .addReg(ARM::R4)
+                            .addImm(ARMCC::AL)
+                            .addReg(0);
+  EXPECT_FALSE(BC->MIB->isPossibleExceptionReturn(OrdinaryMove));
