+++ b/bolt/test/ARM/cortex-m-handler-fop.s
@@ -0,0 +1,202 @@
+## Exact vector entries may use the narrow exception-entry contract: ordinary
+## FOP replaces a stack reload with a same-width move while retaining the
+## stack store, instruction count/order, entry address and BX LR exception
+## return.  A handler touched by any additional pass retains its input body.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=all --eliminate-unreachable=false \
+# RUN:   --fastdyn-firmware-report=%t.json -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.json')); fs={x['name']:x for x in d['functions']}; a=fs['Reset_Handler']; b=fs['irq_handler']; c=fs['pop_handler']; d=fs['register_handler']; e=fs['load_handler']; s=fs['state_handler']; g=fs['unsupported_handler']; f=lambda x:[i for i in x['instructions'] if i['is_possible_exception_return']]; q=lambda x:[i['cortex_m_state_effect'] for i in x['instructions'] if i['cortex_m_state_effect'] != 'none']; print(a['cortex_m_vector_entry'],a['cortex_m_reset_entry'],a['cortex_m_exception_entry'],len(f(a))); print(b['cortex_m_vector_entry'],b['cortex_m_reset_entry'],b['cortex_m_exception_entry'],b['firmware_modified'],f(b)[0]['text'].strip(),f(b)[0]['original_address']); print(c['cortex_m_vector_entry'],c['cortex_m_reset_entry'],c['cortex_m_exception_entry'],c['firmware_modified'],f(c)[0]['text'].strip(),f(c)[0]['original_address']); print(d['cortex_m_vector_entry'],d['cortex_m_reset_entry'],d['cortex_m_exception_entry'],d['firmware_modified'],f(d)[0]['text'].strip(),f(d)[0]['original_address']); print(e['cortex_m_vector_entry'],e['cortex_m_reset_entry'],e['cortex_m_exception_entry'],e['firmware_modified'],f(e)[0]['text'].strip(),f(e)[0]['original_address']); print(s['cortex_m_vector_entry'],s['cortex_m_exception_entry'],s['firmware_modified'],','.join(q(s))); print(g['cortex_m_vector_entry'],g['firmware_modified'],','.join(g['firmware_modification_reasons']),','.join(g['firmware_publication_rejections']))" | FileCheck %s --check-prefix=REPORT
+# RUN: %python -c "import json; n={x['name']:x for x in json.load(open('%t.json'))['functions']}['state_input_handler']; print(n['cortex_m_vector_entry'],n['firmware_modified'],','.join(n['firmware_modification_reasons']),','.join(n['firmware_publication_rejections']))" | FileCheck %s --check-prefix=STATE-INPUT
+# RUN: %python -c "import json; n={x['name']:x for x in json.load(open('%t.json'))['functions']}['return_input_handler']; print(n['cortex_m_vector_entry'],n['firmware_modified'],','.join(n['firmware_modification_reasons']),','.join(n['firmware_publication_rejections']))" | FileCheck %s --check-prefix=RETURN-INPUT
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+
+# BOLT: primary-entry-handlers=9
+# BOLT-SAME: reset-entry-functions=1
+# BOLT-SAME: exception-entry-functions=8
+# BOLT: FOP optimized 6 redundant load(s)
+# BOLT: retained original handler unsupported_handler: transformation exceeds the exception-entry contract
+# BOLT: retained original handler state_input_handler: a forwarded value feeds architectural state
+# BOLT: retained original handler return_input_handler: a forwarded value feeds exception return
+# BOLT: BOLT: 3 out of 9 functions were overwritten.
+
+# REPORT: True True False 1
+# REPORT-NEXT: True False True True bx lr 134217740
+# REPORT-NEXT: True False True True pop {r4, pc} 134217772
+# REPORT-NEXT: True False True False bx r4 134217776
+# REPORT-NEXT: True False True False ldr.w pc, [sp] 134217778
+# REPORT-NEXT: True True True special_register,special_register,interrupt_mask,barrier,barrier,interrupt_mask
+# REPORT-NEXT: True False cfg_normalization,frame_load_forwarding exception_contract_unsupported
+
+# STATE-INPUT: True False frame_load_forwarding exception_state_input_changed
+# RETURN-INPUT: True False frame_load_forwarding exception_return_input_changed
+
+# DISASM: <irq_handler>:
