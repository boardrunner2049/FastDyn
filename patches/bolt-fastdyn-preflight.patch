@@ -0,0 +1,58 @@
+## Verify the complete ARM32 BOLT path, including final ELF symbol-table
+## reconstruction.  The MC intermediate object is insufficient evidence: a
+## previous non-relocation-mode bug emitted the reconstructed $d/$t markers at
+## address zero even though its literal bytes were linked correctly.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 --emit-relocs -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --frame-opt=none -o %t.bolt 2>&1 | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-readelf -s %t.bolt | FileCheck %s
+# RUN: llvm-objdump -d --start-address=0x08000000 --stop-address=0x08000018 \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+
+# CHECK-DAG: 08000010 0 NOTYPE LOCAL DEFAULT {{[0-9]+}} $d
+# CHECK-DAG: 08000014 0 NOTYPE LOCAL DEFAULT {{[0-9]+}} $t
+# CHECK-NOT: 00000000 0 NOTYPE LOCAL {{.*}} $d
+
+# DISASM: 08000008 <literal_worker>:
+# DISASM: ldr.w r0, [pc, #0x4]
+# DISASM: bx lr
+# DISASM: 8000010: {{.*}}.word 0x12345678
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl literal_worker
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl literal_worker
+  .type literal_worker,%function
+  .thumb_func
+literal_worker:
+  ldr r0, .Lliteral
+  bx lr
+  nop
+  .p2align 2
+.Lliteral:
+  .word 0x12345678
+  .size literal_worker, .-literal_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
