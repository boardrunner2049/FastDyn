+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl tail_dispatch
+  .type tail_dispatch,%function
+  .thumb_func
+tail_dispatch:
+  push {r4}
+  pop {r4}
+  bx r12
+# FDATA: 1 tail_dispatch 4 1 promoted_target 0 0 100
+  .rept 16
+  nop
+  .endr
+  .size tail_dispatch, .-tail_dispatch
+
+  .globl promoted_target
+  .type promoted_target,%function
+  .thumb_func
+promoted_target:
+  adds r0, #9
+  bx lr
+  .size promoted_target, .-promoted_target
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
