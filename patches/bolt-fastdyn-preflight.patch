+++ b/bolt/test/ARM/thumb1-native-indirect-call-promotion.s
@@ -0,0 +1,107 @@
+## Thumb-1 ordinary indirect-call promotion uses a separately admitted target
+## literal load.  One argument register is preserved in LR without memory,
+## restored before either call, and both compare outcomes branch around the
+## typed inline word.  Without the added-read contract the original remains.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: link_fdata %s %t.exe %t.fdata
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
+# RUN:   --icp-calls-topn=1 --icp-top-callsites=0 --assume-abi \
+# RUN:   --firmbolt-allow-indirect-call-promotion \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   -v=1 -o %t.no-literal 2>&1 | FileCheck %s --check-prefix=NO-LITERAL
+# RUN: llvm-objdump -d --mcpu=cortex-m0 --disassemble-symbols=indirect_caller \
+# RUN:   %t.no-literal | FileCheck %s --check-prefix=NO-LITERAL-DISASM
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
