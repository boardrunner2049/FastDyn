+TEST_P(MCPlusBuilderTester, ARM_StackOffsetExpressions) {
+  if (GetParam() != Triple::thumb)
+    GTEST_SKIP();
+
+  const std::pair<MCPhysReg, int64_t> SP{ARM::SP, 100};
+  const std::pair<MCPhysReg, int64_t> FP{ARM::R7, 200};
+  int64_t Output = 0;
+
+  // Thumb-1 encodes the immediate in words even though the assembly spelling
+  // and architectural stack adjustment are byte counts.
+  MCInst NarrowAdd = MCInstBuilder(ARM::tADDspi)
+                         .addReg(ARM::SP)
+                         .addReg(ARM::SP)
+                         .addImm(4)
+                         .addImm(ARMCC::AL)
+                         .addReg(0);
+  EXPECT_TRUE(BC->MIB->isStackAdjustment(NarrowAdd));
+  ASSERT_TRUE(BC->MIB->evaluateStackOffsetExpr(NarrowAdd, Output, SP, FP));
+  EXPECT_EQ(Output, 116);
+
+  MCInst WideSub = MCInstBuilder(ARM::t2SUBspImm)
+                       .addReg(ARM::SP)
+                       .addReg(ARM::SP)
+                       .addImm(1024)
+                       .addImm(ARMCC::AL)
+                       .addReg(0)
+                       .addReg(0);
+  EXPECT_TRUE(BC->MIB->isStackAdjustment(WideSub));
+  ASSERT_TRUE(BC->MIB->evaluateStackOffsetExpr(WideSub, Output, SP, FP));
+  EXPECT_EQ(Output, -924);
+
+  MCInst NarrowFP = MCInstBuilder(ARM::tADDrSPi)
+                        .addReg(ARM::R7)
+                        .addReg(ARM::SP)
+                        .addImm(4)
+                        .addImm(ARMCC::AL)
+                        .addReg(0);
+  EXPECT_FALSE(BC->MIB->isStackAdjustment(NarrowFP));
+  ASSERT_TRUE(BC->MIB->evaluateStackOffsetExpr(NarrowFP, Output, SP, FP));
+  EXPECT_EQ(Output, 116);
+  EXPECT_TRUE(BC->MIB->escapesVariable(NarrowFP, false));
+  EXPECT_FALSE(BC->MIB->escapesVariable(NarrowFP, true));
+
+  MCInst WideFP = MCInstBuilder(ARM::t2ADDri)
+                      .addReg(ARM::R7)
+                      .addReg(ARM::R7)
+                      .addImm(64)
+                      .addImm(ARMCC::AL)
+                      .addReg(0)
+                      .addReg(0);
+  ASSERT_TRUE(BC->MIB->evaluateStackOffsetExpr(WideFP, Output, SP, FP));
+  EXPECT_EQ(Output, 264);
+  EXPECT_FALSE(BC->MIB->escapesVariable(WideFP, true));
+
+  // AllocCombiner passes the signed architectural byte effect of the second
+  // adjustment to addToImm(), even when the original instruction uses a
+  // scaled Thumb-1 immediate.
+  int64_t Amount = -4;
+  ASSERT_TRUE(BC->MIB->addToImm(NarrowAdd, Amount, BC->Ctx.get()));
+  EXPECT_EQ(NarrowAdd.getOpcode(), ARM::tADDspi);
+  EXPECT_EQ(NarrowAdd.getOperand(2).getImm(), 3);
+  EXPECT_EQ(Amount, 12);
+
+  MCInst SignFlip = MCInstBuilder(ARM::tADDspi)
+                        .addReg(ARM::SP)
+                        .addReg(ARM::SP)
+                        .addImm(1)
+                        .addImm(ARMCC::AL)
+                        .addReg(0);
+  Amount = -8;
+  ASSERT_TRUE(BC->MIB->addToImm(SignFlip, Amount, BC->Ctx.get()));
+  EXPECT_EQ(SignFlip.getOpcode(), ARM::tSUBspi);
+  EXPECT_EQ(SignFlip.getOperand(2).getImm(), 1);
+  EXPECT_EQ(Amount, -4);
+
+  MCInst WideAdd = MCInstBuilder(ARM::t2ADDspImm)
+                       .addReg(ARM::SP)
+                       .addReg(ARM::SP)
+                       .addImm(1024)
+                       .addImm(ARMCC::AL)
+                       .addReg(0);
+  Amount = 100;
+  ASSERT_TRUE(BC->MIB->addToImm(WideAdd, Amount, BC->Ctx.get()));
+  EXPECT_EQ(WideAdd.getOpcode(), ARM::t2ADDspImm12);
+  EXPECT_EQ(WideAdd.getOperand(2).getImm(), 1124);
+  EXPECT_EQ(Amount, 1124);
+
+  MCInst Overflow = MCInstBuilder(ARM::t2ADDspImm12)
+                        .addReg(ARM::SP)
+                        .addReg(ARM::SP)
+                        .addImm(4095)
+                        .addImm(ARMCC::AL)
+                        .addReg(0);
+  Amount = 1;
+  EXPECT_FALSE(BC->MIB->addToImm(Overflow, Amount, BC->Ctx.get()));
+  EXPECT_EQ(Overflow.getOpcode(), ARM::t2ADDspImm12);
+  EXPECT_EQ(Overflow.getOperand(2).getImm(), 4095);
+  EXPECT_EQ(Amount, 1);
+}
