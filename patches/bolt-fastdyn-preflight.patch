index 0000000000000000000000000000000000000000..57585898f494697921de1440ee5cb7910e9ed53a
--- /dev/null
+++ b/bolt/test/ARM/thumb1-shared-literal-pool.s
@@ -0,0 +1,81 @@
+## A Thumb-1 value pool can be shared by multiple basic blocks.  Firm-BOLT
+## clones it only after existing unconditional skip branches, gives each load
+## a distinct final label and records the one-to-many original data identity.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --firmbolt-allow-literal-address-changes \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='shared_worker'); p=f['owned_literal_pools']; print(f['firmware_modified'],len(p),len({x['output_address'] for x in p}),len({x['original_address'] for x in p}),sum(len(x['labels']) for x in p),d['synthesized_inline_data_bytes'])" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objcopy --strip-symbol=__firmbolt_thumb_literal_capacity0 %t.exe %t.nocap.exe
+# RUN: llvm-bolt %t.nocap.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --firmbolt-allow-literal-address-changes -v=2 -o %t.nocap.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=NOCAP
+
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 2 owner block(s), rebound 2 PC-relative reference(s), and retained 0 function(s)
+# BOLT: BOLT-INFO: shared literal-pool cloning created 1 clone(s) and consumed 8 typed capacity byte(s)
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+# REPORT: True 2 2 1 2 8
+# NOCAP: retained literal pools in shared_worker: shared pool lacks typed clone capacity
+# NOCAP: Thumb literal-pool placement qualified 0 function(s), attached 0 owner block(s), rebound 0 PC-relative reference(s), and retained 1 function(s)
+# NOCAP: 0 out of 2 functions were overwritten.
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  bl shared_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl shared_worker
+  .type shared_worker,%function
+  .thumb_func
+shared_worker:
+  cmp r0, #0
+  beq .Lsecond
+.Lfirst:
+  ldr r1, .Lliteral
+  b .Lguard
+.Lsecond:
+  ldr r1, .Lliteral
+  b .Lguard
+.Lguard:
+  b .Lafter_pool
+  .p2align 2
+.Lliteral:
+  .word 7
+.Lafter_pool:
+  .rept 520
+  nop
+  .endr
+  b .Ljoin
+.Ljoin:
+  mov r0, r1
+  bx lr
+  .p2align 2
+  .globl __firmbolt_thumb_literal_capacity0
+  .type __firmbolt_thumb_literal_capacity0,%object
+__firmbolt_thumb_literal_capacity0:
+  .word 0
+  .word 0
+  .size __firmbolt_thumb_literal_capacity0, .-__firmbolt_thumb_literal_capacity0
+  .size shared_worker, .-shared_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-shared-relocation-pool-growth.s b/bolt/test/ARM/thumb1-shared-relocation-pool-growth.s
