+# RUN: %python -c "import json; d=json.load(open('%t.disabled.json')); print(d['summary']['firmware_modification_reason_counts']['loop_inversion'])" \
+# RUN:   | FileCheck %s --check-prefix=NO-CONTRACT
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata \
+# RUN:   --firmbolt-allow-loop-inversion \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --eliminate-unreachable=false --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
