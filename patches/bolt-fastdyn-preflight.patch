+//--- profile.fdata
+no_lbr
+1 split_worker 0 100
+1 split_worker 2 100
+1 split_worker 4 100
+1 split_worker 6 100
+1 split_worker 8 0
+1 split_worker a 0
diff --git a/bolt/test/ARM/thumb-gnu-zdebug-sections.test b/bolt/test/ARM/thumb-gnu-zdebug-sections.test
