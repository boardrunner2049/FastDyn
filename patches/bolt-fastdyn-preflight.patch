+  .globl flags_live_switch
+  .type flags_live_switch,%function
+  .thumb_func
+flags_live_switch:
+  cmp r0, #2
+  bhi .Ldefault
+LtmpFlagsDispatch:
+  tbb [pc, r0]
+# FDATA: 1 flags_live_switch 4 1 flags_live_switch c 0 90
+# FDATA: 1 flags_live_switch 4 1 flags_live_switch 12 5 5
+# FDATA: 1 flags_live_switch 4 1 flags_live_switch 18 5 5
+.Ltable:
+  .byte (LtmpFlagsCase0 - .Ltable) / 2
+  .byte (LtmpFlagsCase1 - .Ltable) / 2
+  .byte (LtmpFlagsCase2 - .Ltable) / 2
+  .byte 0
+LtmpFlagsCase0:
+  beq .Lequal
+  movs r0, #10
+  bx lr
+LtmpFlagsCase1:
+  beq .Lequal
+  movs r0, #20
+  bx lr
+LtmpFlagsCase2:
+  beq .Lequal
+  movs r0, #30
+  bx lr
+.Lequal:
+  movs r0, #99
+  bx lr
+.Ldefault:
+  movs r0, #0
+  bx lr
+  .size flags_live_switch, .-flags_live_switch
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
