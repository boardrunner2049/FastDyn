+## A Thumb-2 LDR.W literal uses the signed-magnitude imm12 relocation model,
+## but can share the same proven terminal-pool ownership and exact-address
+## publication contract as the Thumb-1 form.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='terminal_wide_worker'); s=next(x for x in d['functions'] if x['name']=='svc_fallthrough_worker'); p=f['owned_literal_pools']; print(f['firmware_modified'],len(p),p[0]['owner_instruction_output_address'],p[0]['original_address'],p[0]['output_address'],len(p[0]['labels']),d['synthesized_inline_data_bytes'],s['firmware_modified'],len(s['owned_literal_pools']))" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objdump -d --start-address=0x08000008 --stop-address=0x08000014 %t.bolt | FileCheck %s --check-prefix=CODE
+
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 1 owner block(s), rebound 1 PC-relative reference(s), and retained 1 function(s); skipped 1 unreferenced island function(s)
+# BOLT: BOLT: 2 out of 4 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+# REPORT: True 1 134217740 134217744 134217744 1 4 False 0
+# CODE: <terminal_wide_worker>:
+# CODE: ldr.w r0, [pc, #0x4]
+# CODE-NEXT: bx lr
+# CODE-NEXT: nop
+# CODE-NEXT: 8000010: {{.*}}.word 0x12345678
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl terminal_wide_worker
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl terminal_wide_worker
+  .type terminal_wide_worker,%function
+  .thumb_func
+terminal_wide_worker:
+  ldr.w r0, .Lwide_literal
+  bx lr
+  nop
+  .p2align 2
+.Lwide_literal:
+  .word 0x12345678
+  .size terminal_wide_worker, .-terminal_wide_worker
+
+  .globl svc_fallthrough_worker
+  .type svc_fallthrough_worker,%function
+  .thumb_func
+svc_fallthrough_worker:
+  ldr.w r1, .Lsvc_literal
+  svc #0
+  nop
+  .p2align 2
+.Lsvc_literal:
+  .word 0x89abcdef
+  .size svc_fallthrough_worker, .-svc_fallthrough_worker
+
+  # Conservative code/data island metadata without a data PC-relative user is
+  # neither an accepted transformation nor a semantic rejection.
+  .globl island_metadata_only
+  .type island_metadata_only,%function
+  .thumb_func
+island_metadata_only:
+  b.w terminal_wide_worker
+  .p2align 2
+.Lunreferenced_data:
+  .word 0xfeedface
+  .size island_metadata_only, .-island_metadata_only
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
