index 0000000000000000000000000000000000000000..7aa7a14af56b692b8c83a129d92d92ca2b8a11e2
--- /dev/null
+++ b/bolt/test/ARM/thumb1-native-indirect-call-method-load-elimination.s
@@ -0,0 +1,128 @@
+## Qualify BOLT's existing immutable-vtable load elimination for Thumb-1.
+## The hot guard compares the raw vtable data address loaded from typed inline
+## data and calls directly.  The cold path retains the exact original method
+## load and BLX.  The added flash read and method-read elision remain separate
+## explicit contracts.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: link_fdata %s %t.exe %t.fdata
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
+# RUN:   --icp-calls-topn=1 --icp-top-callsites=0 --assume-abi \
+# RUN:   --firmbolt-allow-indirect-call-promotion \
+# RUN:   --firmbolt-allow-method-load-elimination \
+# RUN:   --firmbolt-allow-thumb1-icp-literal-load \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --eliminate-unreachable=true --fastdyn-firmware-report=%t.json \
+# RUN:   -v=2 -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m0 --disassemble-symbols=virtual_caller \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=ELIM
+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='virtual_caller'); print(f['firmware_modification_reasons'],f['original_size'],f['output_size'],d['synthesized_call_promotion_instruction_count'],d['synthesized_inline_data_bytes']); print([(x['target_symbol'],hex(x['target_output_address'])) for x in f['synthesized_inline_data']])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
+# RUN:   --icp-calls-topn=1 --icp-top-callsites=0 --assume-abi \
+# RUN:   --firmbolt-allow-indirect-call-promotion \
+# RUN:   --firmbolt-allow-method-load-elimination \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --eliminate-unreachable=false -v=1 -o %t.no-read 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=NO-READ
+# RUN: llvm-objdump -d --mcpu=cortex-m0 --disassemble-symbols=virtual_caller \
+# RUN:   %t.no-read | FileCheck %s --check-prefix=RETAINED
+
+# LOG: ICP found virtual method call in virtual_caller
+# LOG: Cortex-M ICP generator inputs in virtual_caller:
+# LOG-SAME: vtables=1
+# LOG-SAME: fetch-insns=1
+# LOG: ICP succeeded in virtual_caller
+# LOG: ICP percentage of method calls candidates that have loads eliminated = 100.0%
+# ELIM: <virtual_caller>:
+# ELIM-NEXT: {{.*}}push {lr}
+# ELIM-NEXT: {{.*}}ldr r3, [r0]
+# ELIM-NEXT: {{.*}}mov lr, r2
+# ELIM-NEXT: {{.*}}ldr r2, [pc, #{{.*}}]
+# ELIM-NEXT: {{.*}}cmp r3, r2
+# ELIM-NEXT: {{.*}}mov r2, lr
+# ELIM-NEXT: {{.*}}bne
+# ELIM-NEXT: {{.*}}b
+# ELIM: bl 0x{{[0-9a-f]+}} <promoted_target>
+# ELIM: ldr r2, [r3]
+# ELIM-NEXT: {{.*}}blx r2
+# ELIM: pop {pc}
+# REPORT: {{.*}}indirect_call_promotion{{.*}}method_load_elimination{{.*}} 52 34 8 4
+# REPORT-NEXT: [('immutable_vtable', '0x8010050')]
+# NO-READ: ICP failed in virtual_caller
+# NO-READ-SAME: unable to generate promoted call code
+# RETAINED: <virtual_caller>:
+# RETAINED-NEXT: {{.*}}push {lr}
+# RETAINED-NEXT: {{.*}}ldr r3, [r0]
+# RETAINED-NEXT: {{.*}}ldr r2, [r3]
+# RETAINED-NEXT: {{.*}}blx r2
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  ldr r4, .Lram
+  ldr r3, .Lvtable
+  str r3, [r4]
+  mov r0, r4
+  bl virtual_caller
+  str r0, [r4, #4]
+1:
+  b 1b
+  .p2align 2
+.Lram:
+  .word 0x20000000
+.Lvtable:
+  .word immutable_vtable
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl virtual_caller
+  .type virtual_caller,%function
+  .thumb_func
+virtual_caller:
+  push {lr}
+  ldr r3, [r0]
+  ldr r2, [r3]
+  blx r2
+# FDATA: 1 virtual_caller 6 1 promoted_target 0 0 100
+# FDATA: 4 virtual_caller 4 4 immutable_vtable 0 100
+  b 1f
+  .rept 20
+  nop
+  .endr
+1:
+  pop {pc}
+  .size virtual_caller, .-virtual_caller
+
+  .globl promoted_target
+  .type promoted_target,%function
+  .thumb_func
+promoted_target:
+  movs r0, #17
+  bx lr
+  .size promoted_target, .-promoted_target
+
+  .section .rodata.vtable,"a",%progbits
+  .p2align 2
+  .globl immutable_vtable
+  .type immutable_vtable,%object
+immutable_vtable:
+  .word promoted_target
+  .size immutable_vtable, .-immutable_vtable
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-native-indirect-call-promotion.s b/bolt/test/ARM/thumb1-native-indirect-call-promotion.s
