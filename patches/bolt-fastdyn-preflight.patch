+  bl worker
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl worker
+  .type worker,%function
+  .thumb_func
+worker:
+  push {r7, lr}
+  sub sp, #4
+  add r7, sp, #0
+  str r0, [r7]
+  ldr r1, [r7]
+  mov sp, r7
