+# RUN:   --relocs --use-old-text --reorder-functions=user \
+# RUN:   --function-order=%t/order.txt \
+# RUN:   --fastdyn-firmware-report=%t/report.json -o %t/candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
