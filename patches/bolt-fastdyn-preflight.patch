+# RUN:   --firmbolt-allow-literal-address-changes \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=2 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='shared_adr_worker'); print(f['address_stable_layout'],f['firmware_modified'],len(f['owned_literal_pools']))" | FileCheck %s --check-prefix=REPORT
+
+# BOLT: BOLT-INFO: retained literal pools in shared_adr_worker: shared pool has an address-producing consumer
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 0 function(s), attached 0 owner block(s), rebound 0 PC-relative reference(s), and retained 1 function(s)
+# BOLT: BOLT: 0 out of 2 functions were overwritten.
+# REPORT: True False 0
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  bl shared_adr_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl shared_adr_worker
+  .type shared_adr_worker,%function
+  .thumb_func
+shared_adr_worker:
+  cmp r0, #0
