+  BitVector Scavengeable(BC->MRI->getNumRegs(), false);
+  BC->MIB->getGPRegs(Scavengeable, /*IncludeAlias=*/false);
+  BC->MIB->removeNonScavengeableRegs(Scavengeable);
+  EXPECT_TRUE(Scavengeable.test(ARM::R0));
+  EXPECT_TRUE(Scavengeable.test(ARM::R12));
+  EXPECT_FALSE(Scavengeable.test(ARM::R7));
+  EXPECT_FALSE(Scavengeable.test(ARM::R9));
+  EXPECT_FALSE(Scavengeable.test(ARM::R11));
+
+  MCInst CleanNarrow = MCInstBuilder(ARM::tEOR)
+                           .addReg(ARM::R0)
+                           .addReg(ARM::CPSR)
+                           .addReg(ARM::R1)
+                           .addReg(ARM::R1)
+                           .addImm(ARMCC::AL)
+                           .addReg(0);
+  EXPECT_TRUE(BC->MIB->isCleanReg(CleanNarrow));
+  CleanNarrow.getOperand(3).setReg(ARM::R2);
