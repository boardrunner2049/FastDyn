+TEST_F(AArch32Errors, applyFixupThumbNarrowAndConditionalBranches) {
+  ArmConfig ArmCfg;
+
+  // AAELF32's R_ARM_THM_JUMP6 REL addend wraps the unencodable -4 PC-bias
+  // compensation through the instruction's unsigned seven-bit field.
+  uint8_t Jump6AddendMem[2];
+  write16le(Jump6AddendMem, 0xbbf7); // cbnz r7 with raw imm = 124
+  Block &Jump6AddendSite =
+      createMutableBlock(Jump6AddendMem, 0x1000, ThumbAlignment);
+  Expected<int64_t> Jump6Addend = readAddendThumb(
+      *G, Jump6AddendSite, 0, Thumb_Jump6, ArmCfg);
+  ASSERT_THAT_EXPECTED(Jump6Addend, Succeeded());
+  EXPECT_EQ(*Jump6Addend, -4);
+
+  // CBZ/CBNZ can reach only aligned targets in [P+4, P+130].  Verify the
+  // boundary, opcode/register preservation, and rejection on both sides.
+  uint8_t Jump6Mem[6];
+  write16le(Jump6Mem, 0xb907);     // cbnz r7, immediate cleared
+  write16le(Jump6Mem + 2, 0xb107); // cbz r7, immediate cleared
+  write16le(Jump6Mem + 4, 0xb107);
+  Block &Jump6Site = createMutableBlock(Jump6Mem, 0, ThumbAlignment);
+  Symbol &Jump6Target = createSymbolWithDistance(Jump6Site, 130);
+  Jump6Target.setTargetFlags(TargetFlags_aarch32::ThumbSymbol);
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Jump6Site,
+                 Edge(Thumb_Jump6, 0, Jump6Target, -4), ArmCfg),
+      Succeeded());
+  EXPECT_EQ(read16le(Jump6Mem), 0xbbff);
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Jump6Site,
+                 Edge(Thumb_Jump6, 2, Jump6Target, -4), ArmCfg),
+      Succeeded());
+  EXPECT_EQ(read16le(Jump6Mem + 2), 0xb3f7);
+  Symbol &Jump6TooFar = createSymbolWithDistance(Jump6Site, 136);
+  Jump6TooFar.setTargetFlags(TargetFlags_aarch32::ThumbSymbol);
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Jump6Site,
+                 Edge(Thumb_Jump6, 4, Jump6TooFar, -4), ArmCfg),
+      FailedWithMessage(testing::HasSubstr("out of range")));
+
+  // Thumb-1 Bcc T1 has a signed 9-bit byte displacement. A branch two bytes
+  // closer to the same target is the last aligned positive value in range.
+  uint8_t Jump8Mem[4];
+  write16le(Jump8Mem, FixupInfo<Thumb_Jump8>::Opcode.Hi);
+  write16le(Jump8Mem + 2, FixupInfo<Thumb_Jump8>::Opcode.Hi);
+  Block &Jump8Site = createMutableBlock(Jump8Mem, 0);
+  Symbol &Jump8Target = createSymbolWithDistance(Jump8Site, 1ull << 8);
+  Jump8Target.setTargetFlags(TargetFlags_aarch32::ThumbSymbol);
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Jump8Site,
+                 Edge(Thumb_Jump8, 2, Jump8Target, 0), ArmCfg),
+      Succeeded());
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Jump8Site,
+                 Edge(Thumb_Jump8, 0, Jump8Target, 0), ArmCfg),
+      FailedWithMessage(testing::HasSubstr("out of range")));
+
+  // Thumb-1 B T2 has a signed 12-bit byte displacement.
+  uint8_t Jump11Mem[4];
+  write16le(Jump11Mem, FixupInfo<Thumb_Jump11>::Opcode.Hi);
+  write16le(Jump11Mem + 2, FixupInfo<Thumb_Jump11>::Opcode.Hi);
+  Block &Jump11Site = createMutableBlock(Jump11Mem, 0);
+  Symbol &Jump11Target = createSymbolWithDistance(Jump11Site, 1ull << 11);
+  Jump11Target.setTargetFlags(TargetFlags_aarch32::ThumbSymbol);
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Jump11Site,
+                 Edge(Thumb_Jump11, 2, Jump11Target, 0), ArmCfg),
+      Succeeded());
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Jump11Site,
+                 Edge(Thumb_Jump11, 0, Jump11Target, 0), ArmCfg),
+      FailedWithMessage(testing::HasSubstr("out of range")));
+
+  // Thumb-2 Bcc T3 has a signed 21-bit byte displacement.
+  uint8_t Jump19Mem[8];
+  write<endianness::little>(Jump19Mem,
+                            FixupInfo<Thumb_Jump19>::Opcode);
+  write<endianness::little>(Jump19Mem + 4,
+                            FixupInfo<Thumb_Jump19>::Opcode);
+  Block &Jump19Site = createMutableBlock(Jump19Mem, 0);
+  Symbol &Jump19Target = createSymbolWithDistance(Jump19Site, 1ull << 20);
+  Jump19Target.setTargetFlags(TargetFlags_aarch32::ThumbSymbol);
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Jump19Site,
+                 Edge(Thumb_Jump19, 4, Jump19Target, 0), ArmCfg),
+      Succeeded());
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Jump19Site,
+                 Edge(Thumb_Jump19, 0, Jump19Target, 0), ArmCfg),
+      FailedWithMessage(testing::HasSubstr("out of range")));
+}
