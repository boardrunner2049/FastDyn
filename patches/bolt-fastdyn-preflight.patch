+  bx lr
+  .size shorten_worker, .-shorten_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb2-clustered-call-veneer.s b/bolt/test/ARM/thumb2-clustered-call-veneer.s
new file mode 100644
index 0000000000000000000000000000000000000000..1d8253a29b5930cbe70acd42eda77a40eac765b1
--- /dev/null
+++ b/bolt/test/ARM/thumb2-clustered-call-veneer.s
@@ -0,0 +1,106 @@
+## Force Thumb-2 clustered relaxation to replace an inter-function BL target
+## with an absolute call veneer.  The test uses a deliberately tiny cluster
+## size; production defaults derive from the architectural 16 MiB B.W/BL
+## reach.  The final veneer must materialize a Thumb address in r12 and branch
+## through it without changing the caller's call/return behavior.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=none --relax-exp --max-cluster-size=64 \
+# RUN:   --max-thunk-chain-length=0 \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=none --relax-exp --max-cluster-size=64 \
+# RUN:   --max-thunk-chain-length=0 --fastdyn-firmware-report=%t.keep.json \
+# RUN:   -o %t.keep.bolt 2>&1 | FileCheck %s --check-prefix=CONSERVATIVE
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.keep.bolt \
+# RUN:   | FileCheck %s --check-prefix=KEPT
+# RUN: %python -c "import json; d=json.load(open('%t.json')); f=next(x for x in d['functions'] if x['name']=='caller'); src=next(x['original_address'] for x in f['instructions'] if x['is_call'] and x['original_address'] is not None); v=[x for x in f['instructions'] if x['provenance_kind']=='synthesized_call_veneer']; print('POST',len(v),d['summary']['synthesized_call_veneer_instruction_count'],len([x for x in f['instructions'] if x['provenance_kind']=='unmapped']),all(x['source_original_address']==src for x in v),all(x['source_block_original_address'] is None for x in v))" | FileCheck %s --check-prefix=POST-ORIGIN
+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='caller'); v=[x for x in f['instruction_origins'] if x['origin_kind']=='synthesized_call_veneer']; a=[x['output_address'] for x in v]; z=[x['output_size'] for x in v]; print('FINAL',d['synthesized_call_veneer_instruction_count'],len(v),z,a[1]==a[0]+z[0],a[2]==a[1]+z[1],len(set(x['source_original_address'] for x in v))==1)" | FileCheck %s --check-prefix=FINAL-ORIGIN
+
+# BOLT: relaxing Thumb-2 inter-function branches with clustered veneers (cluster size 64 bytes)
+# BOLT: long thunks created
+# BOLT: 1 out of 4 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+
+# CONSERVATIVE: retained original caller: guest instruction count changed
+# CONSERVATIVE: 0 out of 4 functions were overwritten.
+# CONSERVATIVE: BOLT-INFO: not adding new segments
+
+# DISASM: <caller>:
+# DISASM: bl {{.*}} <caller+0x{{[0-9a-f]+}}>
+# DISASM: pop {pc}
+# DISASM-NEXT: movw r12, #0x7f
+# DISASM-NEXT: movt r12, #{{[0-9]+}}
+# DISASM-NEXT: bx r12
+
+# KEPT: <caller>:
+# KEPT: bl {{.*}} <target>
+# KEPT-NOT: movw r12
+
+# POST-ORIGIN: POST 3 3 0 True True
+# FINAL-ORIGIN: FINAL 3 3 [4, 4, 2] True True True
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl caller
+  .type caller,%function
+  .thumb_func
+caller:
+  b .Lcaller_live
+  ## Typed, unreachable code inside the function gives the ordinary UCE pass
+  ## enough compact-emission budget for the veneer.
+  .rept 8
+  nop
+  .endr
+.Lcaller_live:
+  push {lr}
+  bl target
+  pop {pc}
+  .size caller, .-caller
+
+  .globl filler
+  .type filler,%function
+  .thumb_func
+filler:
+  .rept 48
+  adds r4, #1
+  .endr
+  bx lr
+  .size filler, .-filler
+
+  .globl target
+  .type target,%function
+  .thumb_func
+target:
+  adds r0, #1
+  bx lr
+  .size target, .-target
+
+  ## Leave qualified executable slack in the input text range for the 10-byte
+  ## veneer.  Firmware mode still forbids creating a new PT_LOAD segment.
+  .p2align 8
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb2-frame-byte-half-forwarding.s b/bolt/test/ARM/thumb2-frame-byte-half-forwarding.s
new file mode 100644
index 0000000000000000000000000000000000000000..e121ff35140f3ddc5f729923254d42af05dfe89b
--- /dev/null
+++ b/bolt/test/ARM/thumb2-frame-byte-half-forwarding.s
@@ -0,0 +1,101 @@
+## Ordinary FOP may forward byte and halfword stack reloads only if the
+## replacement preserves the load's truncation/sign-extension semantics.
+## Thumb-2 UXTB/SXTB/UXTH/SXTH are the same width as the original loads and do
+## not update APSR, so the strict firmware instruction-count/flag contract is
+## retained.  The observable stack stores remain in place.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e byte_half_worker \
+# RUN:   %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=all --eliminate-unreachable=false \
+# RUN:   --fastdyn-firmware-report=%t.json -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); f=next(x for x in d['functions'] if x['name']=='byte_half_worker'); print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),f['post_optimization_instruction_count'])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# BOLT: BOLT-INFO: FOP optimized 6 redundant load(s)
+# BOLT: BOLT: 3 out of 3 functions were overwritten.
+
+# DISASM: <byte_half_worker>:
+# DISASM: strb.w r0, [sp]
+# DISASM-NEXT: uxtb.w r1, r0
+# DISASM: strb.w r2, [sp, #0x1]
+# DISASM-NEXT: sxtb.w r3, r2
+# DISASM: strh.w r4, [sp, #0x2]
+# DISASM-NEXT: uxth.w r5, r4
+# DISASM: strh.w r6, [sp, #0x4]
+# DISASM-NEXT: sxth.w r8, r6
+# DISASM: <narrow_worker>:
+# DISASM: strb r0, [r7]
+# DISASM-NEXT: uxtb r1, r0
+# DISASM: strb.w r8, [r7, #0x1]
+## A narrow UXTB cannot name r8.  The backend must retain the reload instead
+## of producing an unencodable or width-changing replacement.
+# DISASM-NEXT: ldrb r2, [r7, #0x1]
+# DISASM: <wide_frame_worker>:
+# DISASM: sub.w sp, sp, #0x400
+# DISASM-NEXT: str r0, [sp]
+# DISASM-NEXT: mov r1, r0
+# DISASM-NEXT: add.w sp, sp, #0x400
+
+# REPORT: True frame_load_forwarding 11
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl byte_half_worker
+  .type byte_half_worker,%function
+  .thumb_func
+byte_half_worker:
+  sub sp, #8
+  strb.w r0, [sp, #0]
+  ldrb.w r1, [sp, #0]
+  strb.w r2, [sp, #1]
+  ldrsb.w r3, [sp, #1]
+  strh.w r4, [sp, #2]
+  ldrh.w r5, [sp, #2]
+  strh.w r6, [sp, #4]
+  ldrsh.w r8, [sp, #4]
+  add sp, #8
+  bx lr
+  .size byte_half_worker, .-byte_half_worker
+
+  .globl narrow_worker
+  .type narrow_worker,%function
+  .thumb_func
+narrow_worker:
+  sub sp, #4
+  mov r7, sp
+  strb r0, [r7, #0]
+  ldrb r1, [r7, #0]
+  strb.w r8, [r7, #1]
+  ldrb r2, [r7, #1]
+  mov sp, r7
+  add sp, #4
+  bx lr
+  .size narrow_worker, .-narrow_worker
+
+  .globl wide_frame_worker
+  .type wide_frame_worker,%function
+  .thumb_func
+wide_frame_worker:
+  sub.w sp, sp, #1024
+  str r0, [sp]
+  ldr r1, [sp]
+  add.w sp, sp, #1024
+  bx lr
+  .size wide_frame_worker, .-wide_frame_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word byte_half_worker
