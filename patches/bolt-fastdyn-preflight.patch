+++ b/bolt/test/ARM/thumb2-pcrel-mov-pair-addend-reorder.s
@@ -0,0 +1,111 @@
+## Move a Thumb-2 function containing a split PC-relative MOVW/MOVT pair
+## whose implicit SHT_REL addend is non-zero. The two fields have different P
+## values, so the complete addend must be reconstructed from the pair.
+
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple=thumbv7m-none-eabi -mcpu=cortex-m3 %t/fixture.s -o %t.o
+# RUN: ld.lld --emit-relocs -T %t/link.ld %t.o -o %t.exe
