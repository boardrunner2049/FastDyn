+Error RewriteInstance::validateARMStaticRelocations() {
+  const RelocationHandler &RH = BC->getRelocationHandler();
+
+  for (const SectionRef &RelocationSection : InputFile->sections()) {
+    Expected<section_iterator> RelocatedSectionOrErr =
+        RelocationSection.getRelocatedSection();
+    if (!RelocatedSectionOrErr)
+      return RelocatedSectionOrErr.takeError();
+    if (*RelocatedSectionOrErr == InputFile->section_end())
+      continue;
+
+    const SectionRef RelocatedSection = **RelocatedSectionOrErr;
+    if (!BinarySection(*BC, RelocatedSection).isAllocatable())
+      continue;
+
+    const StringRef RelocationSectionName =
+        cantFail(RelocationSection.getName());
+    const StringRef RelocatedSectionName =
+        cantFail(RelocatedSection.getName());
+    for (const RelocationRef &Rel : RelocationSection.relocations()) {
+      const uint32_t Type = Relocation::getType(Rel);
+      if (RH.skipRelocationType(Type))
+        continue;
+      SmallString<32> TypeName;
+      Rel.getTypeName(TypeName);
+      const bool IsARMGOTFamily =
+          Type == ELF::R_ARM_BASE_PREL ||
+          Type == ELF::R_ARM_GOT_BREL ||
+          Type == ELF::R_ARM_GOT_PREL ||
+          Type == ELF::R_ARM_GOTOFF32;
+      if (IsARMGOTFamily && !RH.isSupported(Type))
+        return createStringError(
+            errc::not_supported,
+            "%s at 0x%" PRIx64 " in %s (from %s) requires an "
+            "exact retained firmware GOT graph; qualify it with "
+            "--firmbolt-arm-got=fixed-static",
+            TypeName.c_str(), Rel.getOffset(),
+            RelocatedSectionName.str().c_str(),
+            RelocationSectionName.str().c_str());
+      if (Type == ELF::R_ARM_TARGET2 && !RH.isSupported(Type))
+        return createStringError(
+            errc::not_supported,
+            "R_ARM_TARGET2 at 0x%" PRIx64 " in %s (from %s) is "
+            "platform-defined; qualify the bare-metal link policy with "
+            "--firmbolt-arm-target2=abs, --firmbolt-arm-target2=rel, or "
+            "--firmbolt-arm-target2=got-rel together with "
+            "--firmbolt-arm-got=fixed-static",
+            Rel.getOffset(), RelocatedSectionName.str().c_str(),
+            RelocationSectionName.str().c_str());
+      if (Type == ELF::R_ARM_TARGET1 && !RH.isSupported(Type))
+        return createStringError(
+            errc::not_supported,
+            "R_ARM_TARGET1 at 0x%" PRIx64 " in %s (from %s) is "
+            "platform-defined; qualify its absolute meaning with "
+            "--firmbolt-arm-target1=abs",
+            Rel.getOffset(), RelocatedSectionName.str().c_str(),
+            RelocationSectionName.str().c_str());
+
+      if (Type == ELF::R_ARM_TARGET1) {
+        const uint64_t SiteOffset =
+            Rel.getOffset() - RelocatedSection.getAddress();
+        Expected<StringRef> ContentsOrErr = RelocatedSection.getContents();
+        if (!ContentsOrErr)
+          return ContentsOrErr.takeError();
+        if (Rel.getOffset() < RelocatedSection.getAddress() ||
+            SiteOffset > ContentsOrErr->size() ||
+            ContentsOrErr->size() - SiteOffset < sizeof(uint32_t))
+          return createStringError(
+              errc::executable_format_error,
+              "R_ARM_TARGET1 at 0x%" PRIx64
+              " does not name one complete word in %s",
+              Rel.getOffset(), RelocatedSectionName.str().c_str());
+
+        symbol_iterator Symbol = Rel.getSymbol();
+        if (Symbol == InputFile->symbol_end())
+          return createStringError(
+              errc::not_supported,
+              "R_ARM_TARGET1 at 0x%" PRIx64
+              " has no symbolic identity for absolute-policy validation",
+              Rel.getOffset());
+        uint32_t SymbolValue = uint32_t(cantFail(Symbol->getAddress()));
+        if (cantFail(Symbol->getType()) == SymbolRef::ST_Function)
+          SymbolValue |= 1;
+        const uint32_t EncodedValue = support::endian::read32le(
+            ContentsOrErr->data() + SiteOffset);
+        if (EncodedValue != SymbolValue) {
+          const uint32_t RelativeTarget =
+              uint32_t(Rel.getOffset()) + EncodedValue;
+          if (RelativeTarget == SymbolValue)
+            return createStringError(
+                errc::not_supported,
+                "R_ARM_TARGET1 at 0x%" PRIx64
+                " has PC-relative contents but --firmbolt-arm-target1=abs "
+                "declares absolute semantics",
+                Rel.getOffset());
+          return createStringError(
+              errc::not_supported,
+              "R_ARM_TARGET1 at 0x%" PRIx64
+              " has an ambiguous or non-zero addend; the qualified absolute "
+              "path currently requires an exact symbolic pointer",
+              Rel.getOffset());
+        }
+        continue;
+      }
+
+      if (RH.isSupported(Type))
+        continue;
+
+      return createStringError(
+          errc::not_supported,
+          "unsupported ARM relocation %s at 0x%" PRIx64
+          " in allocatable section %s (from %s)",
+          TypeName.c_str(), Rel.getOffset(),
+          RelocatedSectionName.str().c_str(),
+          RelocationSectionName.str().c_str());
+    }
+  }
+
+  return Error::success();
+}
+
 void RewriteInstance::adjustCommandLineOptions() {
   if (BC->isAArch64() && !BC->HasRelocations)
     BC->errs() << "BOLT-WARNING: non-relocation mode for AArch64 is not fully "
                   "supported\n";
 
+  // Generic BOLT relocation mode allocates a fresh executable segment after
+  // the final PT_LOAD.  On a Cortex-M image that address is commonly after
+  // SRAM and is not executable flash.  Reuse the original, linker-qualified
+  // .text extent until a firmware memory-map service supplies another typed
+  // RX allocation range.  This still enables whole-image function ordering,
+  // splitting and relocation repair; it merely constrains their placement.
+  if (BC->isARM() && BC->HasRelocations && !opts::UseOldText) {
+    BC->errs() << "BOLT-ERROR: Cortex-M relocation mode currently requires "
+                  "--use-old-text so all emitted code remains inside the "
+                  "qualified input flash range\n";
+    exit(1);
+  }
+
   // RV32 support is currently limited to statically linked, non-PIE
