+# RUN:   -o %t.vectors.bolt 2>&1 | FileCheck %s --check-prefix=VECTORS
+# RUN: llvm-objcopy --rename-section=.isr_vector=rom_start \
+# RUN:   --redefine-sym g_pfnVectors=_vector_table %t.exe %t.zephyr.exe
