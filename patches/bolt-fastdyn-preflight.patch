index 0000000000000000000000000000000000000000..fac641cdcf034b5cfc9a0e91ad33935ccd998ab0
--- /dev/null
+++ b/bolt/test/ARM/thumb1-nonfallthrough-branch-literal-pool.s
@@ -0,0 +1,62 @@
+## A literal pool may follow an unconditional branch whose target is not the
+## code after the pool. The direct branch still proves that the data is not on
+## a fallthrough path; ownership must not depend on the target being a
+## conventional forward resume label.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='branch_owned_worker'); p=f['owned_literal_pools']; print(f['firmware_modified'],len(p),p[0]['original_address'],p[0]['output_address'],d['synthesized_inline_data_bytes'])" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objdump -d --start-address=0x08000008 --stop-address=0x08000018 %t.bolt | FileCheck %s --check-prefix=CODE
+
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 1 owner block(s), rebound 1 PC-relative reference(s), and retained 0 function(s)
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+# REPORT: True 1 134217748 134217748 4
+# CODE: <branch_owned_worker>:
+# CODE: cmp r0, #0x0
+# CODE: beq
+# CODE: mov r0, r1
+# CODE: bx lr
+# CODE: ldr r1, [pc, #0x0]
+# CODE: 8000012: {{.*}} b 0x800000c
+# CODE-NEXT: 8000014: {{.*}}.word 0x00000007
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  bl branch_owned_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl branch_owned_worker
+  .type branch_owned_worker,%function
+  .thumb_func
+branch_owned_worker:
+  cmp r0, #0
+  beq .Lowner
+.Lresume:
+  mov r0, r1
+  bx lr
+.Lowner:
+  ldr r1, .Lliteral
+  b .Lresume
+.Lliteral:
+  .word 7
+  .size branch_owned_worker, .-branch_owned_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-reserved-call-veneer-slot.s b/bolt/test/ARM/thumb1-reserved-call-veneer-slot.s
