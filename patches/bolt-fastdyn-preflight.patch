+struct ARMFixedGOTGraph {
+  uint64_t BaseAddress{0};
+  StringRef Contents;
+  endianness Endian{endianness::little};
+};
+
+/// Resolve the one complete GOT range admitted by the fixed-static firmware
+/// policy.  This is deliberately stricter than recognizing a section name:
+/// the image must have fixed load addresses, the complete table must be
+/// file-backed in a non-executable segment, and no slot may be owned by the
+/// dynamic loader.
+static Expected<ARMFixedGOTGraph>
+resolveARMFixedGOTGraph(const ELFObjectFileBase &Obj, BinaryContext &BC,
+                        StringRef RelocationName) {
+  if (!BC.IsStaticExecutable || !BC.HasFixedLoadAddress || BC.HasInterpHeader)
+    return createStringError(
+        errc::not_supported,
+        "%s requires a static fixed-load image without "
+        "an interpreter",
+        RelocationName.str().c_str());
+
+  std::optional<ARMFixedGOTGraph> Graph;
+  for (const SectionRef &Section : Obj.sections()) {
+    if (cantFail(Section.getName()) != ".got")
+      continue;
+    if (Graph)
+      return createStringError(
+          errc::not_supported,
+          "%s has multiple .got sections without one declared firmware "
+          "origin",
+          RelocationName.str().c_str());
+    BinarySection BSection(BC, Section);
+    if (!BSection.isAllocatable() || BSection.isText())
+      return createStringError(
+          errc::not_supported,
+          "%s has a .got section without fixed "
+          "allocatable non-executable storage",
+          RelocationName.str().c_str());
+    Expected<StringRef> ContentsOrErr = Section.getContents();
+    if (!ContentsOrErr)
+      return ContentsOrErr.takeError();
+    if (ContentsOrErr->size() != Section.getSize() ||
+        ContentsOrErr->size() % sizeof(uint32_t))
+      return createStringError(
+          errc::executable_format_error,
+          "%s has a non-file-backed or malformed .got",
+          RelocationName.str().c_str());
+
+    const uint64_t BaseAddress = Section.getAddress();
+    auto SegmentIt = BC.SegmentMapInfo.upper_bound(BaseAddress);
+    if (SegmentIt == BC.SegmentMapInfo.begin())
+      return createStringError(errc::not_supported,
+                               "%s .got has no fixed input PT_LOAD",
+                               RelocationName.str().c_str());
+    --SegmentIt;
+    const SegmentInfo &Segment = SegmentIt->second;
+    if (Segment.IsExecutable || BaseAddress < Segment.Address ||
+        Section.getSize() > Segment.FileSize ||
+        BaseAddress - Segment.Address >
+            Segment.FileSize - Section.getSize())
+      return createStringError(
+          errc::not_supported,
+          "%s .got is not completely file-backed by one non-executable "
+          "input PT_LOAD",
+          RelocationName.str().c_str());
+    for (uint64_t Offset = 0; Offset < ContentsOrErr->size();
+         Offset += sizeof(uint32_t))
+      if (BC.getDynamicRelocationAt(BaseAddress + Offset))
+        return createStringError(
+            errc::not_supported,
+            "%s uses a dynamic-loader GOT slot at 0x%" PRIx64,
+            RelocationName.str().c_str(), BaseAddress + Offset);
+
+    Graph = ARMFixedGOTGraph{
+        BaseAddress, *ContentsOrErr,
+        Obj.isLittleEndian() ? endianness::little : endianness::big};
+  }
+
+  if (!Graph)
+    return createStringError(errc::not_supported,
+                             "%s has no exact retained .got section",
+                             RelocationName.str().c_str());
+  return *Graph;
+}
+
+/// Resolve one existing firmware GOT entry. This is not a heuristic GOT
+/// reconstruction: the linked word must be the exact ELF target identity and
+/// the match must be unique across the already-qualified complete table.
+static Expected<ARMFixedGOTEntry>
+resolveARMFixedGOTEntry(const ELFObjectFileBase &Obj, BinaryContext &BC,
+                        StringRef RelocationName, StringRef TargetName,
+                        uint64_t TargetAddress) {
+  Expected<ARMFixedGOTGraph> Graph =
+      resolveARMFixedGOTGraph(Obj, BC, RelocationName);
+  if (!Graph)
+    return Graph.takeError();
+
+  std::optional<uint64_t> Match;
+  for (uint64_t Offset = 0; Offset < Graph->Contents.size();
+         Offset += sizeof(uint32_t)) {
+      if (support::endian::read32(Graph->Contents.data() + Offset,
+                                  Graph->Endian) !=
+          uint32_t(TargetAddress))
+        continue;
+      const uint64_t SlotAddress = Graph->BaseAddress + Offset;
+      if (Match && *Match != SlotAddress)
+        return createStringError(
+            errc::not_supported,
+            "%s target %s has multiple exact retained GOT slots",
+            RelocationName.str().c_str(), TargetName.str().c_str());
+      Match = SlotAddress;
+  }
+
+  if (!Match)
+    return createStringError(
+        errc::not_supported,
+        "%s target %s has no unique exact retained .got slot",
+        RelocationName.str().c_str(), TargetName.str().c_str());
+  return ARMFixedGOTEntry{*Match, TargetAddress, Graph->BaseAddress};
+}
