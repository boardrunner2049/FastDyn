+++ b/bolt/test/ARM/cortex-m-instruction-features.s
@@ -0,0 +1,61 @@
+## A generic CPU name and architecture-compatible ELF attributes must not
+## authorize instructions absent from the selected execution CPU.  The body
+## contains FPv5 double-precision arithmetic available on the selected M7 but
+## not on M4, even though both CPUs advertise ARMv7E-M.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7em-none-eabi -mcpu=cortex-m7 \
+# RUN:   -mattr=+fp-armv8d16 %s -o %t.o
