diff --git a/bolt/test/ARM/thumb-stack-allocation-combiner.s b/bolt/test/ARM/thumb-stack-allocation-combiner.s
new file mode 100644
index 0000000000000000000000000000000000000000..f421258e6cc7a7b87074b8e45d0d251972fb6296
--- /dev/null
+++ b/bolt/test/ARM/thumb-stack-allocation-combiner.s
@@ -0,0 +1,82 @@
+## The firmware instruction-count contract keeps guest stack adjustments
+## distinct.  If that contract is explicitly relaxed, AllocCombiner may merge
+## adjustments using architectural byte magnitudes.  An unencodable sum must
+## retain both instructions rather than silently erasing one.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e combine_worker \
+# RUN:   %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=all --eliminate-unreachable=false -o %t.strict 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=STRICT-LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.strict \
+# RUN:   | FileCheck %s --check-prefix=STRICT
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=all --eliminate-unreachable=false \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false -o %t.loose 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=LOOSE-LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.loose \
+# RUN:   | FileCheck %s --check-prefix=LOOSE
+
+# STRICT-LOG: Allocation combiner: 0 empty spaces coalesced
+# STRICT: <combine_worker>:
+# STRICT: sub sp, #0x10
+# STRICT: nop
+# STRICT-NEXT: sub sp, #0x4
+
+# LOOSE-LOG: Allocation combiner: 1 empty spaces coalesced
+# LOOSE: <combine_worker>:
+# LOOSE: sub sp, #0x14
+# LOOSE-NEXT: nop
+# LOOSE-NOT: sub sp, #0x4
+# LOOSE: <overflow_worker>:
+# LOOSE: subw sp, sp, #0xffc
+# LOOSE-NEXT: sub sp, #0x4
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl reset_entry
+  .type reset_entry,%function
+  .thumb_func
+reset_entry:
+  bl combine_worker
+  bl overflow_worker
+1:
+  b 1b
+  .size reset_entry, .-reset_entry
+
+  .globl combine_worker
+  .type combine_worker,%function
+  .thumb_func
+combine_worker:
+  sub sp, #16
+  nop
+  sub sp, #4
+  str r0, [sp]
+  add sp, #20
+  bx lr
+  .size combine_worker, .-combine_worker
+
+  .globl overflow_worker
+  .type overflow_worker,%function
+  .thumb_func
+overflow_worker:
+  subw sp, sp, #4092
+  sub sp, #4
+  mov r0, sp
+  addw sp, sp, #4092
+  add sp, #4
+  bx lr
+  .size overflow_worker, .-overflow_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20002000
+  .word reset_entry
diff --git a/bolt/test/ARM/thumb1-absolute-jump-table.s b/bolt/test/ARM/thumb1-absolute-jump-table.s
new file mode 100644
index 0000000000000000000000000000000000000000..d32134d6717304b69307aec31934bfe77f6df628
--- /dev/null
+++ b/bolt/test/ARM/thumb1-absolute-jump-table.s
@@ -0,0 +1,81 @@
+## Thumb-1 has no TBB/TBH.  GCC/Clang lower bounded switches through a literal
+## pointer to an embedded ABS32 table, then install the selected word in PC.
+## Verify that a stripped firmware ELF (no --emit-relocs) is reconstructed as
+## typed control flow and that synthesized ABS32 references survive final ELF
+## emission.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --frame-opt=none -v=1 -o %t.bolt 2>&1 | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-objdump -d --start-address=0x08000000 --stop-address=0x08000040 \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+
+# BOLT: BOLT-INFO: recovered Thumb ABS32 jump table in switch_worker
+# BOLT-SAME: with 3 entries
+# BOLT: BOLT: 0 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+
+# DISASM: <switch_worker>:
+# DISASM: cmp r0, #0x2
+# DISASM: lsls r1, r0, #0x2
+# DISASM: ldr r2, [pc,
+# DISASM: adds r2, r1, r2
+# DISASM: ldr r2, [r2]
+# DISASM: mov pc, r2
+# DISASM: movs r0, #0xa
+# DISASM: movs r0, #0x14
+# DISASM: movs r0, #0x1e
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl switch_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .p2align 2
+  .globl switch_worker
+  .type switch_worker,%function
+  .thumb_func
+switch_worker:
+  cmp r0, #2
+  bls .Ldispatch
+  movs r0, #0
+  bx lr
+.Ldispatch:
+  lsls r1, r0, #2
+  ldr r2, .Ltable_pointer
+  adds r2, r1, r2
+  ldr r2, [r2]
+  mov pc, r2
+.Lcase0:
+  movs r0, #10
+  bx lr
+.Lcase1:
+  movs r0, #20
+  bx lr
+.Lcase2:
+  movs r0, #30
+  bx lr
+  .p2align 2
+.Ltable_pointer:
+  .word .Ltable
+.Ltable:
+  .word .Lcase0
+  .word .Lcase1
+  .word .Lcase2
+  .size switch_worker, .-switch_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-address-stable-literal-pools.s b/bolt/test/ARM/thumb1-address-stable-literal-pools.s
new file mode 100644
index 0000000000000000000000000000000000000000..59ba9193db11ff61375d557755d6658f0ae5c01d
--- /dev/null
+++ b/bolt/test/ARM/thumb1-address-stable-literal-pools.s
@@ -0,0 +1,104 @@
+## A production Thumb-1 binary can be much larger than one literal-load reach
+## window and contain several interleaved pools.  Verify that BOLT keeps the
+## exact code/data geometry, still applies a same-width FOP rewrite, emits every
+## $d/$t transition, and does not append a duplicate aggregate island.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --frame-opt=all --fastdyn-firmware-report=%t.report.json \
+# RUN:   -v=1 -o %t.bolt 2>&1 | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json')); fs={f['name']:f for f in d['functions']}; f=fs['large_worker']; pools=[p for i in f['instructions'] for p in i.get('owned_literal_pool_ranges',[])]; print('large_worker',f['firmware_modified'],f['address_stable_layout'],','.join(f['firmware_modification_reasons']),len(pools),','.join(str(p['estimated_output_offset'])+':'+str(p['size']) for p in pools)); print('Reset_Handler',fs['Reset_Handler']['firmware_modified']); print('forwarded',d['summary']['firmware_modification_reason_counts']['frame_load_forwarding'],'placed',d['summary']['firmware_modification_reason_counts']['literal_pool_placement'])" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-readelf -s %t.exe > %t.input.syms
+# RUN: llvm-readelf -s %t.bolt > %t.output.syms
+# RUN: FileCheck %s --check-prefix=MARKERS < %t.output.syms
+# RUN: llvm-objdump -d --start-address=0x08000008 --stop-address=0x08000028 \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=HEAD
+# RUN: llvm-objdump -d --start-address=0x0800042c --stop-address=0x08000444 \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=TAIL
+
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 2 owner block(s), rebound 2 PC-relative reference(s), and retained 0 function(s)
+# BOLT: BOLT-INFO: FOP optimized 2 redundant load(s)
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+
+# REPORT: large_worker True False cfg_normalization,frame_load_forwarding,literal_pool_placement 2 20:4,1072:4
+# REPORT-NEXT: Reset_Handler False
+# REPORT-NEXT: forwarded 1 placed 1
+
+# MARKERS-DAG: 0800001c 0 NOTYPE LOCAL DEFAULT {{[0-9]+}} $d
+# MARKERS-DAG: 08000020 0 NOTYPE LOCAL DEFAULT {{[0-9]+}} $t
+# MARKERS-DAG: 08000438 0 NOTYPE LOCAL DEFAULT {{[0-9]+}} $d
+# MARKERS-DAG: 0800043c 0 NOTYPE LOCAL DEFAULT {{[0-9]+}} $t
+
+# HEAD: <large_worker>:
+# HEAD: push {r4, lr}
+# HEAD: sub sp, #0x8
+# HEAD: str r0, [sp]
+# HEAD-NEXT: mov r1, r0
+# HEAD: str r0, [sp, #0x4]
+# HEAD-NEXT: mov r0, r0
+# HEAD: ldr r4, [pc,
+# HEAD: b
+# HEAD: 800001c: {{.*}}.word 0x00000003
+
+# TAIL: ldr r3, [pc,
+# TAIL: b
+# TAIL: 8000438: {{.*}}.word 0x00000005
+# TAIL: add sp, #0x8
+# TAIL: pop {r4, pc}
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl large_worker
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl large_worker
+  .type large_worker,%function
+  .thumb_func
+large_worker:
+  push {r4, lr}
+  sub sp, #8
+  str r0, [sp, #0]
+  ldr r1, [sp, #0]
+  // Ordinary FOP would turn this into a redundant `mov r0, r0` and delete
+  // it. Firm-BOLT retains the same-width move: the private stack read is
+  // forwarded without changing instruction count or the later pool geometry.
+  str r0, [sp, #4]
+  ldr r0, [sp, #4]
+  ldr r4, .Lliteral0
+  adds r0, r1, r4
+  b .Lcode0
+  .p2align 2
+.Lliteral0:
+  .word 3
+.Lcode0:
+  .rept 520
+  nop
+  .endr
+  ldr r3, .Lliteral1
+  adds r0, r0, r3
+  b .Lcode1
+  .p2align 2
+.Lliteral1:
+  .word 5
+.Lcode1:
+  add sp, #8
+  pop {r4, pc}
+  .size large_worker, .-large_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-clustered-call-veneer.s b/bolt/test/ARM/thumb1-clustered-call-veneer.s
new file mode 100644
index 0000000000000000000000000000000000000000..f1e9e3269a0badc1cafd2ae6e2d0b657c62d9383
--- /dev/null
+++ b/bolt/test/ARM/thumb1-clustered-call-veneer.s
@@ -0,0 +1,92 @@
+## Force Thumb-1 clustered relaxation to replace an inter-function BL target
+## with a literal-backed absolute call veneer. The synthesized literal remains
+## symbolic until final linking, carries the Thumb-state bit, and is emitted in
+## the caller's qualified compact range.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --frame-opt=none --relax-exp --max-cluster-size=64 \
+# RUN:   --max-thunk-chain-length=0 \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-objdump -d --mcpu=cortex-m0plus %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-objdump -s --section=.text %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=HEX
+# RUN: %python -c "import json; d=json.load(open('%t.json')); f=next(x for x in d['functions'] if x['name']=='caller'); src=next(x['original_address'] for x in f['instructions'] if x['is_call'] and x['original_address'] is not None); v=[x for x in f['instructions'] if x['provenance_kind']=='synthesized_call_veneer']; print('POST',len(v),d['summary']['synthesized_call_veneer_instruction_count'],len([x for x in f['instructions'] if x['provenance_kind']=='unmapped']),all(x['source_original_address']==src for x in v))" | FileCheck %s --check-prefix=POST-ORIGIN
+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='caller'); v=[x for x in f['instruction_origins'] if x['origin_kind']=='synthesized_call_veneer']; q=f['synthesized_inline_data']; print('FINAL',d['synthesized_call_veneer_instruction_count'],len(v),[x['output_size'] for x in v],all(v[i+1]['output_address']==v[i]['output_address']+v[i]['output_size'] for i in range(len(v)-1))); print('INLINE',d['synthesized_inline_data_bytes'],len(q),q[0]['size'],q[0]['output_address']%4,q[0]['output_address']==q[0]['owner_instruction_output_address']+2,q[0]['target_output_address']&1)" | FileCheck %s --check-prefix=FINAL-ORIGIN
+
+# BOLT: relaxing Thumb-1 inter-function branches with branch chains and literal-backed call veneers (cluster size 64 bytes)
+# BOLT: long thunks created
+# BOLT: 1 out of 4 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+
+# DISASM: <caller>:
+# DISASM: bl {{.*}} <caller+0x{{[0-9a-f]+}}>
+# DISASM: pop {pc}
+# DISASM-NEXT: nop
+# DISASM-NEXT: ldr r3, [pc, #0x0]
+# DISASM-NEXT: bx r3
+
+# HEX: 8000010 7f000008
+
+# POST-ORIGIN: POST 3 3 0 True
+# FINAL-ORIGIN: FINAL 3 3 [2, 2, 2] True
+# FINAL-ORIGIN: INLINE 4 1 4 0 True 1
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
