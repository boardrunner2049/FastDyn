index 0000000000000000000000000000000000000000..dac3c694615e3cc6e3cd545b0e47ebce3bfd872b
--- /dev/null
+++ b/bolt/test/ARM/thumb1-moved-literal-pool-relocation.s
@@ -0,0 +1,68 @@
+## When a checked relaxed contract permits a literal pool to move, both the
+## live data and the retained SHT_REL container offset must follow it.  CFG
+## normalization removes the branch-to-next before the return, moving the
+## pool from 0x08000010 to 0x0800000c.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --firmbolt-allow-literal-address-changes \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='relocated_pool'); p=f['owned_literal_pools'][0]; print(f['firmware_modified'],p['original_address'],p['output_address'],p['relocation_count'])" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objdump -s -j .text %t.bolt | FileCheck %s --check-prefix=DATA
+# RUN: llvm-readelf -r %t.bolt | FileCheck %s --check-prefix=RELOCS
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --firmbolt-allow-literal-address-changes -v=1 \
+# RUN:   -o %t.no-report.bolt 2>&1 | FileCheck %s --check-prefix=NO-REPORT
+# RUN: llvm-readelf -r %t.no-report.bolt | FileCheck %s --check-prefix=RELOCS
+
+# BOLT: BOLT-INFO: reading ARM SHT_REL metadata for compact firmware emission
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: remapped 1 ARM SHT_REL offset(s) and 2 symbol index(es), adding 0 relocation record(s) in .rel.text
+# BOLT: BOLT-INFO: remapped 0 ARM SHT_REL offset(s) and 1 symbol index(es), adding 0 relocation record(s) in .rel.isr_vector
+# NO-REPORT: BOLT-INFO: remapped 1 ARM SHT_REL offset(s) and 2 symbol index(es), adding 0 relocation record(s) in .rel.text
+# REPORT: True 134217744 134217740 1
+# DATA: 8000000 00f002f8 704700bf 004801e0 14000008
+# RELOCS: 0800000c {{.*}} R_ARM_ABS32 {{.*}} external_object
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl relocated_pool
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl relocated_pool
+  .type relocated_pool,%function
+  .thumb_func
+relocated_pool:
+  ldr r0, .Lliteral
+  b .Lreturn
+.Lreturn:
+  bx lr
+  .p2align 2
+.Lliteral:
+  .word external_object
+  .size relocated_pool, .-relocated_pool
+
+  .p2align 2
+  .globl external_object
+  .type external_object,%object
+external_object:
+  .word 0x12345678
+  .size external_object, .-external_object
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-native-indirect-call-method-load-elimination.s b/bolt/test/ARM/thumb1-native-indirect-call-method-load-elimination.s
