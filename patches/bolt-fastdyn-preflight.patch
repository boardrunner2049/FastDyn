+# DISASM: <register_handler>:
+# DISASM: mov r4, lr
+# DISASM-NEXT: bx r4
+# DISASM: <load_handler>:
+# DISASM: ldr.w pc, [sp]
+# DISASM: <state_handler>:
+# DISASM: str r0, [sp]
+# DISASM-NEXT: mov r1, r0
+# DISASM: mrs r2, psp
+# DISASM-NEXT: msr basepri, r2
+# DISASM-NEXT: cpsid i
+# DISASM-NEXT: dsb sy
+# DISASM-NEXT: isb sy
