+++ b/bolt/test/ARM/thumb1-native-indirect-tail-call-promotion.s
@@ -0,0 +1,110 @@
+## Thumb-1 tail-call promotion preserves incoming LR and avoids memory.  A
+## borrowed low argument register is saved in AAPCS scratch r12, restored
+## before either terminal transfer, and the added target-word read is
+## independently contract-gated.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: link_fdata %s %t.exe %t.fdata
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
+# RUN:   --icp-calls-topn=1 --icp-top-callsites=0 --assume-abi \
+# RUN:   --firmbolt-allow-indirect-call-promotion \
+# RUN:   --firmbolt-allow-indirect-tail-call-promotion \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --eliminate-unreachable=false -v=1 -o %t.no-read 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=NO-READ
+# RUN: llvm-objdump -d --mcpu=cortex-m0 --disassemble-symbols=tail_dispatch \
+# RUN:   %t.no-read | FileCheck %s --check-prefix=NO-READ-DISASM
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
+# RUN:   --icp-calls-topn=1 --icp-top-callsites=0 --assume-abi \
+# RUN:   --firmbolt-allow-indirect-call-promotion \
+# RUN:   --firmbolt-allow-indirect-tail-call-promotion \
+# RUN:   --firmbolt-allow-thumb1-icp-literal-load \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --eliminate-unreachable=true --fastdyn-firmware-report=%t.json \
+# RUN:   -v=1 -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m0 --disassemble-symbols=tail_dispatch \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-readelf -x .text %t.bolt | FileCheck %s --check-prefix=HEX
+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='tail_dispatch'); print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),f['original_size'],f['output_size'],d['synthesized_call_promotion_instruction_count'],d['synthesized_inline_data_bytes']); print([(hex(x['output_address']),x['size'],hex(x['target_output_address'])) for x in f['synthesized_inline_data']]); print([(x['origin_kind'],x.get('original_address'),x.get('source_original_address')) for x in f['instruction_origins']])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
