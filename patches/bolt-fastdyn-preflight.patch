--- /dev/null
+++ b/bolt/test/ARM/thumb-target2-fixed-static-got.s
@@ -0,0 +1,131 @@
+## LLD's got-rel interpretation of platform-defined R_ARM_TARGET2 is
+## R_ARM_GOT_PREL. Require both explicit policies, bind the exact retained
+## firmware slot, move the code-owned word, and keep relocation type 41 rather
+## than silently publishing type 96.
+
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/fixture.s -o %t/fixture.o
