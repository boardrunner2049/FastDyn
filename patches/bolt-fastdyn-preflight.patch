@@ -0,0 +1,41 @@
+## A veneer-looking symbol outside the dedicated typed section is not slack.
+## Reject the image instead of silently consuming adjacent executable bytes.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --frame-opt=none -o %t.bolt 2>&1 | FileCheck %s
+
+# CHECK: BOLT-ERROR: Cortex-M veneer reservation __firmbolt_thumb_veneer_slot0 must use both section .firmbolt.veneer and prefix __firmbolt_thumb_veneer_slot
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .p2align 2
+  .globl __firmbolt_thumb_veneer_slot0
+  .type __firmbolt_thumb_veneer_slot0,%function
+  .thumb_func
+__firmbolt_thumb_veneer_slot0:
+  bx lr
+  nop
+  nop
+  nop
+  .size __firmbolt_thumb_veneer_slot0, .-__firmbolt_thumb_veneer_slot0
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
