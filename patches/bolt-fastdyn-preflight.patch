+TEST_P(MCPlusBuilderTester, ARM_RegisterReassignment) {
+  if (GetParam() != Triple::thumb)
+    GTEST_SKIP();
+
+  SmallVector<std::pair<MCPhysReg, MCPhysReg>, 8> Candidates;
+  BC->MIB->getRegisterReassignmentCandidates(Candidates);
+  EXPECT_TRUE(llvm::is_contained(
+      Candidates, std::pair<MCPhysReg, MCPhysReg>{ARM::R4, ARM::R8}));
+  EXPECT_TRUE(llvm::is_contained(
+      Candidates, std::pair<MCPhysReg, MCPhysReg>{ARM::R6, ARM::R10}));
+  EXPECT_FALSE(llvm::any_of(Candidates, [](const auto &Candidate) {
+    return Candidate.first == ARM::R7 || Candidate.first == ARM::R11 ||
+           Candidate.second == ARM::R9;
+  }));
+
+  SmallVector<std::pair<MCPhysReg, MCPhysReg>, 4> AggressiveCandidates;
+  BC->MIB->getAggressiveRegisterReassignmentCandidates(
+      AggressiveCandidates);
+  EXPECT_EQ(AggressiveCandidates,
+            (SmallVector<std::pair<MCPhysReg, MCPhysReg>, 4>{
+                {ARM::R2, ARM::R12}, {ARM::R3, ARM::R12}}));
+
+  MCInst Load = MCInstBuilder(ARM::t2LDRi12)
+                    .addReg(ARM::R0)
+                    .addReg(ARM::R8)
+                    .addImm(4)
+                    .addImm(ARMCC::AL)
+                    .addReg(0);
+  BC->MIB->setSize(Load, 4);
+  std::optional<int64_t> LoadSaving =
+      BC->MIB->applyRegisterReassignment(Load, ARM::R4, ARM::R8);
+  ASSERT_TRUE(LoadSaving);
+  EXPECT_EQ(*LoadSaving, 2);
+  EXPECT_EQ(Load.getOpcode(), ARM::tLDRi);
+  EXPECT_EQ(Load.getOperand(0).getReg(), ARM::R0);
+  EXPECT_EQ(Load.getOperand(1).getReg(), ARM::R4);
+  EXPECT_EQ(Load.getOperand(2).getImm(), 1);
+  EXPECT_EQ(BC->MIB->getInstructionSize(Load), 2u);
+
+  MCInst AggressiveLoad = MCInstBuilder(ARM::t2LDRi12)
+                              .addReg(ARM::R0)
+                              .addReg(ARM::R12)
+                              .addImm(4)
+                              .addImm(ARMCC::AL)
+                              .addReg(0);
+  BC->MIB->setSize(AggressiveLoad, 4);
+  std::optional<int64_t> AggressiveLoadSaving =
+      BC->MIB->applyRegisterReassignment(AggressiveLoad, ARM::R2,
+                                         ARM::R12);
+  ASSERT_TRUE(AggressiveLoadSaving);
+  EXPECT_EQ(*AggressiveLoadSaving, 2);
+  EXPECT_EQ(AggressiveLoad.getOpcode(), ARM::tLDRi);
+  EXPECT_EQ(AggressiveLoad.getOperand(1).getReg(), ARM::R2);
+
+  MCInst AggressiveMove = MCInstBuilder(ARM::t2MOVr)
+                              .addReg(ARM::R12)
+                              .addReg(ARM::R1)
+                              .addImm(ARMCC::AL)
+                              .addReg(0);
+  BC->MIB->setSize(AggressiveMove, 4);
+  std::optional<int64_t> AggressiveMoveSaving =
+      BC->MIB->applyRegisterReassignment(AggressiveMove, ARM::R2,
+                                         ARM::R12);
+  ASSERT_TRUE(AggressiveMoveSaving);
+  EXPECT_EQ(*AggressiveMoveSaving, 0);
+  EXPECT_EQ(AggressiveMove.getOperand(0).getReg(), ARM::R2);
+
+  MCInst Store = MCInstBuilder(ARM::t2STRi12)
+                     .addReg(ARM::R8)
+                     .addReg(ARM::SP)
+                     .addImm(4)
+                     .addImm(ARMCC::AL)
+                     .addReg(0);
+  BC->MIB->setSize(Store, 4);
+  std::optional<int64_t> StoreSaving =
+      BC->MIB->applyRegisterReassignment(Store, ARM::R4, ARM::R8);
+  ASSERT_TRUE(StoreSaving);
+  EXPECT_EQ(*StoreSaving, 2);
+  EXPECT_EQ(Store.getOpcode(), ARM::tSTRspi);
+  EXPECT_EQ(Store.getOperand(0).getReg(), ARM::R4);
+  EXPECT_EQ(Store.getOperand(1).getReg(), ARM::SP);
+  EXPECT_EQ(Store.getOperand(2).getImm(), 1);
+  EXPECT_EQ(BC->MIB->getInstructionSize(Store), 2u);
+
+  // A Thumb-1 low-register encoding cannot represent the reverse half of the
+  // exchange.  The target hook must reject the complete function candidate
+  // instead of silently leaving this instruction unswapped.
+  MCInst Narrow = MCInstBuilder(ARM::tLDRi)
+                      .addReg(ARM::R0)
+                      .addReg(ARM::R4)
+                      .addImm(1)
+                      .addImm(ARMCC::AL)
+                      .addReg(0);
+  BC->MIB->setSize(Narrow, 2);
+  EXPECT_FALSE(
+      BC->MIB->applyRegisterReassignment(Narrow, ARM::R4, ARM::R8));
+  EXPECT_EQ(Narrow.getOpcode(), ARM::tLDRi);
+  EXPECT_EQ(Narrow.getOperand(1).getReg(), ARM::R4);
+
+  std::optional<uint32_t> PopR8 =
+      BC->MIB->rewriteInlineCompactUnwindRegisters(
+          0x808010b0U, ARM::R4, ARM::R8);
+  ASSERT_TRUE(PopR8);
+  EXPECT_EQ(*PopR8, 0x808001b0U);
+
+  std::optional<uint32_t> VspR8 =
+      BC->MIB->rewriteInlineCompactUnwindRegisters(
+          0x8098b0b0U, ARM::R4, ARM::R8);
+  ASSERT_TRUE(VspR8);
+  EXPECT_EQ(*VspR8, 0x8094b0b0U);
+
+  // The one-byte contiguous-range opcode cannot express r8 without r4 after
+  // the exchange.  A range containing both names is invariant.
+  EXPECT_FALSE(BC->MIB->rewriteInlineCompactUnwindRegisters(
+      0x80a0b0b0U, ARM::R4, ARM::R8));
+  EXPECT_EQ(*BC->MIB->rewriteInlineCompactUnwindRegisters(
+                0x80a4b0b0U, ARM::R4, ARM::R8),
+            0x80a4b0b0U);
+
+  SmallVector<uint8_t, 8> ExternalProgram = {
+      0x00, 0x80, 0x10, 0xb0, 0xb0, 0xb0};
+  EXPECT_TRUE(BC->MIB->rewriteCompactUnwindRegisters(
+      ExternalProgram, ARM::R4, ARM::R8));
+  const SmallVector<uint8_t, 8> ExpectedExternal = {
+      0x00, 0x80, 0x01, 0xb0, 0xb0, 0xb0};
+  EXPECT_EQ(ExternalProgram, ExpectedExternal);
+
+  ARMCompactUnwindProgram Program;
+  Program.PersonalityIndex = 1;
+  Program.StorageSize = 8;
+  Program.Opcodes = ExternalProgram;
+  Expected<SmallVector<uint8_t, 16>> Encoded =
+      encodeARMCompactUnwindProgram(Program, ExternalProgram,
+                                    /*IsLittleEndian=*/true);
+  if (!Encoded)
+    FAIL() << toString(Encoded.takeError());
+  const SmallVector<uint8_t, 16> ExpectedEncoded = {
+      0x80, 0x00, 0x01, 0x81, 0xb0, 0xb0, 0xb0, 0x01};
+  EXPECT_EQ(*Encoded, ExpectedEncoded);
+}
