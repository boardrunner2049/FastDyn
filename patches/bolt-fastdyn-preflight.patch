+TEST_F(AArch32Errors, applyFixupNarrowAbsoluteData) {
+  uint8_t Data[3]{0xf0, 0x00, 0x80};
+  Block &Site = createMutableBlock(Data, 0x1000, 1);
+
+  // AAELF32 defines narrow REL addends as sign-extended field contents.
+  Expected<int64_t> Addend8 = readAddendData(*G, Site, 0, Data_Pointer8);
+  ASSERT_THAT_EXPECTED(Addend8, Succeeded());
+  EXPECT_EQ(*Addend8, -16);
+  Expected<int64_t> Addend16 = readAddendData(*G, Site, 1, Data_Pointer16);
+  ASSERT_THAT_EXPECTED(Addend16, Succeeded());
+  EXPECT_EQ(*Addend16, -32768);
+
+  Symbol &Zero = G->addAbsoluteSymbol("zero", orc::ExecutorAddr(0), 0,
+                                      Linkage::Strong, Scope::Local, false);
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Site, Edge(Data_Pointer8, 0, Zero, 255), Cfg),
+      Succeeded());
+  EXPECT_EQ(Data[0], 0xff);
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Site, Edge(Data_Pointer16, 1, Zero, 65535), Cfg),
+      Succeeded());
+  EXPECT_EQ(read16le(Data + 1), 0xffff);
+
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Site, Edge(Data_Pointer8, 0, Zero, -129), Cfg),
+      FailedWithMessage(testing::HasSubstr("out of range")));
+  EXPECT_THAT_ERROR(
+      applyFixup(*G, Site, Edge(Data_Pointer16, 1, Zero, 65536), Cfg),
+      FailedWithMessage(testing::HasSubstr("out of range")));
+}
