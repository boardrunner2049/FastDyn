+  EXPECT_TRUE(BC->MIB->isConditionalMove(NarrowMove));
+
+  MCInst WideMove = MCInstBuilder(ARM::t2MOVr)
+                        .addReg(ARM::R8)
+                        .addReg(ARM::R2)
+                        .addImm(ARMCC::AL)
+                        .addReg(0)
+                        .addReg(0);
+  ASSERT_TRUE(BC->MIB->convertMoveToConditionalMove(
+      WideMove, ARMCC::NE, /*AllowStackMemOp=*/false,
+      /*AllowBasePtrStackMemOp=*/false));
+  EXPECT_EQ(WideMove.getOperand(2).getImm(), ARMCC::NE);
+
+  for (unsigned NumMoves = 1; NumMoves <= 4; ++NumMoves) {
+    ASSERT_TRUE(
+        BC->MIB->canMaterializeConditionalMoveSequence(ARMCC::EQ, NumMoves));
+    std::optional<MCInst> IT =
+        BC->MIB->createConditionalMovePrefix(ARMCC::EQ, NumMoves);
+    ASSERT_TRUE(IT);
+    EXPECT_EQ(IT->getOpcode(), ARM::t2IT);
+    EXPECT_EQ(IT->getOperand(0).getImm(), ARMCC::EQ);
+    EXPECT_EQ(IT->getOperand(1).getImm(), 1U << (4U - NumMoves));
+  }
+  EXPECT_FALSE(BC->MIB->canMaterializeConditionalMoveSequence(ARMCC::EQ, 5));
+  EXPECT_FALSE(BC->MIB->createConditionalMovePrefix(ARMCC::EQ, 5));
+
+  MCInst FlagMove = MCInstBuilder(ARM::t2MOVr)
+                        .addReg(ARM::R0)
+                        .addReg(ARM::R2)
+                        .addImm(ARMCC::AL)
+                        .addReg(0)
+                        .addReg(ARM::CPSR);
+  EXPECT_FALSE(BC->MIB->convertMoveToConditionalMove(
+      FlagMove, ARMCC::EQ, /*AllowStackMemOp=*/false,
+      /*AllowBasePtrStackMemOp=*/false));
+
+  MCInst StackMove = MCInstBuilder(ARM::tMOVr)
+                         .addReg(ARM::SP)
+                         .addReg(ARM::R2)
+                         .addImm(ARMCC::AL)
+                         .addReg(0);
+  EXPECT_FALSE(BC->MIB->convertMoveToConditionalMove(
+      StackMove, ARMCC::EQ, /*AllowStackMemOp=*/false,
+      /*AllowBasePtrStackMemOp=*/false));
+}
