+
+  MCInst CleanWide = MCInstBuilder(ARM::t2EORrr)
+                         .addReg(ARM::R0)
+                         .addReg(ARM::R4)
+                         .addReg(ARM::R4)
+                         .addImm(ARMCC::AL)
+                         .addReg(0)
+                         .addReg(0);
+  EXPECT_TRUE(BC->MIB->isCleanReg(CleanWide));
+
+  MCInst ExclusiveLoad = MCInstBuilder(ARM::t2LDREX)
+                             .addReg(ARM::R0)
+                             .addReg(ARM::R1)
+                             .addImm(0)
+                             .addImm(ARMCC::AL)
+                             .addReg(0);
+  EXPECT_TRUE(BC->MIB->isExclusiveLoad(ExclusiveLoad));
+  EXPECT_FALSE(BC->MIB->isExclusiveStore(ExclusiveLoad));
+  MCInst AcquireLoad = MCInstBuilder(ARM::t2LDAEXB)
+                           .addReg(ARM::R0)
+                           .addReg(ARM::R1)
+                           .addImm(ARMCC::AL)
+                           .addReg(0);
+  EXPECT_TRUE(BC->MIB->isExclusiveLoad(AcquireLoad));
+
+  MCInst ExclusiveStore = MCInstBuilder(ARM::t2STREX)
+                              .addReg(ARM::R0)
+                              .addReg(ARM::R2)
+                              .addReg(ARM::R1)
+                              .addImm(0)
+                              .addImm(ARMCC::AL)
+                              .addReg(0);
+  EXPECT_TRUE(BC->MIB->isExclusiveStore(ExclusiveStore));
+  EXPECT_FALSE(BC->MIB->isExclusiveLoad(ExclusiveStore));
+  MCInst ReleaseStore = MCInstBuilder(ARM::t2STLEXH)
+                            .addReg(ARM::R0)
+                            .addReg(ARM::R2)
+                            .addReg(ARM::R1)
+                            .addImm(ARMCC::AL)
+                            .addReg(0);
+  EXPECT_TRUE(BC->MIB->isExclusiveStore(ReleaseStore));
+
+  MCInst ExclusiveClear = MCInstBuilder(ARM::t2CLREX)
+                              .addImm(ARMCC::AL)
+                              .addReg(0);
+  EXPECT_TRUE(BC->MIB->isExclusiveClear(ExclusiveClear));
+  EXPECT_FALSE(BC->MIB->isExclusiveLoad(ExclusiveClear));
+  EXPECT_FALSE(BC->MIB->isExclusiveStore(ExclusiveClear));
+
+  MCSymbol *Target = BC->Ctx->createTempSymbol();
+  MCInst Branch;
+  BC->MIB->createDirectBranch(Branch, Target, BC->Ctx.get());
+  EXPECT_EQ(Branch.getOpcode(), ARM::t2B);
+  EXPECT_EQ(BC->MIB->getTargetSymbol(Branch), Target);
+
+  MCInst CondBranch;
+  BC->MIB->createCondBranch(CondBranch, Target, ARMCC::NE, BC->Ctx.get());
+  EXPECT_EQ(CondBranch.getOpcode(), ARM::tBcc);
+  EXPECT_EQ(BC->MIB->getCondCode(CondBranch), ARMCC::NE);
+  EXPECT_EQ(BC->MIB->getInvertedCondCode(ARMCC::NE), ARMCC::EQ);
+
+  InstructionListType ShortJump;
