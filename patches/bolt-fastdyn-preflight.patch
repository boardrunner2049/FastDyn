@@ -0,0 +1,65 @@
+## Shortening live code before a terminal pool must not move the pool under
+## the default firmware contract. The proven non-fallthrough owner permits
+## unreachable zero fill after the branch, retaining both the shorter live path
+## and the exact original literal address inside the original footprint.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='terminal_changed'); print(f['firmware_modification_attempted'],f['firmware_modified'],f['firmware_publication_rejections'])" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-nm %t.exe | grep literal_identity | FileCheck %s --check-prefix=ADDRESS
+# RUN: llvm-nm %t.bolt | grep literal_identity | FileCheck %s --check-prefix=ADDRESS
+# RUN: llvm-objdump -d --start-address=0x08000008 --stop-address=0x08000018 %t.bolt | FileCheck %s --check-prefix=CODE
+
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 1 owner block(s), rebound 1 PC-relative reference(s), and retained 0 function(s)
+# BOLT: BOLT-INFO: 1 instructions were shortened
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+# REPORT: True True []
+# ADDRESS: 08000014 {{.*}} literal_identity
+# CODE: <terminal_changed>:
+# CODE: cmp
+# CODE-NEXT: b{{eq|ne}}
+# CODE-NEXT: movs
+# CODE: ldr
+# CODE-NEXT: bx lr
+# CODE-NEXT: movs r0, r0
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl terminal_changed
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl terminal_changed
+  .type terminal_changed,%function
+  .thumb_func
+terminal_changed:
+  cmp r1, #0
+  bne.w .Lload
+  movs r1, #1
+.Lload:
+  ldr.n r0, .Lliteral
+  bx lr
+.globl literal_identity
+literal_identity:
+.Lliteral:
+  .word 9
+  .size terminal_changed, .-terminal_changed
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
