index 0000000000000000000000000000000000000000..d22f9f60e8e38d09bd653fab5ea93a2f7b59eb4c
--- /dev/null
+++ b/bolt/include/bolt/Core/ARMUnwindInfo.h
@@ -0,0 +1,67 @@
+//===- bolt/Core/ARMUnwindInfo.h --------------------------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_BOLT_CORE_ARMUNWINDINFO_H
+#define LLVM_BOLT_CORE_ARMUNWINDINFO_H
+
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/Support/Error.h"
+#include <cstdint>
+#include <optional>
+
+namespace llvm {
+namespace bolt {
+
+class BinaryContext;
+class BinarySection;
+
+enum class ARMUnwindModel : uint8_t {
+  CantUnwind,
+  InlineCompact,
+  ExternalCompact,
+  Generic,
+};
+
+/// A completely bounded ARM-defined compact unwind program. Opcodes are in
+/// architectural execution order, independent of ELF byte order. For an
+/// inline record StorageSection is null and StorageAddress is the exidx word;
+/// for an external record they identify the exact validated extab byte range.
+struct ARMCompactUnwindProgram {
+  unsigned PersonalityIndex{0};
+  BinarySection *StorageSection{nullptr};
+  uint64_t StorageAddress{0};
+  uint64_t StorageSize{0};
+  SmallVector<uint8_t, 8> Opcodes;
+};
+
+struct ARMUnwindRecord {
+  ARMUnwindModel Model{ARMUnwindModel::CantUnwind};
+  std::optional<ARMCompactUnwindProgram> Compact;
+};
+
+/// Decode one exidx unwind word at p WordAddress. External compact records
+/// are accepted only when their complete ARM-defined payload is allocatable,
+/// file-backed and range-bounded. Generic records are classified but their
+/// language-specific payload remains opaque to this service.
+Expected<ARMUnwindRecord>
+decodeARMUnwindRecord(BinaryContext &BC, uint32_t Word,
+                      uint64_t WordAddress);
+
+/// Encode p Opcodes back into the exact fixed-size storage described by
+/// p Program. The returned bytes use the ELF byte order requested by
+/// p IsLittleEndian and never resize the linked record.
+Expected<SmallVector<uint8_t, 16>>
+encodeARMCompactUnwindProgram(const ARMCompactUnwindProgram &Program,
+                              ArrayRef<uint8_t> Opcodes,
+                              bool IsLittleEndian);
+
+} // namespace bolt
+} // namespace llvm
+
+#endif
