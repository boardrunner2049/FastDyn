+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+  .word 0
+  .word 0
+
+  .section .text,"ax",%progbits
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl byte_worker
+  b ambiguous_addend_worker
+  .size Reset_Handler, .-Reset_Handler
+
+  .p2align 2
+  .globl byte_worker
+  .type byte_worker,%function
+  .thumb_func
+byte_worker:
+  push {r7, lr}
+  sub sp, #4
+  add r7, sp, #0
+  str r2, [r7]
+  ldr r2, [r7]
+  ldr r1, =0x20000000
+  movs r0, :lower0_7:target_data
+  strb r0, [r1, #0]
+  movs r0, :lower8_15:target_data
+  strb r0, [r1, #1]
+  movs r0, :upper0_7:target_data
+  strb r0, [r1, #2]
+  movs r0, :upper8_15:target_data
+  strb r0, [r1, #3]
+  mov sp, r7
+  add sp, #4
+  pop {r7, pc}
+  .ltorg
+  .size byte_worker, .-byte_worker
+
+  .p2align 2
+  .globl ambiguous_addend_worker
+  .type ambiguous_addend_worker,%function
+  .thumb_func
+ambiguous_addend_worker:
+  push {r7, lr}
+  sub sp, #4
+  add r7, sp, #0
+  str r2, [r7]
+  ldr r2, [r7]
+  ldr r1, =0x20000000
+  movs r0, :lower0_7:target_data+1
+  strb r0, [r1, #4]
+  mov sp, r7
+  add sp, #4
+  pop {r7, pc}
+  .ltorg
+  .size ambiguous_addend_worker, .-ambiguous_addend_worker
+
+  .section .target,"a",%progbits
+  .globl target_data
+target_data:
+  .byte 0
+
+#--- link.ld
+ENTRY(Reset_Handler)
+SECTIONS {
+  .isr_vector 0x08000000 : { *(.isr_vector) }
+  .text 0x08000100 : { *(.text) }
+  .target 0x08001234 : { *(.target) }
+}
