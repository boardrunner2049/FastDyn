+  .rept 8
+  adds r1, #1
+  .endr
+  b .Lchain2
+.Lchain2:
+  .rept 8
+  adds r1, #1
+  .endr
+  b .Lchain3
+.Lchain3:
+  .rept 8
+  adds r1, #1
+  .endr
+  b .Lchain4
+.Lchain4:
+  .rept 8
+  adds r1, #1
+  .endr
+  mov r0, r1
+  b .Lexit
+.Lexit:
+  bx lr
+  .fnend
+.size cdsplit_worker, . - cdsplit_worker
+
+.weak __aeabi_unwind_cpp_pr1
+
+.align 2
+.global Reset_Handler
+.type Reset_Handler, %function
+.thumb_func
+Reset_Handler:
+  .fnstart
+  .personalityindex 1
+  movw r4, #0
+  movt r4, #0x2000
+  movs r0, #1
+hot_callsite:
+  bl cdsplit_worker
+  str r0, [r4]
+  movs r0, #4
+warm_callsite:
+  bl cdsplit_worker
+  str r0, [r4, #4]
+  movs r0, #2
+cold_callsite:
+  bl cdsplit_worker
+  str r0, [r4, #8]
+.global fixture_halt
+fixture_halt:
+  b fixture_halt
+  .fnend
+.size Reset_Handler, . - Reset_Handler
