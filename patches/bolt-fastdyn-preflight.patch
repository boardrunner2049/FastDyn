index 0000000000000000000000000000000000000000..ee05bce43c2973d85b26a6ac1387e61aa64d2d45
--- /dev/null
+++ b/bolt/test/ARM/thumb-native-inline-memcpy.s
@@ -0,0 +1,139 @@
+## BOLT's existing InlineMemcpy pass is target-generic, but ARM previously had
+## no size recovery or instruction generator.  Firm-BOLT admits the Cortex-M
+## form only under an explicit contract: fixed size, disjoint byte-addressable
+## ordinary RAM, and accepted call/fault/event changes.  Unknown and oversized
+## calls remain unchanged.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --inline-memcpy \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   -o %t.denied 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=DENIED
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --inline-memcpy \
+# RUN:   --firmbolt-allow-inline-memcpy \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=copy_three %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=COPY
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=copy_unknown %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=UNKNOWN
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=copy_large %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=LARGE
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=copy_clobbered %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=CLOBBERED
+# RUN: %python -c "import json; d=json.load(open('%t.json')); l=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='copy_three'); lf=next(x for x in l['functions'] if x['name']=='copy_three'); t=[x for x in lf['instruction_origins'] if x['origin_kind']=='synthesized_from_original_instruction']; print(f['firmware_modified'],f['firmware_modification_reasons'],len(t),len(set(x['source_original_address'] for x in t)),sum(x['may_load'] for x in t),sum(x['may_store'] for x in t))" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# DENIED: Cortex-M memcpy inlining changes call, memory-access and fault/event observations
+# LOG: inlined 1 memcpy() calls
+# COPY: <copy_three>:
+# COPY: movs r2, #0x3
+# COPY-NEXT: ldrb r3, [r1]
+# COPY-NEXT: strb r3, [r0]
+# COPY-NEXT: ldrb r3, [r1, #0x1]
+# COPY-NEXT: strb r3, [r0, #0x1]
+# COPY-NEXT: ldrb r3, [r1, #0x2]
+# COPY-NEXT: strb r3, [r0, #0x2]
+# COPY-NEXT: bx lr
+# COPY-NOT: bl
+# UNKNOWN: <copy_unknown>:
+# UNKNOWN: bl {{.*}}<memcpy>
+# LARGE: <copy_large>:
+# LARGE: movs r2, #0x21
+# LARGE-NEXT: bl {{.*}}<memcpy>
+# CLOBBERED: <copy_clobbered>:
+# CLOBBERED: movs r2, #0x3
+# CLOBBERED-NEXT: bl {{.*}}<clobber>
+# CLOBBERED-NEXT: bl {{.*}}<memcpy>
+# REPORT: True ['unreachable_code_elimination', 'inline_memcpy'] 6 1 3 3
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl copy_three
+  bl copy_unknown
+  bl copy_large
+  bl copy_clobbered
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl copy_three
+  .type copy_three,%function
+  .thumb_func
+copy_three:
+  movs r2, #3
+  bl memcpy
+  bx lr
+  /* Exact, symbol-bounded non-entry capacity. The CFG proves these bytes
+     unreachable before compact emission consumes the range. */
+  .rept 8
+  nop
+  .endr
+  .size copy_three, .-copy_three
+
+  .globl copy_unknown
+  .type copy_unknown,%function
+  .thumb_func
+copy_unknown:
+  mov r2, r3
+  bl memcpy
+  bx lr
+  .size copy_unknown, .-copy_unknown
+
+  .globl copy_large
+  .type copy_large,%function
+  .thumb_func
+copy_large:
+  movs r2, #33
+  bl memcpy
+  bx lr
+  .size copy_large, .-copy_large
+
+  .globl copy_clobbered
+  .type copy_clobbered,%function
+  .thumb_func
+copy_clobbered:
+  movs r2, #3
+  bl clobber
+  bl memcpy
+  bx lr
+  .size copy_clobbered, .-copy_clobbered
+
+  .globl clobber
+  .type clobber,%function
+  .thumb_func
+clobber:
+  movs r2, #17
+  bx lr
+  .size clobber, .-clobber
+
+  .globl memcpy
+  .type memcpy,%function
+  .thumb_func
+memcpy:
+  bx lr
+  .size memcpy, .-memcpy
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb-native-inlining.s b/bolt/test/ARM/thumb-native-inlining.s
new file mode 100644
index 0000000000000000000000000000000000000000..9c9bfffe7e1b7ebef0d8e722eb3aec5325a1dd29
--- /dev/null
+++ b/bolt/test/ARM/thumb-native-inlining.s
@@ -0,0 +1,70 @@
+## Native BOLT inlining is useful on firmware, but it changes a call boundary
+## and copies callee instructions into a different original-address domain.
+## Firm-BOLT therefore keeps it fail-closed by default and records exact clone
+## provenance when the workload contract explicitly admits the change.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --force-inline=tiny_callee --eliminate-unreachable=false \
+# RUN:   -o %t.denied 2>&1 | FileCheck %s --check-prefix=DENIED
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --force-inline=tiny_callee --firmbolt-allow-inlining \
+# RUN:   --eliminate-unreachable=false --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=caller %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); l=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='caller'); lf=next(x for x in l['functions'] if x['name']=='caller'); clones=[x for x in f['instructions'] if x['provenance_kind']=='cloned_original_instruction']; lc=[x for x in lf['instruction_origins'] if x['origin_kind']=='cloned_original_instruction']; print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),f['post_optimization_instruction_count'],len(clones),d['summary']['cloned_original_instruction_count']); print([(hex(x['original_address']),hex(x['output_address'])) for x in lc])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# DENIED: Cortex-M inlining changes call boundaries
+# LOG: 1 out of 3 functions were overwritten.
+# DISASM: <caller>:
+# DISASM-NOT: bl
+# DISASM: push {lr}
+# DISASM: movs r0, #0x2a
+# DISASM-NEXT: adds r0, #0x1
+# DISASM-NEXT: pop {pc}
+# REPORT: True inlining 4 1 1
+# REPORT-NEXT: [('0x8000010', '0x8000008')]
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl caller
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl caller
+  .type caller,%function
+  .thumb_func
+caller:
+  push {lr}
+  bl tiny_callee
+  adds r0, #1
+  pop {pc}
+  .size caller, .-caller
+
+  .globl tiny_callee
+  .type tiny_callee,%function
+  .thumb_func
+tiny_callee:
+  movs r0, #42
+  bx lr
+  .size tiny_callee, .-tiny_callee
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
