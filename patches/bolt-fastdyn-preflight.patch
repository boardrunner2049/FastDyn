index 0000000000000000000000000000000000000000..3edb1e2b68f2dff6024a8383021776d957175440
--- /dev/null
+++ b/bolt/test/ARM/thumb-safe-icf-ehabi.s
@@ -0,0 +1,329 @@
+## Safe Cortex-M ICF must preserve ARM EHABI semantics, not merely code bytes.
+## Equal linker-established CANTUNWIND models may share one canonical output
+## range; the duplicate index record is removed and both the section header and
+## PT_ARM_EXIDX size are rebuilt.  A different inline compact model rejects the
+## candidate after ICF rather than silently selecting one contract.
+
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/fixture.s -o %t/fixture.o
+# RUN: ld.lld --emit-relocs --no-merge-exidx-entries -T %t/link.ld \
+# RUN:   %t/fixture.o -o %t/reference.elf
+# RUN: llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --icf=safe \
+# RUN:   --firmbolt-allow-identical-code-folding --align-functions=4 \
+# RUN:   --align-text=4 -o %t/candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-nm --numeric-sort %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=SYMBOLS
+# RUN: llvm-readelf --unwind %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=UNWIND
+# RUN: llvm-readelf -SWl %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=LAYOUT
+
+## Independently qualify two separately emitted but byte-identical external
+## compact tables.  The canonical index record must retain its exact table;
+## the unreferenced child table remains opaque allocated data.
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/external.s -o %t/external.o
+# RUN: ld.lld --emit-relocs --no-merge-exidx-entries -T %t/link.ld \
+# RUN:   %t/external.o -o %t/external.elf
+# RUN: llvm-bolt %t/external.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --icf=safe \
+# RUN:   --firmbolt-allow-identical-code-folding --align-functions=4 \
+# RUN:   --align-text=4 -o %t/external-candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=EXTERNAL-BOLT
+# RUN: llvm-readelf --unwind %t/external-candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=EXTERNAL-UNWIND
+# RUN: llvm-objdump -s -j .ARM.extab %t/external-candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=EXTERNAL-EXTAB
+
+## A personality-index-1/index-2 pair has identical machine code but different
+## complete compact records and must fail closed.
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/external-mismatch.s -o %t/external-mismatch.o
+# RUN: ld.lld --emit-relocs --no-merge-exidx-entries -T %t/link.ld \
+# RUN:   %t/external-mismatch.o -o %t/external-mismatch.elf
+# RUN: not llvm-bolt %t/external-mismatch.elf \
+# RUN:   --firmbolt-cortex-m-cpu=cortex-m3 --relocs --use-old-text \
+# RUN:   --icf=safe --firmbolt-allow-identical-code-folding \
+# RUN:   --align-functions=4 --align-text=4 \
+# RUN:   -o %t/external-mismatch-candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=EXTERNAL-MISMATCH
