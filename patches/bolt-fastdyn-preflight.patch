+  BC->MIB->createBreakpoint(Breakpoint);
+  EXPECT_EQ(Breakpoint.getOpcode(), ARM::tBKPT);
+  EXPECT_TRUE(BC->MIB->isBreakpoint(Breakpoint));
+
+  MCInst Allocate;
+  BC->MIB->createStackPointerIncrement(Allocate, 16,
+                                       /*NoFlagsClobber=*/true);
+  int64_t StackEffect = 0;
+  ASSERT_TRUE(BC->MIB->evaluateStackOffsetExpr(
+      Allocate, StackEffect, {ARM::SP, 0}, {0, 0}));
+  EXPECT_EQ(StackEffect, -16);
+  MCInst Deallocate;
+  BC->MIB->createStackPointerDecrement(Deallocate, 16,
+                                       /*NoFlagsClobber=*/true);
+  ASSERT_TRUE(BC->MIB->evaluateStackOffsetExpr(
+      Deallocate, StackEffect, {ARM::SP, 0}, {0, 0}));
+  EXPECT_EQ(StackEffect, 16);
+
+  InstructionListType LongTailCall;
+  BC->MIB->createLongTailCall(LongTailCall, Target, BC->Ctx.get());
+  ASSERT_EQ(LongTailCall.size(), 3u);
+  auto LongIt = LongTailCall.begin();
+  EXPECT_EQ(LongIt->getOpcode(), ARM::t2MOVi16);
+  EXPECT_EQ(LongIt->getOperand(0).getReg(), ARM::R12);
+  EXPECT_TRUE(LongIt->getOperand(1).isExpr());
+  EXPECT_FALSE(BC->MIB->isTailCall(*LongIt));
+  ++LongIt;
+  EXPECT_EQ(LongIt->getOpcode(), ARM::t2MOVTi16);
+  EXPECT_EQ(LongIt->getOperand(0).getReg(), ARM::R12);
+  EXPECT_EQ(LongIt->getOperand(1).getReg(), ARM::R12);
+  EXPECT_TRUE(LongIt->getOperand(2).isExpr());
+  EXPECT_FALSE(BC->MIB->isTailCall(*LongIt));
+  ++LongIt;
+  EXPECT_EQ(LongIt->getOpcode(), ARM::tBX);
+  EXPECT_EQ(LongIt->getOperand(0).getReg(), ARM::R12);
+  EXPECT_TRUE(BC->MIB->isTailCall(*LongIt));
+
+  MCInst DirectTail = MCInstBuilder(ARM::t2B)
+                          .addExpr(MCSymbolRefExpr::create(Target, *BC->Ctx))
+                          .addImm(ARMCC::AL)
+                          .addReg(0);
+  ASSERT_TRUE(BC->MIB->convertJmpToTailCall(DirectTail));
+  ASSERT_TRUE(BC->MIB->convertTailCallToCall(DirectTail));
+  EXPECT_EQ(DirectTail.getOpcode(), ARM::tBL);
+  EXPECT_EQ(BC->MIB->getTargetSymbol(DirectTail), Target);
+  EXPECT_FALSE(BC->MIB->isTailCall(DirectTail));
+
+  MCInst IndirectTail = MCInstBuilder(ARM::tBX)
+                            .addReg(ARM::R12)
+                            .addImm(ARMCC::AL)
+                            .addReg(0);
+  ASSERT_TRUE(BC->MIB->convertJmpToTailCall(IndirectTail));
+  ASSERT_TRUE(BC->MIB->convertTailCallToCall(IndirectTail));
+  EXPECT_EQ(IndirectTail.getOpcode(), ARM::tBLXr);
+  EXPECT_EQ(IndirectTail.getOperand(0).getReg(), ARM::R12);
+  EXPECT_FALSE(BC->MIB->isTailCall(IndirectTail));
+}
+
+TEST_P(MCPlusBuilderTester, ARM_ThumbBranchRanges) {
+  if (GetParam() != Triple::thumb)
+    GTEST_SKIP();
+
+  MCInst CBZ = MCInstBuilder(ARM::tCBZ)
+                   .addReg(ARM::R0)
+                   .addImm(0)
+                   .addImm(ARMCC::AL)
+                   .addReg(0);
+  EXPECT_TRUE(BC->MIB->isBranchOffsetInRange(CBZ, 4));
+  EXPECT_TRUE(BC->MIB->isBranchOffsetInRange(CBZ, 130));
+  EXPECT_FALSE(BC->MIB->isBranchOffsetInRange(CBZ, 132));
+  EXPECT_FALSE(BC->MIB->isBranchOffsetInRange(CBZ, -2));
+  EXPECT_FALSE(BC->MIB->isBranchOffsetInRange(CBZ, 5));
+
+  MCInst Bcc = MCInstBuilder(ARM::tBcc)
+                   .addImm(0)
+                   .addImm(ARMCC::NE)
+                   .addReg(ARM::CPSR);
+  // The test target is Cortex-M3: MC can widen the compact spelling after
+  // final layout, so the pre-link predicate must not force a trampoline.
+  EXPECT_TRUE(BC->MIB->isBranchOffsetInRange(Bcc, 4096));
+}
+
+TEST_P(MCPlusBuilderTester, ARM_InlineJumpTables) {
+  if (GetParam() != Triple::thumb)
+    GTEST_SKIP();
+
+  MCInst TBB = MCInstBuilder(ARM::t2TBB)
+                   .addReg(ARM::PC)
+                   .addReg(ARM::R1)
+                   .addImm(ARMCC::AL)
+                   .addReg(0);
+  unsigned IndexReg = 0;
+  unsigned BaseReg = 0;
+  EXPECT_EQ(BC->MIB->getInlineJumpTableEntrySize(TBB, BaseReg, IndexReg), 1u);
+  EXPECT_EQ(BaseReg, ARM::PC);
+  EXPECT_EQ(IndexReg, ARM::R1);
+
+  MCInst TBH = MCInstBuilder(ARM::t2TBH)
+                   .addReg(ARM::PC)
+                   .addReg(ARM::R2)
+                   .addImm(ARMCC::AL)
+                   .addReg(0);
+  IndexReg = 0;
+  BaseReg = 0;
+  EXPECT_EQ(BC->MIB->getInlineJumpTableEntrySize(TBH, BaseReg, IndexReg), 2u);
+  EXPECT_EQ(BaseReg, ARM::PC);
+  EXPECT_EQ(IndexReg, ARM::R2);
+
+  // Recognition reports the architectural base.  BinaryFunction performs
+  // reaching-definition recovery before accepting a non-PC form.
+  MCInst GeneralBaseTBB = MCInstBuilder(ARM::t2TBB)
+                              .addReg(ARM::R4)
+                              .addReg(ARM::R1)
+                              .addImm(ARMCC::AL)
+                              .addReg(0);
+  IndexReg = 0;
+  BaseReg = 0;
+  EXPECT_EQ(BC->MIB->getInlineJumpTableEntrySize(
+                GeneralBaseTBB, BaseReg, IndexReg),
+            1u);
+  EXPECT_EQ(BaseReg, ARM::R4);
+  EXPECT_EQ(IndexReg, ARM::R1);
+}
