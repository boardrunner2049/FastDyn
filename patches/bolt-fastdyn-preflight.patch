index 0000000000000000000000000000000000000000..f55348df1373d5f5231b8bb7c9afac7fd8a64f3d
--- /dev/null
+++ b/bolt/test/ARM/thumb-safe-icf.s
@@ -0,0 +1,142 @@
+## Reuse BOLT's safe ICF on relocation-complete Cortex-M code.  Direct-call
+## twins may share one emitted body only under an explicit firmware address-
+## coalescing contract.  Data-addressed twins and the vector entry remain
+## distinct, and the final report maps every folded original instruction to
+## the canonical emitted instruction.
+
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/fixture.s -o %t/fixture.o
+# RUN: ld.lld --emit-relocs -T %t/link.ld %t/fixture.o -o %t/reference.elf
+# RUN: not llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --icf=safe -o %t/no-contract.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=NO-CONTRACT
+# RUN: not llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --icf=all \
+# RUN:   --firmbolt-allow-identical-code-folding -o %t/all.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=ALL
+# RUN: llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --icf=safe \
+# RUN:   --firmbolt-allow-identical-code-folding \
+# RUN:   --fastdyn-firmware-report=%t/report.json -o %t/candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-nm --numeric-sort %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=SYMBOLS
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=CODE
+# RUN: %python -c "import json; d=json.load(open('%t/report.json.layout.json')); f=d['identical_code_folds']; print(d['identical_code_fold_count'],d['identical_code_folded_original_bytes']); print([(x['child_name'],x['immediate_parent_name'],hex(x['canonical_function_output_address']),[(hex(i['child_original_address']),hex(i['output_address'])) for i in x['instruction_origins']]) for x in f])" \
+# RUN:   | FileCheck %s --check-prefix=ORIGINS
+
+# NO-CONTRACT: Cortex-M safe ICF changes function-address identity
+# ALL: Cortex-M qualifies only --icf=safe; aggressive address coalescing is not admitted
+# BOLT: BOLT-INFO: ICF folded 1 out of 5 functions
+# BOLT: BOLT-INFO: FastDyn wrote linker-resolved firmware layout
+
+## Only direct_call_b aliases direct_call_a.  The pointer-observable pair is
+## retained at two distinct addresses by safe ICF's relocation analysis.
+# SYMBOLS: [[DIRECT:[0-9a-f]+]] T direct_call_a
+# SYMBOLS-NEXT: [[DIRECT]] T direct_call_b
+# SYMBOLS: [[TAKEN_A:[0-9a-f]+]] T address_taken_a
+# SYMBOLS-NEXT: [[TAKEN_B:[0-9a-f]+]] T address_taken_b
+# SYMBOLS-NOT: [[TAKEN_A]] T address_taken_b
+
+# CODE-LABEL: <Reset_Handler>:
+# CODE: bl [[DIRECT:0x[0-9a-f]+]] <direct_call_{{[ab]}}>
+# CODE: bl [[DIRECT]] <direct_call_{{[ab]}}>
+# CODE: bl {{.*}} <address_taken_a>
+# CODE: bl {{.*}} <address_taken_b>
+
+# ORIGINS: 1 4
+# ORIGINS-NEXT: [('direct_call_b', 'direct_call_a', '{{0x[0-9a-f]+}}', [('{{0x[0-9a-f]+}}', '{{0x[0-9a-f]+}}'), ('{{0x[0-9a-f]+}}', '{{0x[0-9a-f]+}}')])]
+
+//--- fixture.s
+.syntax unified
+.cpu cortex-m3
+.thumb
+.eabi_attribute Tag_CPU_arch, 10
+.eabi_attribute Tag_CPU_arch_profile, 'M'
+
+.section .isr_vector, "a", %progbits
+.p2align 2
+.global g_pfnVectors
+.type g_pfnVectors, %object
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+.size g_pfnVectors, . - g_pfnVectors
+
+.section .rodata.function_addresses, "a", %progbits
+.p2align 2
+.global function_addresses
+function_addresses:
+  .word address_taken_a
+  .word address_taken_b
+.size function_addresses, . - function_addresses
+
+.text
+.p2align 2
+.global Reset_Handler
+.type Reset_Handler, %function
+.thumb_func
+Reset_Handler:
+  ldr r4, =0x20000000
+  bl direct_call_a
+  str r0, [r4]
+  bl direct_call_b
+  str r0, [r4, #4]
+  bl address_taken_a
+  str r0, [r4, #8]
+  bl address_taken_b
+  str r0, [r4, #12]
+.global fixture_halt
+fixture_halt:
+  b fixture_halt
+.size Reset_Handler, . - Reset_Handler
+
+.p2align 2
+.global direct_call_a
+.type direct_call_a, %function
+.thumb_func
+direct_call_a:
+  movs r0, #42
+  bx lr
+.size direct_call_a, . - direct_call_a
+
+.p2align 2
+.global direct_call_b
+.type direct_call_b, %function
+.thumb_func
+direct_call_b:
+  movs r0, #42
+  bx lr
+.size direct_call_b, . - direct_call_b
+
+.p2align 2
+.global address_taken_a
+.type address_taken_a, %function
+.thumb_func
+address_taken_a:
+  movs r0, #17
+  bx lr
+.size address_taken_a, . - address_taken_a
+
+.p2align 2
+.global address_taken_b
+.type address_taken_b, %function
+.thumb_func
+address_taken_b:
+  movs r0, #17
+  bx lr
+.size address_taken_b, . - address_taken_b
+
+//--- link.ld
+ENTRY(Reset_Handler)
+MEMORY {
+  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 64K
+  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 16K
+}
+SECTIONS {
+  .isr_vector ORIGIN(FLASH) : { KEEP(*(.isr_vector)) } > FLASH
+  .rodata : { *(.rodata*) } > FLASH
+  .text 0x08000100 : { *(.text*) } > FLASH
+}
diff --git a/bolt/test/ARM/thumb-stack-allocation-combiner.s b/bolt/test/ARM/thumb-stack-allocation-combiner.s
