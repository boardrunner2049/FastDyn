+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl peephole_worker
+  .type peephole_worker,%function
+  .thumb_func
+peephole_worker:
+  cmp r0, #0
+  beq .Lhop
+  movs r0, #9
+  bx lr
+.Lhop:
+  b .Ltarget
+.Ltarget:
+  movs r0, #5
+  bx lr
