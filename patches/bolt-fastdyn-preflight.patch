+          if (Header & 0x70000000U)
+            return createStringError(
+                errc::executable_format_error,
+                "ARM EHABI compact entry at 0x%" PRIx64
+                " has reserved header bits set",
+                *Target);
+          const unsigned PersonalityIndex = (Header >> 24) & 0x0f;
+          if (PersonalityIndex > 2)
+            return createStringError(
+                errc::not_supported,
+                "ARM EHABI compact personality index %u at 0x%" PRIx64
+                " is not qualified for function layout",
+                PersonalityIndex, *Target);
+          const uint64_t RequiredBytes =
+              PersonalityIndex == 0
+                  ? sizeof(uint32_t)
+                  : sizeof(uint32_t) * (1 + ((Header >> 16) & 0xff));
+          if (!TargetSection->containsRange(*Target, RequiredBytes) ||
+              RequiredBytes > ExtabContents.size() - ExtabOffset)
+            return createStringError(
+                errc::executable_format_error,
+                "ARM EHABI compact entry at 0x%" PRIx64
+                " extends beyond section %s",
+                *Target, TargetSection->getName().str().c_str());
+          ExtabSize = RequiredBytes;
+        }
+        ExtabSection = &*TargetSection;
+        ExtabTarget = *Target;
+      }
+      if (!Entries.empty() && *InputStart <= Entries.back().InputStart)
+        return createStringError(
+            errc::executable_format_error,
+            "ARM EHABI index section %s is not strictly address-sorted",
+            Section.getName().str().c_str());
+      Entries.push_back({Offset, *InputStart, 0, UnwindWord, ExtabSection,
+                         ExtabTarget, ExtabSize, PersonalityTarget, {}, false});
+    }
+
+    // A linker may append a final CANTUNWIND sentinel at the end of the
+    // covered executable range.  Mark it before range assignment so that a
+    // function in a later executable section is not incorrectly attached to
+    // the sentinel's open-ended interval.
+    ExidxEntry &LastEntry = Entries.back();
+    if (LastEntry.UnwindWord == 1 &&
+        !BC->getBinaryFunctionAtAddress(LastEntry.InputStart)) {
+      LastEntry.IsSentinel = true;
+      LastEntry.OutputStart = LastEntry.InputStart;
+    }
+
+    // Associate every discovered function with the EHABI range that covers
+    // it.  An entry may intentionally cover several adjacent functions after
+    // link-time CANTUNWIND/compact-record merging.  Such a group remains legal
+    // only if layout keeps all of its functions contiguous.
+    for (auto &FunctionKV : BC->getBinaryFunctions()) {
+      const BinaryFunction &BF = FunctionKV.second;
+      const uint64_t Address = BF.getAddress();
+      if (Address < Entries.front().InputStart)
+        continue;
+      if (Entries.back().IsSentinel &&
+          Address >= Entries.back().InputStart)
+        continue;
+      auto It = llvm::upper_bound(
+          Entries, Address,
+          [](uint64_t Value, const ExidxEntry &Entry) {
+            return Value < Entry.InputStart;
+          });
+      if (It == Entries.begin())
+        continue;
+      --It;
+      It->Functions.push_back(&BF);
+    }
+
+    // Empty non-sentinel ranges are ambiguous code coverage.
+    for (size_t I = 0; I < Entries.size(); ++I) {
+      ExidxEntry &Entry = Entries[I];
+      if (!Entry.Functions.empty())
+        continue;
+      if (Entry.IsSentinel)
+        continue;
+      return createStringError(
+          errc::not_supported,
+          "ARM EHABI range at 0x%" PRIx64
+          " has no exact discovered function coverage",
+          Entry.InputStart);
+    }
+
+    // ICF can legally make several original function identities aliases of
+    // one emitted body.  EHABI is range based, so accepting the code fold
+    // requires the original unwind models to agree as well.  Keep this check
+    // here, after the linker-established input ranges have been decoded, and
+    // before any index bytes are rewritten.  Equal CANTUNWIND/inline models
+    // are exact; external records must name the same table and personality
+    // identity.  A model mismatch rejects the entire output atomically.
+    DenseMap<const BinaryFunction *, size_t> FunctionToEntry;
+    for (size_t I = 0; I < Entries.size(); ++I)
+      for (const BinaryFunction *BF : Entries[I].Functions)
+        FunctionToEntry[BF] = I;
+
+    const auto SameUnwindModel = [](const ExidxEntry &A,
+                                    const ExidxEntry &B) {
+      if (A.UnwindWord == 1 || B.UnwindWord == 1)
+        return A.UnwindWord == B.UnwindWord;
+      const bool AInline = A.UnwindWord & 0x80000000U;
+      const bool BInline = B.UnwindWord & 0x80000000U;
+      if (AInline || BInline)
+        return AInline && BInline && A.UnwindWord == B.UnwindWord;
+      if (A.ExtabSection == B.ExtabSection &&
+          A.ExtabTarget == B.ExtabTarget &&
+          A.PersonalityTarget == B.PersonalityTarget)
+        return true;
+      // ARM-defined external compact entries are self-contained opcode
+      // records.  Linkers commonly emit one byte-identical table per source
+      // function instead of coalescing them.  Treat those records as the same
+      // unwind model only when their complete, already range-validated byte
+      // sequences match.  Generic entries have PersonalityTarget set and may
+      // carry language-specific data of unknown extent, so they continue to
+      // require the exact same table identity above.
+      if (A.PersonalityTarget || B.PersonalityTarget || !A.ExtabSection ||
+          !B.ExtabSection || !A.ExtabSize || A.ExtabSize != B.ExtabSize)
+        return false;
+      const uint64_t AOffset =
+          A.ExtabTarget - A.ExtabSection->getAddress();
+      const uint64_t BOffset =
+          B.ExtabTarget - B.ExtabSection->getAddress();
+      return A.ExtabSection->getContents().substr(AOffset, A.ExtabSize) ==
+             B.ExtabSection->getContents().substr(BOffset, B.ExtabSize);
+    };
+
+    size_t FoldedAliases = 0;
+    for (size_t I = 0; I < Entries.size(); ++I) {
+      ExidxEntry &Entry = Entries[I];
+      if (Entry.IsSentinel)
+        continue;
+      for (const BinaryFunction *BF : Entry.Functions) {
+        if (!BF->isFolded())
+          continue;
+        const BinaryFunction *Canonical = BF->getFoldedIntoFunction();
+        while (Canonical && Canonical->isFolded())
+          Canonical = Canonical->getFoldedIntoFunction();
+        const auto CanonicalIt = FunctionToEntry.find(Canonical);
+        if (!Canonical || CanonicalIt == FunctionToEntry.end())
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI-covered folded function %s has no exact canonical "
+              "unwind range",
+              BF->getPrintName().c_str());
+        const ExidxEntry &CanonicalEntry = Entries[CanonicalIt->second];
+        if (!SameUnwindModel(Entry, CanonicalEntry))
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI-covered folded function %s and canonical function "
+              "%s have incompatible unwind models",
+              BF->getPrintName().c_str(),
+              Canonical->getPrintName().c_str());
+        ++FoldedAliases;
+      }
+    }
+
+    SmallVector<std::pair<uint64_t, size_t>, 64> OutputFunctions;
+    size_t SplitFragments = 0;
+    for (size_t I = 0; I < Entries.size(); ++I) {
+      ExidxEntry &Entry = Entries[I];
+      if (Entry.IsSentinel)
+        continue;
+      Entry.OutputStart = std::numeric_limits<uint64_t>::max();
+      for (const BinaryFunction *BF : Entry.Functions) {
+        // The canonical function contributes the one live output range.  A
+        // compatible folded alias was checked above and needs no duplicate
+        // EHABI entry at the same output address.
+        if (BF->isFolded())
+          continue;
+        const uint64_t OutputAddress = getNewFunctionAddress(BF->getAddress());
+        if (!OutputAddress)
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI-covered function %s has no final output address",
+              BF->getPrintName().c_str());
+        Entry.OutputStart = std::min(Entry.OutputStart, OutputAddress);
+        OutputFunctions.emplace_back(OutputAddress, I);
+
+        // EHABI describes address ranges, not source functions.  Every
+        // emitted split fragment therefore starts a range carrying the same
+        // exact input unwind identity as its main fragment.  A later sort may
+        // coalesce adjacent ranges with the same identity, but it must retain
+        // a new record when another unwind model lies between fragments.
+        for (const FunctionFragment &FF :
+             BF->getLayout().getSplitFragments()) {
+          if (FF.empty())
+            continue;
+          if (!FF.getAddress() || !FF.getImageSize())
+            return createStringError(
+                errc::not_supported,
+                "ARM EHABI-covered split fragment %u of function %s has no "
+                "complete final placement",
+                FF.getFragmentNum().get(), BF->getPrintName().c_str());
+          Entry.OutputStart = std::min(Entry.OutputStart, FF.getAddress());
+          OutputFunctions.emplace_back(FF.getAddress(), I);
+          ++SplitFragments;
+        }
+      }
+    }
+
+    llvm::sort(OutputFunctions);
+    SmallVector<OutputExidxEntry, 32> OutputEntries;
+    std::optional<size_t> CurrentGroup;
+    uint64_t PreviousAddress = 0;
+    for (const auto &[Address, Group] : OutputFunctions) {
+      if (CurrentGroup && Address == PreviousAddress && *CurrentGroup != Group)
+        return createStringError(
+            errc::not_supported,
+            "ARM EHABI output address 0x%" PRIx64
+            " has incompatible unwind range identities",
+            Address);
+      PreviousAddress = Address;
+      if (CurrentGroup && *CurrentGroup == Group)
+        continue;
+      OutputEntries.push_back({&Entries[Group], Address});
+      CurrentGroup = Group;
+    }
+    if (Entries.back().IsSentinel) {
+      if (!OutputEntries.empty() &&
+          Entries.back().OutputStart <= OutputEntries.back().OutputStart)
+        return createStringError(
+            errc::not_supported,
+            "ARM EHABI sentinel no longer follows emitted code");
+      OutputEntries.push_back(
+          {&Entries.back(), Entries.back().OutputStart});
+    }
+
+    // The index remains at its linked address.  Table growth is admitted only
+    // inside bytes that are already file- and memory-backed by the same
+    // PT_LOAD and are not owned by another allocatable section.  This makes
+    // linker-provided padding an explicit capacity contract and prevents a
+    // fragment record from silently overwriting literals, data, or a later
+    // section.  Segment extension is deliberately a separate feature.
+    const uint64_t OutputSize = OutputEntries.size() * 8;
+    const uint64_t SectionAddress = Section.getAddress();
+    const uint64_t SectionOffset = Section.getInputFileOffset();
+    auto SegmentIt = BC->SegmentMapInfo.upper_bound(SectionAddress);
+    if (SegmentIt == BC->SegmentMapInfo.begin())
+      return createStringError(errc::executable_format_error,
+                               "ARM EHABI index is not in a PT_LOAD");
+    --SegmentIt;
+    const SegmentInfo &Segment = SegmentIt->second;
+    if (SectionAddress < Segment.Address ||
+        SectionAddress + Section.getSize() > Segment.Address + Segment.Size ||
+        SectionOffset < Segment.FileOffset ||
+        SectionOffset + Section.getSize() >
+            Segment.FileOffset + Segment.FileSize ||
+        SectionAddress - Segment.Address !=
+            SectionOffset - Segment.FileOffset)
+      return createStringError(
+          errc::executable_format_error,
+          "ARM EHABI index %s lacks one exact file-backed PT_LOAD mapping",
+          Section.getName().str().c_str());
+
+    uint64_t Capacity = std::min(Segment.Address + Segment.Size -
+                                     SectionAddress,
+                                 Segment.FileOffset + Segment.FileSize -
+                                     SectionOffset);
+    for (const BinarySection &Other : BC->allocatableSections()) {
+      if (&Other == &Section || Other.isLinkOnly() || Other.isVirtual())
+        continue;
+      const uint64_t OtherSize = Other.getOutputSize();
+      if (!OtherSize)
+        continue;
+      const uint64_t OtherAddress =
+          Other.getOutputAddress() ? Other.getOutputAddress()
+                                   : Other.getAddress();
+      const uint64_t OtherOffset =
+          Other.getOutputFileOffset() ? Other.getOutputFileOffset()
+                                      : Other.getInputFileOffset();
+      if (OtherAddress > SectionAddress)
+        Capacity = std::min(Capacity, OtherAddress - SectionAddress);
+      if (OtherOffset > SectionOffset)
+        Capacity = std::min(Capacity, OtherOffset - SectionOffset);
+    }
+    if (OutputSize > Capacity)
+      return createStringError(
+          errc::not_supported,
+          "ARM EHABI index %s needs 0x%" PRIx64
+          " bytes after fragment layout but has only 0x%" PRIx64
+          " bytes of exact linked capacity",
+          Section.getName().str().c_str(), OutputSize, Capacity);
+
+    // Retained SHT_REL records use the address of one of the two words in an
+    // input index entry.  Record the exact corresponding output word after
+    // sorting and ICF compaction.  An empty destination list deliberately
+    // removes relocations for a folded child entry.  This mapping is consumed
+    // while copying the non-allocatable relocation section later; rewriting
+    // only the allocatable bytes would leave misleading stale metadata.
+    DenseMap<const ExidxEntry *, SmallVector<size_t, 1>> OutputEntryIndices;
+    for (size_t I = 0; I < OutputEntries.size(); ++I)
+      OutputEntryIndices[OutputEntries[I].Input].push_back(I);
+    for (const ExidxEntry &Entry : Entries) {
+      for (const uint64_t FieldOffset : {uint64_t(0), uint64_t(4)}) {
+        const uint64_t InputFieldAddress =
+            Section.getAddress() + Entry.InputOffset + FieldOffset;
+        auto [It, Inserted] = ARMExidxRelocationAddressMap.try_emplace(
+            InputFieldAddress, SmallVector<uint64_t, 1>());
+        if (!Inserted)
+          return createStringError(
+              errc::executable_format_error,
+              "ARM EHABI relocation field 0x%" PRIx64
+              " belongs to multiple index sections",
+              InputFieldAddress);
+        const auto OutputIt = OutputEntryIndices.find(&Entry);
+        if (OutputIt != OutputEntryIndices.end())
+          for (const size_t OutputIndex : OutputIt->second)
+            It->second.push_back(Section.getAddress() + OutputIndex * 8 +
+                                 FieldOffset);
+      }
+    }
+
+    // Generic entries carry a personality PREL31 in .ARM.extab and may be
+    // followed by language-specific bytes.  Admit them only when the linked
+    // personality relocation survived as an exact symbolic identity, its
+    // final encoded value resolves to that identity, and every non-header
+    // byte in the table remains unchanged at the same address.
+    SmallVector<BinarySection *, 4> GenericSections;
+    for (const ExidxEntry &Entry : Entries)
+      if (Entry.PersonalityTarget &&
+          !llvm::is_contained(GenericSections, Entry.ExtabSection))
+        GenericSections.push_back(Entry.ExtabSection);
+    for (BinarySection *ExtabSection : GenericSections) {
+      const StringRef Input = ExtabSection->getContents();
+      const uint64_t OutputAddress = ExtabSection->getOutputAddress()
+                                         ? ExtabSection->getOutputAddress()
+                                         : ExtabSection->getAddress();
+      if (OutputAddress != ExtabSection->getAddress())
+        return createStringError(
+            errc::not_supported,
+            "ARM EHABI generic table %s changed address",
+            ExtabSection->getName().str().c_str());
+      uint8_t *NewExtabContents = new uint8_t[Input.size()];
+      memcpy(NewExtabContents, Input.data(), Input.size());
+
+      for (const ExidxEntry &Entry : Entries) {
+        if (!Entry.PersonalityTarget || Entry.ExtabSection != ExtabSection)
+          continue;
+        const uint64_t Offset =
+            Entry.ExtabTarget - ExtabSection->getAddress();
+        if (Offset > Input.size() ||
+            Input.size() - Offset < sizeof(uint32_t)) {
+          delete[] NewExtabContents;
+          return createStringError(
+              errc::executable_format_error,
+              "ARM EHABI generic entry at 0x%" PRIx64
+              " has no final personality word",
+              Entry.ExtabTarget);
+        }
+        const uint64_t PersonalityState = Entry.PersonalityTarget & 1;
+        const uint64_t OutputFunctionAddress =
+            getNewFunctionAddress(Entry.PersonalityTarget & ~uint64_t(1));
+        if (!OutputFunctionAddress) {
+          delete[] NewExtabContents;
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI generic personality identity 0x%" PRIx64
+              " has no final function address",
+              Entry.PersonalityTarget);
+        }
+        const uint64_t ExpectedPersonality =
+            OutputFunctionAddress | PersonalityState;
+        Expected<uint32_t> OutputPersonality =
+            EncodePrel31(ExpectedPersonality, OutputAddress + Offset);
+        if (!OutputPersonality) {
+          delete[] NewExtabContents;
+          return OutputPersonality.takeError();
+        }
+        WriteWord(reinterpret_cast<char *>(NewExtabContents + Offset),
+                  *OutputPersonality);
+      }
+
+      for (size_t I = 0; I < Input.size(); ++I) {
+        const bool IsPersonalityWord = llvm::any_of(
+            Entries, [&](const ExidxEntry &Entry) {
+              if (!Entry.PersonalityTarget ||
+                  Entry.ExtabSection != ExtabSection)
+                return false;
+              const uint64_t Offset =
+                  Entry.ExtabTarget - ExtabSection->getAddress();
+              return Offset <= I && I < Offset + sizeof(uint32_t);
+            });
+        if (!IsPersonalityWord &&
+            Input[I] != reinterpret_cast<char *>(NewExtabContents)[I]) {
+          delete[] NewExtabContents;
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI generic table %s changed opaque byte at offset "
+              "0x%zx",
+              ExtabSection->getName().str().c_str(), I);
+        }
+      }
+      ExtabSection->updateContents(NewExtabContents, Input.size());
+      ExtabSection->setOutputAddress(ExtabSection->getAddress());
+      ExtabSection->setOutputFileOffset(ExtabSection->getInputFileOffset());
+    }
+
+    uint8_t *NewContents = new uint8_t[OutputSize];
+    size_t ExternalCompactReferences = 0;
+    size_t ExternalGenericReferences = 0;
+    size_t RewrittenExternalRegisterPrograms = 0;
+    for (size_t I = 0; I < OutputEntries.size(); ++I) {
+      const ExidxEntry &Entry = *OutputEntries[I].Input;
+      const uint64_t Place = Section.getAddress() + I * 8;
+      Expected<uint32_t> FunctionPrel31 =
+          EncodePrel31(OutputEntries[I].OutputStart, Place);
+      if (!FunctionPrel31) {
+        delete[] NewContents;
+        return FunctionPrel31.takeError();
+      }
+      WriteWord(reinterpret_cast<char *>(NewContents + I * 8),
+                *FunctionPrel31);
+      uint32_t OutputUnwindWord = Entry.UnwindWord;
+      std::optional<std::pair<unsigned, unsigned>> RegisterReassignment;
+      for (const BinaryFunction *BF : Entry.Functions) {
+        const auto Current = BF->getFirmwareRegisterReassignment();
+        if (!Current) {
+          if (RegisterReassignment && Entry.UnwindWord != 1) {
+            delete[] NewContents;
+            return createStringError(
+                errc::not_supported,
+                "ARM EHABI range at 0x%" PRIx64
+                " mixes renamed and unchanged functions",
+                Entry.InputStart);
+          }
+          continue;
+        }
+        if (RegisterReassignment && RegisterReassignment != Current) {
+          delete[] NewContents;
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI range at 0x%" PRIx64
+              " contains different register reassignments",
+              Entry.InputStart);
+        }
+        RegisterReassignment = Current;
+      }
+      if (RegisterReassignment && Entry.UnwindWord != 1) {
+        if (Entry.ExtabSection) {
+          if (Entry.PersonalityTarget) {
+            delete[] NewContents;
+            return createStringError(
+                errc::not_supported,
+                "generic ARM EHABI program at 0x%" PRIx64
+                " cannot publish register reassignment",
+                Entry.ExtabTarget);
+          }
+          Expected<ARMUnwindRecord> Unwind = decodeARMUnwindRecord(
+              *BC, Entry.UnwindWord,
+              Section.getAddress() + Entry.InputOffset + sizeof(uint32_t));
+          if (!Unwind) {
+            delete[] NewContents;
+            return Unwind.takeError();
+          }
+          if (Unwind->Model != ARMUnwindModel::ExternalCompact ||
+              !Unwind->Compact) {
+            delete[] NewContents;
+            return createStringError(
+                errc::not_supported,
+                "external ARM EHABI program at 0x%" PRIx64
+                " is not a bounded compact record",
+                Entry.ExtabTarget);
+          }
+          const auto [A, B] = *RegisterReassignment;
+          if (Error E = RewriteExternalCompactProgram(*Unwind->Compact, A, B)) {
+            delete[] NewContents;
+            return E;
+          }
+          ++RewrittenExternalRegisterPrograms;
+        } else {
+          const auto [A, B] = *RegisterReassignment;
+          std::optional<uint32_t> Rewritten =
+              BC->MIB->rewriteInlineCompactUnwindRegisters(
+                  Entry.UnwindWord, A, B);
+          if (!Rewritten) {
+            delete[] NewContents;
+            return createStringError(
+                errc::not_supported,
+                "inline ARM EHABI program at 0x%" PRIx64
+                " cannot encode register reassignment",
+                Entry.InputStart);
+          }
+          OutputUnwindWord = *Rewritten;
+        }
+      }
+      if (Entry.ExtabSection) {
+        const uint64_t ExtabOffset =
+            Entry.ExtabTarget - Entry.ExtabSection->getAddress();
+        const uint64_t OutputSectionAddress =
+            Entry.ExtabSection->getOutputAddress()
+                ? Entry.ExtabSection->getOutputAddress()
+                : Entry.ExtabSection->getAddress();
+        Expected<uint32_t> ExtabPrel31 =
+            EncodePrel31(OutputSectionAddress + ExtabOffset,
+                         Place + sizeof(uint32_t));
+        if (!ExtabPrel31) {
+          delete[] NewContents;
+          return ExtabPrel31.takeError();
+        }
+        OutputUnwindWord = *ExtabPrel31;
+        if (Entry.PersonalityTarget)
+          ++ExternalGenericReferences;
+        else
+          ++ExternalCompactReferences;
+      }
+      WriteWord(reinterpret_cast<char *>(NewContents + I * 8 + 4),
+                OutputUnwindWord);
+    }
+    Section.updateContents(NewContents, OutputSize);
+    Section.setOutputAddress(Section.getAddress());
+    Section.setOutputFileOffset(Section.getInputFileOffset());
+    BC->outs() << "BOLT-INFO: rebuilt ARM EHABI index " << Section.getName()
+               << " with " << OutputEntries.size() << " live entries from "
+               << Entries.size() << " input entries, " << FoldedAliases
+               << " compatible folded alias(es), "
+               << ExternalCompactReferences
+               << " external compact reference(s), and "
+               << ExternalGenericReferences
+               << " relocation-complete generic reference(s) after function "
+                  "layout\n";
+    if (RewrittenExternalRegisterPrograms)
+      BC->outs() << "BOLT-INFO: rewrote "
+                 << RewrittenExternalRegisterPrograms
+                 << " ARM EHABI external compact register program(s) after "
+                    "function layout\n";
+    if (SplitFragments)
+      BC->outs() << "BOLT-INFO: ARM EHABI index " << Section.getName()
+                 << " published " << SplitFragments
+                 << " placed split fragment(s) through exact source unwind "
+                    "identities\n";
+  }
+
+  return Error::success();
+}
