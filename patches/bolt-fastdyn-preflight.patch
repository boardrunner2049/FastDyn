+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='byte_range_switch'); t=f['inline_jump_tables'][0]; print(','.join(f['firmware_modification_reasons']),f['original_size'],f['output_size'],t['kind'],t['original_entry_size'],t['output_entry_size'],t['entry_count'],len(f['instruction_origins'])); g=next(x for x in d['functions'] if x['name']=='halfword_range_switch'); u=g['inline_jump_tables'][0]; print(','.join(g['firmware_modification_reasons']),u['kind'],u['original_entry_size'],u['output_entry_size']); h=next(x for x in d['functions'] if x['name']=='odd_range_switch'); v=h['inline_jump_tables'][0]; print(','.join(h['firmware_modification_reasons']),h['original_size'],h['output_size'],v['kind'],v['original_entry_size'],v['output_entry_size'],v['entry_count'],v['original_trailing_byte_count'],v['output_trailing_byte_count'])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
