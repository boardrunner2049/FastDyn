index 0000000000000000000000000000000000000000..f92bcc1c85276b812bb9d4cd925b14d2af3ad2a2
--- /dev/null
+++ b/bolt/test/ARM/thumb-firmware-publication-policy.s
@@ -0,0 +1,61 @@
+## FOP itself preserves the guest instruction count by retaining a same-width
+## redundant move. Firm-BOLT's strict branch repair must also retain an explicit
+## branch to the next block, so the useful FOP body survives publication rather
+## than being rejected for an incidental CFG canonicalization.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 --emit-relocs -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=all --eliminate-unreachable=false \
