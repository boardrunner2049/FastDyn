+
+class ARMMCPlusBuilder final : public MCPlusBuilder {
+public:
+  using MCPlusBuilder::MCPlusBuilder;
+
+  std::unique_ptr<MCSymbolizer>
+  createTargetSymbolizer(BinaryFunction &Function,
+                         bool CreateNewSymbols) const override {
+    return std::make_unique<ARMMCSymbolizer>(Function, CreateNewSymbols);
+  }
+
+  bool hasThumb2() const { return STI->hasFeature(ARM::FeatureThumb2); }
+
+  bool isMoveToPC(const MCInst &Inst) const {
+    return (Inst.getOpcode() == ARM::tMOVr ||
+            Inst.getOpcode() == ARM::t2MOVr) &&
+           Inst.getNumOperands() >= 2 && Inst.getOperand(0).isReg() &&
+           Inst.getOperand(0).getReg() == ARM::PC &&
+           Inst.getOperand(1).isReg();
+  }
+
+  bool isBranch(const MCInst &Inst) const override {
+    return isMoveToPC(Inst) || Analysis->isBranch(Inst);
+  }
+
+  bool isTerminator(const MCInst &Inst) const override {
+    return isMoveToPC(Inst) || MCPlusBuilder::isTerminator(Inst);
+  }
+
+  bool isConditionalMove(const MCInst &Inst) const override {
+    const MCInstrDesc &Desc = Info->get(Inst.getOpcode());
+    if (!Desc.isMoveReg() && !Desc.isMoveImmediate())
+      return false;
+    return ARM_MC::isPredicated(Inst, Info);
+  }
+
+  bool isUnconditionalBranch(const MCInst &Inst) const override {
+    return isMoveToPC(Inst) || MCPlusBuilder::isUnconditionalBranch(Inst);
+  }
+
+  std::optional<uint32_t>
+  getInstructionSize(const MCInst &Inst) const override {
+    const unsigned Size = Info->get(Inst.getOpcode()).getSize();
+    if (Size == 2 || Size == 4)
+      return Size;
+    return std::nullopt;
+  }
+
+  MCPhysReg getStackPointer() const override { return ARM::SP; }
+  MCPhysReg getFramePointer() const override { return ARM::R7; }
+
+  MCPhysReg getFlagsReg() const override { return ARM::CPSR; }
+
+  MCPhysReg getIntArgRegister(unsigned ArgNo) const override {
+    static constexpr MCPhysReg ArgRegs[] = {ARM::R0, ARM::R1, ARM::R2,
+                                            ARM::R3};
+    return ArgNo < std::size(ArgRegs) ? ArgRegs[ArgNo] : getNoRegister();
+  }
+
+  bool isStackAccess(const MCInst &Inst, bool &IsLoad, bool &IsStore,
+                     bool &IsStoreFromReg, MCPhysReg &Reg, int32_t &SrcImm,
+                     uint16_t &StackPtrReg, int64_t &StackOffset,
+                     uint8_t &Size, bool &IsSimple,
+                     bool &IsIndexed) const override {
+    IsLoad = false;
+    IsStore = false;
+    IsStoreFromReg = false;
+    Reg = getNoRegister();
+    SrcImm = 0;
+    StackPtrReg = getNoRegister();
+    StackOffset = 0;
+    Size = 0;
+    IsSimple = false;
+    IsIndexed = false;
+
+    // These Thumb immediate load/store encodings all decode as
+    //   Rt, base, encoded-offset, predicate, predicate-register.
+    // Thumb-1 word and halfword forms retain their scaled immediate in the
+    // MCInst (unlike the Thumb-2 i8/i12 forms, whose operand is a byte
+    // displacement).  FrameAnalysis consumes byte offsets, so normalize the
+    // narrow encodings here.
+    // Pre/post-indexed and register-offset forms are deliberately excluded:
+    // they update or depend on additional architectural state.
+    unsigned OffsetScale = 1;
+    switch (Inst.getOpcode()) {
+    case ARM::tLDRspi:
+    case ARM::tLDRi:
+      OffsetScale = 4;
+      [[fallthrough]];
+    case ARM::t2LDRi12:
+    case ARM::t2LDRi8:
+      IsLoad = true;
+      Size = 4;
+      break;
+    case ARM::tSTRspi:
+    case ARM::tSTRi:
+      OffsetScale = 4;
+      [[fallthrough]];
+    case ARM::t2STRi12:
+    case ARM::t2STRi8:
+      IsStore = true;
+      IsStoreFromReg = true;
+      Size = 4;
+      break;
+    case ARM::tLDRBi:
+    case ARM::t2LDRBi12:
+    case ARM::t2LDRBi8:
+    case ARM::t2LDRSBi12:
+    case ARM::t2LDRSBi8:
+      IsLoad = true;
+      Size = 1;
+      break;
+    case ARM::tSTRBi:
+    case ARM::t2STRBi12:
+    case ARM::t2STRBi8:
+      IsStore = true;
+      IsStoreFromReg = true;
+      Size = 1;
+      break;
+    case ARM::tLDRHi:
+      OffsetScale = 2;
+      [[fallthrough]];
+    case ARM::t2LDRHi12:
+    case ARM::t2LDRHi8:
+    case ARM::t2LDRSHi12:
+    case ARM::t2LDRSHi8:
+      IsLoad = true;
+      Size = 2;
+      break;
+    case ARM::tSTRHi:
+      OffsetScale = 2;
+      [[fallthrough]];
+    case ARM::t2STRHi12:
+    case ARM::t2STRHi8:
+      IsStore = true;
+      IsStoreFromReg = true;
+      Size = 2;
+      break;
+    default:
+      return false;
+    }
+
+    if (Inst.getNumOperands() < 3 || !Inst.getOperand(0).isReg() ||
+        !Inst.getOperand(1).isReg() || !Inst.getOperand(2).isImm())
+      return false;
+    const MCPhysReg Base = Inst.getOperand(1).getReg();
+    if (Base != ARM::SP && Base != ARM::R7)
+      return false;
+
+    Reg = Inst.getOperand(0).getReg();
+    StackPtrReg = Base;
+    StackOffset = Inst.getOperand(2).getImm() * OffsetScale;
+    IsSimple = true;
+    return true;
+  }
+
+  bool isStackAdjustment(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    case ARM::tADDspi:
+    case ARM::tSUBspi:
+    case ARM::t2ADDspImm:
+    case ARM::t2ADDspImm12:
+    case ARM::t2SUBspImm:
+    case ARM::t2SUBspImm12:
+      break;
+    default:
+      return false;
+    }
+    return Inst.getNumOperands() >= 3 && Inst.getOperand(0).isReg() &&
+           Inst.getOperand(0).getReg() == ARM::SP &&
+           Inst.getOperand(1).isReg() &&
+           Inst.getOperand(1).getReg() == ARM::SP &&
+           Inst.getOperand(2).isImm();
+  }
+
+  bool evaluateStackOffsetExpr(
+      const MCInst &Inst, int64_t &Output,
+      std::pair<MCPhysReg, int64_t> Input1,
+      std::pair<MCPhysReg, int64_t> Input2) const override {
+    bool IsAdd = false;
+    unsigned Scale = 1;
+    switch (Inst.getOpcode()) {
+    case ARM::tADDspi:
+      IsAdd = true;
+      Scale = 4;
+      break;
+    case ARM::tSUBspi:
+      Scale = 4;
+      break;
+    case ARM::tADDrSPi:
+      IsAdd = true;
+      Scale = 4;
+      break;
+    case ARM::t2ADDspImm:
+    case ARM::t2ADDspImm12:
+    case ARM::t2ADDri:
+      IsAdd = true;
+      break;
+    case ARM::t2SUBspImm:
+    case ARM::t2SUBspImm12:
+    case ARM::t2SUBri:
+      break;
+    default:
+      return false;
+    }
+    if (Inst.getNumOperands() < 3 || !Inst.getOperand(0).isReg() ||
+        !Inst.getOperand(1).isReg() || !Inst.getOperand(2).isImm())
+      return false;
+    const MCPhysReg OutputReg = Inst.getOperand(0).getReg();
+    if (OutputReg != ARM::SP && OutputReg != ARM::R7)
+      return false;
+    const MCPhysReg InputReg = Inst.getOperand(1).getReg();
+    std::optional<int64_t> Input;
+    if (InputReg == Input1.first)
+      Input = Input1.second;
+    else if (InputReg == Input2.first)
+      Input = Input2.second;
+    if (!Input)
+      return false;
+    const int64_t Amount = Inst.getOperand(2).getImm() * Scale;
+    Output = IsAdd ? *Input + Amount : *Input - Amount;
+    return true;
+  }
+
+  bool isRegToRegMove(const MCInst &Inst, MCPhysReg &From,
+                      MCPhysReg &To) const override {
+    if (Inst.getOpcode() != ARM::tMOVr && Inst.getOpcode() != ARM::t2MOVr)
+      return false;
+    if (Inst.getNumOperands() < 2 || !Inst.getOperand(0).isReg() ||
+        !Inst.getOperand(1).isReg())
+      return false;
+    To = Inst.getOperand(0).getReg();
+    From = Inst.getOperand(1).getReg();
+    return true;
+  }
+
+  bool escapesVariable(const MCInst &Inst,
+                       bool HasFramePointer) const override {
+    bool IsLoad, IsStore, IsStoreFromReg, IsSimple, IsIndexed;
+    MCPhysReg Reg;
+    int32_t SrcImm;
+    uint16_t Base;
+    int64_t Offset;
+    uint8_t Size;
+    if (isStackAccess(Inst, IsLoad, IsStore, IsStoreFromReg, Reg, SrcImm,
+                      Base, Offset, Size, IsSimple, IsIndexed) ||
+        isStackAdjustment(Inst))
+      return false;
+
+    MCPhysReg From, To;
+    if (isRegToRegMove(Inst, From, To) &&
+        (From == ARM::SP || (HasFramePointer && From == ARM::R7)))
+      return To != ARM::SP && (!HasFramePointer || To != ARM::R7);
+
+    // A compiler may establish or adjust r7 with ADD.W/SUB.W instead of a
+    // plain move.  StackPointerTracking deliberately calls this routine with
+    // HasFramePointer=false to discover that fact; once r7 has been selected
+    // as the frame pointer, the same expression is internal frame arithmetic,
+    // not an escaped stack address.
+    if (HasFramePointer && Inst.getNumOperands() >= 2 &&
+        Inst.getOperand(0).isReg() &&
+        Inst.getOperand(0).getReg() == ARM::R7 &&
+        Inst.getOperand(1).isReg() &&
+        (Inst.getOperand(1).getReg() == ARM::SP ||
+         Inst.getOperand(1).getReg() == ARM::R7)) {
+      switch (Inst.getOpcode()) {
+      case ARM::tADDrSPi:
+      case ARM::t2ADDri:
+      case ARM::t2SUBri:
+        return false;
+      default:
+        break;
+      }
+    }
+
+    const unsigned NumDefs = Info->get(Inst.getOpcode()).getNumDefs();
+    for (unsigned I = NumDefs;
+         I < MCPlus::getNumPrimeOperands(Inst); ++I) {
+      const MCOperand &Operand = Inst.getOperand(I);
+      if (!Operand.isReg())
+        continue;
+      if (Operand.getReg() == ARM::SP ||
+          (HasFramePointer && Operand.getReg() == ARM::R7))
+        return true;
+    }
+    return false;
+  }
+
+  bool replaceMemOperandWithReg(MCInst &Inst,
+                                MCPhysReg RegNum) const override {
+    unsigned ReplacementOpcode = 0;
+    bool IsWideExtension = false;
+    switch (Inst.getOpcode()) {
+    case ARM::tLDRspi:
+    case ARM::tLDRi:
+    case ARM::t2LDRi12:
+    case ARM::t2LDRi8:
+      ReplacementOpcode = ARM::tMOVr;
+      break;
+    case ARM::tLDRBi:
+      if (!isARMLowRegister(RegNum))
+        return false;
+      ReplacementOpcode = ARM::tUXTB;
+      break;
+    case ARM::tLDRHi:
+      if (!isARMLowRegister(RegNum))
+        return false;
+      ReplacementOpcode = ARM::tUXTH;
+      break;
+    case ARM::t2LDRBi12:
+    case ARM::t2LDRBi8:
+      ReplacementOpcode = ARM::t2UXTB;
+      IsWideExtension = true;
+      break;
+    case ARM::t2LDRSBi12:
+    case ARM::t2LDRSBi8:
+      ReplacementOpcode = ARM::t2SXTB;
+      IsWideExtension = true;
+      break;
+    case ARM::t2LDRHi12:
+    case ARM::t2LDRHi8:
+      ReplacementOpcode = ARM::t2UXTH;
+      IsWideExtension = true;
+      break;
+    case ARM::t2LDRSHi12:
+    case ARM::t2LDRSHi8:
+      ReplacementOpcode = ARM::t2SXTH;
+      IsWideExtension = true;
+      break;
+    default:
+      return false;
+    }
+    if (!Inst.getNumOperands() || !Inst.getOperand(0).isReg())
+      return false;
+    const MCPhysReg Destination = Inst.getOperand(0).getReg();
+    MCInstBuilder Builder(ReplacementOpcode);
+    Builder.addReg(Destination).addReg(RegNum);
+    // Thumb-2 extension instructions carry a rotate field.  A reload of a
+    // byte/halfword stack slot is equivalent only to extension with rotate 0.
+    if (IsWideExtension)
+      Builder.addImm(0);
+    Builder.addImm(ARMCC::AL).addReg(0);
+    MCInst Replacement = Builder;
+    // Assignment would discard BOLT's offset, size, origin, and other generic
+    // annotations.  They are part of firmware identity and are also required
+    // by address-stable emission.
+    moveAnnotations(std::move(Inst), Replacement);
+    Inst = std::move(Replacement);
+    return true;
+  }
+
+  bool replaceMemOperandWithImm(MCInst &, StringRef,
+                                uint64_t) const override {
+    // Immediate materialization has target-dependent flag and width choices.
+    // Keep it unavailable until those choices are represented explicitly.
+    return false;
+  }
+
+  bool replaceRegWithImm(MCInst &Inst, unsigned Register,
+                         int64_t Imm) const override {
+    // Tail-duplication propagation calls this hook only for uses reached from
+    // a dominating move-immediate.  Keep the target hook narrower still:
+    // replace one non-def GPR source, preserve flag/predicate operands exactly
+    // and select only an immediate opcode whose architectural value is
+    // encodable.  In particular, never turn flag-preserving Thumb-1 MOV into
+    // MOVS merely because the constant fits.
+    if (Register < ARM::R0 || Register > ARM::R12)
+      return false;
+
+    const unsigned Opcode = Inst.getOpcode();
+    unsigned NewOpcode = 0;
+    unsigned RegisterOperand = 0;
+    unsigned OtherSourceOperand = 0;
+    bool Commutative = false;
+    bool NarrowThreeOperand = false;
+    bool NarrowCompare = false;
+    bool WideCompare = false;
+    bool WideMove = false;
+
+    switch (Opcode) {
+    case ARM::tADDrr:
+      NewOpcode = ARM::tADDi3;
+      Commutative = true;
+      NarrowThreeOperand = true;
+      break;
+    case ARM::tSUBrr:
+      NewOpcode = ARM::tSUBi3;
+      NarrowThreeOperand = true;
+      break;
+    case ARM::tCMPr:
+      NewOpcode = ARM::tCMPi8;
+      NarrowCompare = true;
+      break;
+    case ARM::t2ADDrr:
+      NewOpcode = ARM::t2ADDri;
+      Commutative = true;
+      break;
+    case ARM::t2SUBrr:
+      NewOpcode = ARM::t2SUBri;
+      break;
+    case ARM::t2ANDrr:
+      NewOpcode = ARM::t2ANDri;
+      Commutative = true;
+      break;
+    case ARM::t2ORRrr:
+      NewOpcode = ARM::t2ORRri;
+      Commutative = true;
+      break;
+    case ARM::t2EORrr:
+      NewOpcode = ARM::t2EORri;
+      Commutative = true;
+      break;
+    case ARM::t2CMPrr:
+      NewOpcode = ARM::t2CMPri;
+      WideCompare = true;
+      break;
+    case ARM::t2MOVr:
+      NewOpcode = ARM::t2MOVi;
+      WideMove = true;
+      break;
+    default:
+      return false;
+    }
+
+    if (NarrowCompare) {
+      if (Inst.getNumOperands() < 4 || !isUInt<8>(Imm) ||
+          !Inst.getOperand(0).isReg() ||
+          !Inst.getOperand(1).isReg() ||
+          Inst.getOperand(1).getReg() != Register ||
+          Inst.getOperand(0).getReg() == Register)
+        return false;
+      MCInst Replacement =
+          MCInstBuilder(NewOpcode)
+              .addReg(Inst.getOperand(0).getReg())
+              .addImm(Imm)
+              .addImm(Inst.getOperand(2).getImm())
+              .addReg(Inst.getOperand(3).getReg());
+      moveAnnotations(std::move(Inst), Replacement);
+      Inst = std::move(Replacement);
+      return true;
+    }
+
+    if (WideCompare) {
+      if (Inst.getNumOperands() < 4 ||
+          ARM_AM::getT2SOImmVal(static_cast<uint32_t>(Imm)) == -1 ||
+          !Inst.getOperand(0).isReg() ||
+          !Inst.getOperand(1).isReg() ||
+          Inst.getOperand(1).getReg() != Register ||
+          Inst.getOperand(0).getReg() == Register)
+        return false;
+      MCInst Replacement =
+          MCInstBuilder(NewOpcode)
+              .addReg(Inst.getOperand(0).getReg())
+              .addImm(Imm)
+              .addImm(Inst.getOperand(2).getImm())
+              .addReg(Inst.getOperand(3).getReg());
+      moveAnnotations(std::move(Inst), Replacement);
+      Inst = std::move(Replacement);
+      return true;
+    }
+
+    if (WideMove) {
+      if (Inst.getNumOperands() < 5 ||
+          ARM_AM::getT2SOImmVal(static_cast<uint32_t>(Imm)) == -1 ||
+          !Inst.getOperand(0).isReg() ||
+          Inst.getOperand(0).getReg() == Register ||
+          !Inst.getOperand(1).isReg() ||
+          Inst.getOperand(1).getReg() != Register)
+        return false;
+      MCInst Replacement =
+          MCInstBuilder(NewOpcode)
+              .addReg(Inst.getOperand(0).getReg())
+              .addImm(Imm)
+              .addImm(Inst.getOperand(2).getImm())
+              .addReg(Inst.getOperand(3).getReg())
+              .addReg(Inst.getOperand(4).getReg());
+      moveAnnotations(std::move(Inst), Replacement);
+      Inst = std::move(Replacement);
+      return true;
+    }
+
+    // Register arithmetic has destination, optional CPSR definition, then two
+    // sources.  Do not replace a source that aliases the destination: the
+    // propagation pass must retain its defining move in that case.
+    const unsigned FirstSource = NarrowThreeOperand ? 2 : 1;
+    const unsigned SecondSource = NarrowThreeOperand ? 3 : 2;
+    if (Inst.getNumOperands() <= SecondSource ||
+        !Inst.getOperand(0).isReg() ||
+        !Inst.getOperand(FirstSource).isReg() ||
+        !Inst.getOperand(SecondSource).isReg() ||
+        Inst.getOperand(0).getReg() == Register)
+      return false;
+    if (Inst.getOperand(SecondSource).getReg() == Register) {
+      RegisterOperand = SecondSource;
+      OtherSourceOperand = FirstSource;
+    } else if (Commutative &&
+               Inst.getOperand(FirstSource).getReg() == Register) {
+      RegisterOperand = FirstSource;
+      OtherSourceOperand = SecondSource;
+    } else {
+      return false;
+    }
+    (void)RegisterOperand;
+
+    MCPhysReg OtherSource = Inst.getOperand(OtherSourceOperand).getReg();
+    if (NarrowThreeOperand) {
+      if (!isARMLowRegister(Inst.getOperand(0).getReg()) ||
+          !isARMLowRegister(OtherSource))
+        return false;
+      // The two-address 8-bit form is available when the surviving source is
+      // also the destination; otherwise use the exact three-bit form.
+      if (Inst.getOperand(0).getReg() == OtherSource && isUInt<8>(Imm))
+        NewOpcode = Opcode == ARM::tADDrr ? ARM::tADDi8 : ARM::tSUBi8;
+      else if (!isUInt<3>(Imm))
+        return false;
+      MCInst Replacement =
+          MCInstBuilder(NewOpcode)
+              .addReg(Inst.getOperand(0).getReg())
+              .addReg(Inst.getOperand(1).getReg())
+              .addReg(OtherSource)
+              .addImm(Imm)
+              .addImm(Inst.getOperand(4).getImm())
+              .addReg(Inst.getOperand(5).getReg());
+      moveAnnotations(std::move(Inst), Replacement);
+      Inst = std::move(Replacement);
+      return true;
+    }
+
+    if (!hasThumb2() ||
+        ARM_AM::getT2SOImmVal(static_cast<uint32_t>(Imm)) == -1)
+      return false;
+    MCInst Replacement =
+        MCInstBuilder(NewOpcode)
+            .addReg(Inst.getOperand(0).getReg())
+            .addReg(OtherSource)
+            .addImm(Imm)
+            .addImm(Inst.getOperand(3).getImm())
+            .addReg(Inst.getOperand(4).getReg())
+            .addReg(Inst.getOperand(5).getReg());
+    moveAnnotations(std::move(Inst), Replacement);
+    Inst = std::move(Replacement);
+    return true;
+  }
+
+  bool replaceRegWithReg(MCInst &Inst, unsigned ToReplace,
+                         unsigned ReplaceWith) const override {
+    if (ToReplace < ARM::R0 || ToReplace > ARM::R12 ||
+        ReplaceWith < ARM::R0 || ReplaceWith > ARM::R12 ||
+        ToReplace == ReplaceWith)
+      return false;
+
+    const MCInstrDesc &Desc = Info->get(Inst.getOpcode());
+    const unsigned NumPrimeOperands = MCPlus::getNumPrimeOperands(Inst);
+    const unsigned NumDefs = Desc.getNumDefs();
+    if (NumDefs > NumPrimeOperands)
+      return false;
+    for (unsigned I = 0; I < NumDefs; ++I)
+      if (Inst.getOperand(I).isReg() &&
+          getAliases(ToReplace).test(Inst.getOperand(I).getReg()))
+        return false;
+
+    SmallVector<unsigned, 2> Uses;
+    for (unsigned I = NumDefs; I < NumPrimeOperands; ++I) {
+      const MCOperand &Operand = Inst.getOperand(I);
+      if (!Operand.isReg() || Operand.getReg() != ToReplace)
+        continue;
+      if (I >= Desc.getNumOperands() ||
+          Desc.getOperandConstraint(I, MCOI::TIED_TO) != -1)
+        return false;
+      const MCOperandInfo &OperandInfo = Desc.operands()[I];
+      if (OperandInfo.OperandType != MCOI::OPERAND_REGISTER ||
+          OperandInfo.RegClass < 0 ||
+          static_cast<unsigned>(OperandInfo.RegClass) >=
+              RegInfo->getNumRegClasses() ||
+          !RegInfo->getRegClass(OperandInfo.RegClass).contains(ReplaceWith))
+        return false;
+      Uses.push_back(I);
+    }
+    if (Uses.empty())
+      return false;
+    for (unsigned I : Uses)
+      Inst.getOperand(I) = MCOperand::createReg(ReplaceWith);
+    return true;
+  }
+
+  bool addToImm(MCInst &Inst, int64_t &Amt, MCContext *) const override {
+    const unsigned Opcode = Inst.getOpcode();
+    bool WasSub = false;
+    bool WasWide = false;
+    unsigned Scale = 1;
+    switch (Opcode) {
+    case ARM::tADDspi:
+      Scale = 4;
+      break;
+    case ARM::tSUBspi:
+      WasSub = true;
+      Scale = 4;
+      break;
+    case ARM::t2ADDspImm:
+    case ARM::t2ADDspImm12:
+      WasWide = true;
+      break;
+    case ARM::t2SUBspImm:
+    case ARM::t2SUBspImm12:
+      WasSub = true;
+      WasWide = true;
+      break;
+    default:
+      return false;
+    }
+    if (Inst.getNumOperands() < 3 || !Inst.getOperand(2).isImm())
+      return false;
+
+    const int64_t CurrentMagnitude = Inst.getOperand(2).getImm() * Scale;
+    const int64_t RelativeMagnitude = CurrentMagnitude + Amt;
+    const bool FinalSub = RelativeMagnitude < 0 ? !WasSub : WasSub;
+    const uint64_t FinalMagnitude =
+        RelativeMagnitude < 0 ? uint64_t(-RelativeMagnitude)
+                              : uint64_t(RelativeMagnitude);
+    if (FinalMagnitude > 4095)
+      return false;
+
+    MCInstBuilder Builder(0);
+    if (!WasWide && FinalMagnitude <= 508 && !(FinalMagnitude & 3)) {
+      Builder = MCInstBuilder(FinalSub ? ARM::tSUBspi : ARM::tADDspi)
+                    .addReg(ARM::SP)
+                    .addReg(ARM::SP)
+                    .addImm(FinalMagnitude / 4)
+                    .addImm(ARMCC::AL)
+                    .addReg(0);
+    } else {
+      // ADDW/SUBW accept the complete 12-bit immediate without relying on the
+      // target-dependent modified-immediate subset used by ADD.W/SUB.W.
+      Builder = MCInstBuilder(FinalSub ? ARM::t2SUBspImm12
+                                       : ARM::t2ADDspImm12)
+                    .addReg(ARM::SP)
+                    .addReg(ARM::SP)
+                    .addImm(FinalMagnitude)
+                    .addImm(ARMCC::AL)
+                    .addReg(0);
+    }
+    MCInst Replacement = Builder;
+    moveAnnotations(std::move(Inst), Replacement);
+    Inst = std::move(Replacement);
+    Amt = FinalSub ? -int64_t(FinalMagnitude) : int64_t(FinalMagnitude);
+    return true;
+  }
+
+  bool isRedundantMove(const MCInst &Inst) const override {
+    MCPhysReg From, To;
+    return isRegToRegMove(Inst, From, To) && From == To;
+  }
+
+  bool isCleanReg(const MCInst &Inst) const override {
+    // Liveness may discard the previous destination value when EOR's two
+    // inputs are the same physical register.  Keep this deliberately narrow:
+    // other logical aliases and immediate materializations are already
+    // handled correctly by generic use/def analysis.
+    if (Inst.getOpcode() == ARM::tEOR)
+      return Inst.getNumOperands() >= 4 && Inst.getOperand(2).isReg() &&
+             Inst.getOperand(3).isReg() &&
+             Inst.getOperand(2).getReg() == Inst.getOperand(3).getReg();
+    if (Inst.getOpcode() == ARM::t2EORrr)
+      return Inst.getNumOperands() >= 3 && Inst.getOperand(1).isReg() &&
+             Inst.getOperand(2).isReg() &&
+             Inst.getOperand(1).getReg() == Inst.getOperand(2).getReg();
+    return false;
+  }
+
+  bool isExclusiveLoad(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    case ARM::LDREX:
+    case ARM::LDREXB:
+    case ARM::LDREXH:
+    case ARM::LDREXD:
+    case ARM::LDAEX:
+    case ARM::LDAEXB:
+    case ARM::LDAEXH:
+    case ARM::LDAEXD:
+    case ARM::t2LDREX:
+    case ARM::t2LDREXB:
+    case ARM::t2LDREXH:
+    case ARM::t2LDREXD:
+    case ARM::t2LDAEX:
+    case ARM::t2LDAEXB:
+    case ARM::t2LDAEXH:
+    case ARM::t2LDAEXD:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+  bool isExclusiveStore(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    case ARM::STREX:
+    case ARM::STREXB:
+    case ARM::STREXH:
+    case ARM::STREXD:
+    case ARM::STLEX:
+    case ARM::STLEXB:
+    case ARM::STLEXH:
+    case ARM::STLEXD:
+    case ARM::t2STREX:
+    case ARM::t2STREXB:
+    case ARM::t2STREXH:
+    case ARM::t2STREXD:
+    case ARM::t2STLEX:
+    case ARM::t2STLEXB:
+    case ARM::t2STLEXH:
+    case ARM::t2STLEXD:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+  bool isExclusiveClear(const MCInst &Inst) const override {
+    return Inst.getOpcode() == ARM::CLREX ||
+           Inst.getOpcode() == ARM::t2CLREX;
+  }
+
+  bool requiresAlignedAddress(const MCInst &Inst) const override {
+    // Alignment behavior differs across M-profile generations and can also be
+    // tightened by CCR.UNALIGN_TRP.  Conservatively propagate the alignment
+    // requirement for every decoded memory operation; this affects frame
+    // analysis eligibility, not the architectural memory event itself.
+    const MCInstrDesc &Desc = Info->get(Inst.getOpcode());
+    return Desc.mayLoad() || Desc.mayStore();
+  }
+
+  BitVector getRegsUsedAsParams() const override {
+    BitVector Regs(RegInfo->getNumRegs(), false);
+    for (MCPhysReg Reg : {ARM::R0, ARM::R1, ARM::R2, ARM::R3})
+      Regs |= getAliases(Reg);
+    return Regs;
+  }
+
+  void getCalleeSavedRegs(BitVector &Regs) const override {
+    for (MCPhysReg Reg : {ARM::R4, ARM::R5, ARM::R6, ARM::R7, ARM::R8,
+                          ARM::R9, ARM::R10, ARM::R11, ARM::SP})
+      Regs |= getAliases(Reg);
+  }
+
+  void getDefaultLiveOut(BitVector &Regs) const override {
+    Regs |= getAliases(ARM::R0);
+    Regs |= getAliases(ARM::R1);
+  }
+
+  void getGPRegs(BitVector &Regs, bool IncludeAlias = true) const override {
+    for (MCPhysReg Reg = ARM::R0; Reg <= ARM::R12; ++Reg) {
+      if (IncludeAlias)
+        Regs |= getAliases(Reg);
+      else
+        Regs.set(Reg);
+    }
+  }
+
+  void removeNonScavengeableRegs(BitVector &Regs) const override {
+    // R7 and R11 are the AAPCS frame-pointer choices.  R9 may be the platform
+    // register (SB/TR) and cannot be borrowed without an explicit platform
+    // contract.  SP/LR/PC/CPSR are not returned by getGPRegs in the first
+    // place, but clearing their aliases keeps this hook correct for callers
+    // that supply a broader set.
+    for (MCPhysReg Reg :
+         {ARM::R7, ARM::R9, ARM::R11, ARM::SP, ARM::LR, ARM::PC, ARM::CPSR}) {
+      BitVector Allowed = getAliases(Reg);
+      Allowed.flip();
+      Regs &= Allowed;
+    }
+  }
+
+  bool isIndirectCall(const MCInst &Inst) const override {
+    if (!Info->get(Inst.getOpcode()).isCall())
+      return false;
+    return StringSwitch<bool>(Info->getName(Inst.getOpcode()))
+        .Cases({"tBLXr", "tBLXr_noip", "tBX_CALL"}, true)
+        .Default(false);
+  }
+
+  bool isReturn(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    case ARM::tBX_RET:
+    case ARM::tPOP_RET:
+    case ARM::t2LDMIA_RET:
+      return true;
+    case ARM::tBX:
+      return Inst.getNumOperands() && Inst.getOperand(0).isReg() &&
+             Inst.getOperand(0).getReg() == ARM::LR;
+    case ARM::tPOP:
+    case ARM::t2LDMIA_UPD:
+      return llvm::any_of(MCPlus::primeOperands(Inst),
+                          [](const MCOperand &Operand) {
+                            return Operand.isReg() &&
+                                   Operand.getReg() == ARM::PC;
+                          });
+    default:
+      return Analysis->isReturn(Inst);
+    }
+  }
+
+  bool isIndirectBranch(const MCInst &Inst) const override {
+    // LLVM's generic ARM instruction descriptors classify BX LR and
+    // load-multiple-to-PC as indirect branches.  For BOLT CFG purposes they
+    // are returns; leaving both classifications set routes them through jump
+    // table/tail-call recovery and rejects otherwise ordinary firmware.
+    return !isReturn(Inst) &&
+           (isMoveToPC(Inst) || Analysis->isIndirectBranch(Inst));
+  }
+
+  bool isBranchOnReg(const MCInst &Inst) const override {
+    if (isMoveToPC(Inst))
+      return true;
+    return StringSwitch<bool>(Info->getName(Inst.getOpcode()))
+        .Cases({"tBX", "tBXNS", "tBRIND"}, true)
+        .Default(isIndirectCall(Inst));
+  }
+
+  bool isBranchOnMem(const MCInst &) const override { return false; }
+
+  bool hasPCRelOperand(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    case ARM::tADR:
+    case ARM::tLDRpci:
+    case ARM::t2ADR:
+    case ARM::t2LDRpci:
+    case ARM::t2LDRBpci:
+    case ARM::t2LDRHpci:
+    case ARM::t2LDRSBpci:
+    case ARM::t2LDRSHpci:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+  MCInst::iterator getMemOperandDisp(MCInst &Inst) const override {
+    if (!hasPCRelOperand(Inst) || Inst.getNumOperands() < 2)
+      return Inst.end();
+    return std::next(Inst.begin());
+  }
+
+  bool evaluateMemOperandTarget(const MCInst &Inst, uint64_t &Target,
+                                uint64_t Address,
+                                uint64_t) const override {
+    if (!hasPCRelOperand(Inst) || Inst.getNumOperands() < 2)
+      return false;
+    const MCOperand &Operand = Inst.getOperand(1);
+    if (!Operand.isImm())
+      return false;
+    // LLVM's Thumb-1 decoders expose the literal-load displacement in bytes,
+    // but expose ADR's encoded imm8 in word units (see
+    // DecodeThumbAddSpecialReg).  Treating the latter as bytes produces odd
+    // synthetic data targets (and can turn a constant-pool reference into an
+    // apparent alternate code entry).
+    const int64_t Displacement =
+        Inst.getOpcode() == ARM::tADR ? Operand.getImm() * 4
+                                     : Operand.getImm();
+    Target = alignDown(Address + 4, uint64_t(4)) + Displacement;
+    return true;
+  }
+
+  bool symbolizePCRelOperand(BinaryFunction &Function, MCInst &Inst,
+                             uint64_t Address,
+                             uint64_t Size) const override {
+    // Thumb-1 ADR/LDR literals can address only a forward, word-aligned
+    // 0--1020 byte window.  Small functions can use BOLT's ordinary aggregate
+    // island placement.  Larger functions remain fully decoded, but require
+    // address-stable emission so their interleaved pools retain the exact
+    // offsets for which the original encodings were linked.
+    uint64_t Target = 0;
+    if (!evaluateMemOperandTarget(Inst, Target, Address, Size))
+      return false;
+    if (Inst.getOpcode() == ARM::tLDRpci || Inst.getOpcode() == ARM::tADR) {
+      // An island owned by this function is emitted with the replacement and
+      // can be kept in the qualified span.  A reference to independently
+      // placed data would require pinning the instruction's exact offset (or
+      // range-aware island cloning); ordinary CFG edits can otherwise move it
+      // behind the target or beyond 1020 bytes.
+      const bool OwnsTarget =
+          Function.containsAddress(Target, /*UseMaxSize=*/true) ||
+          Function.getOrCreateIslandAccess(Target) != nullptr;
+      const uint64_t EarliestPC =
+          alignDown(Function.getAddress() + 4, uint64_t(4));
+      const uint64_t LatestInstruction =
+          Function.getAddress() + Function.getMaxSize() - 2;
+      const uint64_t LatestPC =
+          alignDown(LatestInstruction + 4, uint64_t(4));
+      const bool FixedTargetReachableForWholeRange =
+          !(Target & 3) && Target >= LatestPC && Target <= EarliestPC + 1020;
+      const bool Qualified =
+          (OwnsTarget && Function.getMaxSize() <= 1020) ||
+          FixedTargetReachableForWholeRange;
+      const bool AddressStable = !Qualified && OwnsTarget && !(Target & 3) &&
+                                 Target >= Address && Target <= Address + 1020 &&
+                                 Target < Function.getAddress() +
+                                              Function.getSize();
+      if (AddressStable)
+        Function.setRequiresAddressStableLayout(
+            BinaryFunction::AddressStabilityReason::ThumbPCRelative);
+      else if (!Qualified)
+        Function.setSimple(false);
+      if (opts::Verbosity >= 2)
+        Function.getBinaryContext().outs()
+            << "BOLT-INFO: Thumb-1 PC-relative "
+            << (Qualified ? "qualified"
+                          : AddressStable ? "address-stable" : "retained")
+            << " in "
+            << Function.getPrintName() << " at 0x"
+            << Twine::utohexstr(Address) << " -> 0x"
+            << Twine::utohexstr(Target) << " (owns-target=" << OwnsTarget
+            << ", fixed-range=" << FixedTargetReachableForWholeRange
+            << ", max-size=" << Function.getMaxSize() << ")\n";
+    }
+    BinaryContext &BC = Function.getBinaryContext();
+    const MCSymbol *Symbol;
+    uint64_t Addend;
+    std::tie(Symbol, Addend) =
+        BC.handleAddressRef(Target, Function, /*IsPCRel=*/true);
+    const MCExpr *Expr = MCSymbolRefExpr::create(Symbol, *BC.Ctx);
+    if (Addend)
+      Expr = MCBinaryExpr::createAdd(
+          Expr, MCConstantExpr::create(Addend, *BC.Ctx), *BC.Ctx);
+    Inst.getOperand(1) = MCOperand::createExpr(Expr);
+    return true;
+  }
+
+  bool convertJmpToTailCall(MCInst &Inst) override {
+    if (!isBranch(Inst) || isTailCall(Inst))
+      return false;
+    setTailCall(Inst);
+    return true;
+  }
+
+  bool convertTailCallToJmp(MCInst &Inst) override {
+    removeAnnotation(Inst, MCPlus::MCAnnotation::kTailCall);
+    return true;
+  }
+
+  bool convertTailCallToCall(MCInst &Inst) override {
+    unsigned NewOpcode = 0;
+    switch (Inst.getOpcode()) {
+    case ARM::tB:
+    case ARM::t2B:
+      NewOpcode = ARM::tBL;
+      break;
+    case ARM::tBX:
+      NewOpcode = ARM::tBLXr;
+      break;
+    default:
+      return false;
+    }
+    Inst.setOpcode(NewOpcode);
+    removeAnnotation(Inst, MCPlus::MCAnnotation::kTailCall);
+    clearOffset(Inst);
+    return true;
+  }
+
+  bool lowerTailCall(MCInst &Inst) override {
+    removeAnnotation(Inst, MCPlus::MCAnnotation::kTailCall);
+    if (getConditionalTailCall(Inst))
+      unsetConditionalTailCall(Inst);
+    return true;
+  }
+
+  bool isNoop(const MCInst &Inst) const override {
+    StringRef Name = Info->getName(Inst.getOpcode());
+    if (Name == "tNOP" || Name == "t2NOP")
+      return true;
+    return (Name == "tHINT" || Name == "t2HINT") &&
+           Inst.getNumOperands() && Inst.getOperand(0).isImm() &&
+           Inst.getOperand(0).getImm() == 0;
+  }
+
+  bool isBreakpoint(const MCInst &Inst) const override {
+    return Info->getName(Inst.getOpcode()) == "tBKPT";
+  }
+
+  bool isTrap(const MCInst &Inst) const override {
+    return Info->getName(Inst.getOpcode()).starts_with("tUDF");
+  }
+
+  StringRef getTrapFillValue() const override {
+    // Thumb UDF #0, in little-endian byte order.
+    static const char Trap[] = {char(0x00), char(0xde)};
+    return StringRef(Trap, sizeof(Trap));
+  }
+
+  void createTrap(MCInst &Inst) const override {
+    Inst = MCInstBuilder(ARM::tUDF).addImm(0);
+  }
+
+  void createBreakpoint(MCInst &Inst) const override {
+    Inst = MCInstBuilder(ARM::tBKPT).addImm(0);
+  }
+
+  void createStackPointerIncrement(MCInst &Inst, int Size,
+                                   bool = false) const override {
+    assert(Size >= 0 && "negative ARM stack allocation");
+    if (Size <= 508 && !(Size & 3)) {
+      Inst = MCInstBuilder(ARM::tSUBspi)
+                 .addReg(ARM::SP)
+                 .addReg(ARM::SP)
+                 .addImm(Size / 4)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+      return;
+    }
+    assert(hasThumb2() && Size <= 4095 &&
+           "ARM stack allocation does not fit one instruction");
+    Inst = MCInstBuilder(ARM::t2SUBspImm12)
+               .addReg(ARM::SP)
+               .addReg(ARM::SP)
+               .addImm(Size)
+               .addImm(ARMCC::AL)
+               .addReg(0);
+  }
+
+  void createStackPointerDecrement(MCInst &Inst, int Size,
+                                   bool = false) const override {
+    assert(Size >= 0 && "negative ARM stack deallocation");
+    if (Size <= 508 && !(Size & 3)) {
+      Inst = MCInstBuilder(ARM::tADDspi)
+                 .addReg(ARM::SP)
+                 .addReg(ARM::SP)
+                 .addImm(Size / 4)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+      return;
+    }
+    assert(hasThumb2() && Size <= 4095 &&
+           "ARM stack deallocation does not fit one instruction");
+    Inst = MCInstBuilder(ARM::t2ADDspImm12)
+               .addReg(ARM::SP)
+               .addReg(ARM::SP)
+               .addImm(Size)
+               .addImm(ARMCC::AL)
+               .addReg(0);
+  }
+
+  bool isPush(const MCInst &Inst) const override {
+    return Inst.getOpcode() == ARM::tPUSH ||
+           Inst.getOpcode() == ARM::t2STMDB_UPD;
+  }
+
+  bool isPop(const MCInst &Inst) const override {
+    return Inst.getOpcode() == ARM::tPOP ||
+           Inst.getOpcode() == ARM::tPOP_RET ||
+           Inst.getOpcode() == ARM::t2LDMIA_UPD ||
+           Inst.getOpcode() == ARM::t2LDMIA_RET;
+  }
+
+  // Cortex-M indirect tail calls commonly follow a callee-saved register
+  // restore.  Without an ARM implementation of this target hook, BOLT treats
+  // the same multi-block epilogue that x86/AArch64 recognize as an unknown
+  // computed jump and discards its call profile.  Stay conservative: require
+  // a terminal block, reject a stack save in the same block, and require an
+  // actual POP/LDMIA stack restore (or an ordinary return).
+  bool isEpilogue(const BinaryBasicBlock &BB) const override {
+    if (BB.succ_size())
+      return false;
+
+    bool SawStackRestore = false;
+    for (auto It = BB.rbegin(); It != BB.rend(); ++It) {
+      const MCInst &Inst = *It;
+      if (isCFI(Inst))
+        continue;
+      if (isReturn(Inst))
+        return true;
+      if (isPush(Inst)) {
+        const bool SavesLR = llvm::any_of(
+            llvm::make_range(Inst.begin(),
+                             Inst.begin() + MCPlus::getNumPrimeOperands(Inst)),
+            [](const MCOperand &Operand) {
+              return Operand.isReg() && Operand.getReg() == ARM::LR;
+            });
+        if (SavesLR)
+          return false;
+      }
+      if (isPop(Inst))
+        SawStackRestore = true;
+    }
+    return SawStackRestore;
+  }
+
+  int getPushSize(const MCInst &Inst) const override {
+    if (!isPush(Inst))
+      return 0;
+    unsigned SavedRegisters = 0;
+    for (unsigned I = 0; I < MCPlus::getNumPrimeOperands(Inst); ++I) {
+      const MCOperand &Operand = Inst.getOperand(I);
+      if (!Operand.isReg() || !Operand.getReg() ||
+          Operand.getReg() == ARM::SP || Operand.getReg() == ARM::CPSR)
+        continue;
+      ++SavedRegisters;
+    }
+    return 4 * SavedRegisters;
+  }
+
+  int getPopSize(const MCInst &Inst) const override {
+    if (!isPop(Inst))
+      return 0;
+    unsigned RestoredRegisters = 0;
+    for (unsigned I = 0; I < MCPlus::getNumPrimeOperands(Inst); ++I) {
+      const MCOperand &Operand = Inst.getOperand(I);
+      if (!Operand.isReg() || !Operand.getReg() ||
+          Operand.getReg() == ARM::SP || Operand.getReg() == ARM::CPSR)
+        continue;
+      ++RestoredRegisters;
+    }
+    return 4 * RestoredRegisters;
+  }
+
+  bool isSUB(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    case ARM::tSUBspi:
+    case ARM::t2SUBspImm:
+    case ARM::t2SUBspImm12:
+    case ARM::tSUBi3:
+    case ARM::tSUBi8:
+    case ARM::tSUBrr:
+    case ARM::t2SUBri:
+    case ARM::t2SUBrr:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+  bool isLEA64r(const MCInst &) const override { return false; }
+
+  bool shortenInstruction(MCInst &Inst,
+                          const MCSubtargetInfo &) const override {
+    // Wide and narrow Thumb branches have identical prime operands and
+    // architectural effects.  Start compact and let the final MC relaxation
+    // widen an edge again if block placement exceeds the T1/T2 range.  Do not
+    // shorten arithmetic or moves here: many narrow forms update APSR while
+    // their wide counterparts do not.
+    switch (Inst.getOpcode()) {
+    case ARM::t2B:
+      Inst.setOpcode(ARM::tB);
+      setSize(Inst, 2);
+      return true;
+    case ARM::t2Bcc:
+      Inst.setOpcode(ARM::tBcc);
+      setSize(Inst, 2);
+      return true;
+    default:
+      return false;
+    }
+  }
+
+  bool isReversibleBranch(const MCInst &Inst,
+                          bool = true) const override {
+    return Inst.getOpcode() == ARM::tBcc ||
+           Inst.getOpcode() == ARM::t2Bcc;
+  }
+
+  int getPCRelEncodingSize(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    case ARM::tCBZ:
+    case ARM::tCBNZ:
+      return 7;
+    case ARM::tBcc:
+      return 9;
+    case ARM::tB:
+      return 12;
+    case ARM::t2Bcc:
+      return 21;
+    case ARM::t2B:
+    case ARM::tBL:
+    case ARM::tBLXi:
+      return 25;
+    default:
+      // Direct branch forms admitted by the Cortex-M decoder but not listed
+      // above are left to MC/linker range checking rather than guessed.
+      return 32;
+    }
+  }
+
+  bool isBranchOffsetInRange(const MCInst &Inst,
+                             int64_t Offset) const override {
+    if (Offset & 1)
+      return false;
+    switch (Inst.getOpcode()) {
+    case ARM::tCBZ:
+    case ARM::tCBNZ:
+      // Encoded immediate is unsigned and relative to PC+4.
+      return Offset >= 4 && Offset <= 130;
+    case ARM::tBcc:
+      return hasThumb2() || (Offset >= -252 && Offset <= 258);
+    case ARM::tB:
+      return hasThumb2() || (Offset >= -2044 && Offset <= 2050);
+    case ARM::t2Bcc:
+      return Offset >= -(1 << 20) + 4 && Offset <= (1 << 20) + 2;
+    case ARM::t2B:
+    case ARM::tBL:
+    case ARM::tBLXi:
+      return Offset >= -(1 << 24) + 4 && Offset <= (1 << 24) + 2;
+    default:
+      return true;
+    }
+  }
+
+  unsigned getCondCode(const MCInst &Inst) const override {
+    if ((Inst.getOpcode() == ARM::tBcc || Inst.getOpcode() == ARM::t2Bcc) &&
+        Inst.getNumOperands() > 1 && Inst.getOperand(1).isImm())
+      return Inst.getOperand(1).getImm();
+    return ARMCC::AL;
+  }
+
+  bool isValidCondCode(unsigned CC) const override { return CC < ARMCC::AL; }
+
+  unsigned getCanonicalBranchCondCode(unsigned CC) const override {
+    return std::min(CC, getInvertedCondCode(CC));
+  }
+
+  unsigned getInvertedCondCode(unsigned CC) const override {
+    assert(isValidCondCode(CC) && "invalid ARM condition code");
+    return ARMCC::getOppositeCondition(static_cast<ARMCC::CondCodes>(CC));
+  }
+
+  void createCondBranch(MCInst &Inst, const MCSymbol *Target, unsigned CC,
+                        MCContext *Ctx) const override {
+    // Start from the compact encoding.  LLVM MC relaxes an in-section Thumb-2
+    // branch to B<c>.W when the final block layout exceeds the T1 range.  This
+    // avoids pessimistically adding two bytes to every synthesized firmware
+    // CFG edge while retaining range correctness on M3/M4.
+    Inst = MCInstBuilder(ARM::tBcc)
+               .addExpr(MCSymbolRefExpr::create(Target, *Ctx))
+               .addImm(CC)
+               .addReg(ARM::CPSR);
+  }
+
+  void createLongCondBranch(MCInst &Inst, const MCSymbol *Target, unsigned CC,
+                            MCContext *Ctx) const override {
+    Inst = MCInstBuilder(hasThumb2() ? ARM::t2Bcc : ARM::tBcc)
+               .addExpr(MCSymbolRefExpr::create(Target, *Ctx))
+               .addImm(CC)
+               .addReg(ARM::CPSR);
+  }
+
+  bool replaceBranchCondition(MCInst &Inst, const MCSymbol *Target,
+                              MCContext *Ctx, unsigned CC) const override {
+    if (!isReversibleBranch(Inst) || !isValidCondCode(CC))
+      return false;
+    Inst.getOperand(0) =
+        MCOperand::createExpr(MCSymbolRefExpr::create(Target, *Ctx));
+    Inst.getOperand(1).setImm(CC);
+    return true;
+  }
+
+  InstructionListType reverseBranchCondition(
+      MCInst Inst, const MCSymbol *Target, MCContext *Ctx,
+      bool = true) const override {
+    if (!replaceBranchCondition(Inst, Target, Ctx,
+                                getInvertedCondCode(getCondCode(Inst))))
+      return {};
+    return {Inst};
+  }
+
+  void createNoop(MCInst &Inst) const override {
+    Inst = MCInstBuilder(ARM::tHINT)
+               .addImm(0)
+               .addImm(ARMCC::AL)
+               .addReg(0);
+  }
+
+  void createReturn(MCInst &Inst) const override {
+    Inst = MCInstBuilder(ARM::tBX_RET)
+               .addReg(ARM::LR)
+               .addImm(ARMCC::AL)
+               .addReg(0);
+  }
+
+  void createDirectCall(MCInst &Inst, const MCSymbol *Target,
+                        MCContext *Ctx, bool IsTailCall) override {
+    if (IsTailCall) {
+      createDirectBranch(Inst, Target, Ctx);
+      setTailCall(Inst);
+      return;
+    }
+    Inst = MCInstBuilder(ARM::tBL)
+               .addImm(ARMCC::AL)
+               .addReg(0)
+               .addExpr(MCSymbolRefExpr::create(Target, *Ctx));
+  }
+
+  void createCall(MCInst &Inst, const MCSymbol *Target,
+                  MCContext *Ctx) override {
+    createDirectCall(Inst, Target, Ctx, /*IsTailCall=*/false);
+  }
+
+  void createTailCall(MCInst &Inst, const MCSymbol *Target,
+                      MCContext *Ctx) override {
+    createDirectBranch(Inst, Target, Ctx);
+    setTailCall(Inst);
+  }
+
+  void createLongTailCall(InstructionListType &Sequence,
+                          const MCSymbol *Target,
+                          MCContext *Ctx) override {
+    if (!hasThumb2()) {
+      // Thumb-1 cannot materialize an arbitrary 32-bit code address in
+      // registers without extra clobbers. Use the AAPCS call-clobbered r3 to
+      // load a linker-relocated Thumb address from an adjacent literal and
+      // tail-branch through it. The inline-data record is an explicit emitter
+      // object, not bytes copied from an input constant island.
+      MCSymbol *Literal = Ctx->createNamedTempSymbol("Thumb1CallTarget");
+      MCInst Inst = MCInstBuilder(ARM::tLDRpci)
+                        .addReg(ARM::R3)
+                        // LongJmp word-aligns the final LDR and emits the
+                        // literal immediately after the two-instruction
+                        // sequence, so the architectural displacement is
+                        // exactly zero. Keeping this immediate avoids asking
+                        // MC to judge alignment in a private fragment whose
+                        // final firmware base may be 2 mod 4.
+                        .addImm(0)
+                        .addImm(ARMCC::AL)
+                        .addReg(0);
+      Sequence.push_back(Inst);
+
+      Inst = MCInstBuilder(ARM::tBX)
+                 .addReg(ARM::R3)
+                 .addImm(ARMCC::AL)
+                 .addReg(0);
+      setTailCall(Inst);
+      // The ELF symbol is Thumb-typed, so AArch32 data relocation semantics
+      // already contribute the state bit through S. Keep A zero here; adding
+      // another one would materialize Target + 2.
+      const MCExpr *TargetExpr = MCSymbolRefExpr::create(Target, *Ctx);
+      setInlineData(Inst, InlineData{Literal, TargetExpr, 4, 4});
+      Sequence.push_back(Inst);
+      return;
+    }
+
+    // Thumb-2 has no single instruction for an arbitrary-address tail call.
+    // Materialize the address in r12 (IP), the AAPCS intra-procedure-call
+    // scratch register, then branch through it. The materialized address must
+    // carry the Thumb-state bit so BX remains in Thumb state.
+    //
+    // This sequence is qualified only for call/tail-call edges: an arbitrary
+    // intra-function jump is not allowed to clobber a live r12.
+
+    // BOLT's JITLink graph represents the code label at its even byte
+    // address. Unlike an ELF STT_FUNC value produced by a static linker, that
+    // synthetic label does not acquire the Thumb-state bit for MOVW/MOVT
+    // fixups. Add it explicitly: every qualified Cortex-M code target is
+    // Thumb, and BX requires bit zero set or it raises INVSTATE.
+    const MCExpr *TargetExpr = MCBinaryExpr::createAdd(
+        MCSymbolRefExpr::create(Target, *Ctx), MCConstantExpr::create(1, *Ctx),
+        *Ctx);
+    MCInst Inst = MCInstBuilder(ARM::t2MOVi16)
+                      .addReg(ARM::R12)
+                      .addExpr(MCSpecifierExpr::create(TargetExpr, ARM::S_LO16,
+                                                       *Ctx))
+                      .addImm(ARMCC::AL)
+                      .addReg(0);
+    Sequence.push_back(Inst);
+
+    Inst = MCInstBuilder(ARM::t2MOVTi16)
+               .addReg(ARM::R12)
+               .addReg(ARM::R12)
+               .addExpr(MCSpecifierExpr::create(TargetExpr, ARM::S_HI16, *Ctx))
+               .addImm(ARMCC::AL)
+               .addReg(0);
+    Sequence.push_back(Inst);
+
+    Inst = MCInstBuilder(ARM::tBX)
+               .addReg(ARM::R12)
+               .addImm(ARMCC::AL)
+               .addReg(0);
+    setTailCall(Inst);
+    Sequence.push_back(Inst);
+  }
+
+  InstructionListType materializeSymbolAddress(const MCSymbol *Target,
+                                               MCContext *Ctx,
+                                               MCPhysReg RegName,
+                                               int64_t Addend,
+                                               bool IsCodePointer) const {
+    if (!hasThumb2() || !Target || !RegName)
+      return {};
+
+    // Function pointers on Cortex-M carry the Thumb-state bit, while vtable
+    // object addresses do not. Keep this distinction explicit: reusing the
+    // function-pointer helper for a method-load-elimination guard would compare
+    // against an odd, nonexistent vtable address and send every call cold.
+    const MCExpr *TargetExpr = MCSymbolRefExpr::create(Target, *Ctx);
+    const int64_t EffectiveAddend = Addend + (IsCodePointer ? 1 : 0);
+    if (EffectiveAddend)
+      TargetExpr = MCBinaryExpr::createAdd(
+          TargetExpr, MCConstantExpr::create(EffectiveAddend, *Ctx), *Ctx);
+
+    InstructionListType Sequence;
+    Sequence.push_back(MCInstBuilder(ARM::t2MOVi16)
+                           .addReg(RegName)
+                           .addExpr(MCSpecifierExpr::create(
+                               TargetExpr, ARM::S_LO16, *Ctx))
+                           .addImm(ARMCC::AL)
+                           .addReg(0));
+    Sequence.push_back(MCInstBuilder(ARM::t2MOVTi16)
+                           .addReg(RegName)
+                           .addReg(RegName)
+                           .addExpr(MCSpecifierExpr::create(
+                               TargetExpr, ARM::S_HI16, *Ctx))
+                           .addImm(ARMCC::AL)
+                           .addReg(0));
+    return Sequence;
+  }
+
+  InstructionListType materializeAddress(const MCSymbol *Target,
+                                         MCContext *Ctx,
+                                         MCPhysReg RegName,
+                                         int64_t Addend = 0) const override {
+    return materializeSymbolAddress(Target, Ctx, RegName, Addend,
+                                    /*IsCodePointer=*/true);
+  }
+
+  InstructionListType createLoadImmediate(const MCPhysReg Dest,
+                                          uint64_t Imm) const override {
+    if (!hasThumb2() || Dest < ARM::R0 || Dest > ARM::R12 ||
+        !isUInt<32>(Imm))
+      return {};
+
+    const uint32_t Value = static_cast<uint32_t>(Imm);
+    InstructionListType Sequence;
+    Sequence.push_back(MCInstBuilder(ARM::t2MOVi16)
+                           .addReg(Dest)
+                           .addImm(Value & 0xffff)
+                           .addImm(ARMCC::AL)
+                           .addReg(0));
+    if (Value >> 16)
+      Sequence.push_back(MCInstBuilder(ARM::t2MOVTi16)
+                             .addReg(Dest)
+                             .addReg(Dest)
+                             .addImm(Value >> 16)
+                             .addImm(ARMCC::AL)
+                             .addReg(0));
+    return Sequence;
+  }
+
+  InstructionListType materializeConstant(BinaryContext &BC,
+                                          const MCInst &Inst,
+                                          StringRef ConstantData,
+                                          uint64_t Offset) const override {
+    uint8_t DataSize = 0;
+    bool Signed = false;
+    switch (Inst.getOpcode()) {
+    case ARM::tLDRpci:
+    case ARM::t2LDRpci:
+      DataSize = 4;
+      break;
+    case ARM::t2LDRBpci:
+      DataSize = 1;
+      break;
+    case ARM::t2LDRHpci:
+      DataSize = 2;
+      break;
+    case ARM::t2LDRSBpci:
+      DataSize = 1;
+      Signed = true;
+      break;
+    case ARM::t2LDRSHpci:
+      DataSize = 2;
+      Signed = true;
+      break;
+    default:
+      return {};
+    }
+    if (!Inst.getNumOperands() || !Inst.getOperand(0).isReg() ||
+        Offset + DataSize > ConstantData.size())
+      return {};
+
+    DataExtractor Extractor(ConstantData, BC.AsmInfo->isLittleEndian());
+    const uint64_t Value =
+        Signed ? static_cast<uint32_t>(Extractor.getSigned(&Offset, DataSize))
+               : Extractor.getUnsigned(&Offset, DataSize);
+    return createLoadImmediate(Inst.getOperand(0).getReg(), Value);
+  }
+
+  bool analyzeVirtualMethodCall(InstructionIterator ForwardBegin,
+                                InstructionIterator ForwardEnd,
+                                std::vector<MCInst *> &MethodFetchInsns,
+                                unsigned &VtableRegNum,
+                                unsigned &MethodRegNum,
+                                uint64_t &MethodOffset) const override {
+    VtableRegNum = getNoRegister();
+    MethodRegNum = getNoRegister();
+    MethodOffset = 0;
+    if (ForwardBegin == ForwardEnd)
+      return false;
+
+    std::reverse_iterator<InstructionIterator> Itr(ForwardEnd);
+    std::reverse_iterator<InstructionIterator> End(ForwardBegin);
+    MCInst &CallInst = *Itr++;
+    if (!isIndirectCall(CallInst) && !isIndirectBranch(CallInst))
+      return false;
+
+    // Thumb predicate operands precede the actual register target. Recover
+    // the final explicit register, matching the audited ICP call forms.
+    for (unsigned I = CallInst.getNumOperands(); I != 0; --I) {
+      const MCOperand &Operand = CallInst.getOperand(I - 1);
+      if (Operand.isReg() && Operand.getReg()) {
+        MethodRegNum = Operand.getReg();
+        break;
+      }
+    }
+    if (!MethodRegNum)
+      return false;
+
+    while (Itr != End) {
+      MCInst &CurInst = *Itr++;
+      const MCInstrDesc &Desc = Info->get(CurInst.getOpcode());
+      if (!Desc.hasDefOfPhysReg(CurInst, MethodRegNum, *RegInfo))
+        continue;
+
+      // Start with the fixed-offset 32-bit Thumb loads emitted for ordinary
+      // C++ vtable dispatch. Indexed, writeback, conditional, narrow, and
+      // negative-offset forms remain explicit unsupported classes.
+      unsigned OffsetScale = 0;
+      switch (CurInst.getOpcode()) {
+      case ARM::tLDRi:
+        OffsetScale = 4;
+        break;
+      case ARM::t2LDRi12:
+        OffsetScale = 1;
+        break;
+      default:
+        return false;
+      }
+      if (CurInst.getNumOperands() < 3 ||
+          !CurInst.getOperand(0).isReg() ||
+          CurInst.getOperand(0).getReg() != MethodRegNum ||
+          !CurInst.getOperand(1).isReg() ||
+          !CurInst.getOperand(2).isImm())
+        return false;
+      if (CurInst.getNumOperands() >= 5 &&
+          (!CurInst.getOperand(3).isImm() ||
+           CurInst.getOperand(3).getImm() != ARMCC::AL ||
+           !CurInst.getOperand(4).isReg() ||
+           CurInst.getOperand(4).getReg()))
+        return false;
+
+      VtableRegNum = CurInst.getOperand(1).getReg();
+      if (!VtableRegNum || VtableRegNum == ARM::SP ||
+          VtableRegNum == ARM::PC)
+        return false;
+      const int64_t EncodedOffset = CurInst.getOperand(2).getImm();
+      if (EncodedOffset < 0)
+        return false;
+      MethodOffset = static_cast<uint64_t>(EncodedOffset) * OffsetScale;
+      MethodFetchInsns.push_back(&CurInst);
+      return true;
+    }
+    return false;
+  }
+
+  InstructionListType createCmpJNEWithReg(MCPhysReg Reg1, MCPhysReg Reg2,
+                                           const MCSymbol *Target,
+                                           MCContext *Ctx) const override {
+    if (!hasThumb2() || !Reg1 || !Reg2 || Reg1 == Reg2)
+      return {};
+    InstructionListType Sequence;
+    Sequence.push_back(MCInstBuilder(ARM::t2CMPrr)
+                           .addReg(Reg1)
+                           .addReg(Reg2)
+                           .addImm(ARMCC::AL)
+                           .addReg(0));
+    MCInst Branch;
+    createCondBranch(Branch, Target, ARMCC::NE, Ctx);
+    Sequence.push_back(Branch);
+    return Sequence;
+  }
+
+  BlocksVectorTy indirectCallPromotion(
+      const MCInst &CallInst, MCPhysReg Reg,
+      const std::vector<std::pair<MCSymbol *, uint64_t>> &Targets,
+      const std::vector<std::pair<MCSymbol *, uint64_t>> &VtableSyms,
+      const std::vector<MCInst *> &MethodFetchInsns,
+      const bool MinimizeCodeSize, MCContext *Ctx) override {
+    BlocksVectorTy Results;
+    // Register-indirect calls and immutable-vtable method-load elimination
+    // are independently contract-gated by the pass. Thumb-1 ordinary calls
+    // use a dead low register plus an explicitly skipped inline literal.
+    // Thumb-1 method-load elimination uses the same typed scalar mechanism,
+    // but its value is the raw vtable data address rather than a Thumb code
+    // pointer. Jump-table promotion and compact old sequences use separate
+    // target hooks/contracts. Tail calls are gated by a distinct pass option
+    // before reaching here; Thumb-1 tail calls preserve a borrowed low
+    // register in r12, never LR or memory.
+    const bool IsTailCall = isTailCall(CallInst);
+    const bool LoadElim = !VtableSyms.empty();
+    if (getJumpTable(CallInst) || MinimizeCodeSize || Targets.empty())
+      return Results;
+    if (LoadElim != !MethodFetchInsns.empty() ||
+        (LoadElim && VtableSyms.size() != Targets.size()))
+      return Results;
+
+    // Thumb predicate operands precede the actual target register (for
+    // example, tBLXr is encoded as predicate, predicate-register, target).
+    // Restrict this first implementation to the register-call forms audited
+    // here, then recover the final explicit non-zero register instead of
+    // assuming the x86/AArch64 operand order.
+    const StringRef OpcodeName = Info->getName(CallInst.getOpcode());
+    if (OpcodeName != "tBLXr" && OpcodeName != "tBLXr_noip" &&
+        OpcodeName != "tBX_CALL" &&
+        !(IsTailCall && OpcodeName == "tBX"))
+      return Results;
+    MCPhysReg TargetReg = 0;
+    for (unsigned I = CallInst.getNumOperands(); I != 0; --I) {
+      const MCOperand &Operand = CallInst.getOperand(I - 1);
+      if (Operand.isReg() && Operand.getReg()) {
+        TargetReg = Operand.getReg();
+        break;
+      }
+    }
+    if (!TargetReg)
+      return Results;
+    MCPhysReg CompareReg = TargetReg;
+    if (LoadElim) {
+      const MCInst *MethodLoad = MethodFetchInsns.front();
+      if (!MethodLoad || MethodLoad->getNumOperands() < 2 ||
+          !MethodLoad->getOperand(1).isReg())
+        return Results;
+      CompareReg = MethodLoad->getOperand(1).getReg();
+      if (!CompareReg)
+        return Results;
+    }
+    // AAPCS designates r12/IP as intra-procedure-call scratch on Thumb-2.
+    // Liveness may conservatively report every register live around an
+    // unresolved indirect callee; under the pass's explicit --assume-abi
+    // contract, r12 is still a legal guard scratch. If r12 itself carries an
+    // ordinary call target, LR is the one non-memory alternative: BL/BLX
+    // overwrite it on both promoted and fallback paths. A tail BX must pass
+    // the incoming LR through to its callee, so that case remains unsupported.
+    //
+    // Thumb-1 cannot materialize an arbitrary address in r12 and its literal
+    // load destination must be r0-r7. Prefer a dead caller-argument register
+    // independently scavenged from the exact pre-call liveness state. When
+    // none is available, preserve one of r0-r3 temporarily. Ordinary calls
+    // use LR because both the promoted BL and fallback BLX overwrite it. A
+    // tail call must pass incoming LR through to its callee, so it uses r12,
+    // the AAPCS intra-procedure-call scratch register. A flag-preserving MOV
+    // restores the argument before either transfer. This deliberately does
+    // not spill: an added stack access would introduce fault and alias
+    // obligations.
+    MCPhysReg ScratchReg = 0;
+    bool Thumb1RestoreScratch = false;
+    MCPhysReg Thumb1PreserveReg = 0;
+    if (hasThumb2()) {
+      ScratchReg = ARM::R12;
+      if (CompareReg == ARM::R12)
+        ScratchReg = IsTailCall ? MCPhysReg(0) : MCPhysReg(ARM::LR);
+    } else {
+      if (!hasAnnotation(CallInst, "FirmBOLTAllowThumb1ICPLiteralLoad") ||
+          CompareReg == ARM::LR)
+        return Results;
+      if (Reg >= ARM::R0 && Reg <= ARM::R3 && Reg != CompareReg) {
+        ScratchReg = Reg;
+      } else {
+        Thumb1PreserveReg = IsTailCall ? MCPhysReg(ARM::R12)
+                                       : MCPhysReg(ARM::LR);
+        if (CompareReg == Thumb1PreserveReg)
+          return Results;
+        for (MCPhysReg Candidate :
+             {MCPhysReg(ARM::R3), MCPhysReg(ARM::R2),
+              MCPhysReg(ARM::R1), MCPhysReg(ARM::R0)})
+          if (Candidate != CompareReg) {
+            ScratchReg = Candidate;
+            Thumb1RestoreScratch = true;
+            break;
+          }
+      }
+    }
+    if (!ScratchReg)
+      return Results;
+
+    MCSymbol *NextTarget = nullptr;
+    MCSymbol *MergeBlock = nullptr;
+    for (unsigned I = 0; I < Targets.size(); ++I) {
+      if (!Targets[I].first)
+        return {};
+      Results.emplace_back(NextTarget, InstructionListType());
+      InstructionListType &Guard = Results.back().second;
+      MCSymbol *DirectLabel = Ctx->createNamedTempSymbol();
+      MCSymbol *Thumb1Literal = nullptr;
+      const MCExpr *Thumb1TargetExpr = nullptr;
+      if (hasThumb2()) {
+        InstructionListType Address =
+            LoadElim
+                ? materializeSymbolAddress(
+                      VtableSyms[I].first, Ctx, ScratchReg,
+                      static_cast<int64_t>(VtableSyms[I].second),
+                      /*IsCodePointer=*/false)
+                : materializeAddress(Targets[I].first, Ctx, ScratchReg);
+        Guard.insert(Guard.end(), Address.begin(), Address.end());
+      } else {
+        Thumb1Literal = Ctx->createNamedTempSymbol(
+            LoadElim ? "Thumb1ICPVtable" : "Thumb1ICPTarget");
+        const MCSymbol *LiteralTarget =
+            LoadElim ? VtableSyms[I].first : Targets[I].first;
+        if (!LiteralTarget)
+          return {};
+        const int64_t LiteralAddend =
+            LoadElim ? static_cast<int64_t>(VtableSyms[I].second) : 0;
+        Thumb1TargetExpr = MCSymbolRefExpr::create(LiteralTarget, *Ctx);
+        if (LiteralAddend)
+          Thumb1TargetExpr = MCBinaryExpr::createAdd(
+              Thumb1TargetExpr,
+              MCConstantExpr::create(LiteralAddend, *Ctx), *Ctx);
+        if (Thumb1RestoreScratch)
+          Guard.push_back(MCInstBuilder(ARM::tMOVr)
+                              .addReg(Thumb1PreserveReg)
+                              .addReg(ScratchReg)
+                              .addImm(ARMCC::AL)
+                              .addReg(0));
+        Guard.push_back(MCInstBuilder(ARM::tLDRpci)
+                            .addReg(ScratchReg)
+                            .addExpr(MCSymbolRefExpr::create(Thumb1Literal,
+                                                            *Ctx))
+                            .addImm(ARMCC::AL)
+                            .addReg(0));
+      }
+      NextTarget = Ctx->createNamedTempSymbol();
+      if (hasThumb2()) {
+        InstructionListType Compare =
+            createCmpJNEWithReg(CompareReg, ScratchReg, NextTarget, Ctx);
+        if (Compare.empty())
+          return {};
+        Guard.insert(Guard.end(), Compare.begin(), Compare.end());
+      } else {
+        Guard.push_back(MCInstBuilder(
+                            isARMLowRegister(CompareReg) ? ARM::tCMPr
+                                                        : ARM::tCMPhir)
+                            .addReg(CompareReg)
+                            .addReg(ScratchReg)
+                            .addImm(ARMCC::AL)
+                            .addReg(0));
+        if (Thumb1RestoreScratch)
+          Guard.push_back(MCInstBuilder(ARM::tMOVr)
+                              .addReg(ScratchReg)
+                              .addReg(Thumb1PreserveReg)
+                              .addImm(ARMCC::AL)
+                              .addReg(0));
+        MCInst Mismatch;
+        createCondBranch(Mismatch, NextTarget, ARMCC::NE, Ctx);
+        Guard.push_back(Mismatch);
+        // InlineData is deliberately emitted immediately after its owner.
+        // Thumb-1 literal words must be word-aligned, while an input call may
+        // begin at either halfword of a word.  Insert an explicit unreachable
+        // NOP before the branch when required; publication later recomputes
+        // the final address and retains the original body if another pass has
+        // changed this parity.  Do not use a section-relative .align here:
+        // compact firmware fragments may be rebased by two bytes.
+        const uint64_t OriginalCallAddress = getAnnotationAs<uint64_t>(
+            CallInst, "FirmBOLTThumb1ICPOriginalAddress");
+        // Method-load elimination erases the fetch before replacing the call,
+        // so the guard starts at the earliest removed instruction rather than
+        // at the original call PC.  Using the call address here can shift the
+        // final scalar by one halfword and produce an invalid Thumb literal
+        // fixup even though ordinary register-call promotion is aligned.
+        uint64_t ExpansionAddress = OriginalCallAddress;
+        if (LoadElim && !MethodFetchInsns.empty() &&
+            MethodFetchInsns.front() != &CallInst) {
+          if (!hasAnnotation(*MethodFetchInsns.front(),
+                             "FastDynOriginalAddress"))
+            return {};
+          ExpansionAddress = getAnnotationAs<uint64_t>(
+              *MethodFetchInsns.front(), "FastDynOriginalAddress");
+        }
+        uint64_t InlineAddress = ExpansionAddress;
+        for (const MCInst &Inst : Guard)
+          InlineAddress += getInstructionSize(Inst).value_or(2);
+        InlineAddress += 2; // the following unconditional Thumb-1 branch
+        if (InlineAddress & 2) {
+          MCInst Padding;
+          createNoop(Padding);
+          Guard.push_back(Padding);
+          InlineAddress += 2;
+        }
+        if (InlineAddress & 3)
+          return {};
+        // Both comparison outcomes must jump around the literal word: BNE
+        // enters the next guard/cold block, while the matching path takes this
+        // explicit branch to the direct-call block. Attaching the typed data
+        // to that branch keeps it out of every executable fall-through path.
+        MCInst SkipLiteral;
+        createUncondBranch(SkipLiteral, DirectLabel, Ctx);
+        setInlineData(SkipLiteral,
+                      InlineData{Thumb1Literal, Thumb1TargetExpr, 4, 4});
+        Guard.push_back(SkipLiteral);
+      }
+
+      Results.emplace_back(DirectLabel, InstructionListType());
+      InstructionListType &Direct = Results.back().second;
+      MCInst PromotedCall;
+      createDirectCall(PromotedCall, Targets[I].first, Ctx,
+                       IsTailCall);
+      Direct.push_back(PromotedCall);
+      if (IsTailCall) {
+        continue;
+      } else if (I == 0) {
+        MergeBlock = Ctx->createNamedTempSymbol();
+      } else {
+        MCInst Merge;
+        createUncondBranch(Merge, MergeBlock, Ctx);
+        Direct.push_back(Merge);
+      }
+    }
+
+    Results.emplace_back(NextTarget, InstructionListType());
+    InstructionListType &Cold = Results.back().second;
+    for (const MCInst *Fetch : MethodFetchInsns)
+      if (Fetch != &CallInst)
+        Cold.push_back(*Fetch);
+    Cold.push_back(CallInst);
+    if (!IsTailCall) {
+      MCInst Merge;
+      createUncondBranch(Merge, MergeBlock, Ctx);
+      Cold.push_back(Merge);
+      Results.emplace_back(MergeBlock, InstructionListType());
+    }
+    return Results;
+  }
+
+  BlocksVectorTy jumpTablePromotion(
+      const MCInst &IJmpInst,
+      const std::vector<std::pair<MCSymbol *, uint64_t>> &Targets,
+      const std::vector<MCInst *> &TargetFetchInsns,
+      MCContext *Ctx) const override {
+    BlocksVectorTy Results;
+    if (!hasThumb2() || Targets.empty() || !getJumpTable(IJmpInst))
+      return Results;
+
+    unsigned BaseReg = 0;
+    unsigned IndexReg = 0;
+    const bool IsInline =
+        getInlineJumpTableEntrySize(IJmpInst, BaseReg, IndexReg);
+    if (!IsInline)
+      IndexReg = getJumpTableIndexReg(IJmpInst);
+    if (!IndexReg)
+      return Results;
+
+    MCSymbol *NextTarget = nullptr;
+    for (const auto &[Target, CaseIndex] : Targets) {
+      if (!Target || CaseIndex > 4095)
+        return {};
+      Results.emplace_back(NextTarget, InstructionListType());
+      InstructionListType &Guard = Results.back().second;
+      Guard.push_back(MCInstBuilder(ARM::t2CMPri)
+                          .addReg(IndexReg)
+                          .addImm(CaseIndex)
+                          .addImm(ARMCC::AL)
+                          .addReg(0));
+      NextTarget = Ctx->createNamedTempSymbol();
+      MCInst Branch;
+      createCondBranch(Branch, Target, ARMCC::EQ, Ctx);
+      Guard.push_back(Branch);
+    }
+
+    // Preserve the complete original dispatch on the cold path. TBB/TBH is
+    // itself the table fetch. For a recovered ABS32 dispatch, its address and
+    // entry loads remain in the predecessor block and the terminal MOV/BX is
+    // retained here; TargetFetchInsns contains only a producer that the
+    // generic rewrite explicitly selected for movement.
+    Results.emplace_back(NextTarget, InstructionListType());
+    InstructionListType &Cold = Results.back().second;
+    for (const MCInst *Inst : TargetFetchInsns)
+      if (Inst != &IJmpInst)
+        Cold.push_back(*Inst);
+    Cold.push_back(IJmpInst);
+    return Results;
+  }
+
+  void createShortJmp(InstructionListType &Sequence,
+                      const MCSymbol *Target, MCContext *Ctx,
+                      bool IsTailCall) override {
+    MCInst Inst;
+    createDirectBranch(Inst, Target, Ctx);
+    if (IsTailCall)
+      setTailCall(Inst);
+    Sequence.push_back(Inst);
+  }
+
+  void createDirectBranch(MCInst &Inst, const MCSymbol *Target,
+                          MCContext *Ctx) override {
+    Inst = MCInstBuilder(hasThumb2() ? ARM::t2B : ARM::tB)
+               .addExpr(MCSymbolRefExpr::create(Target, *Ctx))
+               .addImm(ARMCC::AL)
+               .addReg(0);
+  }
+
+  void createUncondBranch(MCInst &Inst, const MCSymbol *Target,
+                          MCContext *Ctx) const override {
+    // As above, let MC relaxation widen only the edges that require it.
+    Inst = MCInstBuilder(ARM::tB)
+               .addExpr(MCSymbolRefExpr::create(Target, *Ctx))
+               .addImm(ARMCC::AL)
+               .addReg(0);
+  }
+
+  void createLongUncondBranch(MCInst &Inst, const MCSymbol *Target,
+                              MCContext *Ctx) const override {
+    Inst = MCInstBuilder(hasThumb2() ? ARM::t2B : ARM::tB)
+               .addExpr(MCSymbolRefExpr::create(Target, *Ctx))
+               .addImm(ARMCC::AL)
+               .addReg(0);
+  }
+
+  int getShortJmpEncodingSize() const override { return 2; }
+  int getUncondBranchEncodingSize() const override {
+    return hasThumb2() ? 4 : 2;
+  }
+
+  const MCExpr *getTargetExprFor(MCInst &, const MCExpr *Expr,
+                                 MCContext &Ctx,
+                                 uint32_t RelType) const override {
+    switch (RelType) {
+    case ELF::R_ARM_MOVT_ABS:
+    case ELF::R_ARM_THM_MOVT_ABS:
+      return MCSpecifierExpr::create(Expr, ARM::S_HI16, Ctx);
+    case ELF::R_ARM_MOVW_ABS_NC:
+    case ELF::R_ARM_THM_MOVW_ABS_NC:
+      return MCSpecifierExpr::create(Expr, ARM::S_LO16, Ctx);
+    default:
+      return Expr;
+    }
+  }
+
+  std::optional<Relocation>
+  createRelocation(const MCFixup &Fixup,
+                   const MCAsmBackend &MAB) const override {
+    const MCFixupKind Kind = Fixup.getKind();
+    const MCFixupKindInfo Info = MAB.getFixupKindInfo(Kind);
+    uint32_t Type = ELF::R_ARM_NONE;
+    switch (Kind) {
+    case MCFixupKind(ARM::fixup_arm_thumb_bl):
+    case MCFixupKind(ARM::fixup_arm_thumb_blx):
+      Type = ELF::R_ARM_THM_CALL;
+      break;
+    case MCFixupKind(ARM::fixup_t2_uncondbranch):
+      Type = ELF::R_ARM_THM_JUMP24;
+      break;
+    case MCFixupKind(ARM::fixup_t2_condbranch):
+      Type = ELF::R_ARM_THM_JUMP19;
+      break;
+    case MCFixupKind(ARM::fixup_arm_thumb_br):
+      Type = ELF::R_ARM_THM_JUMP11;
+      break;
+    case MCFixupKind(ARM::fixup_arm_thumb_bcc):
+      Type = ELF::R_ARM_THM_JUMP8;
+      break;
+    case MCFixupKind(ARM::fixup_arm_thumb_cb):
+      Type = ELF::R_ARM_THM_JUMP6;
+      break;
+    case MCFixupKind(ARM::fixup_arm_thumb_cp):
+      Type = ELF::R_ARM_THM_PC8;
+      break;
+    case MCFixupKind(ARM::fixup_t2_ldst_pcrel_12):
+      Type = ELF::R_ARM_THM_PC12;
+      break;
+    case MCFixupKind(ARM::fixup_thumb_adr_pcrel_10):
+    case MCFixupKind(ARM::fixup_t2_adr_pcrel_12):
+      Type = ELF::R_ARM_THM_ALU_PREL_11_0;
+      break;
+    case MCFixupKind(ARM::fixup_t2_movw_lo16):
+      Type = ELF::R_ARM_THM_MOVW_ABS_NC;
+      break;
+    case MCFixupKind(ARM::fixup_t2_movt_hi16):
+      Type = ELF::R_ARM_THM_MOVT_ABS;
+      break;
+    default:
+      if (Kind == FK_Data_1)
+        Type = ELF::R_ARM_ABS8;
+      else if (Kind == FK_Data_2)
+        Type = ELF::R_ARM_ABS16;
+      else if (Kind == FK_Data_4)
+        Type = ELF::R_ARM_ABS32;
+      else
+        return std::nullopt;
+      break;
+    }
+
+    // Target-specific ARM fixups describe split instruction fields. Their
+    // non-zero TargetOffset is part of the encoding, not a byte displacement
+    // of the relocation record; the record still starts at Fixup::Offset.
+    (void)Info;
+    const auto [Symbol, Addend] = extractFixupExpr(Fixup);
+    return Relocation({Fixup.getOffset(), Symbol, Type, Addend, 0});
+  }
+
+  bool shouldRecordCodeRelocation(uint32_t Type) const override {
+    switch (Type) {
+    case ELF::R_ARM_ABS8:
+    case ELF::R_ARM_ABS16:
+    case ELF::R_ARM_ABS32:
+    case ELF::R_ARM_REL32:
+    case ELF::R_ARM_PREL31:
+    case ELF::R_ARM_THM_CALL:
+    case ELF::R_ARM_THM_JUMP24:
+    case ELF::R_ARM_THM_JUMP19:
+    case ELF::R_ARM_THM_JUMP11:
+    case ELF::R_ARM_THM_JUMP8:
+    case ELF::R_ARM_THM_JUMP6:
+    case ELF::R_ARM_THM_PC8:
+    case ELF::R_ARM_THM_PC12:
+    case ELF::R_ARM_THM_ALU_PREL_11_0:
+    case ELF::R_ARM_THM_MOVW_ABS_NC:
+    case ELF::R_ARM_THM_MOVT_ABS:
+    case ELF::R_ARM_THM_MOVW_PREL_NC:
+    case ELF::R_ARM_THM_MOVT_PREL:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+  void replaceBranchTarget(MCInst &Inst, const MCSymbol *Target,
+                           MCContext *Ctx) const override {
+    const MCInstrDesc &Desc = Info->get(Inst.getOpcode());
+    for (unsigned I = 0; I < Desc.getNumOperands(); ++I) {
+      if (Desc.operands()[I].OperandType != MCOI::OPERAND_PCREL)
+        continue;
+      Inst.getOperand(I) = MCOperand::createExpr(
+          MCSymbolRefExpr::create(Target, *Ctx));
+      return;
+    }
+    llvm_unreachable("direct ARM branch has no PC-relative operand");
+  }
+
+  const MCSymbol *getTargetSymbol(const MCInst &Inst,
+                                  unsigned OpNum = 0) const override {
+    if (OpNum < MCPlus::getNumPrimeOperands(Inst) &&
+        Inst.getOperand(OpNum).isExpr())
+      return getTargetSymbolInfo(Inst.getOperand(OpNum).getExpr()).first;
+    if (OpNum == 0)
+      for (const MCOperand &Operand : Inst)
+        if (Operand.isExpr())
+          return getTargetSymbolInfo(Operand.getExpr()).first;
+    return nullptr;
+  }
+
+  std::pair<const MCSymbol *, uint64_t>
+  getTargetSymbolInfo(const MCExpr *Expr) const override {
+    if (const auto *Specifier = dyn_cast<MCSpecifierExpr>(Expr))
+      Expr = Specifier->getSubExpr();
+    return MCPlusBuilder::getTargetSymbolInfo(Expr);
+  }
+
+  int64_t getTargetAddend(const MCExpr *Expr) const override {
+    if (const auto *Specifier = dyn_cast<MCSpecifierExpr>(Expr))
+      Expr = Specifier->getSubExpr();
+    if (const auto *Binary = dyn_cast<MCBinaryExpr>(Expr)) {
+      if (Binary->getOpcode() == MCBinaryExpr::Add)
+        if (const auto *Constant = dyn_cast<MCConstantExpr>(Binary->getRHS()))
+          return Constant->getValue();
+    }
+    return 0;
+  }
+
+  int64_t getTargetAddend(const MCInst &Inst,
+                          unsigned OpNum = 0) const override {
+    if (OpNum < MCPlus::getNumPrimeOperands(Inst) &&
+        Inst.getOperand(OpNum).isExpr())
+      return getTargetAddend(Inst.getOperand(OpNum).getExpr());
+    return 0;
+  }
+
+  bool analyzeBranch(InstructionIterator Begin, InstructionIterator End,
+                     const MCSymbol *&TBB, const MCSymbol *&FBB,
+                     MCInst *&CondBranch,
+                     MCInst *&UncondBranch) const override {
+    auto I = End;
+    while (I != Begin) {
+      --I;
+      if (isPseudo(*I) || isNoop(*I))
+        continue;
+      if (!isTerminator(*I) || isTailCall(*I) || !isBranch(*I))
+        break;
+      if (isIndirectBranch(*I))
+        return false;
+      if (isUnconditionalBranch(*I)) {
+        CondBranch = nullptr;
+        UncondBranch = &*I;
+        TBB = getTargetSymbol(*I);
+        if (!TBB)
+          return false;
+        continue;
+      }
+      if (!CondBranch) {
+        const MCSymbol *Target = getTargetSymbol(*I);
+        if (!Target)
+          return false;
+        FBB = TBB;
+        TBB = Target;
+        CondBranch = &*I;
+        continue;
+      }
+      return false;
+    }
+    return true;
+  }
+
+  bool analyzeThumbAbsoluteJumpTable(
+      MCInst &Instruction, InstructionIterator Begin, InstructionIterator End,
+      ThumbAbsoluteJumpTableInfo &Result) const override {
+    Result = {};
+    auto Trace = [&](const Twine &Message) {
+      if (opts::Verbosity >= 3)
+        errs() << "BOLT-DEBUG: Thumb ABS32 matcher: " << Message << '\n';
+    };
+    Trace(Twine("examining opcode ") + Info->getName(Instruction.getOpcode()));
+
+    // Recover the register whose value is installed in PC.  Thumb-1 uses
+    // `mov pc, Rt`; Thumb-2 commonly uses BX.  Returns and indirect calls were
+    // removed from this path by isIndirectBranch().
+    MCPhysReg TargetReg = getNoRegister();
+    switch (Instruction.getOpcode()) {
+    case ARM::tMOVr:
+    case ARM::t2MOVr:
+      if (Instruction.getNumOperands() < 2 ||
+          !Instruction.getOperand(0).isReg() ||
+          Instruction.getOperand(0).getReg() != ARM::PC ||
+          !Instruction.getOperand(1).isReg())
+        return false;
+      TargetReg = Instruction.getOperand(1).getReg();
+      break;
+    case ARM::tBX:
+      if (!Instruction.getNumOperands() ||
+          !Instruction.getOperand(0).isReg())
+        return false;
+      TargetReg = Instruction.getOperand(0).getReg();
+      if (TargetReg == ARM::LR)
+        return false;
+      break;
+    default:
+      return false;
+    }
+    Trace(Twine("target register ") + Twine(TargetReg));
+
+    SmallVector<MCInst *, 32> Previous;
+    for (auto I = Begin; I != End; ++I)
+      if (&*I != &Instruction && !isPseudo(*I))
+        Previous.push_back(&*I);
+    if (Previous.size() < 6)
+      return false;
+    Trace(Twine("examining ") + Twine(Previous.size()) +
+          " preceding instructions");
+
+    // Find the reaching definition inside the current straight-line dispatch
+    // fragment.  A call or control transfer is a hard boundary: its implicit
+    // clobbers cannot be inferred from the compact MC operand list.
+    auto findDefBefore = [&](MCPhysReg Reg, size_t Before)
+        -> std::optional<size_t> {
+      while (Before) {
+        --Before;
+        MCInst &Candidate = *Previous[Before];
+        if (isCall(Candidate) || isBranch(Candidate) || isReturn(Candidate))
+          return std::nullopt;
+        BitVector Written(RegInfo->getNumRegs());
+        getWrittenRegs(Candidate, Written);
+        if (Written.test(Reg))
+          return Before;
+      }
+      return std::nullopt;
+    };
+
+    const std::optional<size_t> TargetLoadPos =
+        findDefBefore(TargetReg, Previous.size());
+    if (!TargetLoadPos)
+      return false;
+    Trace(Twine("target load at matcher index ") + Twine(*TargetLoadPos));
+    MCInst &TargetLoad = *Previous[*TargetLoadPos];
+    switch (TargetLoad.getOpcode()) {
+    case ARM::tLDRi:
+    case ARM::t2LDRi12:
+    case ARM::t2LDRi8:
+      break;
+    default:
+      return false;
+    }
+    if (TargetLoad.getNumOperands() < 3 ||
+        !TargetLoad.getOperand(0).isReg() ||
+        TargetLoad.getOperand(0).getReg() != TargetReg ||
+        !TargetLoad.getOperand(1).isReg() ||
+        TargetLoad.getOperand(1).getReg() != TargetReg ||
+        !TargetLoad.getOperand(2).isImm() ||
+        TargetLoad.getOperand(2).getImm() != 0)
+      return false;
+
+    const std::optional<size_t> AddPos =
+        findDefBefore(TargetReg, *TargetLoadPos);
+    if (!AddPos)
+      return false;
+    Trace(Twine("address add at matcher index ") + Twine(*AddPos));
+    MCInst &Add = *Previous[*AddPos];
+    MCPhysReg ScaledReg = getNoRegister();
+    MCPhysReg BaseReg = getNoRegister();
+    if (Add.getOpcode() == ARM::tADDrr) {
+      if (Add.getNumOperands() < 4 || !Add.getOperand(0).isReg() ||
+          Add.getOperand(0).getReg() != TargetReg ||
+          !Add.getOperand(2).isReg() || !Add.getOperand(3).isReg())
+        return false;
+      ScaledReg = Add.getOperand(2).getReg();
+      BaseReg = Add.getOperand(3).getReg();
+    } else if (Add.getOpcode() == ARM::t2ADDrr) {
+      if (Add.getNumOperands() < 3 || !Add.getOperand(0).isReg() ||
+          Add.getOperand(0).getReg() != TargetReg ||
+          !Add.getOperand(1).isReg() || !Add.getOperand(2).isReg())
+        return false;
+      ScaledReg = Add.getOperand(1).getReg();
+      BaseReg = Add.getOperand(2).getReg();
+    } else {
+      return false;
+    }
+    if (ScaledReg == BaseReg || !ScaledReg || !BaseReg)
+      return false;
+
+    const std::optional<size_t> ShiftPos =
+        findDefBefore(ScaledReg, *AddPos);
+    const std::optional<size_t> BaseLoadPos =
+        findDefBefore(BaseReg, *AddPos);
+    if (!ShiftPos || !BaseLoadPos)
+      return false;
+    Trace(Twine("scale/base definitions at matcher indices ") +
+          Twine(*ShiftPos) + "/" + Twine(*BaseLoadPos));
+
+    MCInst &Shift = *Previous[*ShiftPos];
+    MCPhysReg IndexReg = getNoRegister();
+    if (Shift.getOpcode() == ARM::tLSLri) {
+      if (Shift.getNumOperands() < 4 || !Shift.getOperand(0).isReg() ||
+          Shift.getOperand(0).getReg() != ScaledReg ||
+          !Shift.getOperand(2).isReg() || !Shift.getOperand(3).isImm() ||
+          Shift.getOperand(3).getImm() != 2)
+        return false;
+      IndexReg = Shift.getOperand(2).getReg();
+    } else if (Shift.getOpcode() == ARM::t2LSLri) {
+      if (Shift.getNumOperands() < 3 || !Shift.getOperand(0).isReg() ||
+          Shift.getOperand(0).getReg() != ScaledReg ||
+          !Shift.getOperand(1).isReg() || !Shift.getOperand(2).isImm() ||
+          Shift.getOperand(2).getImm() != 2)
+        return false;
+      IndexReg = Shift.getOperand(1).getReg();
+    } else {
+      return false;
+    }
+
+    MCInst &BaseLoad = *Previous[*BaseLoadPos];
+    switch (BaseLoad.getOpcode()) {
+    case ARM::tLDRpci:
+    case ARM::t2LDRpci:
+      break;
+    case ARM::t2LDRi12:
+      if (BaseLoad.getNumOperands() < 2 ||
+          !BaseLoad.getOperand(1).isReg() ||
+          BaseLoad.getOperand(1).getReg() != ARM::PC)
+        return false;
+      break;
+    default:
+      return false;
+    }
+    if (BaseLoad.getNumOperands() < 2 ||
+        !BaseLoad.getOperand(0).isReg() ||
+        BaseLoad.getOperand(0).getReg() != BaseReg)
+      return false;
+
+    const size_t DispatchPos = std::min(*ShiftPos, *BaseLoadPos);
+    MCInst *Guard = nullptr;
+    MCInst *Compare = nullptr;
+    bool BranchesToDispatch = false;
+    uint64_t LastEntry = 0;
+    size_t GuardPos = 0;
+    for (size_t I = DispatchPos; I-- > 0;) {
+      MCInst &Candidate = *Previous[I];
+      if (isNoop(Candidate))
+        continue;
+      if (Candidate.getOpcode() != ARM::tBcc &&
+          Candidate.getOpcode() != ARM::t2Bcc)
+        continue;
+      if (Candidate.getNumOperands() < 2 ||
+          !Candidate.getOperand(1).isImm())
+        continue;
+      const unsigned CC = Candidate.getOperand(1).getImm();
+      if (CC != ARMCC::LS && CC != ARMCC::HI)
+        continue;
+
+      // The compare must be the immediately preceding semantic instruction.
+      size_t J = I;
+      while (J && isNoop(*Previous[J - 1]))
+        --J;
+      if (!J)
+        return false;
+      Compare = Previous[J - 1];
+      if (Compare->getOpcode() != ARM::tCMPi8 &&
+          Compare->getOpcode() != ARM::t2CMPri)
+        return false;
+      if (Compare->getNumOperands() < 2 ||
+          !Compare->getOperand(0).isReg() ||
+          Compare->getOperand(0).getReg() != IndexReg ||
+          !Compare->getOperand(1).isImm() ||
+          Compare->getOperand(1).getImm() < 0)
+        return false;
+      LastEntry = Compare->getOperand(1).getImm();
+      if (LastEntry >= 4096)
+        return false;
+
+      BranchesToDispatch = CC == ARMCC::LS;
+      if (!BranchesToDispatch) {
+        // For `bhi default`, the dispatch must be the immediate fall-through;
+        // otherwise a second path could redefine the index or table base.
+        size_t Next = I + 1;
+        while (Next < DispatchPos && isNoop(*Previous[Next]))
+          ++Next;
+        if (Next != DispatchPos)
+          return false;
+      }
+      Guard = &Candidate;
+      GuardPos = I;
+      break;
+    }
+    (void)Compare;
+    (void)GuardPos;
+    if (!Guard)
+      return false;
+    Trace(Twine("matched guarded table with ") + Twine(LastEntry + 1) +
+          " entries");
+
+    Result.TableAddressLoad = &BaseLoad;
+    Result.GuardBranch = Guard;
+    Result.DispatchStart = Previous[DispatchPos];
+    Result.IndexReg = IndexReg;
+    Result.EntryCount = LastEntry + 1;
+    Result.GuardBranchesToDispatch = BranchesToDispatch;
+    return true;
+  }
+
+  IndirectBranchType analyzeIndirectBranch(
+      MCInst &Instruction, InstructionIterator, InstructionIterator, unsigned,
+      MCInst *&MemLocInstr, unsigned &BaseReg, unsigned &IndexReg,
+      int64_t &Disp, const MCExpr *&DispExpr, MCInst *&PCRelBase,
+      MCInst *&FixedEntryLoad) const override {
+    if (getInlineJumpTableEntrySize(Instruction, BaseReg, IndexReg)) {
+      MemLocInstr = &Instruction;
+      return IndirectBranchType::POSSIBLE_JUMP_TABLE;
+    }
+
+    // Once BinaryFunction has reconstructed and annotated an absolute Thumb
+    // table, CFG post-processing only needs to confirm that this remains a
+    // known jump-table branch.  The guard can live in a predecessor block and
+    // is intentionally not guessed again from the shortened iterator range.
+    if (getJumpTable(Instruction)) {
+      MemLocInstr = &Instruction;
+      return IndirectBranchType::POSSIBLE_JUMP_TABLE;
+    }
+
+    // Other jump tables and exception-return control flow need
+    // Cortex-M-specific recovery. Returning UNKNOWN retains the affected
+    // function; it must never infer an ordinary branch from BX/POP-PC.
+    MemLocInstr = nullptr;
+    BaseReg = getNoRegister();
+    IndexReg = getNoRegister();
+    Disp = 0;
+    DispExpr = nullptr;
+    PCRelBase = nullptr;
+    FixedEntryLoad = nullptr;
+    return IndirectBranchType::UNKNOWN;
+  }
+
+  unsigned getInlineJumpTableEntrySize(const MCInst &Instruction,
+                                       unsigned &BaseRegNum,
+                                       unsigned &IndexRegNum) const override {
+    unsigned EntrySize = 0;
+    switch (Instruction.getOpcode()) {
+    case ARM::t2TBB:
+      EntrySize = 1;
+      break;
+    case ARM::t2TBH:
+      EntrySize = 2;
+      break;
+    default:
+      return 0;
+    }
+
+    if (Instruction.getNumOperands() < 2 ||
+        !Instruction.getOperand(0).isReg() ||
+        !Instruction.getOperand(1).isReg())
+      return 0;
+    BaseRegNum = Instruction.getOperand(0).getReg();
+    IndexRegNum = Instruction.getOperand(1).getReg();
+    return EntrySize;
+  }
+};
+
+} // namespace
+
+namespace llvm::bolt {
+
+MCPlusBuilder *createARMMCPlusBuilder(const MCInstrAnalysis *Analysis,
+                                     const MCInstrInfo *Info,
+                                     const MCRegisterInfo *RegInfo,
+                                     const MCSubtargetInfo *STI) {
+  return new ARMMCPlusBuilder(Analysis, Info, RegInfo, STI);
+}
+
+} // namespace llvm::bolt
diff --git a/bolt/lib/Target/ARM/ARMMCSymbolizer.cpp b/bolt/lib/Target/ARM/ARMMCSymbolizer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2e377b6f3fadb52173886bbe64d27f433d1fdc30
--- /dev/null
+++ b/bolt/lib/Target/ARM/ARMMCSymbolizer.cpp
@@ -0,0 +1,44 @@
+//===- ARMMCSymbolizer.cpp - BOLT ARM/Thumb symbolization ----------------===//
+
+#include "ARMMCSymbolizer.h"
+#include "bolt/Core/BinaryContext.h"
+#include "bolt/Core/BinaryFunction.h"
+#include "bolt/Core/MCPlusBuilder.h"
+#include "bolt/Core/Relocation.h"
+#include "llvm/MC/MCInst.h"
+
+using namespace llvm;
+using namespace llvm::bolt;
+
+ARMMCSymbolizer::ARMMCSymbolizer(BinaryFunction &Function,
+                                 bool CreateNewSymbols)
+    : MCSymbolizer(*Function.getBinaryContext().Ctx, nullptr),
+      Function(Function), CreateNewSymbols(CreateNewSymbols) {}
+
+bool ARMMCSymbolizer::tryAddingSymbolicOperand(
+    MCInst &Inst, raw_ostream &, int64_t Value, uint64_t InstAddress,
+    bool, uint64_t, uint64_t, uint64_t InstSize) {
+  BinaryContext &BC = Function.getBinaryContext();
+
+  // BinaryFunction owns control-flow symbolization so it can distinguish
+  // local labels, calls, tail calls and interprocedural branches.
+  if (BC.MIB->isBranch(Inst) || BC.MIB->isCall(Inst))
+    return false;
+
+  const uint64_t Offset = InstAddress - Function.getAddress();
+  const Relocation *Rel =
+      Function.getRelocationInRange(Offset, Offset + InstSize);
+  if (!Rel || !Rel->Symbol)
+    return false;
+
+  const MCExpr *Expr = MCSymbolRefExpr::create(Rel->Symbol, *BC.Ctx);
+  if (Rel->Addend)
+    Expr = MCBinaryExpr::createAdd(
+        Expr, MCConstantExpr::create(Rel->Addend, *BC.Ctx), *BC.Ctx);
+  Inst.addOperand(MCOperand::createExpr(
+      BC.MIB->getTargetExprFor(Inst, Expr, *BC.Ctx, Rel->Type)));
+  return true;
+}
+
+void ARMMCSymbolizer::tryAddingPcLoadReferenceComment(raw_ostream &, int64_t,
+                                                       uint64_t) {}
