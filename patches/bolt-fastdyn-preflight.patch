+# REPORT-NEXT: [('0x8000008', '0x8000008'), ('0x800000a', '0x800000a'), ('0x800000c', '0x800000c'), ('0x800000e', '0x800000e'), ('0x8000010', '0x8000010'), ('0x8000012', '0x8000012'), ('0x8000014', '0x8000014')]
+
+  .syntax unified
