+TEST_P(MCPlusBuilderTester, ARM_ABIAndBranchConstruction) {
+  if (GetParam() != Triple::thumb)
+    GTEST_SKIP();
+
+  const BitVector Params = BC->MIB->getRegsUsedAsParams();
+  for (MCPhysReg Reg : {ARM::R0, ARM::R1, ARM::R2, ARM::R3})
+    EXPECT_TRUE(Params.test(Reg));
+  EXPECT_FALSE(Params.test(ARM::R4));
+  EXPECT_EQ(BC->MIB->getIntArgRegister(0), ARM::R0);
+  EXPECT_EQ(BC->MIB->getIntArgRegister(3), ARM::R3);
+  EXPECT_EQ(BC->MIB->getIntArgRegister(4), 0u);
+
+  BitVector CalleeSaved(BC->MRI->getNumRegs());
+  BC->MIB->getCalleeSavedRegs(CalleeSaved);
+  for (MCPhysReg Reg : {ARM::R4, ARM::R7, ARM::R11, ARM::SP})
+    EXPECT_TRUE(CalleeSaved.test(Reg));
+  EXPECT_FALSE(CalleeSaved.test(ARM::R0));
