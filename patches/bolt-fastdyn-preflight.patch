+# RELOCS: Relocation section '.rel.text' {{.*}} contains 3 entries:
+# RELOCS: 08000010 {{.*}} R_ARM_ABS32 {{.*}} external_object
+# RELOCS-NEXT: 08000018 {{.*}} R_ARM_ABS32 {{.*}} external_object
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
