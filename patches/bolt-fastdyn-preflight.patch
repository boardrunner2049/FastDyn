+          SlotName, orc::ExecutorAddr(BoundValue),
+          sizeof(uint32_t), jitlink::Linkage::Strong, jitlink::Scope::Local,
+          /*IsLive=*/true);
+      Edge.setKind(BoundKind);
+      Edge.setTarget(Slot);
+    }
+  }
+  return Error::success();
