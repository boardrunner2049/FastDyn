+# DISASM-NEXT: add r0, r9
+# DISASM-NEXT: ldr r0, [r0]
+# DISASM-LABEL: <sbrel32_worker>:
+# DISASM: movw r0, #0x28
+# DISASM-NEXT: movt r0, #0x2000
+# DISASM-NEXT: ldr r0, [r0]
+# DISASM-NEXT: add r0, r9
+# DISASM-NEXT: ldr r0, [r0]
+
+#--- fixture.s
+  .syntax unified
+  .thumb
+
+  .section .isr_vector,"a",%progbits
+  .p2align 2
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+  .word 0
+  .word 0
+
+  .section .text,"ax",%progbits
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movw r9, #0
+  movt r9, #0x2000
+  movs r2, #1
+  bl rwpi_worker
+halt:
+  b halt
+  .size Reset_Handler, .-Reset_Handler
+
+  .p2align 2
+  .globl rwpi_worker
+  .type rwpi_worker,%function
+  .thumb_func
+rwpi_worker:
+  push {r7, lr}
+  sub sp, #4
+  add r7, sp, #0
+  str r2, [r7]
+  ldr.w r2, [r7]
+  movw r0, :lower16:rw_data(sbrel) + 4
+  movt r0, :upper16:rw_data(sbrel) + 4
+  add r0, r9
+  ldr r0, [r0]
+  adds r0, r2
+  mov sp, r7
+  add sp, #4
+  pop {r7, pc}
+  .size rwpi_worker, .-rwpi_worker
+
+  .p2align 2
+  .globl checked_rwpi_worker
+  .type checked_rwpi_worker,%function
+  .thumb_func
+checked_rwpi_worker:
+  push {r7, lr}
+  sub sp, #4
+  add r7, sp, #0
+  str r2, [r7]
+  ldr.w r2, [r7]
+  movw r0, #0
+  .reloc .-4, R_ARM_THM_MOVW_BREL, rw_data_checked
+  add r0, r9
+  ldr r0, [r0]
+  adds r0, r2
+  mov sp, r7
+  add sp, #4
+  pop {r7, pc}
+  .size checked_rwpi_worker, .-checked_rwpi_worker
+
+  .p2align 2
+  .globl sbrel32_worker
+  .type sbrel32_worker,%function
+  .thumb_func
+sbrel32_worker:
+  push {r7, lr}
+  sub sp, #4
+  add r7, sp, #0
+  str r2, [r7]
+  ldr.w r2, [r7]
+  movw r0, :lower16:rw_offset
+  movt r0, :upper16:rw_offset
+  ldr r0, [r0]
+  add r0, r9
+  ldr r0, [r0]
+  adds r0, r2
+  mov sp, r7
+  add sp, #4
+  pop {r7, pc}
+  .size sbrel32_worker, .-sbrel32_worker
+
+  .p2align 2
+  .globl unsupported_exec_brel
+  .type unsupported_exec_brel,%function
+  .thumb_func
+unsupported_exec_brel:
+  movw r0, :lower16:flash_data(sbrel)
+  movt r0, :upper16:flash_data(sbrel)
+  bx lr
+  .size unsupported_exec_brel, .-unsupported_exec_brel
+
+  .p2align 2
+  .globl flash_data
+  .type flash_data,%object
+flash_data:
+  .word 7
+  .size flash_data, .-flash_data
+
+  .section .data,"aw",%progbits
+  .space 32
+  .p2align 2
+  .globl rw_data
+  .type rw_data,%object
+rw_data:
+  .word 13
+  .globl rw_data_checked
+  .type rw_data_checked,%object
+rw_data_checked:
+  .word 41
+  .size rw_data_checked, .-rw_data_checked
+  .globl rw_offset
+  .type rw_offset,%object
+rw_offset:
+  .word rw_data_checked(sbrel)
+  .size rw_offset, .-rw_offset
+  .size rw_data, .-rw_data
+
+#--- overflow.s
+  .syntax unified
+  .thumb
+
+  .section .text,"ax",%progbits
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movw r0, #0
+  .reloc .-4, R_ARM_THM_MOVW_BREL, overflow_data
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .section .data,"aw",%progbits
+  .space 65536
+  .globl overflow_data
+  .type overflow_data,%object
+overflow_data:
+  .word 0
+  .size overflow_data, .-overflow_data
+
+#--- link.ld
+ENTRY(Reset_Handler)
+PHDRS {
+  flash PT_LOAD FLAGS(5);
+  ram PT_LOAD FLAGS(6);
+}
+SECTIONS {
+  .isr_vector 0x08000000 : { KEEP(*(.isr_vector)) } :flash
+  .text 0x08000100 : { *(.text) } :flash
+  .data 0x20000000 : { *(.data) } :ram
+}
diff --git a/bolt/test/ARM/thumb2-terminal-literal-pool.s b/bolt/test/ARM/thumb2-terminal-literal-pool.s
new file mode 100644
index 0000000000000000000000000000000000000000..3522837c3084fb2b62146ce32728b1dbda7358c5
--- /dev/null
+++ b/bolt/test/ARM/thumb2-terminal-literal-pool.s
@@ -0,0 +1,78 @@
+## A Thumb-2 LDR.W literal uses the signed-magnitude imm12 relocation model,
+## but can share the same proven terminal-pool ownership and exact-address
+## publication contract as the Thumb-1 form.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='terminal_wide_worker'); s=next(x for x in d['functions'] if x['name']=='svc_fallthrough_worker'); p=f['owned_literal_pools']; print(f['firmware_modified'],len(p),p[0]['owner_instruction_output_address'],p[0]['original_address'],p[0]['output_address'],len(p[0]['labels']),d['synthesized_inline_data_bytes'],s['firmware_modified'],len(s['owned_literal_pools']))" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objdump -d --start-address=0x08000008 --stop-address=0x08000014 %t.bolt | FileCheck %s --check-prefix=CODE
+
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 1 owner block(s), rebound 1 PC-relative reference(s), and retained 1 function(s); skipped 1 unreferenced island function(s)
+# BOLT: BOLT: 1 out of 4 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+# REPORT: True 1 134217740 134217744 134217744 1 4 False 0
+# CODE: <terminal_wide_worker>:
+# CODE: ldr.w r0, [pc, #0x4]
+# CODE-NEXT: bx lr
+# CODE-NEXT: movs r0, r0
+# CODE-NEXT: 8000010: {{.*}}.word 0x12345678
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl terminal_wide_worker
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl terminal_wide_worker
+  .type terminal_wide_worker,%function
+  .thumb_func
+terminal_wide_worker:
+  ldr.w r0, .Lwide_literal
+  bx lr
+  nop
+  .p2align 2
+.Lwide_literal:
+  .word 0x12345678
+  .size terminal_wide_worker, .-terminal_wide_worker
+
+  .globl svc_fallthrough_worker
+  .type svc_fallthrough_worker,%function
+  .thumb_func
+svc_fallthrough_worker:
+  ldr.w r1, .Lsvc_literal
+  svc #0
+  nop
+  .p2align 2
+.Lsvc_literal:
+  .word 0x89abcdef
+  .size svc_fallthrough_worker, .-svc_fallthrough_worker
+
+  # Conservative code/data island metadata without a data PC-relative user is
+  # neither an accepted transformation nor a semantic rejection.
+  .globl island_metadata_only
+  .type island_metadata_only,%function
+  .thumb_func
+island_metadata_only:
+  b.w terminal_wide_worker
+  .p2align 2
+.Lunreferenced_data:
+  .word 0xfeedface
+  .size island_metadata_only, .-island_metadata_only
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumbv8-branch-future-relocations.s b/bolt/test/ARM/thumbv8-branch-future-relocations.s
new file mode 100644
index 0000000000000000000000000000000000000000..91a318cfbd499ed195d335bc8fef725ffa3c481f
--- /dev/null
+++ b/bolt/test/ARM/thumbv8-branch-future-relocations.s
@@ -0,0 +1,113 @@
+## Armv8.1-M branch-future instructions have multiple PC-relative operands,
+## while ELF carries a relocation only for the long target.  FirmBOLT must not
+## symbolize the short branch-location or BFCSEL after-target with that record.
+## Until the architectural low-overhead-loop state machine is represented in
+## the CFG, the complete containing functions are retained fail-closed.
+
+# RUN: llvm-mc -filetype=obj -triple=thumbv8.1m.main-none-eabi \
+# RUN:   -mcpu=cortex-m55 -arm-add-build-attributes %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 \
+# RUN:   --section-start=.isr_vector=0x08001000 -e Reset_Handler \
+# RUN:   %t.o -o %t.exe
+# RUN: llvm-readelf -r %t.exe | FileCheck %s --check-prefix=RELOCS
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m55 \
+# RUN:   --frame-opt=none --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-readelf -r %t.bolt | FileCheck %s --check-prefix=RELOCS
+# RUN: llvm-objdump -d --mcpu=cortex-m55 --no-show-raw-insn %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); print([(f['name'],f['simple'],f['firmware_modified']) for f in d['functions'] if f['name'].endswith('_worker')])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+# RUN: %python -c "import json; d=json.load(open('%t.json')); print([(f['name'],[(hex(e['original_address']),e['opcode'],e['cortex_m_state_effect']) for e in f['opaque_cortex_m_state_effects']]) for f in d['functions'] if f['name'].endswith('_worker')])" \
+# RUN:   | FileCheck %s --check-prefix=EFFECTS
+
+# RELOCS-DAG: R_ARM_THM_BF16{{.*}}bf_target
+# RELOCS-DAG: R_ARM_THM_BF12{{.*}}bfc_target
+# RELOCS-DAG: R_ARM_THM_BF18{{.*}}bfl_target
+
+# BOLT: unresolved=0
+# BOLT: BOLT-INFO: not adding new segments
+
+# DISASM: <bf_worker>:
+# DISASM: bf
+# DISASM: <bfc_worker>:
+# DISASM: bfcsel
+# DISASM: <bfl_worker>:
+# DISASM: bfl
+
+# REPORT: [('bf_worker', False, False), ('bfc_worker', False, False), ('bfl_worker', False, False)]
+# EFFECTS: [('bf_worker', [('0x800000c', 't2BFi', 'branch_future')]), ('bfc_worker', [('0x8000014', 't2BFic', 'branch_future')]), ('bfl_worker', [('0x800001c', 't2BFLi', 'branch_future')])]
+
+  .syntax unified
+  .thumb
+
+  .section .text.entry,"ax",%progbits
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl bf_worker
+  bl bfc_worker
+  b bfl_worker
+  .size Reset_Handler, .-Reset_Handler
+
+  .section .text.workers,"ax",%progbits
+  .p2align 2
+  .globl bf_worker
+  .type bf_worker,%function
+  .thumb_func
+bf_worker:
+  bf #4, bf_target
+  bx lr
+  .size bf_worker, .-bf_worker
+
+  .p2align 2
+  .globl bfc_worker
+  .type bfc_worker,%function
+  .thumb_func
+bfc_worker:
+  bfcsel #4, bfc_target, #8, eq
+  bx lr
+  .size bfc_worker, .-bfc_worker
+
+  .p2align 2
+  .globl bfl_worker
+  .type bfl_worker,%function
+  .thumb_func
+bfl_worker:
+  bfl #4, bfl_target
+  bx lr
+  .size bfl_worker, .-bfl_worker
+
+  .section .text.targets,"ax",%progbits
+  .p2align 2
+  .globl bf_target
+  .type bf_target,%function
+  .thumb_func
+bf_target:
+  bx lr
+  .size bf_target, .-bf_target
+
+  .globl bfc_target
+  .type bfc_target,%function
+  .thumb_func
+bfc_target:
+  bx lr
+  .size bfc_target, .-bfc_target
+
+  .globl bfl_target
+  .type bfl_target,%function
+  .thumb_func
+bfl_target:
+  bx lr
+  .size bfl_target, .-bfl_target
+
+  .section .isr_vector,"a",%progbits
+  .p2align 2
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+  .word 0
+  .word 0
diff --git a/bolt/test/ARM/thumbv8-low-overhead-loop-retention.s b/bolt/test/ARM/thumbv8-low-overhead-loop-retention.s
new file mode 100644
index 0000000000000000000000000000000000000000..c948c93057e1ee5c676031c55f38dd63995ad0f7
--- /dev/null
+++ b/bolt/test/ARM/thumbv8-low-overhead-loop-retention.s
@@ -0,0 +1,98 @@
+## Scalar and MVE tail-predicated low-overhead-loop instructions mutate hidden
+## architectural loop state in addition to their visible LR/VPR operands.
+## FirmBOLT must retain the complete containing function until that state,
+## exception invalidation and implicit branch behavior are represented.
+
+# RUN: llvm-mc -filetype=obj -triple=thumbv8.1m.main-none-eabi \
+# RUN:   -mcpu=cortex-m55 -arm-add-build-attributes %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 \
+# RUN:   --section-start=.isr_vector=0x08001000 -e Reset_Handler \
+# RUN:   %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m55 \
+# RUN:   --frame-opt=all --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-objdump -d --mcpu=cortex-m55 --no-show-raw-insn %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); print([(f['name'],f['simple'],f['firmware_modified']) for f in d['functions'] if f['name'].endswith('_worker')])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+# RUN: %python -c "import json; d=json.load(open('%t.json')); print([(f['name'],[(hex(e['original_address']),e['opcode'],e['cortex_m_state_effect']) for e in f['opaque_cortex_m_state_effects']]) for f in d['functions'] if f['name'].endswith('_worker')])" \
+# RUN:   | FileCheck %s --check-prefix=EFFECTS
+
+# BOLT: BOLT-INFO: not adding new segments
+
+# DISASM: <scalar_worker>:
+# DISASM: wls lr, r0
+# DISASM: le lr
+# DISASM: <mve_while_worker>:
+# DISASM: wlstp.8 lr, r0
+# DISASM: letp lr
+# DISASM: <mve_do_worker>:
+# DISASM: dlstp.16 lr, r0
+# DISASM: lctp
+# DISASM: letp lr
+
+# REPORT: [('scalar_worker', False, False), ('mve_while_worker', False, False), ('mve_do_worker', False, False)]
+# EFFECTS: [('scalar_worker', [('0x800000c', 't2WLS', 'low_overhead_loop'), ('0x8000012', 't2LEUpdate', 'low_overhead_loop')]), ('mve_while_worker', [('0x8000018', 'MVE_WLSTP_8', 'low_overhead_loop'), ('0x800001e', 'MVE_LETP', 'low_overhead_loop')]), ('mve_do_worker', [('0x8000024', 'MVE_DLSTP_16', 'low_overhead_loop'), ('0x8000028', 'MVE_LCTP', 'low_overhead_loop'), ('0x800002e', 'MVE_LETP', 'low_overhead_loop')])]
+
+  .syntax unified
+  .thumb
+
+  .section .text.entry,"ax",%progbits
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl scalar_worker
+  bl mve_while_worker
+  b mve_do_worker
+  .size Reset_Handler, .-Reset_Handler
+
+  .section .text.workers,"ax",%progbits
+  .p2align 2
+  .globl scalar_worker
+  .type scalar_worker,%function
+  .thumb_func
+scalar_worker:
+  wls lr, r0, .Lscalar_end
+.Lscalar_loop:
+  adds r1, #1
+  le lr, .Lscalar_loop
+.Lscalar_end:
+  bx lr
+  .size scalar_worker, .-scalar_worker
+
+  .p2align 2
+  .globl mve_while_worker
+  .type mve_while_worker,%function
+  .thumb_func
+mve_while_worker:
+  wlstp.8 lr, r0, .Lmve_while_end
+.Lmve_while_loop:
+  nop
+  letp lr, .Lmve_while_loop
+.Lmve_while_end:
+  bx lr
+  .size mve_while_worker, .-mve_while_worker
+
+  .p2align 2
+  .globl mve_do_worker
+  .type mve_do_worker,%function
+  .thumb_func
+mve_do_worker:
+  dlstp.16 lr, r0
+.Lmve_do_loop:
+  lctp
+  nop
+  letp lr, .Lmve_do_loop
+  bx lr
+  .size mve_do_worker, .-mve_do_worker
+
+  .section .isr_vector,"a",%progbits
+  .p2align 2
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+  .word 0
+  .word 0
diff --git a/bolt/test/elf32-basic.test b/bolt/test/elf32-basic.test
