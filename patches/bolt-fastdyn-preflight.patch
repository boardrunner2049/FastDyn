index 0000000000000000000000000000000000000000..a133be2230bbe913e7653ca444a1cda39c211ba9
--- /dev/null
+++ b/bolt/test/ARM/requires-vector-contract.s
@@ -0,0 +1,28 @@
+## Production Cortex-M optimization must not guess exception entries.  An
+## explicit identity/emission diagnostic remains available for decoder and
+## linker bring-up, but it is not the optimization default.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 --emit-relocs -e ordinary_entry %t.o -o %t.exe
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 -o %t.bolt \
+# RUN:   2>&1 | FileCheck %s --check-prefix=REJECT
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline=false -o %t.identity 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=IDENTITY
+
+# REJECT: BOLT-ERROR: Cortex-M production optimization requires an explicit .isr_vector section
+# IDENTITY: BOLT: 0 out of 1 functions were overwritten.
+# IDENTITY: BOLT-INFO: not adding new segments
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .globl ordinary_entry
+  .type ordinary_entry,%function
+  .thumb_func
+ordinary_entry:
+  movs r0, #7
+  bx lr
+  .size ordinary_entry, .-ordinary_entry
diff --git a/bolt/test/ARM/secondary-vector-entry.s b/bolt/test/ARM/secondary-vector-entry.s
new file mode 100644
index 0000000000000000000000000000000000000000..c3fdf7d62fbeb049e875f453d8d6b2a20a8c4a88
--- /dev/null
+++ b/bolt/test/ARM/secondary-vector-entry.s
@@ -0,0 +1,41 @@
+## A vector can legally name an assembly/secondary entry inside a symbolized
+## function.  Protect the exact containing function instead of either guessing
+## a nearest anchor or optimizing through the entry.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 --emit-relocs -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 -o %t.bolt \
+# RUN:   2>&1 | FileCheck %s
+
+# CHECK: Cortex-M firmware constraints:
+# CHECK-SAME: protected-handlers=2
+# CHECK-SAME: secondary-entry-handlers=1
+# CHECK-SAME: unresolved=0
+# CHECK: BOLT: 0 out of 2 functions were overwritten.
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl SecondaryHandlerContainer
+  .type SecondaryHandlerContainer,%function
+  .thumb_func
+SecondaryHandlerContainer:
+  nop
+.Lsecondary_handler:
+  bx lr
+  .size SecondaryHandlerContainer, .-SecondaryHandlerContainer
+
+  .section .isr_vector,"a",%progbits
+  .word 0x20001000
+  .word Reset_Handler
+  .word .Lsecondary_handler + 1
diff --git a/bolt/test/ARM/thumb-abs32-jump-table-promotion-detached-rejected.s b/bolt/test/ARM/thumb-abs32-jump-table-promotion-detached-rejected.s
new file mode 100644
index 0000000000000000000000000000000000000000..eec0c28c484a876125a6ac223ad245fca49d0ad6
--- /dev/null
+++ b/bolt/test/ARM/thumb-abs32-jump-table-promotion-detached-rejected.s
@@ -0,0 +1,87 @@
+## A detached ABS32 table may have unknown/shared users and is not part of the
+## function's atomic publication range. Retain it when the input lacks exact
+## relocations for the pointer and every table entry, even with an admitted
+## compare/branch-event contract and a hot edge profile.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: link_fdata %s %t.exe %t.fdata
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=jump-tables \
+# RUN:   --icp-jt-topn=1 --icp-top-callsites=0 \
+# RUN:   --firmbolt-allow-jump-table-promotion \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   -v=1 -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+
+# LOG: BOLT-INFO: ICP skipped detached Thumb ABS32 table in switch_worker
+# LOG-SAME: retained relocation graph or explicit atomic update contract is incomplete
+# LOG: BOLT: 0 out of 2 functions were overwritten.
+# DISASM: <switch_worker>:
+# DISASM: cmp r0, #0x2
+# DISASM: mov pc, r2
+# DISASM-NOT: cmp.w r0, #0x0
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  bl switch_worker
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .p2align 2
+  .globl switch_worker
+  .type switch_worker,%function
+  .thumb_func
+switch_worker:
+  cmp r0, #2
+  bls .Ldispatch
+  movs r0, #0
+  bx lr
+.Ldispatch:
+  lsls r1, r0, #2
+  ldr r2, .Ltable_pointer
+  adds r2, r1, r2
+  ldr r2, [r2]
+  mov pc, r2
+# FDATA: 1 switch_worker 10 1 switch_worker 12 0 90
+# FDATA: 1 switch_worker 10 1 switch_worker 16 5 5
+# FDATA: 1 switch_worker 10 1 switch_worker 1a 5 5
+.Lcase0:
+  movs r0, #10
+  bx lr
+.Lcase1:
+  movs r0, #20
+  bx lr
+.Lcase2:
+  movs r0, #30
+  bx lr
+  .p2align 2
+.Ltable_pointer:
+  .word .Ldetached_table
+  .size switch_worker, .-switch_worker
+
+  .section .rodata,"a",%progbits
+  .p2align 2
+.Ldetached_table:
+  .word .Lcase0
+  .word .Lcase1
+  .word .Lcase2
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb-abs32-jump-table-promotion-detached-relocs.s b/bolt/test/ARM/thumb-abs32-jump-table-promotion-detached-relocs.s
new file mode 100644
index 0000000000000000000000000000000000000000..2c41163fed6becef236291f6be3ff2acb0f7913b
--- /dev/null
+++ b/bolt/test/ARM/thumb-abs32-jump-table-promotion-detached-relocs.s
@@ -0,0 +1,117 @@
+## A detached, read-only ABS32 switch table is eligible only when retained
+## input relocations cover the literal pointer and every table entry and the
+## caller explicitly admits atomic publication of the function and table.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: link_fdata %s %t.exe %t.fdata
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=jump-tables \
+# RUN:   --icp-jt-topn=1 --icp-top-callsites=0 \
+# RUN:   --firmbolt-allow-jump-table-promotion \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   -v=1 -o %t.no-contract 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=NO-CONTRACT
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=jump-tables \
+# RUN:   --icp-jt-topn=1 --icp-top-callsites=0 \
+# RUN:   --firmbolt-allow-jump-table-promotion \
+# RUN:   --firmbolt-allow-detached-jump-table-update \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --fastdyn-firmware-report=%t.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-readelf -x .rodata -r %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=RELOCS
+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='switch_worker'); t=f['inline_jump_tables'][0]; print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),d['synthesized_jump_table_promotion_instruction_count']); print(t['reference_relocations_complete'],hex(t['table_pointer_original_address']),hex(t['table_pointer_output_address']),hex(t['original_table_address']),hex(t['table_output_address']),[hex(x) for x in t['target_block_output_addresses']])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# NO-CONTRACT: BOLT-INFO: recovered Thumb ABS32 jump table in switch_worker
+# NO-CONTRACT: BOLT-INFO: ICP skipped detached Thumb ABS32 table in switch_worker
+# NO-CONTRACT-SAME: retained relocation graph or explicit atomic update contract is incomplete
+# NO-CONTRACT: BOLT: 0 out of 2 functions were overwritten.
+# LOG: BOLT-INFO: recovered Thumb ABS32 jump table in switch_worker
+# LOG: ICP succeeded in switch_worker
+# LOG: BOLT: 1 out of 2 functions were overwritten.
+# LOG: BOLT-INFO: not adding new segments
+# DISASM: <switch_worker>:
+# DISASM: cmp.w r0, #0
+# DISASM-NEXT: beq
+# DISASM: mov pc, r2
+# RELOCS: Relocation section '.rel.text'
