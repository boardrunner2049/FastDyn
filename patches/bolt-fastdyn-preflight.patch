+++ b/bolt/test/ARM/thumb1-shared-relocation-pool-growth.s
@@ -0,0 +1,79 @@
+## A retained SHT_REL container starts with one record for the original pool.
+## Cloning the value-only pool must grow that container with one record for
+## each live copy, remap both source offsets, and retain the external binding.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --firmbolt-allow-literal-address-changes -v=2 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-readelf -SWr %t.bolt | FileCheck %s --check-prefix=RELOCS
+
+# BOLT: Thumb literal-pool placement qualified 1 function(s), attached 2 owner block(s), rebound 2 PC-relative reference(s), and retained 0 function(s)
+# BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: remapped 1 ARM SHT_REL offset(s) and {{[0-9]+}} symbol index(es), adding 1 relocation record(s) in .rel.text
+# RELOCS: .rel.text REL {{.*}} 000018 08
+# RELOCS: Relocation section '.rel.text' {{.*}} contains 3 entries:
+# RELOCS: 08000010 {{.*}} R_ARM_ABS32 {{.*}} external_object
+# RELOCS-NEXT: 08000018 {{.*}} R_ARM_ABS32 {{.*}} external_object
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  bl shared_relocation_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl shared_relocation_worker
+  .type shared_relocation_worker,%function
+  .thumb_func
+shared_relocation_worker:
+  cmp r0, #0
+  beq .Lsecond
+.Lfirst:
+  ldr r1, .Lliteral
+  b .Lguard
+.Lsecond:
+  ldr r1, .Lliteral
+  b .Lguard
+.Lguard:
+  b .Lafter_pool
+  .p2align 2
+.Lliteral:
+  .word external_object
+.Lafter_pool:
+  .rept 520
+  nop
+  .endr
+  mov r0, r1
+  bx lr
+  .p2align 2
+  .globl __firmbolt_thumb_literal_capacity0
+  .type __firmbolt_thumb_literal_capacity0,%object
+__firmbolt_thumb_literal_capacity0:
+  .word 0
+  .word 0
+  .size __firmbolt_thumb_literal_capacity0, .-__firmbolt_thumb_literal_capacity0
+  .size shared_relocation_worker, .-shared_relocation_worker
+
+  .p2align 2
+  .globl external_object
+  .type external_object,%object
+external_object:
+  .word 0x12345678
+  .size external_object, .-external_object
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
