+# USELESS: Cortex-M useless-conditional-branch removal is not yet qualified
+# LOG: Peephole: 1 double jumps patched
+# DISASM: <peephole_worker>:
+# DISASM: cmp r0, #0x0
+# DISASM-NEXT: beq 0x8000012
+# DISASM-NEXT: movs r0, #0x9
+# DISASM-NEXT: bx lr
+# DISASM-NEXT: b 0x8000012
+# DISASM-NEXT: movs r0, #0x5
+# DISASM-NEXT: bx lr
