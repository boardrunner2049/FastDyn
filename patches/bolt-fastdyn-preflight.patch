index 0000000000000000000000000000000000000000..01c2fb3ff4df15d90b174a838573d3426199bcb4
--- /dev/null
+++ b/bolt/test/ARM/thumb-zero-size-absolute-boundary.s
@@ -0,0 +1,59 @@
+## Absolute symbols are numeric constants, not file positions.  They must not
+## truncate a zero-sized function when BOLT infers its extent from the next
+## symbol.  The constant 0xff lies inside the address range of the first
+## function but the complete second MOVNE.W extends through address 0xff.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --image-base=0 -Ttext=0xec -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-reject-target-incompatible-input --frame-opt=none \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+
+# BOLT: BOLT-INFO: Cortex-M target CPU cortex-m3
+# BOLT-NOT: cannot decode instruction
+# BOLT: BOLT: 0 out of 2 functions were overwritten.
+# DISASM: <Reset_Handler>:
+# DISASM: cmp r1, #0x0
+# DISASM: itt ne
+# DISASM: movne.w r1, #0xffffffff
+# DISASM: movne.w r0, #0xffffffff
+# DISASM: b.w
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_name, "cortex-m3"
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+
+  .globl CONFIG_BUILD_GAP_FILL_PATTERN
+  .type CONFIG_BUILD_GAP_FILL_PATTERN,%object
+  .set CONFIG_BUILD_GAP_FILL_PATTERN, 0xff
+
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  cmp r1, #0
+  itt ne
+  movne.w r1, #-1
+  movne.w r0, #-1
+  b.w next_function
+
+  .p2align 2
+  .globl next_function
+  .type next_function,%function
+  .thumb_func
+next_function:
+  bx lr
+  .size next_function, .-next_function
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-absolute-jump-table.s b/bolt/test/ARM/thumb1-absolute-jump-table.s
