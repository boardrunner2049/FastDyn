+## BOLT tail duplication is target-generic machinery, but it copies original
+## instructions and changes execution multiplicity. Firm-BOLT therefore keeps
+## it fail-closed for firmware until the contract admits the change and must
+## publish exact clone provenance for every duplicated Thumb instruction.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: link_fdata --no-lbr %s %t.exe %t.fdata
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata \
+# RUN:   --tail-duplication=aggressive --tail-duplication-minimum-offset=0 \
+# RUN:   -o %t.denied 2>&1 | FileCheck %s --check-prefix=DENIED
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata \
+# RUN:   --tail-duplication=aggressive --tail-duplication-minimum-offset=0 \
+# RUN:   --firmbolt-allow-tail-duplication \
+# RUN:   --tail-duplication-const-copy-propagation \
+# RUN:   -o %t.propagation-denied 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=PROPAGATION-DENIED
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata \
+# RUN:   --tail-duplication=aggressive --tail-duplication-minimum-offset=0 \
+# RUN:   --firmbolt-allow-tail-duplication \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --eliminate-unreachable=false --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=taildup_worker \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); l=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='taildup_worker'); lf=next(x for x in l['functions'] if x['name']=='taildup_worker'); clones=[x for x in f['instructions'] if x['provenance_kind']=='cloned_original_instruction']; lc=[x for x in lf['instruction_origins'] if x['origin_kind']=='cloned_original_instruction']; print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),len(clones),d['summary']['cloned_original_instruction_count'],d['summary']['unmapped_instruction_count']); print([(hex(x['original_address']),hex(x['output_address'])) for x in lc])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# DENIED: Cortex-M tail duplication changes execution multiplicity
+# PROPAGATION-DENIED: Cortex-M tail-duplication propagation removes register-defining instructions
+# LOG: tail duplication modified 1
+# DISASM: <taildup_worker>:
+# DISASM: movs r0, #0x1
+# DISASM: adds r0, #0x2
+# DISASM-NEXT: bx lr
+# REPORT: True instruction_shortening,tail_duplication 2 2 0
+# REPORT-NEXT: [('0x8000016', '0x800000e'), ('0x8000018', '0x8000010')]
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  bl taildup_worker
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl taildup_worker
+  .type taildup_worker,%function
+  .thumb_func
+taildup_worker:
+  cmp r0, #0
+  bne .Ltaildup_cold
+.Ltaildup_hot:
+  movs r0, #1
+  b.w .Ltaildup_shared
+.Ltaildup_cold:
+  movs r0, #10
+  bx lr
+.Ltaildup_shared:
+  adds r0, #2
+  bx lr
+  .size taildup_worker, .-taildup_worker
+
+# FDATA: 1 taildup_worker 0 100
+# FDATA: 1 taildup_worker 4 100
+# FDATA: 1 taildup_worker a 1
+# FDATA: 1 taildup_worker e 100
+
+  .section .isr_vector,"a",%progbits
