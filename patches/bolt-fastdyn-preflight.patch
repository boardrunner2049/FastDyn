index 0000000000000000000000000000000000000000..f512cc9ce952d7ad57a5082ebceed580d15368ff
--- /dev/null
+++ b/bolt/test/ARM/thumb1-terminal-pop-padded-literal-pool.s
@@ -0,0 +1,71 @@
+## Compiler-shaped Thumb-1 epilogues can retain an alignment NOP in the same
+## BOLT basic block as POP {...,pc}. The return still guards the literal pool:
+## walk backward across exact no-ops rather than requiring the block's final
+## decoded instruction itself to be the owner.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='padded_pop_worker'); p=f['owned_literal_pools']; print(f['firmware_modified'],len(p),p[0]['owner_instruction_output_address'],p[0]['original_address'],p[0]['output_address'],d['synthesized_inline_data_bytes'])" | FileCheck %s --check-prefix=REPORT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='non_nop_worker'); print(f['firmware_modified'],len(f['owned_literal_pools']))" | FileCheck %s --check-prefix=NONNOP
+# RUN: llvm-objdump -d --start-address=0x08000008 --stop-address=0x08000018 %t.bolt | FileCheck %s --check-prefix=CODE
+
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 1 owner block(s), rebound 1 PC-relative reference(s), and retained 1 function(s)
+# BOLT: BOLT: 1 out of 3 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+# REPORT: True 1 134217740 134217744 134217744 4
+# NONNOP: False 0
+# CODE: <padded_pop_worker>:
+# CODE: push {r4, lr}
+# CODE-NEXT: ldr r0, [pc, #0x4]
+# CODE-NEXT: pop {r4, pc}
+# CODE-NEXT: movs r0, r0
+# CODE-NEXT: 8000010: {{.*}}.word 0x00000007
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl padded_pop_worker
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl padded_pop_worker
+  .type padded_pop_worker,%function
+  .thumb_func
+padded_pop_worker:
+  push {r4, lr}
+  ldr r0, .Lliteral
+  pop {r4, pc}
+  nop
+  .p2align 2
+.Lliteral:
+  .word 7
+  .size padded_pop_worker, .-padded_pop_worker
+
+  .globl non_nop_worker
+  .type non_nop_worker,%function
+  .thumb_func
+non_nop_worker:
+  ldr r1, .Lretained_literal
+  bx lr
+  movs r2, #0
+  .p2align 2
+.Lretained_literal:
+  .word 9
+  .size non_nop_worker, .-non_nop_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb2-abs-mov-pair-addend-reorder.s b/bolt/test/ARM/thumb2-abs-mov-pair-addend-reorder.s
new file mode 100644
index 0000000000000000000000000000000000000000..00ad60dc513e8f74e18a033f82dd27073f9a6c8e
--- /dev/null
+++ b/bolt/test/ARM/thumb2-abs-mov-pair-addend-reorder.s
@@ -0,0 +1,91 @@
+## Move a Thumb-2 function containing a split absolute MOVW/MOVT pair whose
+## SHT_REL implicit addend is non-zero.
+
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple=thumbv7m-none-eabi -mcpu=cortex-m3 %t/fixture.s -o %t.o
+# RUN: ld.lld --emit-relocs -T %t/link.ld %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 --relocs \
+# RUN:   --use-old-text --reorder-functions=user --align-functions=1 \
+# RUN:   --function-order=%t/order.txt -v=3 -o %t.out 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-readelf -rW %t.out | FileCheck %s --check-prefix=RELOCS
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.out \
+# RUN:   | FileCheck %s --check-prefix=CANDIDATE-CODE
+
+# BOLT-DAG: BOLT-DEBUG: ARM relocation external_data type 47 {{.*}} addend=4
+# BOLT-DAG: BOLT-DEBUG: ARM relocation external_data type 48 {{.*}} addend=4
+# BOLT: BOLT-INFO: 3 functions pinned by order file
+
+# RELOCS-DAG: 08000100 {{.*}} R_ARM_THM_MOVW_ABS_NC {{.*}} external_data
+# RELOCS-DAG: 08000104 {{.*}} R_ARM_THM_MOVT_ABS {{.*}} external_data
+
+# CANDIDATE-CODE: <abs_worker>:
+# CANDIDATE-CODE-NEXT: movw r0, #0x1004
+# CANDIDATE-CODE-NEXT: movt r0, #0x800
+
+#--- fixture.s
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+
+  .section .text.reset,"ax",%progbits
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl abs_worker
+halt:
+  b halt
+  .size Reset_Handler, .-Reset_Handler
+
+  .section .text.spacer,"ax",%progbits
+  .globl spacer
+  .type spacer,%function
+  .thumb_func
+spacer:
+  bx lr
+  .size spacer, .-spacer
+
+  .section .text.worker,"ax",%progbits
+  .globl abs_worker
+  .type abs_worker,%function
+  .thumb_func
+abs_worker:
+  movw r0, :lower16:(external_data + 4)
+  movt r0, :upper16:(external_data + 4)
+  ldr r0, [r0]
+  bx lr
+  .size abs_worker, .-abs_worker
+
+  .section .rodata,"a",%progbits
+  .p2align 2
+  .globl external_data
+external_data:
+  .word 13
+  .word 42
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+  .word 0
+  .word 0
+
+#--- link.ld
+ENTRY(Reset_Handler)
+SECTIONS {
+  .isr_vector 0x08000000 : { KEEP(*(.isr_vector)) }
+  .text 0x08000100 : {
+    *(.text.reset)
+    *(.text.spacer)
+    *(.text.worker)
+  }
+  .rodata 0x08001000 : { *(.rodata) }
+}
+
+#--- order.txt
+abs_worker
+spacer
+Reset_Handler
diff --git a/bolt/test/ARM/thumb2-branch-shortening.s b/bolt/test/ARM/thumb2-branch-shortening.s
