index 0000000000000000000000000000000000000000..ba7116256186cfe150195f866da5470e3e7909b1
--- /dev/null
+++ b/bolt/test/ARM/thumb-native-indirect-call-method-load-elimination.s
@@ -0,0 +1,127 @@
+## Qualify BOLT's existing method-load-elimination path for a Cortex-M3
+## fixed-offset load from an immutable, mapped vtable. The hot path compares
+## the vtable address and calls directly; the cold path must still execute the
+## exact original method load and BLX. Without the firmware read-elision
+## contract, ordinary ICP may run but the load must remain ahead of the guard.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: link_fdata %s %t.exe %t.fdata
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
+# RUN:   --icp-calls-topn=1 --icp-top-callsites=0 --assume-abi \
+# RUN:   --firmbolt-allow-indirect-call-promotion \
+# RUN:   --firmbolt-allow-method-load-elimination \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --fastdyn-firmware-report=%t.json -v=2 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=virtual_caller \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=ELIM
+# RUN: %python -c "import json; p=json.load(open('%t.json')); f=next(x for x in p['functions'] if x['name']=='virtual_caller'); print(f['firmware_modification_reasons'])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
+# RUN:   --icp-calls-topn=1 --icp-top-callsites=0 --assume-abi \
+# RUN:   --firmbolt-allow-indirect-call-promotion \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   -v=2 -o %t.retained 2>&1 | FileCheck %s --check-prefix=DENIED
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=virtual_caller \
+# RUN:   %t.retained | FileCheck %s --check-prefix=RETAINED
+
+# LOG: ICP found virtual method call in virtual_caller
+# LOG: Cortex-M ICP generator inputs in virtual_caller:
+# LOG-SAME: vtables=1
+# LOG-SAME: fetch-insns=1
+# LOG: ICP succeeded in virtual_caller
+# LOG: ICP number of method load elimination candidates = 1
+# LOG: ICP percentage of method calls candidates that have loads eliminated = 100.0%
+
+# ELIM: <virtual_caller>:
+# ELIM: push {lr}
+# ELIM-NEXT: ldr r3, [r0]
+# ELIM-NEXT: movw r12, #{{[0-9]+}}
+# ELIM-NEXT: movt r12, #{{[0-9]+}}
+# ELIM-NEXT: cmp.w r3, r12
+# ELIM-NEXT: bne
+# ELIM: bl 0x{{[0-9a-f]+}} <promoted_target>
+# ELIM: ldr r2, [r3]
+# ELIM-NEXT: blx r2
+# ELIM: pop {pc}
+
+# REPORT: indirect_call_promotion
+# REPORT-SAME: method_load_elimination
+
+# DENIED: ICP retained Cortex-M method load in virtual_caller: missing --firmbolt-allow-method-load-elimination
+# DENIED: ICP percentage of method calls candidates that have loads eliminated = 0.0%
+# RETAINED: <virtual_caller>:
+# RETAINED: push {lr}
+# RETAINED-NEXT: ldr r3, [r0]
+# RETAINED-NEXT: ldr r2, [r3]
+# RETAINED-NEXT: movw r12, #{{[0-9]+}}
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movw r4, #0
+  movt r4, #0x2000
+  movw r3, :lower16:immutable_vtable
+  movt r3, :upper16:immutable_vtable
+  str r3, [r4]
+  mov r0, r4
+  bl virtual_caller
+  str r0, [r4, #4]
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl virtual_caller
+  .type virtual_caller,%function
+  .thumb_func
+virtual_caller:
+  push {lr}
+  ldr r3, [r0]
+  ldr r2, [r3]
+  blx r2
+# FDATA: 1 virtual_caller 6 1 promoted_target 0 0 100
+# Memory-profile records must follow branch-profile records in fdata.
+# FDATA: 4 virtual_caller 4 4 immutable_vtable 0 100
+  b 1f
+  .rept 16
+  nop
+  .endr
+1:
+  pop {pc}
+  .size virtual_caller, .-virtual_caller
+
+  .globl promoted_target
+  .type promoted_target,%function
+  .thumb_func
+promoted_target:
+  adds r0, #7
+  bx lr
+  .size promoted_target, .-promoted_target
+
+  .section .rodata.vtable,"a",%progbits
+  .p2align 2
+  .globl immutable_vtable
+  .type immutable_vtable,%object
+immutable_vtable:
+  # ARM ELF STT_FUNC symbols already carry the Thumb-state bit in data
+  # relocations; an extra +1 would produce an invalid even function pointer.
+  .word promoted_target
+  .size immutable_vtable, .-immutable_vtable
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
