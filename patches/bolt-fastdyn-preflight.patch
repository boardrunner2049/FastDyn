+# RUN:   --frame-opt=all --eliminate-unreachable=false \
+# RUN:   --fastdyn-firmware-report=%t.default.json -o %t.default
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=all --eliminate-unreachable=false \
+# RUN:   --firmbolt-allow-handler-exact-self-forwarding-state-inputs \
+# RUN:   --fastdyn-firmware-report=%t.allowed.json -o %t.allowed
+# RUN: %python -c "import json; f={x['name']:x for x in json.load(open('%t.default.json'))['functions']}; print(f['exact_state_handler']['firmware_modified'],f['exact_state_handler']['firmware_publication_rejections']); print(f['nonself_state_handler']['firmware_modified'],f['nonself_state_handler']['firmware_publication_rejections']); print(f['return_input_handler']['firmware_modified'],f['return_input_handler']['firmware_publication_rejections'])" | FileCheck %s --check-prefix=DEFAULT
+# RUN: %python -c "import json; d=json.load(open('%t.allowed.json')); f={x['name']:x for x in d['functions']}; fw={x['load_original_address']:x for x in d['frame_forwardings']}; print(f['exact_state_handler']['firmware_modified'],f['exact_state_handler']['firmware_publication_rejections']); print(f['nonself_state_handler']['firmware_modified'],f['nonself_state_handler']['firmware_publication_rejections']); print(f['return_input_handler']['firmware_modified'],f['return_input_handler']['firmware_publication_rejections']); print(sorted(x['exact_adjacent_self_move'] for x in fw.values()))" | FileCheck %s --check-prefix=ALLOWED
+# RUN: llvm-objdump -d --mcpu=cortex-m3 %t.allowed | FileCheck %s --check-prefix=CODE
+
+# DEFAULT: False ['exception_state_input_changed']
+# DEFAULT-NEXT: False ['exception_state_input_changed']
+# DEFAULT-NEXT: False ['exception_return_input_changed']
+# ALLOWED: True []
+# ALLOWED-NEXT: False ['exception_state_input_changed']
+# ALLOWED-NEXT: False ['exception_return_input_changed']
+# ALLOWED-NEXT: [False, False, True]
+# CODE: <exact_state_handler>:
+# CODE: str r0, [sp]
+# CODE-NEXT: mov r0, r0
+# CODE-NEXT: msr basepri, r0
+# CODE: <nonself_state_handler>:
+# CODE: str r0, [sp]
+# CODE-NEXT: ldr r1, [sp]
+# CODE-NEXT: msr basepri, r1
+# CODE: <return_input_handler>:
+# CODE: str r0, [sp]
+# CODE-NEXT: ldr.w lr, [sp]
+# CODE: bx lr
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl exact_state_handler
+  .type exact_state_handler,%function
+  .thumb_func
+exact_state_handler:
+  sub sp, #4
+  str r0, [sp]
+  ldr r0, [sp]
+  msr basepri, r0
+  add sp, #4
+  bx lr
+  .size exact_state_handler, .-exact_state_handler
+
+  .globl nonself_state_handler
+  .type nonself_state_handler,%function
+  .thumb_func
+nonself_state_handler:
+  sub sp, #4
+  str r0, [sp]
+  ldr r1, [sp]
+  msr basepri, r1
+  add sp, #4
+  bx lr
+  .size nonself_state_handler, .-nonself_state_handler
+
+  .globl return_input_handler
+  .type return_input_handler,%function
+  .thumb_func
+return_input_handler:
+  sub sp, #4
+  str r0, [sp]
+  ldr lr, [sp]
+  add sp, #4
+  bx lr
+  .size return_input_handler, .-return_input_handler
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+  .word exact_state_handler
+  .word nonself_state_handler
+  .word return_input_handler
diff --git a/bolt/test/ARM/cortex-m-handler-fop.s b/bolt/test/ARM/cortex-m-handler-fop.s
