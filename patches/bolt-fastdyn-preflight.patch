+  .p2align 2
+  .globl byte_range_switch
+  .type byte_range_switch,%function
+  .thumb_func
+byte_range_switch:
+  cmp r0, #3
+  bhi .Lbyte_default
+# FDATA: 1 byte_range_switch 2 1 byte_range_switch 4 0 100
+# FDATA: 1 byte_range_switch 2 1 byte_range_switch 20 0 1
+  tbh [pc, r0, lsl #1]
+.Lbyte_table:
