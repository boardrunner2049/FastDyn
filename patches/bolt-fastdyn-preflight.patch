+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json')); p=next(x for x in d['functions'] if x['name']=='proven_transfer'); n=next(x for x in d['functions'] if x['name']=='lr_read_transfer'); q=[r for i in p['instructions'] for r in i.get('owned_literal_pool_ranges',[])]; print(p['firmware_modified'],len(q),q[0]['owner_kind'],q[0]['original_address'],q[0]['estimated_output_offset']); print(n['firmware_modified'],sum(len(i.get('owned_literal_pool_ranges',[])) for i in n['instructions']))" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objdump -d %t.bolt | FileCheck %s --check-prefix=CODE
+
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 1 owner block(s), rebound 1 PC-relative reference(s), and retained 1 function(s)
+# BOLT: BOLT: 1 out of 4 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+# REPORT: True 1 proven_local_call_transfer
+# REPORT-NEXT: False 0
+# CODE: <proven_transfer>:
+# CODE: ldr r1
+# CODE-NEXT: bl
+# CODE-NEXT: movs r0, r0
+# CODE-NEXT: {{.*}}.word 0x11223344
+# CODE: <lr_read_transfer>:
+# CODE: mov r0, lr
+# CODE: ldr r1
+# CODE-NEXT: bl
+# CODE-NEXT: {{.*}}.word 0x55667788
+
