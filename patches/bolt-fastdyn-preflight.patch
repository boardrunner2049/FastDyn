--- /dev/null
+++ b/lld/test/ELF/arm-thumbv8_1m-branch-future.s
@@ -0,0 +1,57 @@
+// REQUIRES: arm
+// RUN: llvm-mc -triple=thumbv8.1m.main-none-eabi -mcpu=cortex-m55 \
+// RUN:   -arm-add-build-attributes -filetype=obj -o %t.o %s
+// RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e _start %t.o -o %t
+// RUN: llvm-readobj -r %t | FileCheck %s --check-prefix=RELOCS
+// RUN: llvm-objdump -d --mcpu=cortex-m55 --no-show-raw-insn %t \
+// RUN:   | FileCheck %s --check-prefix=DISASM
+
+/// Exercise the three Armv8.1-M branch-future relocations through the final
+/// linker.  Their signed, halfword-scaled target occupies split fields that
+/// are different from ordinary Thumb branches.
+
+// RELOCS-DAG: R_ARM_THM_BF16 bf_target
+// RELOCS-DAG: R_ARM_THM_BF12 bfc_target
+// RELOCS-DAG: R_ARM_THM_BF18 bfl_target
+
+// DISASM: <_start>:
+// DISASM: bf 0x8000008, 0x8000010
+// DISASM: bfcsel 0x800000c, 0x8000012, 0x8000010, eq
+// DISASM: bfl 0x8000010, 0x8000014
+// DISASM: bx lr
+
+  .syntax unified
+  .thumb
+  .text
+  .p2align 2
+  .globl _start
+  .type _start,%function
+  .thumb_func
