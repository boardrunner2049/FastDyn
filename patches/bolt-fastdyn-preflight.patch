+# CHECK-DAG: 08000010 0 NOTYPE LOCAL DEFAULT {{[0-9]+}} $d
+# CHECK-DAG: 08000014 0 NOTYPE LOCAL DEFAULT {{[0-9]+}} $t
+# CHECK-NOT: 00000000 0 NOTYPE LOCAL {{.*}} $d
