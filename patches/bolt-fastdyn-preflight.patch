+  const bool IsLittleEndian = BC->AsmInfo->isLittleEndian();
+  const auto ReadWord = [IsLittleEndian](const char *Data) {
+    return IsLittleEndian ? support::endian::read32le(Data)
+                          : support::endian::read32be(Data);
+  };
