diff --git a/bolt/lib/Target/ARM/ARMRelocationHandler.cpp b/bolt/lib/Target/ARM/ARMRelocationHandler.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8e2a59127ff401151f290077e28279c51fc57b8e
--- /dev/null
+++ b/bolt/lib/Target/ARM/ARMRelocationHandler.cpp
@@ -0,0 +1,339 @@
+//===- ARMRelocationHandler.cpp - ARM/Thumb relocation handling ----------===//
+
+#include "bolt/Core/Relocation.h"
+#include "llvm/ExecutionEngine/JITLink/aarch32.h"
+#include "llvm/Object/ELF.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/MathExtras.h"
+#include "llvm/Support/raw_ostream.h"
+
+using namespace llvm;
+using namespace llvm::bolt;
+
+namespace {
+
+static uint16_t thumbHi(uint32_t Contents) { return Contents & 0xffff; }
+static uint16_t thumbLo(uint32_t Contents) { return Contents >> 16; }
+static uint32_t thumbWords(uint16_t Hi, uint16_t Lo) {
+  return uint32_t(Hi) | (uint32_t(Lo) << 16);
+}
+
+static int64_t decodeThumb19(uint32_t Contents) {
+  const uint16_t Hi = thumbHi(Contents);
+  const uint16_t Lo = thumbLo(Contents);
+  return SignExtend64<21>(((Hi & 0x0400) << 10) |
+                          ((Lo & 0x0800) << 8) |
+                          ((Lo & 0x2000) << 5) |
+                          ((Hi & 0x003f) << 12) |
+                          ((Lo & 0x07ff) << 1));
+}
+
+static uint32_t encodeThumb19(uint32_t Original, int64_t Value) {
+  uint16_t Hi = thumbHi(Original);
+  uint16_t Lo = thumbLo(Original);
+  Hi = (Hi & 0xfbc0) | ((Value >> 10) & 0x0400) |
+       ((Value >> 12) & 0x003f);
+  Lo = (Lo & 0xd000) | 0x8000 | ((Value >> 8) & 0x0800) |
+       ((Value >> 5) & 0x2000) | ((Value >> 1) & 0x07ff);
+  return thumbWords(Hi, Lo);
+}
+
+class ARMRelocationHandler final : public RelocationHandler {
+public:
+  bool isSupported(uint32_t Type) const override {
+    switch (Type) {
+    case ELF::R_ARM_NONE:
+    case ELF::R_ARM_ABS8:
+    case ELF::R_ARM_ABS16:
+    case ELF::R_ARM_ABS32:
+    case ELF::R_ARM_REL32:
+    case ELF::R_ARM_PREL31:
+    case ELF::R_ARM_RELATIVE:
+    case ELF::R_ARM_IRELATIVE:
+    case ELF::R_ARM_V4BX:
+    case ELF::R_ARM_THM_CALL:
+    case ELF::R_ARM_THM_JUMP24:
+    case ELF::R_ARM_THM_JUMP19:
+    case ELF::R_ARM_THM_JUMP11:
+    case ELF::R_ARM_THM_JUMP8:
+    case ELF::R_ARM_THM_JUMP6:
+    case ELF::R_ARM_THM_PC8:
+    case ELF::R_ARM_THM_PC12:
+    case ELF::R_ARM_THM_ALU_PREL_11_0:
+    case ELF::R_ARM_THM_MOVW_ABS_NC:
+    case ELF::R_ARM_THM_MOVT_ABS:
+    case ELF::R_ARM_THM_MOVW_PREL_NC:
+    case ELF::R_ARM_THM_MOVT_PREL:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+  size_t getSizeForType(uint32_t Type) const override {
+    switch (Type) {
+    case ELF::R_ARM_NONE:
+    case ELF::R_ARM_V4BX:
+      return 0;
+    case ELF::R_ARM_ABS8:
+      return 1;
+    case ELF::R_ARM_ABS16:
+    case ELF::R_ARM_THM_JUMP11:
+    case ELF::R_ARM_THM_JUMP8:
+    case ELF::R_ARM_THM_JUMP6:
+    case ELF::R_ARM_THM_PC8:
+      return 2;
+    default:
+      if (isSupported(Type))
+        return 4;
+      llvm_unreachable("unsupported ARM relocation type");
+    }
+  }
+
+  bool skipRelocationType(uint32_t Type) const override {
+    return Type == ELF::R_ARM_NONE || Type == ELF::R_ARM_V4BX;
+  }
+
+  bool canEncodeValue(uint32_t Type, uint64_t Value,
+                      uint64_t PC) const override {
+    const int64_t Delta = int64_t(Value) - int64_t(PC);
+    const int64_t ThumbBranchDelta =
+        int64_t(Value) - int64_t(PC + 4);
+    switch (Type) {
+    case ELF::R_ARM_ABS8:
+      return isUInt<8>(Value) || isInt<8>(Value);
+    case ELF::R_ARM_ABS16:
+      return isUInt<16>(Value) || isInt<16>(Value);
+    case ELF::R_ARM_ABS32:
+    case ELF::R_ARM_RELATIVE:
+    case ELF::R_ARM_IRELATIVE:
+    case ELF::R_ARM_THM_MOVW_ABS_NC:
+    case ELF::R_ARM_THM_MOVT_ABS:
+      return isUInt<32>(Value) || isInt<32>(Value);
+    case ELF::R_ARM_REL32:
+    case ELF::R_ARM_THM_MOVW_PREL_NC:
+    case ELF::R_ARM_THM_MOVT_PREL:
+      return isInt<32>(Delta);
+    case ELF::R_ARM_PREL31:
+      return isInt<31>(Delta);
+    case ELF::R_ARM_THM_JUMP8:
+      return !(ThumbBranchDelta & 1) && isInt<9>(ThumbBranchDelta);
+    case ELF::R_ARM_THM_JUMP6:
+      return ThumbBranchDelta >= 0 && ThumbBranchDelta <= 126 &&
+             !(ThumbBranchDelta & 1);
+    case ELF::R_ARM_THM_JUMP11:
+      return !(ThumbBranchDelta & 1) && isInt<12>(ThumbBranchDelta);
+    case ELF::R_ARM_THM_JUMP19:
+      return !(ThumbBranchDelta & 1) && isInt<21>(ThumbBranchDelta);
+    case ELF::R_ARM_THM_CALL:
+    case ELF::R_ARM_THM_JUMP24:
+      return !(ThumbBranchDelta & 1) && isInt<25>(ThumbBranchDelta);
+    case ELF::R_ARM_THM_PC8: {
+      const int64_t LiteralDelta = int64_t(Value) -
+          int64_t(alignDown(PC + 4, uint64_t(4)));
+      return LiteralDelta >= 0 && !(LiteralDelta & 3) &&
+             isUInt<10>(LiteralDelta);
+    }
+    case ELF::R_ARM_THM_PC12:
+    case ELF::R_ARM_THM_ALU_PREL_11_0: {
+      const int64_t LiteralDelta = int64_t(Value) -
+          int64_t(alignDown(PC + 4, uint64_t(4)));
+      return LiteralDelta >= -4095 && LiteralDelta <= 4095;
+    }
+    default:
+      return false;
+    }
+  }
+
+  uint64_t encodeValue(uint32_t Type, uint64_t Value, uint64_t PC,
+                       uint32_t Original) const override {
+    int64_t Delta = int64_t(Value) - int64_t(PC);
+    switch (Type) {
+    case ELF::R_ARM_ABS8:
+    case ELF::R_ARM_ABS16:
+    case ELF::R_ARM_ABS32:
+    case ELF::R_ARM_RELATIVE:
+    case ELF::R_ARM_IRELATIVE:
+      return Value;
+    case ELF::R_ARM_REL32:
+      return uint32_t(Delta);
+    case ELF::R_ARM_PREL31:
+      return (Original & 0x80000000U) | (uint32_t(Delta) & 0x7fffffffU);
+    case ELF::R_ARM_THM_JUMP8:
+      Delta = int64_t(Value) - int64_t(PC + 4);
+      return (Original & 0xff00U) | ((Delta >> 1) & 0x00ff);
+    case ELF::R_ARM_THM_JUMP6:
+      Delta = int64_t(Value) - int64_t(PC + 4);
+      return (Original & ~0x02f8U) | ((Delta & 0x40) << 3) |
+             ((Delta & 0x3e) << 2);
+    case ELF::R_ARM_THM_JUMP11:
+      Delta = int64_t(Value) - int64_t(PC + 4);
+      return (Original & 0xf800U) | ((Delta >> 1) & 0x07ff);
+    case ELF::R_ARM_THM_JUMP19:
+      Delta = int64_t(Value) - int64_t(PC + 4);
+      return encodeThumb19(Original, Delta);
+    case ELF::R_ARM_THM_CALL:
+    case ELF::R_ARM_THM_JUMP24: {
+      Delta = int64_t(Value) - int64_t(PC + 4);
+      const auto Imm = jitlink::aarch32::encodeImmBT4BlT1BlxT2_J1J2(Delta);
+      return thumbWords((thumbHi(Original) & 0xf800) | Imm.Hi,
+                        (thumbLo(Original) & 0xd000) | Imm.Lo);
+    }
+    case ELF::R_ARM_THM_PC8: {
+      Delta = int64_t(Value) - int64_t(alignDown(PC + 4, uint64_t(4)));
+      return (Original & 0xff00U) | ((Delta >> 2) & 0xff);
+    }
+    case ELF::R_ARM_THM_PC12: {
+      Delta = int64_t(Value) - int64_t(alignDown(PC + 4, uint64_t(4)));
+      uint16_t Hi = thumbHi(Original);
+      uint16_t Lo = thumbLo(Original);
+      Hi = (Hi & ~0x0080U) | (Delta >= 0 ? 0x0080U : 0);
+      Lo = (Lo & 0xf000U) | (uint64_t(std::abs(Delta)) & 0x0fff);
+      return thumbWords(Hi, Lo);
+    }
+    case ELF::R_ARM_THM_ALU_PREL_11_0: {
+      Delta = int64_t(Value) - int64_t(alignDown(PC + 4, uint64_t(4)));
+      uint16_t Hi = thumbHi(Original);
+      uint16_t Lo = thumbLo(Original);
+      const uint32_t Imm = std::abs(Delta);
+      Hi = (Hi & 0xfb0fU) | (Delta < 0 ? 0x00a0U : 0) |
+           ((Imm >> 1) & 0x0400);
+      Lo = (Lo & 0x8f00U) | ((Imm << 4) & 0x7000) | (Imm & 0xff);
+      return thumbWords(Hi, Lo);
+    }
+    case ELF::R_ARM_THM_MOVW_ABS_NC:
+    case ELF::R_ARM_THM_MOVT_ABS:
+    case ELF::R_ARM_THM_MOVW_PREL_NC:
+    case ELF::R_ARM_THM_MOVT_PREL: {
+      uint32_t RelValue = uint32_t(Value);
+      if (Type == ELF::R_ARM_THM_MOVW_PREL_NC ||
+          Type == ELF::R_ARM_THM_MOVT_PREL)
+        RelValue = uint32_t(Delta);
+      if (Type == ELF::R_ARM_THM_MOVT_ABS ||
+          Type == ELF::R_ARM_THM_MOVT_PREL)
+        RelValue >>= 16;
+      const auto Imm = jitlink::aarch32::encodeImmMovtT1MovwT3(RelValue);
+      return thumbWords((thumbHi(Original) & 0xfbf0) | Imm.Hi,
+                        (thumbLo(Original) & 0x8f00) | Imm.Lo);
+    }
+    default:
+      llvm_unreachable("unsupported ARM relocation encoding");
+    }
+  }
+
+  uint64_t extractValue(uint32_t Type, uint64_t Contents,
+                        uint64_t PC) const override {
+    const uint32_t Word = uint32_t(Contents);
+    switch (Type) {
+    case ELF::R_ARM_ABS8:
+      return uint64_t(SignExtend64<8>(Contents & 0xff));
+    case ELF::R_ARM_ABS16:
+      return uint64_t(SignExtend64<16>(Contents & 0xffff));
+    case ELF::R_ARM_ABS32:
+    case ELF::R_ARM_RELATIVE:
+    case ELF::R_ARM_IRELATIVE:
+      return Word;
+    case ELF::R_ARM_REL32:
+      return uint64_t(int64_t(PC) + int32_t(Word));
+    case ELF::R_ARM_PREL31:
+      return uint64_t(int64_t(PC) + SignExtend64<31>(Word & 0x7fffffff));
+    case ELF::R_ARM_THM_JUMP8:
+      return uint64_t(int64_t(PC + 4) +
+                      SignExtend64<9>((Word & 0xff) << 1));
+    case ELF::R_ARM_THM_JUMP6:
+      return PC + 4 + ((Word & 0x0200) >> 3) +
+             ((Word & 0x00f8) >> 2);
+    case ELF::R_ARM_THM_JUMP11:
+      return uint64_t(int64_t(PC + 4) +
+                      SignExtend64<12>((Word & 0x7ff) << 1));
+    case ELF::R_ARM_THM_JUMP19:
+      return uint64_t(int64_t(PC + 4) + decodeThumb19(Word));
+    case ELF::R_ARM_THM_CALL:
+    case ELF::R_ARM_THM_JUMP24:
+      return uint64_t(int64_t(PC + 4) +
+          jitlink::aarch32::decodeImmBT4BlT1BlxT2_J1J2(
+              thumbHi(Word), thumbLo(Word)));
+    case ELF::R_ARM_THM_PC8:
+      return alignDown(PC + 4, uint64_t(4)) + ((Word & 0xff) << 2);
+    case ELF::R_ARM_THM_PC12: {
+      const int64_t Imm = thumbLo(Word) & 0x0fff;
+      return uint64_t(int64_t(alignDown(PC + 4, uint64_t(4))) +
+                      ((thumbHi(Word) & 0x0080) ? Imm : -Imm));
+    }
+    case ELF::R_ARM_THM_ALU_PREL_11_0: {
+      const uint16_t Hi = thumbHi(Word), Lo = thumbLo(Word);
+      const int64_t Imm = ((Hi & 0x0400) << 1) |
+                          ((Lo & 0x7000) >> 4) | (Lo & 0xff);
+      return uint64_t(int64_t(alignDown(PC + 4, uint64_t(4))) +
+                      ((Hi & 0x00f0) ? -Imm : Imm));
+    }
+    case ELF::R_ARM_THM_MOVW_ABS_NC:
+    case ELF::R_ARM_THM_MOVT_ABS:
+    case ELF::R_ARM_THM_MOVW_PREL_NC:
+    case ELF::R_ARM_THM_MOVT_PREL:
+      return jitlink::aarch32::decodeImmMovtT1MovwT3(
+          thumbHi(Word), thumbLo(Word));
+    default:
+      llvm_unreachable("unsupported ARM relocation extraction");
+    }
+  }
+
+  bool isGOT(uint32_t Type) const override {
+    return Type == ELF::R_ARM_GOT_BREL || Type == ELF::R_ARM_GOT_PREL;
+  }
+  bool isRelative(uint32_t Type) const override {
+    return Type == ELF::R_ARM_RELATIVE;
+  }
+  bool isIRelative(uint32_t Type) const override {
+    return Type == ELF::R_ARM_IRELATIVE;
+  }
+  bool isTLS(uint32_t Type) const override {
+    return Type >= ELF::R_ARM_TLS_DTPMOD32 && Type <= ELF::R_ARM_TLS_LE32;
+  }
+  bool isInstructionReference(uint32_t Type) const override {
+    return Type == ELF::R_ARM_THM_PC8 || Type == ELF::R_ARM_THM_PC12 ||
+           Type == ELF::R_ARM_THM_ALU_PREL_11_0;
+  }
+  bool isPCRelative(uint32_t Type) const override {
+    switch (Type) {
+    case ELF::R_ARM_REL32:
+    case ELF::R_ARM_PREL31:
+    case ELF::R_ARM_THM_CALL:
+    case ELF::R_ARM_THM_JUMP24:
+    case ELF::R_ARM_THM_JUMP19:
+    case ELF::R_ARM_THM_JUMP11:
+    case ELF::R_ARM_THM_JUMP8:
+    case ELF::R_ARM_THM_JUMP6:
+    case ELF::R_ARM_THM_PC8:
+    case ELF::R_ARM_THM_PC12:
+    case ELF::R_ARM_THM_ALU_PREL_11_0:
+    case ELF::R_ARM_THM_MOVW_PREL_NC:
+    case ELF::R_ARM_THM_MOVT_PREL:
+      return true;
+    default:
+      return false;
+    }
+  }
+  uint32_t getNone() const override { return ELF::R_ARM_NONE; }
+  uint32_t getPC32() const override { return ELF::R_ARM_REL32; }
+  uint32_t getPC64() const override {
+    llvm_unreachable("ARM32 has no 64-bit PC-relative relocation");
+  }
+  uint32_t getAbs64() const override {
+    llvm_unreachable("ARM32 has no 64-bit absolute relocation");
+  }
+  uint32_t getRelative() const override { return ELF::R_ARM_RELATIVE; }
+  void printType(raw_ostream &OS, uint32_t Type) const override {
+    OS << object::getELFRelocationTypeName(ELF::EM_ARM, Type);
+  }
+};
+
+} // namespace
+
+namespace llvm::bolt {
+
+std::unique_ptr<RelocationHandler> createARMRelocationHandler() {
+  return std::make_unique<ARMRelocationHandler>();
+}
+
+} // namespace llvm::bolt
