+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --frame-opt=all --eliminate-unreachable=false \
+# RUN:   --fastdyn-firmware-report=%t.json -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-objdump -d --mcpu=cortex-m0plus %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json')); f=next(x for x in d['functions'] if x['name']=='worker'); print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),f['post_optimization_instruction_count'],len(f['instructions']))" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='worker'); o=next(x for x in f['instruction_origins'] if x.get('original_address')==0x08000010); print(o['linked_bytes_hex'],all(len(bytes.fromhex(x['linked_bytes_hex']))==x['output_size'] for x in f['instruction_origins']))" \
+# RUN:   | FileCheck %s --check-prefix=LINKED-BYTES
