index 0000000000000000000000000000000000000000..04baae36ab36997a72d7dfd4aed7a11ff902778c
--- /dev/null
+++ b/bolt/test/ARM/thumb1-native-conditional-move-retention.s
@@ -0,0 +1,99 @@
+## Armv6-M has no IT instruction.  Even under an explicit firmware contract,
+## Firm-BOLT must reject the hammock before mutating the CFG and retain the
+## original Thumb-1 branch rather than producing a body the MC layer cannot
+## encode.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi \
+# RUN:   -mcpu=cortex-m0plus %s -o %t.o
+# RUN: link_fdata %s %t.o %t.fdata --no-lbr
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --cmov-conversion \
