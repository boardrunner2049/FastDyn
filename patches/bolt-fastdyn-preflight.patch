+# NO-READ-DISASM: <tail_dispatch>:
+# NO-READ-DISASM-NEXT: {{.*}}push {r4}
+# NO-READ-DISASM-NEXT: {{.*}}pop {r4}
+# NO-READ-DISASM-NEXT: {{.*}}bx r3
+# NO-READ-DISASM-NOT: ldr
+# LOG: ICP succeeded in tail_dispatch
+# LOG: BOLT-INFO: not adding new segments
+# DISASM: <tail_dispatch>:
+# DISASM-NEXT: {{.*}}push {r4}
+# DISASM-NEXT: {{.*}}pop {r4}
+# DISASM-NEXT: {{.*}}mov r12, r2
+# DISASM-NEXT: {{.*}}ldr r2, [pc, #{{.*}}]
+# DISASM-NEXT: {{.*}}cmp r3, r2
+# DISASM-NEXT: {{.*}}mov r2, r12
+# DISASM-NEXT: {{.*}}bne
+# DISASM-NEXT: {{.*}}b
+# DISASM: b{{(\.w)?}} 0x{{[0-9a-f]+}} <promoted_target>
+# DISASM: bx r3
+# HEX: 3b000008
+# REPORT: True {{.*}}indirect_call_promotion{{.*}} 38 24 6 4
+# REPORT-NEXT: [('0x8000024', 4, '0x800003b')]
+# REPORT-NEXT: {{.*}}original_instruction{{.*}}synthesized_call_promotion{{.*}}cloned_original_instruction{{.*}}original_instruction{{.*}}
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
