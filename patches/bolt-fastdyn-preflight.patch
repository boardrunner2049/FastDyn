+## BOLT's existing read-only-load simplifier needs ARM PC-relative operand and
+## constant-materialization hooks. Cortex-M additionally requires an explicit
+## contract because removing even an immutable flash load changes its read,
+## fault and modeled-time observations.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 \
+# RUN:   --section-start=.rodata=0x08000100 -e Reset_Handler %t.o -o %t.exe
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --simplify-rodata-loads \
+# RUN:   -o %t.denied 2>&1 | FileCheck %s --check-prefix=DENIED
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --simplify-rodata-loads \
+# RUN:   --firmbolt-allow-read-only-load-elision \
+# RUN:   --eliminate-unreachable=false --fastdyn-firmware-report=%t.json \
+# RUN:   -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=load_immutable %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=load_unresolved_pool %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=UNRESOLVED
+# RUN: %python -c "import json; d=json.load(open('%t.json')); l=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='load_immutable'); lf=next(x for x in l['functions'] if x['name']=='load_immutable'); print(f['firmware_modified'],f['firmware_modification_reasons'],lf['original_size'],lf['output_size']); print([(x['origin_kind'],hex(x.get('original_address',x.get('source_original_address')))) for x in lf['instruction_origins']])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+# RUN: %python -c "import json; d=json.load(open('%t.json')); l=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='load_unresolved_pool'); lf=next(x for x in l['functions'] if x['name']=='load_unresolved_pool'); print(lf['firmware_modified'],f['firmware_modification_reasons'],lf['firmware_publication_rejections'],lf['original_size'],lf['output_size'],len(lf['instruction_origins']),all(x['origin_kind']=='original_instruction' for x in lf['instruction_origins']))" \
+# RUN:   | FileCheck %s --check-prefix=REJECTED
+
+# DENIED: Cortex-M read-only-load simplification removes a mapped read/fault event
+# LOG: simplified 2 out of 2 loads from statically computed addresses
+# DISASM: <load_immutable>:
+# DISASM-NOT: ldr
+# DISASM: movw r0, #0x1234
+# DISASM-NEXT: bx lr
+# REPORT: True ['read_only_load_elision'] 6 6
+# REPORT-NEXT: [('synthesized_from_original_instruction', '0x{{[0-9a-f]+}}'), ('original_instruction', '0x{{[0-9a-f]+}}')]
+# UNRESOLVED: <load_unresolved_pool>:
