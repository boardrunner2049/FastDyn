+/// Reconstruct an AArch32 SHT_REL addend from a matching Thumb MOVW/MOVT
+/// pair.  Each relocation stores only half of S + A (ABS) or S + A - P
+/// (PREL), and the two PREL instructions have distinct P values.  Pair by
+/// relocation section, symbol, relocation family and destination register;
+/// reject rather than guess if those facts admit different addends.
+static ARMSplitAddendResult reconstructARMSplitAddend(
+    const ELFObjectFileBase *Obj, const BinaryContext &BC,
+    const RelocationHandler &RH, const RelocationRef &Rel, uint32_t RType,
+    uint64_t SymbolAddress, uint64_t ExtractedValue,
+    std::optional<uint64_t> StaticBase = std::nullopt) {
+  ARMSplitAddendResult Result;
+  const bool IsLow = RType == ELF::R_ARM_THM_MOVW_ABS_NC ||
+                     RType == ELF::R_ARM_THM_MOVW_PREL_NC ||
+                     RType == ELF::R_ARM_THM_MOVW_BREL_NC ||
+                     RType == ELF::R_ARM_THM_MOVW_BREL;
+  const bool IsPCRelative = RType == ELF::R_ARM_THM_MOVW_PREL_NC ||
+                            RType == ELF::R_ARM_THM_MOVT_PREL;
+  const bool IsStaticBaseRelative =
+      RType == ELF::R_ARM_THM_MOVW_BREL_NC ||
+      RType == ELF::R_ARM_THM_MOVW_BREL ||
+      RType == ELF::R_ARM_THM_MOVT_BREL;
+  if (IsStaticBaseRelative && !StaticBase)
+    return Result;
+  SmallVector<uint32_t, 2> PairTypes;
+  switch (RType) {
+  case ELF::R_ARM_THM_MOVW_ABS_NC:
+    PairTypes.push_back(ELF::R_ARM_THM_MOVT_ABS);
+    break;
+  case ELF::R_ARM_THM_MOVT_ABS:
+    PairTypes.push_back(ELF::R_ARM_THM_MOVW_ABS_NC);
+    break;
+  case ELF::R_ARM_THM_MOVW_PREL_NC:
+    PairTypes.push_back(ELF::R_ARM_THM_MOVT_PREL);
+    break;
+  case ELF::R_ARM_THM_MOVT_PREL:
+    PairTypes.push_back(ELF::R_ARM_THM_MOVW_PREL_NC);
+    break;
+  case ELF::R_ARM_THM_MOVW_BREL_NC:
+  case ELF::R_ARM_THM_MOVW_BREL:
+    PairTypes.push_back(ELF::R_ARM_THM_MOVT_BREL);
+    break;
+  case ELF::R_ARM_THM_MOVT_BREL:
+    PairTypes.push_back(ELF::R_ARM_THM_MOVW_BREL_NC);
+    PairTypes.push_back(ELF::R_ARM_THM_MOVW_BREL);
+    break;
+  default:
+    return Result;
+  }
+
+  const uint64_t RelocationSectionIndex = Rel.getRawDataRefImpl().d.a;
+  const uint32_t SymbolIndex = getRelocationSymbol(Obj, Rel);
+  ErrorOr<uint64_t> RelContents =
+      BC.getUnsignedValueAtAddress(Rel.getOffset(), /*Size=*/4);
+  if (!RelContents)
+    return Result;
+  // Thumb-2 MOVW/MOVT encode Rd in bits 11:8 of the second halfword.
+  const uint32_t DestinationRegister = (uint32_t(*RelContents) >> 24) & 0xf;
+  bool FoundAddend = false;
+  SmallVector<std::pair<RelocationRef, uint64_t>, 4> PairCandidates;
+
+  for (const SectionRef &Section : Obj->sections()) {
+    if (Section.getIndex() != RelocationSectionIndex)
+      continue;
+    for (const RelocationRef &Candidate : Section.relocations()) {
+      if (!llvm::is_contained(PairTypes, Candidate.getType()) ||
+          getRelocationSymbol(Obj, Candidate) != SymbolIndex)
+        continue;
+      ErrorOr<uint64_t> CandidateContents =
+          BC.getUnsignedValueAtAddress(Candidate.getOffset(), /*Size=*/4);
+      if (!CandidateContents ||
+          ((uint32_t(*CandidateContents) >> 24) & 0xf) !=
+              DestinationRegister)
+        continue;
+      PairCandidates.emplace_back(Candidate, *CandidateContents);
+    }
+    break;
+  }
+
+  Result.SawPair = !PairCandidates.empty();
+  const uint32_t AdjacentPairAddress =
+      uint32_t(Rel.getOffset()) + (IsLow ? 4 : uint32_t(-4));
+  const bool HasAdjacentPair = llvm::any_of(
+      PairCandidates, [&](const auto &Candidate) {
+        return uint32_t(Candidate.first.getOffset()) == AdjacentPairAddress;
+      });
+  for (const auto &[Candidate, CandidateContents] : PairCandidates) {
+    // Canonical compiler output places MOVT immediately after MOVW. Prefer
+    // that structural pairing so multiple references to one symbol and
+    // destination register do not create false ambiguity. If it is absent,
+    // admit only a unique addend across all otherwise compatible partners.
+    if (HasAdjacentPair &&
+        uint32_t(Candidate.getOffset()) != AdjacentPairAddress)
+      continue;
+
+    const uint32_t CandidateValue = uint32_t(RH.extractValue(
+        Candidate.getType(), CandidateContents, Candidate.getOffset()));
+    const uint32_t LowValue =
+        IsLow ? uint32_t(ExtractedValue) : CandidateValue;
+    const uint32_t HighValue =
+        IsLow ? CandidateValue : uint32_t(ExtractedValue);
+    const uint32_t LowPlace =
+        IsLow ? uint32_t(Rel.getOffset()) : uint32_t(Candidate.getOffset());
+    const uint32_t HighPlace =
+        IsLow ? uint32_t(Candidate.getOffset()) : uint32_t(Rel.getOffset());
+
+    uint32_t ResolvedValue = (HighValue << 16) | LowValue;
+    if (IsPCRelative) {
+      // HighValue belongs to S+A-HighPlace while LowValue belongs to
+      // S+A-LowPlace. Recover the low half at HighPlace, then translate the
+      // complete 32-bit modular value back to LowPlace.
+      const uint32_t PlaceDelta = HighPlace - LowPlace;
+      const uint32_t AtHighPlace =
+          (HighValue << 16) | uint16_t(LowValue - PlaceDelta);
+      ResolvedValue = AtHighPlace + PlaceDelta;
+    }
+    const uint32_t ReferenceBase =
+        uint32_t(SymbolAddress) -
+        (IsStaticBaseRelative ? uint32_t(*StaticBase) : 0);
+    const uint32_t AddendValue =
+        ResolvedValue - ReferenceBase + (IsPCRelative ? LowPlace : 0);
+
+    const uint32_t LowResolved = ReferenceBase + AddendValue -
+                                 (IsPCRelative ? LowPlace : 0);
+    const uint32_t HighResolved = ReferenceBase + AddendValue -
+                                  (IsPCRelative ? HighPlace : 0);
+    if ((LowResolved & 0xffff) != (LowValue & 0xffff) ||
+        (HighResolved >> 16) != (HighValue & 0xffff))
+      continue;
+
+    const int64_t SignedAddend = int32_t(AddendValue);
+    if (FoundAddend && Result.Addend != SignedAddend) {
+      Result.Ambiguous = true;
+      continue;
+    }
+    Result.Addend = SignedAddend;
+    FoundAddend = true;
+  }
+  Result.Resolved = FoundAddend;
+  return Result;
+}
