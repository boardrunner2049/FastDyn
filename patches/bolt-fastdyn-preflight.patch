+# REPORT: 1 [(0, 'main', 134217984, 12, 3), (1, 'cold', 134218116, 12, 1), (2, 'warm', 134218032, 84, 5)] 49 ['block_reordering', 'function_splitting']
+
+//--- fixture.s
+.syntax unified
+.cpu cortex-m3
+.thumb
+.eabi_attribute Tag_CPU_arch, 10
+.eabi_attribute Tag_CPU_arch_profile, 'M'
+
+.section .isr_vector, "a", %progbits
+.align 2
+.global g_pfnVectors
+.type g_pfnVectors, %object
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+.size g_pfnVectors, . - g_pfnVectors
+
+.section .text, "ax", %progbits
+.align 2
+.global cdsplit_worker
+.type cdsplit_worker, %function
+.thumb_func
+cdsplit_worker:
+  cmp r0, #2
+  bge .Lchain_start
+.Lfast:
+  movs r0, #5
+  b .Lexit
+.Lchain_start:
+  mov.w r1, #10
+  bgt .Lchain1
+.Lcold:
+  adds r1, #1
+  adds r1, #1
+  adds r1, #1
+  adds r1, #1
+  b .Lexit
+.Lchain1:
+  .rept 8
+  adds r1, #1
+  .endr
+  b .Lchain2
+.Lchain2:
+  .rept 8
+  adds r1, #1
+  .endr
+  b .Lchain3
+.Lchain3:
+  .rept 8
+  adds r1, #1
+  .endr
+  b .Lchain4
+.Lchain4:
+  .rept 8
+  adds r1, #1
+  .endr
+  mov r0, r1
+  b .Lexit
+.Lexit:
+  bx lr
+.size cdsplit_worker, . - cdsplit_worker
+
+.align 2
+.global Reset_Handler
+.type Reset_Handler, %function
+.thumb_func
+Reset_Handler:
+  movw r4, #0
+  movt r4, #0x2000
+  movs r0, #1
+hot_callsite:
+  bl cdsplit_worker
+  str r0, [r4]
+  movs r0, #4
+warm_callsite:
+  bl cdsplit_worker
+  str r0, [r4, #4]
+  movs r0, #2
+cold_callsite:
+  bl cdsplit_worker
+  str r0, [r4, #8]
+.global fixture_halt
+fixture_halt:
+  b fixture_halt
+.size Reset_Handler, . - Reset_Handler
+
+//--- link.ld
+ENTRY(Reset_Handler)
+MEMORY {
+  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 64K
+  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 16K
+}
+SECTIONS {
+  .isr_vector ORIGIN(FLASH) : { KEEP(*(.isr_vector)) } > FLASH
+  .text ORIGIN(FLASH) + 0x100 : {
+    *(.text*)
+    . = . + 8;
+  } > FLASH
+  .data : { *(.data*) } > RAM AT > FLASH
+  .bss (NOLOAD) : { *(.bss*) *(COMMON) } > RAM
+}
