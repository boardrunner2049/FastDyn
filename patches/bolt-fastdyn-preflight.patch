diff --git a/bolt/test/ARM/thumb-register-reassignment-shared-extab.s b/bolt/test/ARM/thumb-register-reassignment-shared-extab.s
new file mode 100644
index 0000000000000000000000000000000000000000..484944da727e8a76c6275095811ed7dc2e60c59b
--- /dev/null
+++ b/bolt/test/ARM/thumb-register-reassignment-shared-extab.s
@@ -0,0 +1,95 @@
+## An external compact EHABI program is mutable only when one exact function
+## owns its complete storage. Two ranges naming the same extab record must keep
+## both otherwise-profitable register-reassignment candidates unchanged.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --no-merge-exidx-entries -Ttext=0x08000000 -e Reset_Handler \
+# RUN:   %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --reg-reassign \
+# RUN:   --firmbolt-allow-register-reassignment -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=worker_a \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-readobj --unwind %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=EHABI
+
+# LOG: BOLT-INFO: Reg Reassignment Pass: ARM EHABI admitted 1 CANTUNWIND-covered function(s) and retained 2 function(s) with unsupported compact, shared or generic unwind programs; 0 single-function compact program(s) remain candidate-qualified.
+# LOG: BOLT-INFO: Reg Reassignment Pass: no changes were made.
+# DISASM-LABEL: <worker_a>:
+# DISASM-NEXT: sub sp, #0x8
+# DISASM-NEXT: str.w r8, [sp, #0x4]
+# DISASM-NEXT: mov.w r8, r1
+# EHABI: ExceptionHandlingTable: .ARM.extab
+# EHABI-COUNT-2: 0x80 0x10 ; pop {r8}
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+reset_ehabi_anchor:
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  bl worker_a
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl worker_a
+  .type worker_a,%function
+worker_a_ehabi_anchor:
+  .thumb_func
+worker_a:
+  sub sp, #8
+  str.w r8, [sp, #4]
+  mov.w r8, r1
+  ldr.w r0, [r8, #0]
+  str.w r0, [r8, #4]
+  ldr.w r8, [sp, #4]
+  add sp, #8
+  bx lr
+  .size worker_a, .-worker_a
+
+  .globl worker_b
+  .type worker_b,%function
+worker_b_ehabi_anchor:
+  .thumb_func
+worker_b:
+  sub sp, #8
+  str.w r8, [sp, #4]
+  mov.w r8, r1
+  ldr.w r0, [r8, #0]
+  str.w r0, [r8, #4]
+  ldr.w r8, [sp, #4]
+  add sp, #8
+  bx lr
+  .size worker_b, .-worker_b
+code_end:
+
+  .section .ARM.extab.shared,"a",%progbits
+  .p2align 2
+shared_extab:
+  // Personality index 1, no additional words, pop {r8}.
+  .long 0x81008010
+
+  .section .ARM.exidx.shared,"ao?",%0x70000001,.text
+  .p2align 2
+  .long reset_ehabi_anchor(PREL31)
+  .long 1
+  .long worker_a_ehabi_anchor(PREL31)
+  .long shared_extab(PREL31)
+  .long worker_b_ehabi_anchor(PREL31)
+  .long shared_extab(PREL31)
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb-reserved-veneer-slot-live-reject.s b/bolt/test/ARM/thumb-reserved-veneer-slot-live-reject.s
new file mode 100644
index 0000000000000000000000000000000000000000..d3bfc642eacebf89071782ba2b1063e90b191c18
--- /dev/null
+++ b/bolt/test/ARM/thumb-reserved-veneer-slot-live-reject.s
@@ -0,0 +1,45 @@
+## A correctly typed slot is still invalid if the original image can reach it.
+## The reservation contract permits replacement only of non-entry capacity.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus \
+# RUN:   %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 \
+# RUN:   --section-start=.firmbolt.veneer=0x08000100 -e Reset_Handler \
+# RUN:   %t.o -o %t.exe
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --frame-opt=none -o %t.bolt 2>&1 | FileCheck %s
+
+# CHECK: BOLT-ERROR: Cortex-M veneer slot has an original direct code reference from Reset_Handler
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl __firmbolt_thumb_veneer_slot0
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .section .firmbolt.veneer,"ax",%progbits
+  .p2align 2
+  .globl __firmbolt_thumb_veneer_slot0
+  .type __firmbolt_thumb_veneer_slot0,%function
+  .thumb_func
+__firmbolt_thumb_veneer_slot0:
+  bx lr
+  nop
+  nop
+  nop
+  .size __firmbolt_thumb_veneer_slot0, .-__firmbolt_thumb_veneer_slot0
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb-reserved-veneer-slot-reject.s b/bolt/test/ARM/thumb-reserved-veneer-slot-reject.s
