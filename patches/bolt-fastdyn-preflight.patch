+struct CortexMEHABIQualification {
+  DenseSet<const BinaryFunction *> BlockedFunctions;
+  DenseMap<const BinaryFunction *, SmallVector<uint8_t, 8>> CompactPrograms;
+  uint64_t CantUnwindFunctions{0};
+};
+
+/// Classify functions through the typed ARM EHABI index rather than a
+/// conventional section name. GNU linker scripts may call an SHT_ARM_EXIDX
+/// section ".ARM" (as the real FreeRTOS fixture does), so matching only
+/// ".ARM.exidx" silently misses architectural unwind state.
+Expected<CortexMEHABIQualification>
+qualifyCortexMEHABIRegisterReassignment(BinaryContext &BC) {
+  CortexMEHABIQualification Result;
+  DenseSet<const BinaryFunction *> CoveredFunctions;
+  const bool IsLittleEndian = BC.AsmInfo->isLittleEndian();
+  const auto ReadWord = [IsLittleEndian](const char *Data) {
+    return IsLittleEndian ? support::endian::read32le(Data)
+                          : support::endian::read32be(Data);
+  };
+  const auto DecodePrel31 = [](uint32_t Word,
+                               uint64_t Place) -> Expected<uint64_t> {
+    const int64_t Delta = SignExtend64<31>(Word & 0x7fffffffU);
+    if (Place > static_cast<uint64_t>(std::numeric_limits<int64_t>::max()))
+      return createStringError(errc::result_out_of_range,
+                               "ARM PREL31 place is not representable");
+    const int64_t Target = static_cast<int64_t>(Place) + Delta;
+    if (Target < 0)
+      return createStringError(errc::result_out_of_range,
+                               "ARM PREL31 target underflows address zero");
+    return static_cast<uint64_t>(Target);
+  };
+
+  struct Entry {
+    uint64_t Start{0};
+    ARMUnwindRecord Unwind;
+    bool IsSentinel{false};
+    SmallVector<const BinaryFunction *, 2> Functions;
+  };
+
+  // One external program can describe several ranges. Register reassignment
+  // may mutate it only when one exact function owns the complete payload.
+  DenseMap<uint64_t, const BinaryFunction *> ExternalCompactOwners;
+
+  for (BinarySection &Section : BC.allocatableSections()) {
+    if (Section.getELFType() != ELF::SHT_ARM_EXIDX)
+      continue;
+    const StringRef Contents = Section.getContents();
+    if (Contents.empty() || Contents.size() % 8 != 0)
+      return createStringError(
+          errc::executable_format_error,
+          "ARM EHABI index section %s has invalid size 0x%" PRIx64,
+          Section.getName().str().c_str(),
+          static_cast<uint64_t>(Contents.size()));
+
+    SmallVector<Entry, 32> Entries;
+    Entries.reserve(Contents.size() / 8);
+    for (uint64_t Offset = 0; Offset < Contents.size(); Offset += 8) {
+      const uint64_t Place = Section.getAddress() + Offset;
+      Expected<uint64_t> Start =
+          DecodePrel31(ReadWord(Contents.data() + Offset), Place);
+      if (!Start)
+        return Start.takeError();
+      if (!Entries.empty() && *Start <= Entries.back().Start)
+        return createStringError(
+            errc::executable_format_error,
+            "ARM EHABI index section %s is not strictly address-sorted",
+            Section.getName().str().c_str());
+      const uint32_t UnwindWord = ReadWord(Contents.data() + Offset + 4);
+      Expected<ARMUnwindRecord> Unwind = decodeARMUnwindRecord(
+          BC, UnwindWord, Place + sizeof(uint32_t));
+      if (!Unwind)
+        return Unwind.takeError();
+      Entries.push_back({*Start, std::move(*Unwind), false, {}});
+    }
+
+    Entry &Last = Entries.back();
+    if (Last.Unwind.Model == ARMUnwindModel::CantUnwind &&
+        !BC.getBinaryFunctionAtAddress(Last.Start))
+      Last.IsSentinel = true;
+
+    for (auto &FunctionKV : BC.getBinaryFunctions()) {
+      const BinaryFunction &BF = FunctionKV.second;
+      const uint64_t Address = BF.getAddress();
+      if (Address < Entries.front().Start)
+        continue;
+      if (Entries.back().IsSentinel && Address >= Entries.back().Start)
+        continue;
+      auto It = llvm::upper_bound(
+          Entries, Address,
+          [](uint64_t Value, const Entry &Candidate) {
+            return Value < Candidate.Start;
+          });
+      if (It == Entries.begin())
+        continue;
+      --It;
+      if (!CoveredFunctions.insert(&BF).second)
+        return createStringError(
+            errc::not_supported,
+            "Cortex-M function %s is covered by multiple ARM EHABI indexes",
+            BF.getPrintName().c_str());
+      It->Functions.push_back(&BF);
+    }
+
+    for (const Entry &Current : Entries) {
+      if (Current.IsSentinel)
+        continue;
+      if (Current.Unwind.Model == ARMUnwindModel::CantUnwind) {
+        Result.CantUnwindFunctions += Current.Functions.size();
+        continue;
+      }
+      if (Current.Unwind.Compact && Current.Functions.size() == 1) {
+        const BinaryFunction *BF = Current.Functions.front();
+        const ARMCompactUnwindProgram &Program = *Current.Unwind.Compact;
+        if (Current.Unwind.Model == ARMUnwindModel::ExternalCompact) {
+          auto [Owner, Inserted] = ExternalCompactOwners.try_emplace(
+              Program.StorageAddress, BF);
+          if (!Inserted) {
+            Result.CompactPrograms.erase(Owner->second);
+            Result.BlockedFunctions.insert(Owner->second);
+            Result.BlockedFunctions.insert(BF);
+            continue;
+          }
+        }
+        Result.CompactPrograms[BF] = Program.Opcodes;
+        continue;
+      }
+      for (const BinaryFunction *BF : Current.Functions)
+        Result.BlockedFunctions.insert(BF);
+    }
+  }
+  return Result;
+}
