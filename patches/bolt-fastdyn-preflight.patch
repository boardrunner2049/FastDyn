+TEST(ARMRelocationHandlerTest, ThumbLiteralAndMovRoundTrips) {
+  std::unique_ptr<RelocationHandler> Handler = createARMRelocationHandler();
+  constexpr uint64_t PC = 0x08001002;
+  constexpr uint64_t Literal = 0x080013fc;
+  ASSERT_TRUE(Handler->canEncodeValue(ELF::R_ARM_THM_PC8, Literal, PC));
+  const uint64_t Ldr = Handler->encodeValue(ELF::R_ARM_THM_PC8, Literal, PC,
+                                            0x4800);
+  EXPECT_EQ(Handler->extractValue(ELF::R_ARM_THM_PC8, Ldr, PC), Literal);
+
+  constexpr uint32_t Movw = 0x0000f240;
+  constexpr uint32_t Value = 0xabcd;
+  const uint64_t Encoded = Handler->encodeValue(
+      ELF::R_ARM_THM_MOVW_ABS_NC, Value, PC, Movw);
+  EXPECT_EQ(Handler->extractValue(ELF::R_ARM_THM_MOVW_ABS_NC, Encoded, PC),
+            Value);
+
+  // BREL receives the already-resolved S+A-B(S) value. The relocation
+  // handler owns only the split Thumb immediate; selection of B(S) is a
+  // firmware/linker contract enforced by RewriteInstance.
+  constexpr uint32_t StaticOffset = 0x89abcdef;
+  constexpr uint32_t Movt = 0x0000f2c0;
+  for (const auto &[Type, Original, Expected] : {
+           std::tuple<uint32_t, uint32_t, uint32_t>{
+               ELF::R_ARM_THM_MOVW_BREL_NC, Movw,
+               StaticOffset & 0xffff},
+           {ELF::R_ARM_THM_MOVT_BREL, Movt, StaticOffset >> 16},
+       }) {
+    EXPECT_TRUE(Handler->isSupported(Type));
+    EXPECT_EQ(Handler->getSizeForType(Type), 4U);
+    EXPECT_TRUE(Handler->canEncodeValue(Type, StaticOffset, PC));
+    const uint64_t BrelEncoded =
+        Handler->encodeValue(Type, StaticOffset, PC, Original);
+    EXPECT_EQ(Handler->extractValue(Type, BrelEncoded, PC), Expected);
+  }
+
+  // The checked form represents the complete unsigned static-base offset in
+  // one MOVW. It must reject values that would silently truncate.
+  EXPECT_TRUE(
+      Handler->canEncodeValue(ELF::R_ARM_THM_MOVW_BREL, 0xffff, PC));
+  EXPECT_FALSE(
+      Handler->canEncodeValue(ELF::R_ARM_THM_MOVW_BREL, 0x10000, PC));
+  const uint64_t CheckedEncoded = Handler->encodeValue(
+      ELF::R_ARM_THM_MOVW_BREL, 0xabcd, PC, Movw);
+  EXPECT_EQ(Handler->extractValue(ELF::R_ARM_THM_MOVW_BREL, CheckedEncoded,
+                                  PC),
+            0xabcdU);
+
+  // A data-word static-base relocation carries the complete already-resolved
+  // S+A-B(S) value. The firmware contract supplies B(S); the target handler
+  // must preserve all 32 bits without applying a second address transform.
+  EXPECT_TRUE(Handler->isSupported(ELF::R_ARM_SBREL32));
+  EXPECT_EQ(Handler->getSizeForType(ELF::R_ARM_SBREL32), 4U);
+  EXPECT_TRUE(
+      Handler->canEncodeValue(ELF::R_ARM_SBREL32, StaticOffset, PC));
+  const uint64_t SBRelEncoded = Handler->encodeValue(
+      ELF::R_ARM_SBREL32, StaticOffset, PC, 0);
+  EXPECT_EQ(SBRelEncoded, StaticOffset);
+  EXPECT_EQ(Handler->extractValue(ELF::R_ARM_SBREL32, SBRelEncoded, PC),
+            StaticOffset);
+
+  // A qualified fixed firmware GOT supplies G(S)+A as the already-resolved
+  // target. The target handler owns the signed Delta32 field while BOLT's
+  // reference graph selects the exact retained slot.
+  constexpr uint64_t GOTPlace = 0x0800010c;
+  constexpr uint64_t GOTTargetWithAddend = 0x20000106;
+  EXPECT_TRUE(Handler->isPCRelative(ELF::R_ARM_GOT_PREL));
+  EXPECT_TRUE(Handler->canEncodeValue(ELF::R_ARM_GOT_PREL,
+                                      GOTTargetWithAddend, GOTPlace));
+  const uint64_t GOTEncoded = Handler->encodeValue(
+      ELF::R_ARM_GOT_PREL, GOTTargetWithAddend, GOTPlace, 0);
+  EXPECT_EQ(GOTEncoded, 0x17fffffaU);
+  EXPECT_EQ(Handler->extractValue(ELF::R_ARM_GOT_PREL, GOTEncoded, GOTPlace),
+            GOTTargetWithAddend);
+
+  // The other fixed-static GOT family members use the same complete 32-bit
+  // fields: BASE_PREL is PC-relative, while GOT_BREL and GOTOFF32 already
+  // contain offsets from the qualified GOT origin.
+  constexpr uint64_t GOTBaseWithAddend = 0x20000112;
+  EXPECT_TRUE(Handler->isPCRelative(ELF::R_ARM_BASE_PREL));
+  const uint64_t BaseEncoded = Handler->encodeValue(
+      ELF::R_ARM_BASE_PREL, GOTBaseWithAddend, GOTPlace, 0);
+  EXPECT_EQ(Handler->extractValue(ELF::R_ARM_BASE_PREL, BaseEncoded, GOTPlace),
+            GOTBaseWithAddend);
+  for (const auto [Type, Value] : {
+           std::pair<uint32_t, uint64_t>{ELF::R_ARM_GOT_BREL, 0},
+           {ELF::R_ARM_GOTOFF32, 0x100},
+       }) {
+    EXPECT_TRUE(Handler->canEncodeValue(Type, Value, GOTPlace));
+    const uint64_t Encoded = Handler->encodeValue(Type, Value, GOTPlace, 0);
+    EXPECT_EQ(Handler->extractValue(Type, Encoded, GOTPlace), Value);
+  }
+}
