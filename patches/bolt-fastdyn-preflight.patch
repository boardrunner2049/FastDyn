+# RUN:   -o %t/profile-candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=PROFILE-BOLT
+
+## A branch/call profile feeds BOLT's call-graph-directed CDSort.  The
+## exec-count control over the same profile emits worker_a, worker_b, reset;
+## CDSort instead keeps the hot worker_a/reset affinity contiguous before
+## worker_b.  This distinguishes graph ordering from mere count sorting.
+# RUN: llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --data=%t/callgraph.fdata --relocs --use-old-text \
