+# RUN:   --frame-opt=none -o %t.m7.bolt
+# RUN: llvm-objdump -d --mcpu=cortex-m7 --mattr=+fp-armv8d16 %t.m7.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m4 \
+# RUN:   --frame-opt=none -o %t.m4-retained.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=CPU-RETAIN
+# RUN: llvm-objcopy --dump-section=.text=%t.input.text %t.exe
+# RUN: llvm-objcopy --dump-section=.text=%t.retained.text %t.m4-retained.bolt
+# RUN: cmp %t.input.text %t.retained.text
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m4 \
+# RUN:   --firmbolt-reject-target-incompatible-input --frame-opt=none \
+# RUN:   -o %t.m4-rejected.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=CPU-REJECT
+# RUN: test ! -e %t.m4-rejected.bolt
+
+# DISASM: <fp64_worker>:
+# DISASM: vadd.f64 d0, d1, d2
+# DISASM: bx lr
+# CPU-RETAIN: BOLT-WARNING: selected Cortex-M CPU cortex-m4 cannot decode instruction at address 0x8000006 in function fp64_worker; retaining the function unchanged
+# CPU-REJECT: BOLT-ERROR: selected Cortex-M CPU cortex-m4 cannot decode instruction at address 0x8000006 in function fp64_worker
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_name, "7E-M"
+  .eabi_attribute Tag_CPU_arch, 13
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .eabi_attribute Tag_FP_arch, 8
+  .eabi_attribute Tag_ABI_HardFP_use, 3
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl fp64_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl fp64_worker
+  .type fp64_worker,%function
+  .thumb_func
+fp64_worker:
+  vadd.f64 d0, d1, d2
+  bx lr
+  .size fp64_worker, .-fp64_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/cortex-m-v8-profiles.s b/bolt/test/ARM/cortex-m-v8-profiles.s
