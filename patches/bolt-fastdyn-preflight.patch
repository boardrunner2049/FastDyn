+  constexpr uint64_t PC = 0x08001000;
+
+  EXPECT_EQ(Handler->getSizeForType(ELF::R_ARM_ABS8), 1U);
+  EXPECT_TRUE(Handler->canEncodeValue(ELF::R_ARM_ABS8, 255, PC));
+  EXPECT_TRUE(Handler->canEncodeValue(ELF::R_ARM_ABS8,
+                                      uint64_t(int64_t(-128)), PC));
+  EXPECT_FALSE(Handler->canEncodeValue(ELF::R_ARM_ABS8, 256, PC));
