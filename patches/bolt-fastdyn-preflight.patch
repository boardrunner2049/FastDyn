+load_unresolved_pool:
+  ldr.w r0, .Lunresolved_scalar
+  bx lr
+  .size load_unresolved_pool, .-load_unresolved_pool
+
+  .p2align 2
+  .type .Lunresolved_scalar,%object
+.Lunresolved_scalar:
+  .word 0x5678
+  .size .Lunresolved_scalar, .-.Lunresolved_scalar
+
+  .section .rodata,"a",%progbits
