+# RUN:   --frame-opt=none -o %t.bad 2>&1 | FileCheck %s --check-prefix=MISMATCH
+
+# DISASM: <feature_worker>:
+# DISASM: smlad r0, r1, r2, r3
+# DISASM: vadd.f32 s0, s1, s2
+# DISASM: bx lr
+
+# MISMATCH: Cortex-M CPU/input attribute mismatch
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 13
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .eabi_attribute Tag_FP_arch, 6
+  .eabi_attribute Tag_ABI_HardFP_use, 3
+  .fpu fpv4-sp-d16
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl feature_worker
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl feature_worker
+  .type feature_worker,%function
+  .thumb_func
+feature_worker:
+  smlad r0, r1, r2, r3
+  vadd.f32 s0, s1, s2
+  bx lr
+  .size feature_worker, .-feature_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
