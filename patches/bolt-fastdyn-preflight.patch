+# LOG-SAME: cannot clobber flags reg
+# DISASM: <flags_live_switch>:
+# DISASM: tbb [pc, r0]
+# REPORT-NOT: jump_table_promotion
+# REPORT: 0
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
