+# RUN:   --frame-opt=none -o %t.bad 2>&1 | FileCheck %s --check-prefix=MISMATCH
+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m7 \
+# RUN:   --frame-opt=none -o %t.bad-exact 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=EXACT-MISMATCH
+
+# DISASM: <feature_worker>:
+# DISASM: smlad r0, r1, r2, r3
+# DISASM: vadd.f32 s0, s1, s2
+# DISASM: bx lr
+
+# MISMATCH: Cortex-M CPU/input attribute mismatch
+# EXACT-MISMATCH: Cortex-M exact CPU/input attribute mismatch
+# FEATURES: BOLT-INFO: Cortex-M target CPU cortex-m4, input CPU attribute Cortex-M4, input feature evidence +mclass,+vfp4d16sp
+
+  .syntax unified
