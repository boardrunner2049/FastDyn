diff --git a/bolt/test/ARM/Inputs/make-gnu-zdebug.py b/bolt/test/ARM/Inputs/make-gnu-zdebug.py
new file mode 100644
index 0000000000000000000000000000000000000000..3d6df9b73db2262d4e658c35a400e41f18e69614
--- /dev/null
+++ b/bolt/test/ARM/Inputs/make-gnu-zdebug.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Wrap raw DWARF bytes in the legacy GNU zlib-compression format."""
+
+import argparse
+import struct
+import zlib
+from pathlib import Path
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("input", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--corrupt-magic", action="store_true")
+    args = parser.parse_args()
+
+    data = args.input.read_bytes()
+    magic = b"FAIL" if args.corrupt_magic else b"ZLIB"
+    args.output.write_bytes(
+        magic + struct.pack(">Q", len(data)) + zlib.compress(data)
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
