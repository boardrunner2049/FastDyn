index 0000000000000000000000000000000000000000..e0f1709ff0d6f0b1c86bc18d88bd653b96cc435d
--- /dev/null
+++ b/bolt/test/ARM/thumb-exidx-function-reorder.s
@@ -0,0 +1,302 @@
+## ARM EHABI index entries embed linked PREL31 code addresses and LLD does not
+## retain their synthetic relocations under --emit-relocs.  Qualify exact,
+## fixed-footprint reconstruction after Cortex-M function reordering.  The
+## inline compact unwind word must follow worker_a, the external compact table
+## reference must follow Reset_Handler, and CANTUNWIND follows worker_b; the
+## final sentinel remains last.
+
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/fixture.s -o %t/fixture.o
+# RUN: ld.lld --emit-relocs --no-merge-exidx-entries -T %t/link.ld \
+# RUN:   %t/fixture.o -o %t/reference.elf
+# RUN: llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --reorder-functions=user \
+# RUN:   --function-order=%t/order.txt -o %t/candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: llvm-nm --numeric-sort %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=ORDER
+# RUN: llvm-readelf --unwind %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=UNWIND
+# RUN: llvm-readelf -SWl %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=LAYOUT
+
+## Independently exercise the ARM-defined personality-index-2 external
+## compact form through the same reorder/rebind path.
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/compact-pr2.s -o %t/compact-pr2.o
+# RUN: ld.lld --emit-relocs --no-merge-exidx-entries -T %t/link.ld \
+# RUN:   %t/compact-pr2.o -o %t/compact-pr2.elf
+# RUN: llvm-bolt %t/compact-pr2.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --reorder-functions=user \
+# RUN:   --function-order=%t/order.txt -o %t/compact-pr2-candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=PR2-BOLT
+# RUN: llvm-readelf --unwind %t/compact-pr2-candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=PR2
+
+## Generic .ARM.extab records contain a second-level personality PREL31 and
+## opaque language-specific data.  Qualify exact retained relocation identity
+## plus unchanged opaque bytes; reject the same input without that relocation.
+# RUN: llvm-mc -filetype=obj -triple thumbv7m-none-eabi -mcpu=cortex-m3 \
+# RUN:   %t/extab.s -o %t/extab.o
+# RUN: ld.lld --emit-relocs --no-merge-exidx-entries -T %t/link.ld \
+# RUN:   %t/extab.o -o %t/extab.elf
+# RUN: llvm-bolt %t/extab.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --reorder-functions=user \
+# RUN:   --align-functions=1 --function-order=%t/generic-order.txt \
+# RUN:   -o %t/extab-candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=GENERIC-BOLT
+# RUN: llvm-readelf --unwind %t/extab-candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=GENERIC
+# RUN: llvm-nm --numeric-sort %t/extab-candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=GENERIC-ORDER
+# RUN: llvm-objdump -s -j .ARM.extab %t/extab-candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=GENERIC-BYTES
+# RUN: llvm-readelf -r %t/extab-candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=GENERIC-RELOC
+# RUN: llvm-objcopy --remove-section=.rel.ARM.extab %t/extab.elf \
+# RUN:   %t/extab-no-personality-reloc.elf
+# RUN: not llvm-bolt %t/extab-no-personality-reloc.elf \
+# RUN:   --firmbolt-cortex-m-cpu=cortex-m3 --relocs --use-old-text \
+# RUN:   --reorder-functions=user --align-functions=1 \
+# RUN:   --function-order=%t/generic-order.txt \
+# RUN:   -o %t/extab-no-personality-reloc-candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=MISSING-PERSONALITY
+
+# BOLT: BOLT-INFO: rebuilt ARM EHABI index .ARM.exidx with 4 fixed-footprint entries, 1 external compact reference(s), and 0 relocation-complete generic reference(s) after function layout
+# BOLT: BOLT-INFO: not adding new segments
+
+# ORDER: 08000100 T worker_b
+# ORDER-NEXT: 08000104 T Reset_Handler
+# ORDER: 08000118 T fixture_halt
+# ORDER-NEXT: 0800011c T worker_a
+
+# UNWIND: FunctionAddress: 0x8000100
+# UNWIND-NEXT: Model: CantUnwind
+# UNWIND: FunctionAddress: 0x8000104
+# UNWIND: ExceptionHandlingTable: .ARM.extab
+# UNWIND: Model: Compact
+# UNWIND: PersonalityIndex: 1
+# UNWIND: FunctionAddress: 0x800011C
+# UNWIND-NEXT: Model: Compact
+# UNWIND: FunctionAddress: 0x8000124
+# UNWIND-NEXT: Model: CantUnwind
+
+# LAYOUT: .text {{.*}} 08000100 {{.*}} 000022 {{.*}} AX
+# LAYOUT: .ARM.extab PROGBITS 08000124 010124 000008
+# LAYOUT: .ARM.exidx ARM_EXIDX 0800012c 01012c 000020 {{.*}} AL 3
+# LAYOUT: EXIDX 0x01012c 0x0800012c 0x0800012c 0x00020 0x00020 R 0x4
+
+# PR2-BOLT: BOLT-INFO: rebuilt ARM EHABI index .ARM.exidx with 4 fixed-footprint entries, 1 external compact reference(s), and 0 relocation-complete generic reference(s) after function layout
+
+# PR2: ExceptionHandlingTable: .ARM.extab
+# PR2: Model: Compact
+# PR2: PersonalityIndex: 2
+
+# GENERIC-BOLT: BOLT-INFO: rebuilt ARM EHABI index .ARM.exidx with 4 fixed-footprint entries, 0 external compact reference(s), and 1 relocation-complete generic reference(s) after function layout
+
+# GENERIC: FunctionAddress: 0x8000104
+# GENERIC: ExceptionHandlingTable: .ARM.extab
+# GENERIC: Model: Generic
+# GENERIC: PersonalityRoutineAddress: 0x8000101
+# GENERIC: PersonalityRoutineName: __gxx_personality_v0
+
+# GENERIC-ORDER: 08000100 T __gxx_personality_v0
+# GENERIC-ORDER: 08000102 T worker_b
+# GENERIC-ORDER: 08000104 T Reset_Handler
+# GENERIC-ORDER: 0800010a T worker_a
+
+# GENERIC-BYTES: Contents of section .ARM.extab:
+# GENERIC-BYTES-NEXT: 800010c f5ffff7f b0b0b000 00000000
+
+# GENERIC-RELOC: 0800010c {{.*}} R_ARM_PREL31 08000101 __gxx_personality_v0
+
+# MISSING-PERSONALITY: BOLT-ERROR: 'cannot rebuild ARM EHABI index tables': ARM EHABI generic entry at 0x800010c lacks an exact R_ARM_PREL31 personality identity
+
+//--- fixture.s
+.syntax unified
+.cpu cortex-m3
+.thumb
+.eabi_attribute Tag_CPU_arch, 10
+.eabi_attribute Tag_CPU_arch_profile, 'M'
+
+.section .isr_vector, "a", %progbits
+.align 2
+.global g_pfnVectors
+.type g_pfnVectors, %object
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+.size g_pfnVectors, . - g_pfnVectors
+
+.section .text, "ax", %progbits
+.align 2
+.global Reset_Handler
+.type Reset_Handler, %function
+.thumb_func
+Reset_Handler:
+  .fnstart
+  .personalityindex 1
+  movw r4, #0
+  movt r4, #0x2000
+  bl worker_a
+  str r0, [r4]
+  bl worker_b
+  str r0, [r4, #4]
+.global fixture_halt
+fixture_halt:
+  b fixture_halt
+  .fnend
+.size Reset_Handler, . - Reset_Handler
+
+.weak __aeabi_unwind_cpp_pr1
+
+.align 2
+.global worker_a
+.type worker_a, %function
+.thumb_func
+worker_a:
+  .fnstart
+  push {r4, lr}
+  .save {r4, lr}
+  movs r0, #17
+  pop {r4, pc}
+  .fnend
+.size worker_a, . - worker_a
+
+.align 2
+.global worker_b
+.type worker_b, %function
+.thumb_func
+worker_b:
+  .fnstart
+  movs r0, #42
+  bx lr
+  .cantunwind
+  .fnend
+.size worker_b, . - worker_b
+
+//--- compact-pr2.s
+.syntax unified
+.cpu cortex-m3
+.thumb
+.eabi_attribute Tag_CPU_arch, 10
+.eabi_attribute Tag_CPU_arch_profile, 'M'
+
+.section .isr_vector, "a", %progbits
+.word 0x20001000
+.word Reset_Handler
+
+.section .text, "ax", %progbits
+.global Reset_Handler
+.type Reset_Handler, %function
+.thumb_func
+Reset_Handler:
+  .fnstart
+  .personalityindex 2
+  bl worker_a
+  nop
+  bx lr
+  .fnend
+.size Reset_Handler, . - Reset_Handler
+
+.global worker_a
+.type worker_a, %function
+.thumb_func
+worker_a:
+  .fnstart
+  bx lr
+  .cantunwind
+  .fnend
+.size worker_a, . - worker_a
+
+.global worker_b
+.type worker_b, %function
+.thumb_func
+worker_b:
+  .fnstart
+  bx lr
+  .cantunwind
+  .fnend
+.size worker_b, . - worker_b
+
+.weak __aeabi_unwind_cpp_pr2
+
+//--- extab.s
+.syntax unified
+.cpu cortex-m3
+.thumb
+.eabi_attribute Tag_CPU_arch, 10
+.eabi_attribute Tag_CPU_arch_profile, 'M'
+
+.section .isr_vector, "a", %progbits
+.word 0x20001000
+.word Reset_Handler
+
+.section .text, "ax", %progbits
+.global Reset_Handler
+.type Reset_Handler, %function
+.thumb_func
+Reset_Handler:
+  .fnstart
+  bl worker_a
+  bx lr
+  .personality __gxx_personality_v0
+  .handlerdata
+  .long 0
+  .section .text
+  .fnend
+.size Reset_Handler, . - Reset_Handler
+
+.global worker_a
+.type worker_a, %function
+.thumb_func
+worker_a:
+  .fnstart
+  bx lr
+  .cantunwind
+  .fnend
+.size worker_a, . - worker_a
+
+.global worker_b
+.type worker_b, %function
+.thumb_func
+worker_b:
+  .fnstart
+  bx lr
+  .cantunwind
+  .fnend
+.size worker_b, . - worker_b
+
+.global __gxx_personality_v0
+.type __gxx_personality_v0, %function
+.thumb_func
+__gxx_personality_v0:
+  bx lr
+.size __gxx_personality_v0, . - __gxx_personality_v0
+
+//--- link.ld
+ENTRY(Reset_Handler)
+MEMORY {
+  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 64K
+  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 16K
+}
+SECTIONS {
+  .isr_vector ORIGIN(FLASH) : { KEEP(*(.isr_vector)) } > FLASH
+  .text ORIGIN(FLASH) + 0x100 : { *(.text*) } > FLASH
+  .ARM.extab : { *(.ARM.extab* .gnu.linkonce.armextab.*) } > FLASH
+  .ARM.exidx : { *(.ARM.exidx* .gnu.linkonce.armexidx.*) } > FLASH
+  .data : { *(.data*) } > RAM AT > FLASH
+  .bss (NOLOAD) : { *(.bss*) *(COMMON) } > RAM
+}
+
+//--- order.txt
+worker_b
+Reset_Handler
+worker_a
+
+//--- generic-order.txt
+__gxx_personality_v0
+worker_b
+Reset_Handler
+worker_a
diff --git a/bolt/test/ARM/thumb-firmware-publication-policy.s b/bolt/test/ARM/thumb-firmware-publication-policy.s
