+TEST(ARMRelocationHandlerTest, ThumbBranchFutureRoundTripsAndRanges) {
+  std::unique_ptr<RelocationHandler> Handler = createARMRelocationHandler();
+  constexpr uint64_t PC = 0x08010000;
+
+  struct Case {
+    uint32_t Type;
+    uint32_t Original;
+    int64_t FirstInvalidNegative;
+    int64_t LastValidNegative;
+    int64_t LastValidPositive;
+    int64_t FirstInvalidPositive;
+  };
+
+  const Case Cases[] = {
+      {ELF::R_ARM_THM_BF12, 0xe001f102, -4098, -4096, 4094, 4096},
+      {ELF::R_ARM_THM_BF16, 0xe001f140, -65538, -65536, 65534, 65536},
+      {ELF::R_ARM_THM_BF18, 0xc001f100, -262146, -262144, 262142,
+       262144},
+  };
+
+  for (const Case &C : Cases) {
+    SCOPED_TRACE(C.Type);
+    const int64_t Base = int64_t(PC + 4);
+    EXPECT_FALSE(Handler->canEncodeValue(
+        C.Type, uint64_t(Base + C.FirstInvalidNegative), PC));
+    EXPECT_TRUE(Handler->canEncodeValue(
+        C.Type, uint64_t(Base + C.LastValidNegative), PC));
+    EXPECT_TRUE(Handler->canEncodeValue(
+        C.Type, uint64_t(Base + C.LastValidPositive), PC));
+    EXPECT_FALSE(Handler->canEncodeValue(
+        C.Type, uint64_t(Base + C.FirstInvalidPositive), PC));
+    EXPECT_FALSE(Handler->canEncodeValue(C.Type, PC + 1, PC));
+
+    for (const int64_t Delta : {C.LastValidNegative, int64_t(-4),
+                                int64_t(0), C.LastValidPositive}) {
+      const uint64_t Target = uint64_t(Base + Delta);
+      const uint64_t Encoded =
+          Handler->encodeValue(C.Type, Target, PC, C.Original);
+      EXPECT_EQ(Handler->extractValue(C.Type, Encoded, PC), Target);
+    }
+  }
+}
