+# VERIFY: No errors.
+# ARANGES: Address Range Header:{{.*}}addr_size = 0x04
+# ARANGES: [0x080001{{[0-9a-f]+}},
+# RANGES: .debug_ranges contents:
+# RANGES: {{[0-9a-f]+}} 080001{{[0-9a-f]+}} 080001{{[0-9a-f]+}}
+# LOC: .debug_loc contents:
+# LOC: (0x080001{{[0-9a-f]+}}, 0x080001{{[0-9a-f]+}}):
+# DWARF5: locations list header:{{.*}}addr_size = 0x04
+# DWARF5: range list header:{{.*}}addr_size = 0x04
+# DWP: DW_AT_name{{.*}}("Reset_Handler")
+# DWP: DW_AT_name{{.*}}("Aux_Handler")
+
+//--- fixture.c
+typedef unsigned int uintptr_t;
+
+int Reset_Handler(int x, int *out);
+
+__attribute__((section(".isr_vector"), used))
+const uintptr_t g_pfnVectors[] = {
+  0x20001000u,
+  (uintptr_t)Reset_Handler,
+};
+
+__attribute__((noinline)) int worker(int x, int *out) {
+  int value = x + 1;
+  if (x & 1)
+    value += x;
+  *out = value;
+  return value;
+}
+
+int Reset_Handler(int x, int *out) {
+  return worker(x, out);
+}
+
+//--- aranges.s
+.section .debug_aranges,"",%progbits
+.Laranges_start:
+  .long .Laranges_end - .Laranges_header
+.Laranges_header:
+  .short 2
+  .long 0
+  .byte 4
+  .byte 0
+  .long 0
+  .long worker
+  .long 16
+  .long 0
+  .long 0
+.Laranges_end:
+
+//--- link.ld
+ENTRY(Reset_Handler)
+MEMORY {
+  FLASH (rx)  : ORIGIN = 0x08000100, LENGTH = 64K
+  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 16K
+}
+SECTIONS {
+  .isr_vector : { KEEP(*(.isr_vector)) } > FLASH
+  .text : { *(.text .text.*) } > FLASH
+  .rodata : { *(.rodata .rodata.*) } > FLASH
+  .data : { *(.data .data.*) } > RAM AT > FLASH
+  .bss (NOLOAD) : { *(.bss .bss.* COMMON) } > RAM
+  .debug_info 0 : { *(.debug_info) }
+  .debug_abbrev 0 : { *(.debug_abbrev) }
+  .debug_line 0 : { *(.debug_line) }
+  .debug_str 0 : { *(.debug_str) }
+  .debug_ranges 0 : { *(.debug_ranges) }
+  .debug_loc 0 : { *(.debug_loc) }
+  .debug_aranges 0 : { *(.debug_aranges) }
+  /DISCARD/ : { *(.ARM.exidx*) *(.ARM.extab*) }
+}
