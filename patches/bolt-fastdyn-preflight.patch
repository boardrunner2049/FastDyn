+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='terminal_changed'); print(f['firmware_modification_attempted'],f['firmware_modified'],f['firmware_publication_rejections'])" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objcopy --dump-section .text=%t.input.text %t.exe
