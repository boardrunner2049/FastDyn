+    for (size_t I = 0; I < Entries.size(); ++I) {
+      ExidxEntry &Entry = Entries[I];
+      if (!Entry.Functions.empty())
+        continue;
+      if (Entry.IsSentinel)
+        continue;
+      return createStringError(
+          errc::not_supported,
+          "ARM EHABI range at 0x%" PRIx64
+          " has no exact discovered function coverage",
+          Entry.InputStart);
+    }
+
+    SmallVector<std::pair<uint64_t, size_t>, 64> OutputFunctions;
+    for (size_t I = 0; I < Entries.size(); ++I) {
+      ExidxEntry &Entry = Entries[I];
+      if (Entry.IsSentinel)
+        continue;
+      Entry.OutputStart = std::numeric_limits<uint64_t>::max();
+      for (const BinaryFunction *BF : Entry.Functions) {
+        if (BF->isSplit())
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI-covered function %s is split; fragment unwind "
+              "records are not qualified",
+              BF->getPrintName().c_str());
+        if (BF->isFolded())
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI-covered function %s is folded; duplicate unwind "
+              "ranges are not qualified",
+              BF->getPrintName().c_str());
+        const uint64_t OutputAddress = getNewFunctionAddress(BF->getAddress());
+        if (!OutputAddress)
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI-covered function %s has no final output address",
+              BF->getPrintName().c_str());
+        Entry.OutputStart = std::min(Entry.OutputStart, OutputAddress);
+        OutputFunctions.emplace_back(OutputAddress, I);
+      }
+    }
+
+    llvm::sort(OutputFunctions);
+    SmallDenseSet<size_t, 32> ClosedGroups;
+    std::optional<size_t> CurrentGroup;
+    for (const auto &[Address, Group] : OutputFunctions) {
+      (void)Address;
+      if (CurrentGroup && *CurrentGroup == Group)
+        continue;
+      if (ClosedGroups.contains(Group))
+        return createStringError(
+            errc::not_supported,
+            "ARM EHABI merged range at 0x%" PRIx64
+            " becomes non-contiguous after function layout",
+            Entries[Group].InputStart);
+      if (CurrentGroup)
+        ClosedGroups.insert(*CurrentGroup);
+      CurrentGroup = Group;
+    }
+
+    SmallVector<ExidxEntry *, 32> OutputEntries;
+    for (ExidxEntry &Entry : Entries)
+      if (!Entry.IsSentinel)
+        OutputEntries.push_back(&Entry);
+    llvm::sort(OutputEntries, [](const ExidxEntry *A, const ExidxEntry *B) {
+      return A->OutputStart < B->OutputStart;
+    });
+    if (Entries.back().IsSentinel) {
+      if (!OutputEntries.empty() &&
+          Entries.back().OutputStart <= OutputEntries.back()->OutputStart)
+        return createStringError(
+            errc::not_supported,
+            "ARM EHABI sentinel no longer follows emitted code");
+      OutputEntries.push_back(&Entries.back());
+    }
+
+    if (OutputEntries.size() != Entries.size())
+      return createStringError(errc::executable_format_error,
+                               "ARM EHABI entry accounting mismatch");
+
+    // Generic entries carry a personality PREL31 in .ARM.extab and may be
+    // followed by language-specific bytes.  Admit them only when the linked
+    // personality relocation survived as an exact symbolic identity, its
+    // final encoded value resolves to that identity, and every non-header
+    // byte in the table remains unchanged at the same address.
+    SmallVector<BinarySection *, 4> GenericSections;
+    for (const ExidxEntry &Entry : Entries)
+      if (Entry.PersonalityTarget &&
+          !llvm::is_contained(GenericSections, Entry.ExtabSection))
+        GenericSections.push_back(Entry.ExtabSection);
+    for (BinarySection *ExtabSection : GenericSections) {
+      const StringRef Input = ExtabSection->getContents();
+      const uint64_t OutputAddress = ExtabSection->getOutputAddress()
+                                         ? ExtabSection->getOutputAddress()
+                                         : ExtabSection->getAddress();
+      if (OutputAddress != ExtabSection->getAddress())
+        return createStringError(
+            errc::not_supported,
+            "ARM EHABI generic table %s changed address",
+            ExtabSection->getName().str().c_str());
+      uint8_t *NewExtabContents = new uint8_t[Input.size()];
+      memcpy(NewExtabContents, Input.data(), Input.size());
+
+      for (const ExidxEntry &Entry : Entries) {
+        if (!Entry.PersonalityTarget || Entry.ExtabSection != ExtabSection)
+          continue;
+        const uint64_t Offset =
+            Entry.ExtabTarget - ExtabSection->getAddress();
+        if (Offset > Input.size() ||
+            Input.size() - Offset < sizeof(uint32_t)) {
+          delete[] NewExtabContents;
+          return createStringError(
+              errc::executable_format_error,
+              "ARM EHABI generic entry at 0x%" PRIx64
+              " has no final personality word",
+              Entry.ExtabTarget);
+        }
+        const uint64_t PersonalityState = Entry.PersonalityTarget & 1;
+        const uint64_t OutputFunctionAddress =
+            getNewFunctionAddress(Entry.PersonalityTarget & ~uint64_t(1));
+        if (!OutputFunctionAddress) {
+          delete[] NewExtabContents;
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI generic personality identity 0x%" PRIx64
+              " has no final function address",
+              Entry.PersonalityTarget);
+        }
+        const uint64_t ExpectedPersonality =
+            OutputFunctionAddress | PersonalityState;
+        Expected<uint32_t> OutputPersonality =
+            EncodePrel31(ExpectedPersonality, OutputAddress + Offset);
+        if (!OutputPersonality) {
+          delete[] NewExtabContents;
+          return OutputPersonality.takeError();
+        }
+        WriteWord(reinterpret_cast<char *>(NewExtabContents + Offset),
+                  *OutputPersonality);
+      }
+
+      for (size_t I = 0; I < Input.size(); ++I) {
+        const bool IsPersonalityWord = llvm::any_of(
+            Entries, [&](const ExidxEntry &Entry) {
+              if (!Entry.PersonalityTarget ||
+                  Entry.ExtabSection != ExtabSection)
+                return false;
+              const uint64_t Offset =
+                  Entry.ExtabTarget - ExtabSection->getAddress();
+              return Offset <= I && I < Offset + sizeof(uint32_t);
+            });
+        if (!IsPersonalityWord &&
+            Input[I] != reinterpret_cast<char *>(NewExtabContents)[I]) {
+          delete[] NewExtabContents;
+          return createStringError(
+              errc::not_supported,
+              "ARM EHABI generic table %s changed opaque byte at offset "
+              "0x%zx",
+              ExtabSection->getName().str().c_str(), I);
+        }
+      }
+      ExtabSection->updateContents(NewExtabContents, Input.size());
+      ExtabSection->setOutputAddress(ExtabSection->getAddress());
+      ExtabSection->setOutputFileOffset(ExtabSection->getInputFileOffset());
+    }
+
+    uint8_t *NewContents = new uint8_t[Contents.size()];
+    size_t ExternalCompactReferences = 0;
+    size_t ExternalGenericReferences = 0;
+    for (size_t I = 0; I < OutputEntries.size(); ++I) {
+      const ExidxEntry &Entry = *OutputEntries[I];
+      const uint64_t Place = Section.getAddress() + I * 8;
+      Expected<uint32_t> FunctionPrel31 =
+          EncodePrel31(Entry.OutputStart, Place);
+      if (!FunctionPrel31) {
+        delete[] NewContents;
+        return FunctionPrel31.takeError();
+      }
+      WriteWord(reinterpret_cast<char *>(NewContents + I * 8),
+                *FunctionPrel31);
+      uint32_t OutputUnwindWord = Entry.UnwindWord;
+      if (Entry.ExtabSection) {
+        const uint64_t ExtabOffset =
+            Entry.ExtabTarget - Entry.ExtabSection->getAddress();
+        const uint64_t OutputSectionAddress =
+            Entry.ExtabSection->getOutputAddress()
+                ? Entry.ExtabSection->getOutputAddress()
+                : Entry.ExtabSection->getAddress();
+        Expected<uint32_t> ExtabPrel31 =
+            EncodePrel31(OutputSectionAddress + ExtabOffset,
+                         Place + sizeof(uint32_t));
+        if (!ExtabPrel31) {
+          delete[] NewContents;
+          return ExtabPrel31.takeError();
+        }
+        OutputUnwindWord = *ExtabPrel31;
+        if (Entry.PersonalityTarget)
+          ++ExternalGenericReferences;
+        else
+          ++ExternalCompactReferences;
+      }
+      WriteWord(reinterpret_cast<char *>(NewContents + I * 8 + 4),
+                OutputUnwindWord);
+    }
+    Section.updateContents(NewContents, Contents.size());
+    Section.setOutputAddress(Section.getAddress());
+    Section.setOutputFileOffset(Section.getInputFileOffset());
+    BC->outs() << "BOLT-INFO: rebuilt ARM EHABI index " << Section.getName()
+               << " with " << Entries.size()
+               << " fixed-footprint entries, " << ExternalCompactReferences
+               << " external compact reference(s), and "
+               << ExternalGenericReferences
+               << " relocation-complete generic reference(s) after function "
+                  "layout\n";
+  }
+
+  return Error::success();
+}
