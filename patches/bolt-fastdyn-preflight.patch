+# RUN: llvm-mc -triple=thumbv8.1m.main-none-eabi -mcpu=cortex-m55 \
+# RUN:   -arm-add-build-attributes -filetype=obj -o %t.o %s
+# RUN: llvm-objdump -r %t.o | FileCheck %s --check-prefix=RELOCS
+# RUN: llvm-jitlink -noexec -slab-address 0x08000000 \
+# RUN:   -slab-allocate 64Kb -slab-page-size 4096 -check %s %t.o
+
+## Armv8.1-M branch-future instructions contain two labels.  Only the second
+## label receives an ELF relocation.  Check all three split signed immediate
+## forms at a deterministic linked address so that an incorrect operand,
+## scaling, PC bias, or field layout is observable in the final instruction.
+
+# RELOCS: R_ARM_THM_BF16 bf_target
+# RELOCS: R_ARM_THM_BF12 bfc_target
+# RELOCS: R_ARM_THM_BF18 bfl_target
+
+# jitlink-check: *{4}(bf_site) = 0xe00bf140
+# jitlink-check: *{4}(bfc_site) = 0xe807f102
+# jitlink-check: *{4}(bfl_site) = 0xc005f100
+
+  .syntax unified
+  .thumb
+
+  .section .text.sites,"ax",%progbits
+  .p2align 2
+  .globl bf_site
+  .type bf_site,%function
+  .thumb_func
+bf_site:
+  bf #4, bf_target
+  bx lr
+  .size bf_site, .-bf_site
+
+  .p2align 2
+  .globl bfc_site
+  .type bfc_site,%function
+  .thumb_func
+bfc_site:
+  bfcsel #4, bfc_target, #8, eq
+  bx lr
+  .size bfc_site, .-bfc_site
+
+  .p2align 2
+  .globl bfl_site
+  .type bfl_site,%function
+  .thumb_func
+bfl_site:
+  bfl #4, bfl_target
+  bx lr
+  .size bfl_site, .-bfl_site
+
+  .globl main
+  .type main,%function
+  .thumb_func
+main:
+  bx lr
+  .size main, .-main
+
+  .section .text.targets,"ax",%progbits
+  .p2align 2
+  .globl bf_target
+  .type bf_target,%function
+  .thumb_func
+bf_target:
+  bx lr
+  .size bf_target, .-bf_target
+
+  .globl bfc_target
+  .type bfc_target,%function
+  .thumb_func
