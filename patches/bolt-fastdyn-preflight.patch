+TEST_P(MCPlusBuilderTester, ARM_ReadOnlyConstantMaterialization) {
+  if (GetParam() != Triple::thumb)
+    GTEST_SKIP();
+
+  MCSymbol *Literal = BC->Ctx->createTempSymbol();
+  MCInst WordLoad = MCInstBuilder(ARM::t2LDRpci)
+                        .addReg(ARM::R4)
+                        .addExpr(MCSymbolRefExpr::create(Literal, *BC->Ctx))
+                        .addImm(ARMCC::AL)
+                        .addReg(0);
+  ASSERT_NE(BC->MIB->getMemOperandDisp(WordLoad), WordLoad.end());
+  EXPECT_EQ(BC->MIB->getMemOperandDisp(WordLoad),
+            std::next(WordLoad.begin()));
+
+  StringRef SmallWord("\x34\x12\x00\x00", 4);
+  InstructionListType Small =
+      BC->MIB->materializeConstant(*BC, WordLoad, SmallWord, 0);
+  ASSERT_EQ(Small.size(), 1u);
+  EXPECT_EQ(Small.front().getOpcode(), ARM::t2MOVi16);
+  EXPECT_EQ(Small.front().getOperand(0).getReg(), ARM::R4);
+  EXPECT_EQ(Small.front().getOperand(1).getImm(), 0x1234);
+
+  StringRef FullWord("\x78\x56\x34\x12", 4);
+  InstructionListType Full =
+      BC->MIB->materializeConstant(*BC, WordLoad, FullWord, 0);
+  ASSERT_EQ(Full.size(), 2u);
+  auto FullIt = Full.begin();
+  EXPECT_EQ(FullIt->getOpcode(), ARM::t2MOVi16);
+  EXPECT_EQ(FullIt->getOperand(1).getImm(), 0x5678);
+  ++FullIt;
+  EXPECT_EQ(FullIt->getOpcode(), ARM::t2MOVTi16);
+  EXPECT_EQ(FullIt->getOperand(2).getImm(), 0x1234);
+
+  MCInst SignedByteLoad = MCInstBuilder(ARM::t2LDRSBpci)
+                              .addReg(ARM::R5)
+                              .addExpr(MCSymbolRefExpr::create(Literal,
+                                                              *BC->Ctx))
+                              .addImm(ARMCC::AL)
+                              .addReg(0);
+  StringRef SignedByte("\x80", 1);
+  InstructionListType Signed =
+      BC->MIB->materializeConstant(*BC, SignedByteLoad, SignedByte, 0);
+  ASSERT_EQ(Signed.size(), 2u);
+  auto SignedIt = Signed.begin();
+  EXPECT_EQ(SignedIt->getOperand(1).getImm(), 0xff80);
+  ++SignedIt;
+  EXPECT_EQ(SignedIt->getOperand(2).getImm(), 0xffff);
+
+  MCInst PCLoad = WordLoad;
+  PCLoad.getOperand(0).setReg(ARM::PC);
+  EXPECT_TRUE(BC->MIB->materializeConstant(*BC, PCLoad, SmallWord, 0).empty());
+  EXPECT_TRUE(BC->MIB
+                  ->materializeConstant(*BC, WordLoad, StringRef("\x01", 1),
+                                        0)
+                  .empty());
+}
