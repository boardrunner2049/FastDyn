+                    .addImm(4)
+                    .addImm(ARMCC::AL)
+                    .addReg(0);
+  bool IsLoad, IsStore, IsStoreFromReg, IsSimple, IsIndexed;
+  MCPhysReg Reg;
+  int32_t SrcImm;
+  uint16_t Base;
+  int64_t Offset;
+  uint8_t Size;
+  ASSERT_TRUE(BC->MIB->isStackAccess(
+      Load, IsLoad, IsStore, IsStoreFromReg, Reg, SrcImm, Base, Offset,
+      Size, IsSimple, IsIndexed));
+  EXPECT_TRUE(IsLoad);
+  EXPECT_FALSE(IsStore);
+  EXPECT_EQ(Reg, ARM::R0);
+  EXPECT_EQ(Base, ARM::SP);
+  EXPECT_EQ(Offset, 16);
+  EXPECT_EQ(Size, 4);
+  EXPECT_TRUE(IsSimple);
+  EXPECT_FALSE(IsIndexed);
+
+  ASSERT_TRUE(BC->MIB->replaceMemOperandWithReg(Load, ARM::R2));
+  EXPECT_EQ(Load.getOpcode(), ARM::tMOVr);
+  EXPECT_EQ(Load.getOperand(0).getReg(), ARM::R0);
+  EXPECT_EQ(Load.getOperand(1).getReg(), ARM::R2);
+
+  auto CheckExtendedForwarding = [&](unsigned LoadOpcode, uint8_t AccessSize,
+                                     int64_t AccessOffset,
+                                     unsigned ExpectedOpcode) {
+    MCInst ExtendedLoad = MCInstBuilder(LoadOpcode)
+                              .addReg(ARM::R8)
+                              .addReg(ARM::SP)
+                              .addImm(AccessOffset)
+                              .addImm(ARMCC::AL)
+                              .addReg(0);
+    ASSERT_TRUE(BC->MIB->isStackAccess(
+        ExtendedLoad, IsLoad, IsStore, IsStoreFromReg, Reg, SrcImm, Base,
+        Offset, Size, IsSimple, IsIndexed));
+    EXPECT_TRUE(IsLoad);
+    EXPECT_FALSE(IsStore);
+    EXPECT_EQ(Base, ARM::SP);
+    EXPECT_EQ(Offset, AccessOffset);
+    EXPECT_EQ(Size, AccessSize);
+    EXPECT_TRUE(IsSimple);
+    EXPECT_FALSE(IsIndexed);
+    ASSERT_TRUE(
+        BC->MIB->replaceMemOperandWithReg(ExtendedLoad, ARM::R9));
+    EXPECT_EQ(ExtendedLoad.getOpcode(), ExpectedOpcode);
+    EXPECT_EQ(ExtendedLoad.getOperand(0).getReg(), ARM::R8);
+    EXPECT_EQ(ExtendedLoad.getOperand(1).getReg(), ARM::R9);
+    EXPECT_EQ(ExtendedLoad.getOperand(2).getImm(), 0);
+  };
+
+  CheckExtendedForwarding(ARM::t2LDRBi12, 1, 1, ARM::t2UXTB);
+  CheckExtendedForwarding(ARM::t2LDRSBi8, 1, -1, ARM::t2SXTB);
+  CheckExtendedForwarding(ARM::t2LDRHi12, 2, 2, ARM::t2UXTH);
+  CheckExtendedForwarding(ARM::t2LDRSHi8, 2, -2, ARM::t2SXTH);
+
+  MCInst NarrowByteLoad = MCInstBuilder(ARM::tLDRBi)
+                              .addReg(ARM::R1)
+                              .addReg(ARM::R7)
+                              .addImm(1)
+                              .addImm(ARMCC::AL)
+                              .addReg(0);
+  MCInst UnencodableNarrowByteLoad = NarrowByteLoad;
+  ASSERT_TRUE(BC->MIB->isStackAccess(
+      NarrowByteLoad, IsLoad, IsStore, IsStoreFromReg, Reg, SrcImm, Base,
+      Offset, Size, IsSimple, IsIndexed));
+  EXPECT_EQ(Offset, 1);
+  ASSERT_TRUE(
+      BC->MIB->replaceMemOperandWithReg(NarrowByteLoad, ARM::R2));
+  EXPECT_EQ(NarrowByteLoad.getOpcode(), ARM::tUXTB);
+  EXPECT_FALSE(BC->MIB->replaceMemOperandWithReg(
+      UnencodableNarrowByteLoad, ARM::R8));
+  EXPECT_EQ(UnencodableNarrowByteLoad.getOpcode(), ARM::tLDRBi);
+
+  MCInst NarrowHalfLoad = MCInstBuilder(ARM::tLDRHi)
+                              .addReg(ARM::R1)
+                              .addReg(ARM::R7)
+                              .addImm(3)
+                              .addImm(ARMCC::AL)
+                              .addReg(0);
+  ASSERT_TRUE(BC->MIB->isStackAccess(
+      NarrowHalfLoad, IsLoad, IsStore, IsStoreFromReg, Reg, SrcImm, Base,
+      Offset, Size, IsSimple, IsIndexed));
+  EXPECT_EQ(Offset, 6);
+  EXPECT_EQ(Size, 2);
+}
