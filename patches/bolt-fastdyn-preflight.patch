+# RUN: ld.lld -T %S/Inputs/thumb-zero-vector.ld --emit-relocs \
+# RUN:   %t.zero.o -o %t.zero.exe
+# RUN: llvm-bolt %t.zero.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --frame-opt=all --eliminate-unreachable=false \
+# RUN:   -o %t.zero.bolt 2>&1 | FileCheck %s --check-prefix=ZERO
+
+# BOLT: BOLT-INFO: Firm-BOLT publication policy checked 1 attempted function(s), rejected 0 for guest instruction-count changes
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# VECTORS: Cortex-M firmware constraints: vector={{0x[0-9a-f]+}}, source=.vectors section
+# VECTORS: 1 out of 2 functions were overwritten.
+# ZEPHYR: Cortex-M firmware constraints: vector={{0x[0-9a-f]+}}, source=_vector_table/_vector_end
+# ZEPHYR: 1 out of 2 functions were overwritten.
+# ZERO: Cortex-M firmware constraints: vector=0x0, source=_vector_table/_vector_end
+# ZERO: 1 out of 2 functions were overwritten.
+
+# REPORT: True True frame_load_forwarding  7 7
+# REPORT-NEXT: 0
+
+# DISASM: <worker>:
+# DISASM: str r0, [sp]
+# DISASM-NEXT: mov r0, r0
+# DISASM: b 0x8000010
+# DISASM: adds r0, #0x1
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl worker
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl worker
+  .type worker,%function
+  .thumb_func
+worker:
+  sub sp, #4
+  str r0, [sp]
+  ldr r0, [sp]
+  b .Lnext
+.Lnext:
+  adds r0, #1
+  add sp, #4
+  bx lr
+  .size worker, .-worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
+  .globl _vector_end
+_vector_end:
