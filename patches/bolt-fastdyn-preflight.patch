+
+# RUN: llvm-mc -filetype=obj -triple thumbv8.1m.main-none-eabi \
+# RUN:   -mcpu=cortex-m85 -mattr=+pacbti,+mve,+mve.fp -defsym=M85=1 %s -o %t.m85.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.m85.o -o %t.m85.exe
+# RUN: llvm-bolt %t.m85.exe --firmbolt-cortex-m-cpu=cortex-m85 \
+# RUN:   --frame-opt=all --fastdyn-firmware-report=%t.m85.json \
+# RUN:   -o %t.m85.bolt 2>&1 | FileCheck %s --check-prefix=M85-BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.m85.json')); f=next(x for x in d['functions'] if x['name']=='pacbti_worker'); print(f['simple'],f['firmware_modified'])" | FileCheck %s --check-prefix=M85-REPORT
+# RUN: llvm-objdump -d --mcpu=cortex-m85 --mattr=+pacbti %t.m85.bolt \
+# RUN:   | FileCheck %s --check-prefix=M85-DISASM
+
+# RUN: not llvm-bolt %t.m23.exe --firmbolt-cortex-m-cpu=cortex-m33 \
+# RUN:   --frame-opt=none -o %t.bad 2>&1 | FileCheck %s --check-prefix=MISMATCH
+
+# M23-BOLT: BOLT-INFO: FOP optimized 1 redundant load(s)
+# M23-DISASM: <ordinary_worker>:
+# M23-DISASM: str r0, [sp]
+# M23-DISASM-NEXT: mov r1, r0
+
+# M33-BOLT: security-state-functions=1
+# M33-REPORT: False False
+# M33-DISASM: <secure_gateway>:
+# M33-DISASM-NEXT: sg
+# M33-DISASM-NEXT: bxns lr
+
+# M55-DISASM: <mve_worker>:
+# M55-DISASM-NEXT: vadd.i32 q0, q1, q2
+# M55-DISASM-NEXT: vadd.f32 q0, q1, q2
+# M55-DISASM-NEXT: bx lr
+
+# M85-BOLT: security-state-functions=1
+# M85-REPORT: False False
+# M85-DISASM: <pacbti_worker>:
+# M85-DISASM-NEXT: pacbti r12, lr, sp
+# M85-DISASM-NEXT: bti
+# M85-DISASM-NEXT: aut r12, lr, sp
+# M85-DISASM-NEXT: bx lr
+
+# MISMATCH: Cortex-M CPU/input attribute mismatch
+
+  .syntax unified
+  .thumb
+  .ifdef M23
+  .eabi_attribute Tag_CPU_arch, 16
