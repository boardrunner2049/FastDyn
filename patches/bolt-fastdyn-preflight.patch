+++ b/bolt/test/ARM/thumb-gnu-zdebug-sections.test
@@ -0,0 +1,102 @@
+## Legacy GNU-compressed debug sections use .zdebug_* names and a "ZLIB"
+## header instead of SHF_COMPRESSED.  FirmBOLT must decode them, rewrite the
+## represented DWARF, publish canonical .debug_* output, and remove stale ARM
+## SHT_REL tables whose legacy targets no longer exist.
+
+# REQUIRES: system-linux, zlib
+# RUN: split-file %s %t
+# RUN: %clang --target=thumbv7m-none-eabi -mcpu=cortex-m3 -mthumb -O2 -g \
+# RUN:   -gdwarf-5 -ffreestanding -fno-unwind-tables \
+# RUN:   -fno-asynchronous-unwind-tables -c %t/fixture.c -o %t/fixture.o
+# RUN: ld.lld --emit-relocs -T %t/link.ld %t/fixture.o -o %t/plain.elf
+# RUN: llvm-objcopy --dump-section=.debug_info=%t/debug_info \
+# RUN:   --dump-section=.debug_abbrev=%t/debug_abbrev %t/plain.elf
+# RUN: %python %S/Inputs/make-gnu-zdebug.py %t/debug_info %t/zdebug_info
+# RUN: %python %S/Inputs/make-gnu-zdebug.py %t/debug_abbrev %t/zdebug_abbrev
+# RUN: llvm-objcopy --update-section=.debug_info=%t/zdebug_info \
+# RUN:   --update-section=.debug_abbrev=%t/zdebug_abbrev \
+# RUN:   --rename-section=.debug_info=.zdebug_info \
+# RUN:   --rename-section=.debug_abbrev=.zdebug_abbrev \
+# RUN:   --rename-section=.rel.debug_info=.rel.zdebug_info %t/plain.elf \
+# RUN:   %t/reference.elf
+# RUN: llvm-dwarfdump --verify %t/reference.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=VERIFY
+# RUN: llvm-dwarfdump --debug-info %t/reference.elf \
+# RUN:   | FileCheck %s --check-prefix=INFO
+# RUN: llvm-bolt %t/reference.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --update-debug-sections \
+# RUN:   --always-convert-to-ranges --align-functions=1 \
+# RUN:   -o %t/candidate.elf
+# RUN: llvm-dwarfdump --verify %t/candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=VERIFY
+# RUN: llvm-dwarfdump --debug-info %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=INFO
+# RUN: llvm-readelf --sections --wide %t/candidate.elf \
+# RUN:   | FileCheck %s --check-prefix=SECTIONS
+
+## Malformed legacy payloads must fail before rewriting rather than becoming
+## an apparently valid output with no compile units.
+# RUN: %python %S/Inputs/make-gnu-zdebug.py --corrupt-magic \
+# RUN:   %t/debug_info %t/bad-zdebug_info
+# RUN: llvm-objcopy --update-section=.debug_info=%t/bad-zdebug_info \
+# RUN:   --rename-section=.debug_info=.zdebug_info %t/plain.elf %t/bad.elf
+# RUN: not llvm-bolt %t/bad.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --update-debug-sections \
+# RUN:   -o %t/bad-candidate.elf 2>&1 | FileCheck %s --check-prefix=BAD
+
+## Two physical sections must not compete for one canonical DWARF identity.
+# RUN: llvm-objcopy --add-section=.zdebug_info=%t/zdebug_info %t/plain.elf \
+# RUN:   %t/ambiguous.elf
+# RUN: not llvm-bolt %t/ambiguous.elf --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --relocs --use-old-text --update-debug-sections \
+# RUN:   -o %t/ambiguous-candidate.elf 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=AMBIGUOUS
+
+# VERIFY: No errors.
+# INFO: DW_TAG_compile_unit
+# INFO: DW_AT_name{{.*}}fixture.c
+# SECTIONS-NOT: .zdebug_info
+# SECTIONS-NOT: .zdebug_abbrev
+# SECTIONS-NOT: .rel.zdebug_info
+# SECTIONS: .debug_info
+# SECTIONS: .debug_abbrev
+# BAD: failed to decompress section '.zdebug_info': invalid GNU compressed section magic
+# AMBIGUOUS: ambiguous debug section representations for '.debug_info'
+
+//--- fixture.c
+typedef unsigned int uintptr_t;
+
+int Reset_Handler(int x);
+
+__attribute__((section(".isr_vector"), used))
+const uintptr_t g_pfnVectors[] = {
+    0x20001000u,
+    (uintptr_t)Reset_Handler,
+};
+
+__attribute__((noinline)) int worker(int x) { return x * 7 + 3; }
+
+int Reset_Handler(int x) { return worker(x); }
+
+//--- link.ld
+ENTRY(Reset_Handler)
+MEMORY {
+  FLASH (rx)  : ORIGIN = 0x08000100, LENGTH = 64K
+  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 16K
+}
+SECTIONS {
+  .isr_vector : { KEEP(*(.isr_vector)) } > FLASH
+  .text : { *(.text .text.*) } > FLASH
+  .rodata : { *(.rodata .rodata.*) } > FLASH
+  .data : { *(.data .data.*) } > RAM AT > FLASH
+  .bss (NOLOAD) : { *(.bss .bss.* COMMON) } > RAM
+  .debug_info 0 : { *(.debug_info) }
+  .debug_abbrev 0 : { *(.debug_abbrev) }
+  .debug_line 0 : { *(.debug_line) }
+  .debug_str 0 : { *(.debug_str) }
+  .debug_str_offsets 0 : { *(.debug_str_offsets) }
+  .debug_line_str 0 : { *(.debug_line_str) }
+  .debug_addr 0 : { *(.debug_addr) }
+  .debug_loclists 0 : { *(.debug_loclists) }
+  /DISCARD/ : { *(.ARM.exidx*) *(.ARM.extab*) }
+}
diff --git a/bolt/test/ARM/thumb-jump-table-footprint-reduction.s b/bolt/test/ARM/thumb-jump-table-footprint-reduction.s
