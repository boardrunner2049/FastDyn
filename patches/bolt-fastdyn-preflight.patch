+json::Array firmwarePublicationRejections(const BinaryFunction &BF) {
+  json::Array Reasons;
+  for (const auto &[Reason, Name] : FirmwarePublicationRejectionNames)
+    if (BF.hasFirmwarePublicationRejection(Reason))
+      Reasons.push_back(Name);
+  return Reasons;
+}
