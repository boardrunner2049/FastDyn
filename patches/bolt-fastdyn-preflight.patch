+# RUN:   --icp-calls-topn=1 --assume-abi \
+# RUN:   --firmbolt-allow-indirect-call-promotion \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --eliminate-unreachable=true --fastdyn-firmware-report=%t.skip.json \
+# RUN:   -v=1 -o %t.skip 2>&1 | FileCheck %s --check-prefix=SKIP
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=calls \
+# RUN:   --icp-calls-topn=1 --assume-abi \
+# RUN:   --firmbolt-allow-indirect-call-promotion \
+# RUN:   --firmbolt-allow-indirect-tail-call-promotion \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --eliminate-unreachable=true --fastdyn-firmware-report=%t.json \
+# RUN:   -v=1 -o %t.bolt 2>&1 | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 --disassemble-symbols=tail_dispatch \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='tail_dispatch'); print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),f['original_size'],f['output_size'],d['synthesized_call_promotion_instruction_count']); print([(x['origin_kind'],x.get('original_address'),x.get('source_original_address')) for x in f['instruction_origins']])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# SKIP: ICP skipped tail call in tail_dispatch
+# LOG: ICP succeeded in tail_dispatch
+# DISASM: <tail_dispatch>:
+# DISASM: movw r12
+# DISASM-NEXT: movt r12
+# DISASM-NEXT: cmp{{(\.w)?}} r3, r12
+# DISASM-NEXT: bne
+# DISASM: b.w 0x{{[0-9a-f]+}} <promoted_target>
+# DISASM: bx r3
+# REPORT: True {{.*}}indirect_call_promotion{{.*}} 38 {{2[0-9]}} 4
+# REPORT-NEXT: [('original_instruction', {{[0-9]+}}, None), ('original_instruction', {{[0-9]+}}, None), ('synthesized_call_promotion', None, {{[0-9]+}}), ('synthesized_call_promotion', None, {{[0-9]+}}), ('synthesized_call_promotion', None, {{[0-9]+}}), ('synthesized_call_promotion', None, {{[0-9]+}}), ('cloned_original_instruction', {{[0-9]+}}, None), ('original_instruction', {{[0-9]+}}, None)]
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #10
+  movw r3, :lower16:promoted_target + 1
+  movt r3, :upper16:promoted_target + 1
+  bl tail_dispatch
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl tail_dispatch
+  .type tail_dispatch,%function
+  .thumb_func
+tail_dispatch:
+  push {r4}
+  pop {r4}
+  bx r3
+# FDATA: 1 tail_dispatch 4 1 promoted_target 0 0 100
+  # The bytes after the terminal tail call are executable but unreachable.
+  # BOLT must first recognize the preceding stack-restore epilogue and then
+  # prove this block unreachable before compact emission can consume its span.
+  .rept 16
+  nop
+  .endr
+  .size tail_dispatch, .-tail_dispatch
+
+  .globl promoted_target
+  .type promoted_target,%function
+  .thumb_func
