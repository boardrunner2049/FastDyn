index 0000000000000000000000000000000000000000..bf4ee26b3a3623e2a40f402c0d064bf6be22e2c7
--- /dev/null
+++ b/llvm/test/ExecutionEngine/JITLink/AArch32/ELF_thumb_data_pointers.s
@@ -0,0 +1,55 @@
+# Verify that AArch32 JITLink restores the architectural Thumb-state bit for
+# data relocations to a defined Thumb symbol. LinkGraph stores its canonical
+# instruction address as even and carries the execution state separately in
+# ThumbSymbol. ARM-state targets must remain even.
+
+# RUN: llvm-mc -triple=armv7-none-eabi -arm-add-build-attributes \
+# RUN:   -filetype=obj -o %t.o %s
+# RUN: llvm-objdump -r %t.o | FileCheck %s --check-prefix=RELOCS
+# RUN: llvm-jitlink -noexec -slab-address 0x10000 -slab-allocate 10Kb \
+# RUN:   -slab-page-size 4096 -check %s %t.o
+
+.syntax unified
+
+.data
+.globl thumb_pointer
+thumb_pointer:
+  .word thumb_target
+.globl thumb_delta
+thumb_delta:
+  .word thumb_target - .
+.globl arm_pointer
+arm_pointer:
+  .word arm_target
+
+# RELOCS: R_ARM_ABS32 thumb_target
+# RELOCS: R_ARM_REL32 thumb_target
+# RELOCS: R_ARM_ABS32 arm_target
+# jitlink-check: *{4}(thumb_pointer) = thumb_target + 1
+# jitlink-check: (thumb_delta + *{4}(thumb_delta))[31:0] = thumb_target + 1
+# jitlink-check: *{4}(arm_pointer) = arm_target
+
+.text
+.p2align 2
+.arm
+.globl arm_target
+.type arm_target,%function
+arm_target:
+  bx lr
+.size arm_target, .-arm_target
+
+.p2align 1
+.thumb
+.globl thumb_target
+.type thumb_target,%function
+.thumb_func
+thumb_target:
+  bx lr
+.size thumb_target, .-thumb_target
+
+.globl main
+.type main,%function
+.thumb_func
+main:
+  bx lr
+.size main, .-main
