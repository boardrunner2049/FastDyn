+# RUN:   | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=taildup_copy %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   --disassemble-symbols=taildup_copy_observable %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=OBSERVABLE
+
+# LOG: tail duplication modified 2
+# LOG: tail duplication applied 1 static
+# DISASM: <taildup_copy>:
+# DISASM-NOT: mov r2, r3
+# DISASM: add.w r0, r0, r3
+# DISASM-NEXT: bx lr
+# OBSERVABLE: <taildup_copy_observable>:
+# OBSERVABLE: mov r1, r3
+# OBSERVABLE: add.w r0, r0, r1
+# OBSERVABLE-NEXT: bx lr
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  movs r3, #5
+  bl taildup_copy
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl taildup_copy
+  .type taildup_copy,%function
+  .thumb_func
+taildup_copy:
+  cmp r0, #0
+  bne .Lcold
+.Lhot:
+  mov r2, r3
+  b.w .Lshared
+.Lcold:
+  movs r0, #10
+  bx lr
+.Lshared:
+  add.w r0, r0, r2
+  bx lr
+  .size taildup_copy, .-taildup_copy
+
+# FDATA: 1 taildup_copy 0 100
+# FDATA: 1 taildup_copy 4 100
+# FDATA: 1 taildup_copy a 1
+# FDATA: 1 taildup_copy e 100
+
+  .globl taildup_copy_observable
+  .type taildup_copy_observable,%function
+  .thumb_func
+taildup_copy_observable:
+  cmp r0, #0
+  bne .Lobservable_cold
+.Lobservable_hot:
+  mov r1, r3
+  b.w .Lobservable_shared
+.Lobservable_cold:
+  movs r0, #10
+  bx lr
+.Lobservable_shared:
+  add.w r0, r0, r1
+  bx lr
+  .size taildup_copy_observable, .-taildup_copy_observable
+
