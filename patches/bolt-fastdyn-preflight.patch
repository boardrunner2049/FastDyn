diff --git a/bolt/test/ARM/thumb1-moved-literal-pool-relocation.s b/bolt/test/ARM/thumb1-moved-literal-pool-relocation.s
new file mode 100644
index 0000000000000000000000000000000000000000..dac3c694615e3cc6e3cd545b0e47ebce3bfd872b
--- /dev/null
+++ b/bolt/test/ARM/thumb1-moved-literal-pool-relocation.s
@@ -0,0 +1,68 @@
+## When a checked relaxed contract permits a literal pool to move, both the
+## live data and the retained SHT_REL container offset must follow it.  CFG
+## normalization removes the branch-to-next before the return, moving the
+## pool from 0x08000010 to 0x0800000c.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld --emit-relocs -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --firmbolt-allow-literal-address-changes \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='relocated_pool'); p=f['owned_literal_pools'][0]; print(f['firmware_modified'],p['original_address'],p['output_address'],p['relocation_count'])" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objdump -s -j .text %t.bolt | FileCheck %s --check-prefix=DATA
+# RUN: llvm-readelf -r %t.bolt | FileCheck %s --check-prefix=RELOCS
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --firmbolt-allow-literal-address-changes -v=1 \
+# RUN:   -o %t.no-report.bolt 2>&1 | FileCheck %s --check-prefix=NO-REPORT
+# RUN: llvm-readelf -r %t.no-report.bolt | FileCheck %s --check-prefix=RELOCS
+
+# BOLT: BOLT-INFO: reading ARM SHT_REL metadata for compact firmware emission
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: remapped 1 ARM SHT_REL offset(s) and 2 symbol index(es), adding 0 relocation record(s) in .rel.text
+# BOLT: BOLT-INFO: remapped 0 ARM SHT_REL offset(s) and 1 symbol index(es), adding 0 relocation record(s) in .rel.isr_vector
+# NO-REPORT: BOLT-INFO: remapped 1 ARM SHT_REL offset(s) and 2 symbol index(es), adding 0 relocation record(s) in .rel.text
+# REPORT: True 134217744 134217740 1
+# DATA: 8000000 00f002f8 704700bf 004801e0 14000008
+# RELOCS: 0800000c {{.*}} R_ARM_ABS32 {{.*}} external_object
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  bl relocated_pool
+  bx lr
+  nop
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl relocated_pool
+  .type relocated_pool,%function
+  .thumb_func
+relocated_pool:
+  ldr r0, .Lliteral
+  b .Lreturn
+.Lreturn:
+  bx lr
+  .p2align 2
+.Lliteral:
+  .word external_object
+  .size relocated_pool, .-relocated_pool
+
+  .p2align 2
+  .globl external_object
+  .type external_object,%object
+external_object:
+  .word 0x12345678
+  .size external_object, .-external_object
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-multi-successor-literal-owner.s b/bolt/test/ARM/thumb1-multi-successor-literal-owner.s
new file mode 100644
index 0000000000000000000000000000000000000000..ccef80dc627ff267298efa4dac8b30afaee373d2
--- /dev/null
+++ b/bolt/test/ARM/thumb1-multi-successor-literal-owner.s
@@ -0,0 +1,69 @@
+## A guarded Thumb literal pool can be owned by the final unconditional
+## branch in a block that also contains an earlier conditional branch.  The
+## block has two CFG successors, but execution reaching the final transfer
+## still cannot fall through into the data.  Ownership is therefore tied to
+## the exact terminal branch target, not to the aggregate successor count.
+
+# RUN: llvm-mc -filetype=obj -triple thumbv6m-none-eabi -mcpu=cortex-m0plus %s -o %t.o
+# RUN: ld.lld -Ttext=0x08000000 -e Reset_Handler %t.o -o %t.exe
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m0plus \
+# RUN:   --fastdyn-firmware-report=%t.report.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=BOLT
+# RUN: %python -c "import json; d=json.load(open('%t.report.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='multi_successor_owner'); p=f['owned_literal_pools']; print(f['firmware_modified'],len(p),p[0]['original_address']==p[0]['output_address'],f['firmware_publication_rejections'],d['synthesized_inline_data_bytes'])" | FileCheck %s --check-prefix=REPORT
+# RUN: llvm-objdump -d --disassemble-symbols=multi_successor_owner %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=CODE
+# RUN: llvm-objdump -s -j .text %t.bolt | FileCheck %s --check-prefix=DATA
+
+# BOLT: BOLT-INFO: Thumb literal-pool placement qualified 1 function(s), attached 1 owner block(s), rebound 1 PC-relative reference(s), and retained 0 function(s)
+# BOLT: BOLT: 1 out of 2 functions were overwritten.
+# BOLT: BOLT-INFO: not adding new segments
+# REPORT: True 1 True [] 4
+# CODE: <multi_successor_owner>:
+# CODE: ldr r1, [pc,
+# CODE: cmp r0, #0x0
+# CODE: beq
+# CODE-NEXT: b
+# CODE-NEXT: {{nop|mov r8, r8|movs r0, r0}}
+# DATA: 07000000
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 12
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  bl multi_successor_owner
+  bx lr
+  .size Reset_Handler, .-Reset_Handler
+
+  .globl multi_successor_owner
+  .type multi_successor_owner,%function
+  .thumb_func
+multi_successor_owner:
+  ldr r1, .Lpool
+  movs r2, #0
+  cmp r0, #0
+  beq .Lalternate
+  b .Lresume
+  .p2align 2
+.Lpool:
+  .word 7
+  .thumb
+.Lresume:
+  mov r0, r1
+  bx lr
+.Lalternate:
+  adds r0, #1
+  b .Lresume
+  .size multi_successor_owner, .-multi_successor_owner
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
diff --git a/bolt/test/ARM/thumb1-native-conditional-move-retention.s b/bolt/test/ARM/thumb1-native-conditional-move-retention.s
