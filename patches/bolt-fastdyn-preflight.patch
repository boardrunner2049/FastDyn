+# RUN: not llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=jump-tables \
+# RUN:   --icp-jt-topn=1 --icp-top-callsites=0 \
+# RUN:   -o %t.no-contract 2>&1 | FileCheck %s --check-prefix=NO-CONTRACT
+# RUN: llvm-bolt %t.exe --firmbolt-cortex-m-cpu=cortex-m3 \
+# RUN:   --firmbolt-arm-full-pipeline --data=%t.fdata --icp=jump-tables \
+# RUN:   --icp-jt-topn=1 --icp-top-callsites=0 \
+# RUN:   --firmbolt-allow-jump-table-promotion \
+# RUN:   --firmbolt-preserve-guest-instruction-count=false \
+# RUN:   --fastdyn-firmware-report=%t.json -v=1 -o %t.bolt 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=LOG
+# RUN: llvm-objdump -d --mcpu=cortex-m3 \
+# RUN:   %t.bolt | FileCheck %s --check-prefix=DISASM
+# RUN: llvm-readelf -s %t.bolt | FileCheck %s --check-prefix=SYMS
+# RUN: %python -c "import json; d=json.load(open('%t.json.layout.json')); f=next(x for x in d['functions'] if x['name']=='switch_worker'); print(f['firmware_modified'],','.join(f['firmware_modification_reasons']),f['original_size'],f['output_size'],d['synthesized_call_promotion_instruction_count'],d['synthesized_jump_table_promotion_instruction_count']); print([x['origin_kind'] for x in f['instruction_origins'][:5]])" \
+# RUN:   | FileCheck %s --check-prefix=REPORT
+
+# NO-CONTRACT: Cortex-M jump-table promotion changes compare and branch events
+# LOG: ICP succeeded in switch_worker
+# DISASM: <switch_worker>:
+# DISASM: cmp.w r0, #0
+# DISASM-NEXT: beq
+# DISASM: tbb [pc, r0]
+# DISASM: movs r0, #0xa
+# DISASM: movs r0, #0x14
+# DISASM: movs r0, #0x1e
+# SYMS-DAG: 08000016 {{.*}} $d
+# SYMS-DAG: 0800001a {{.*}} $t
+# REPORT: True {{.*}}jump_table_promotion{{.*}} 60 36 0 2
+# REPORT-NEXT: ['original_instruction', 'original_instruction', 'synthesized_jump_table_promotion', 'synthesized_jump_table_promotion', 'original_instruction']
+
+  .syntax unified
+  .thumb
+  .eabi_attribute Tag_CPU_arch, 10
+  .eabi_attribute Tag_CPU_arch_profile, 'M'
+  .text
+  .p2align 2
+
+  .globl Reset_Handler
+  .type Reset_Handler,%function
+  .thumb_func
+Reset_Handler:
+  movs r0, #0
+  bl switch_worker
+1:
+  b 1b
+  .size Reset_Handler, .-Reset_Handler
+
+  .p2align 2
+  .globl switch_worker
+  .type switch_worker,%function
+  .thumb_func
+switch_worker:
+  cmp r0, #2
+  bhi .Ldefault
+LtmpDispatch:
+  tbb [pc, r0]
+# FDATA: 1 switch_worker 4 1 switch_worker c 0 90
+# FDATA: 1 switch_worker 4 1 switch_worker 10 5 5
+# FDATA: 1 switch_worker 4 1 switch_worker 14 5 5
+.Ltable:
+  .byte (LtmpCase0 - .Ltable) / 2
+  .byte (LtmpCase1 - .Ltable) / 2
+  .byte (LtmpCase2 - .Ltable) / 2
+  .byte 0
+LtmpCase0:
+  movs r0, #10
+  bx lr
+LtmpCase1:
+  movs r0, #20
+  bx lr
+LtmpCase2:
+  movs r0, #30
+  bx lr
+.Ldefault:
+  movs r0, #0
+  bx lr
+  .rept 16
+  nop
+  .endr
+  .size switch_worker, .-switch_worker
+
+  .section .isr_vector,"a",%progbits
+  .globl g_pfnVectors
+g_pfnVectors:
+  .word 0x20001000
+  .word Reset_Handler
