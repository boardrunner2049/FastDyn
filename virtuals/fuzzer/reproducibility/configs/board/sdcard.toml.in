[Memory]

[Memory.main]
id = "ram0"
base_address = "0x20000000"
memory_size = "512M"
memory_type = "SRAM"
backend = "file"
memory_file = "__SDCARD_MAIN_RAM__"
share = true
prealloc = false

[[Memory.ram1]]
id = "ram1"
index = 1
base_address = "0x30000000"
memory_size = "512K"
memory_type = "SRAM"
backend = "file"
memory_file = "__SDCARD_RAM1__"
share = true
prealloc = false

[Machine]
# Closest repository CMSIS-SVD key; CPU execution remains Cortex-M7.
platform = "STM32F429"
qemu_path = "qemu-system-arm"
enable_gdb = false
stop_on_start = false
launch_gdb = false
monitor_port = 15560
qmp_socket = "/tmp/fastdyn-f769-sd-qmp.sock"
log_file = "qemu.log"
log_options = "none"
semihosting = true
semihosting_config = "enable=on,target=native"
coverage = true
finline = "None"

[CPU]
[[CPU.cpu0]]
arch = "arm"
machine = "cortexm"
cpu = "cortex-m7"
plugin_library = "build/libfastdyn.so"
binary = "boardrunner/boardrunner_examples/examples/STM32F769i-eval/SD_Card/Firmwares/STM32F769I_EVAL.elf"
init_nsvtor = "0x08000000"
twintrace = "None"
hardware_trace = "hardware_log/io.log"

[Device.Models.elder]

[Device.Models.passthrough]
backend = "stlink"

[Device.Models.classic]

[Device.Models.twintrace]
backend = "stlink"

[Device.Models.unhandled]

[Device.sdmmc1]
ranges = [["0x40012C00", "0x40012FFF"]]
irq = [["0", "100"]]
description = "STM32F769 SDMMC1 through the saved Elder model."
scroll_config = """
[sdmmc1]
internal_model = "sdmmc1_model"
"""

[[Device.sdmmc1.handlers]]
model = "elder"
enabled = true
scroll = "__SDCARD_MODEL_PATH__"

[[Device.sdmmc1.handlers]]
model = "passthrough"
enabled = false

[Device.remaining_space]
ranges = [
  ["0x40000000", "0x40012BFF"],
  ["0x40013000", "0xDFFFFFFF"],
  ["0xE0000000", "0xEFFFFFFF"],
]
irq = [["0", "100"]]
description = "All non-SDMMC1 peripherals through ST-LINK passthrough."

[[Device.remaining_space.handlers]]
model = "passthrough"
enabled = true

[[Device.remaining_space.handlers]]
model = "classic"
enabled = false
